# =============================================================================
# Email Security Gateway — local environment template
#
#   pnpm env:init   copies this file to .env and replaces every __GENERATE__ with a random
#                   secret (__GENERATE_<n>__: n characters), then expands ${VAR} references.
#
# .env is git-ignored. Never commit real credentials. In staging/production, secrets come from
# AWS Secrets Manager via External Secrets (mounted as files and read through <KEY>_FILE).
# Values below that point at localhost are for services run on the host (`pnpm dev`);
# docker-compose.yml overrides hostnames for containers.
# =============================================================================

COMPOSE_PROJECT_NAME=email-gateway

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
APP_ENV=local
DEPLOYMENT_MODE=saas
LOG_LEVEL=info
SERVICE_VERSION=0.1.0-local

# --- Host port bindings (all bound to 127.0.0.1). Change any that clash locally. ---
MYSQL_HOST_PORT=3306
# Read replica (mysql-replica). Seeded and kept in sync automatically by mysql-replica-setup.
MYSQL_REPLICA_HOST_PORT=3308
RABBITMQ_HOST_PORT=5672
RABBITMQ_MGMT_HOST_PORT=15672
REDIS_HOST_PORT=6379
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
SMTP_HOST_PORT=2525
RSPAMD_HOST_PORT=11333
RSPAMD_CONTROLLER_HOST_PORT=11334
CLAMAV_HOST_PORT=3310
API_HOST_PORT=3000
ADMIN_PORTAL_HOST_PORT=3001
SMTP_ADAPTER_HOST_PORT=3010
EMAIL_WORKER_HOST_PORT=3020
POLICY_ENGINE_HOST_PORT=3030
DELIVERY_WORKER_HOST_PORT=3040
NOTIFICATION_WORKER_HOST_PORT=3050
ARCHIVE_WORKER_HOST_PORT=3060
OPENSEARCH_HOST_PORT=9200
CLICKHOUSE_HOST_PORT=8123
OTEL_HTTP_HOST_PORT=4318
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3100
NOTIFY_SMARTHOST_HOST_PORT=2526

# --- MySQL 8.4 -----------------------------------------------------------------
MYSQL_ROOT_PASSWORD=__GENERATE__
MYSQL_DATABASE=email_gateway
# Runtime account: SELECT/INSERT/UPDATE/DELETE only.
MYSQL_APP_USER=gateway_app
MYSQL_APP_PASSWORD=__GENERATE__
# Migration account: ALL on the gateway schema, plus ALL on two throwaway schemas only:
# <db>_shadow (prisma migrate dev) and <db>_perf (pnpm db:perf). Never any privilege on *.*.
MYSQL_MIGRATOR_USER=gateway_migrator
MYSQL_MIGRATOR_PASSWORD=__GENERATE__
DATABASE_URL=mysql://${MYSQL_APP_USER}:${MYSQL_APP_PASSWORD}@localhost:${MYSQL_HOST_PORT}/${MYSQL_DATABASE}
MIGRATION_DATABASE_URL=mysql://${MYSQL_MIGRATOR_USER}:${MYSQL_MIGRATOR_PASSWORD}@localhost:${MYSQL_HOST_PORT}/${MYSQL_DATABASE}
# Shadow database for `prisma migrate dev` (local development only; reset by Prisma on each run).
SHADOW_DATABASE_URL=mysql://${MYSQL_MIGRATOR_USER}:${MYSQL_MIGRATOR_PASSWORD}@localhost:${MYSQL_HOST_PORT}/${MYSQL_DATABASE}_shadow
# Reader account: SELECT on the schema + REPLICATION CLIENT (lag probe only). Used by the api for
# control-plane reads against the replica; data-plane services never use it.
MYSQL_READER_USER=gateway_reader
MYSQL_READER_PASSWORD=__GENERATE__
# Replication account: used by the replica's I/O thread and as the CLONE donor login.
# MySQL allows at most 32 characters for a replication password.
MYSQL_REPLICATION_USER=gateway_repl
MYSQL_REPLICATION_PASSWORD=__GENERATE_32__
DATABASE_READ_URL=mysql://${MYSQL_READER_USER}:${MYSQL_READER_PASSWORD}@localhost:${MYSQL_REPLICA_HOST_PORT}/${MYSQL_DATABASE}
# Reads fall back to the writer when the replica lags more than this, or has stopped replicating.
DATABASE_READ_MAX_LAG_SECONDS=10
DATABASE_READ_LAG_CHECK_INTERVAL_MS=5000

# --- RabbitMQ -----------------------------------------------------------------
RABBITMQ_USER=gateway
RABBITMQ_PASSWORD=__GENERATE__
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@localhost:${RABBITMQ_HOST_PORT}
RABBITMQ_PREFETCH=20

# --- Redis --------------------------------------------------------------------
REDIS_PASSWORD=__GENERATE__
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:${REDIS_HOST_PORT}/0

# --- Object storage (MinIO locally, AWS S3 in the cloud) -------------------------
MINIO_ROOT_USER=gateway-minio
MINIO_ROOT_PASSWORD=__GENERATE__
S3_REGION=ap-south-1
S3_ENDPOINT=http://localhost:${MINIO_HOST_PORT}
S3_FORCE_PATH_STYLE=true
S3_BUCKET_MAIL=gateway-mail
S3_BUCKET_ARCHIVE=gateway-archive
S3_ACCESS_KEY_ID=${MINIO_ROOT_USER}
S3_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}

# --- Postfix ------------------------------------------------------------------
POSTFIX_MYHOSTNAME=mx.gateway.local
# Comma-separated domains the local MX accepts mail for.
POSTFIX_RELAY_DOMAINS=gateway.test

# --- ClickHouse / OpenSearch (profile: analytics) --------------------------------
CLICKHOUSE_USER=gateway
CLICKHOUSE_PASSWORD=__GENERATE__
CLICKHOUSE_DB=gateway_analytics

# --- Observability (profile: observability) ---------------------------------------
# Unset to disable tracing. Containers use http://otel-collector:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=
GRAFANA_ADMIN_PASSWORD=__GENERATE__

# --- API / portal ---------------------------------------------------------------
CORS_ORIGINS=http://localhost:${ADMIN_PORTAL_HOST_PORT}
API_INTERNAL_URL=http://localhost:${API_HOST_PORT}

# --- API authentication and tenancy (step 1.2/1.3) ---
# Existing .env files: append these keys from here; never re-run env:init --force (it rotates
# every secret). Rotation of the first three: move the old value to the *_PREVIOUS key.
AUTH_JWT_SECRET=__GENERATE_64__
AUTH_JWT_PREVIOUS_SECRET=
AUTH_JWT_ISSUER=email-gateway
AUTH_JWT_AUDIENCE=email-gateway-api
AUTH_ACCESS_TOKEN_TTL_SECONDS=600
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_SESSION_MAX_AGE_SECONDS=2592000
# HMAC pepper for API-key and recovery-code hashes.
AUTH_TOKEN_PEPPER=__GENERATE_64__
# AES-256-GCM key (64 hex characters) for application-encrypted columns such as MFA secrets.
DATA_ENCRYPTION_KEY=__GENERATE_64__
DATA_ENCRYPTION_KEY_PREVIOUS=
# Argon2id parameters; the values below are the minimums (OWASP Password Storage Cheat Sheet).
AUTH_ARGON2_MEMORY_KIB=19456
AUTH_ARGON2_TIME_COST=2
AUTH_ARGON2_PARALLELISM=1
AUTH_LOGIN_MAX_ACCOUNT_FAILURES=5
AUTH_LOGIN_MAX_IP_FAILURES=50
AUTH_LOGIN_FAILURE_WINDOW_SECONDS=900
AUTH_LOCKOUT_BASE_SECONDS=900
AUTH_LOCKOUT_MAX_SECONDS=86400
AUTH_MFA_ISSUER=EmailSecurityGateway
AUTH_PASSWORD_RESET_TTL_SECONDS=1800
AUTH_EMAIL_VERIFICATION_TTL_SECONDS=86400
AUTH_INVITATION_TTL_SECONDS=604800
AUTH_LOGIN_AUDIT_RETENTION_DAYS=365
AUTH_BACKGROUND_JOBS_ENABLED=true
PLATFORM_OVERRIDE_MAX_MINUTES=60
ORG_DELETION_RETENTION_DAYS=30
ORG_DELETION_CONFIRM_WINDOW_HOURS=72
# Reverse-proxy hops in front of the api (0 locally, 1 behind the ALB/ingress); drives client IPs.
HTTP_TRUST_PROXY=0
# Origin of the admin portal; invitation, reset and verification emails link here.
PORTAL_PUBLIC_URL=http://localhost:${ADMIN_PORTAL_HOST_PORT}

# --- Transactional email (password reset, verification, invitations, alerts) ---
# Services submit to the internal smarthost postfix-notify (Compose overrides these for the api
# container). Plaintext (NOTIFY_SMTP_SECURE=none) is accepted only in local and CI; production
# submits over TLS. NOTIFY_SMTP_USER/PASSWORD/CA_PATH remain available for a direct relay.
NOTIFY_SMTP_HOST=127.0.0.1
NOTIFY_SMTP_PORT=${NOTIFY_SMARTHOST_HOST_PORT}
NOTIFY_SMTP_SECURE=none
NOTIFY_SMTP_FROM=
# Upstream submission relay used by postfix-notify. Credentials are only used inside that
# container. TLS is mandatory and the upstream certificate is pinned by its SHA-256 fingerprint:
#   openssl s_client -connect HOST:587 -starttls smtp </dev/null 2>/dev/null \
#     | openssl x509 -noout -fingerprint -sha256
NOTIFY_RELAY_HOST=
NOTIFY_RELAY_PORT=587
NOTIFY_RELAY_USER=
NOTIFY_RELAY_PASSWORD=
NOTIFY_RELAY_TLS_FINGERPRINT=

# --- Domain onboarding and DNS (step 2.1) ---
# How the api resolves customers' DNS records (ADR-0017). system: node:dns against DNS_SERVERS
# (empty = the host's resolvers, e.g. a local Unbound or the VPC resolver). doh: DNS-over-HTTPS
# (RFC 8484) against DNS_DOH_URL; https only outside local/ci; sends customer domain names to
# that provider.
DNS_RESOLVER_MODE=system
# Comma list of ip, ip:port or [ipv6]:port (system mode).
DNS_SERVERS=
DNS_DOH_URL=https://cloudflare-dns.com/dns-query
# Per try; DOMAIN_CHECK_DEADLINE_MS must be >= DNS_TIMEOUT_MS x DNS_TRIES.
DNS_TIMEOUT_MS=2500
DNS_TRIES=2
# Extra upstreams (same kind as the mode: IPs for system, URLs for doh) used only to check that
# the MX change has propagated. Empty = no propagation check.
DNS_PROPAGATION_UPSTREAMS=
# Redis cache of definitive DNS answers; 0 disables it. System-mode answers carry no TTL and
# are cached for DNS_CACHE_NEGATIVE_TTL_SECONDS.
DNS_CACHE_MAX_TTL_SECONDS=300
DNS_CACHE_NEGATIVE_TTL_SECONDS=60
# Required, no default: where customers point their MX (priority:host list) and the SPF record
# they include. Set per environment to the gateway's real public names.
GATEWAY_MX_HOSTS=10:mx1.mail-gateway.test,20:mx2.mail-gateway.test
GATEWAY_SPF_INCLUDE=_spf.mail-gateway.test
# Optional DMARC report destinations (comma list of mailto: URIs) added to recommendations.
# External destinations need an authorization record (RFC 7489 section 7.1).
GATEWAY_DMARC_RUA=mailto:dmarc-reports@mail-gateway.test
GATEWAY_DMARC_RUF=
# Ownership TXT record: <label>.<domain> = emailgateway-verification=<token>.
DOMAIN_VERIFICATION_LABEL=_emailgateway-verify
DOMAIN_VERIFICATION_TTL_DAYS=7
# Comma list of DNS names customers may not onboard (equal to or under any entry).
DOMAIN_RESERVED_SUFFIXES=
# Background verification / re-verification / DKIM retirement inside the api.
DOMAIN_BACKGROUND_JOBS_ENABLED=true
DOMAIN_JOBS_INTERVAL_SECONDS=30
DOMAIN_CHECK_BATCH_SIZE=50
DOMAIN_CHECK_CONCURRENCY=4
DOMAIN_CHECK_DEADLINE_MS=15000
DOMAIN_RETRY_BASE_SECONDS=60
DOMAIN_RETRY_MAX_SECONDS=3600
DOMAIN_RECHECK_INCOMPLETE_SECONDS=1800
DOMAIN_RECHECK_INTERVAL_SECONDS=86400
DKIM_ROTATION_OVERLAP_DAYS=7
