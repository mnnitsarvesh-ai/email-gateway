# Copy to .env.local (gitignored) for local development. Placeholders only.
# Real values never go in git; cloud environments use Secrets Manager or SSM.

NODE_ENV=development
LOG_LEVEL=info

# MySQL writer (the data plane uses the writer only)
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DBNAME

# RabbitMQ
AMQP_URL=amqp://USER:PASSWORD@HOST:5672

# Redis
REDIS_URL=redis://HOST:6379

# S3 / MinIO
S3_ENDPOINT=http://HOST:9000
S3_BUCKET=BUCKET_NAME
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
