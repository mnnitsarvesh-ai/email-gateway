{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install*)",
      "Bash(pnpm turbo *)",
      "Bash(pnpm build*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm test*)",
      "Bash(pnpm dbmate *)",
      "Bash(docker compose *)",
      "Bash(swaks *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(terraform fmt*)",
      "Bash(terraform validate*)",
      "Read(**/.env.example)"
    ],
    "deny": [
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(terraform * apply*)",
      "Bash(terraform * destroy*)",
      "Bash(git push*)",
      "Bash(kubectl*)",
      "Bash(aws)",
      "Bash(aws *)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.dev*)",
      "Read(**/.env.prod*)",
      "Read(**/.env.stag*)",
      "Read(**/.env.test*)",
      "Read(**/.env.qa*)",
      "Read(**/.env.uat*)",
      "Read(**/.env.ci*)",
      "Read(**/.env.secret*)",
      "Read(**/secrets/**)",
      "Read(**/.secrets/**)"
    ]
  }
}
