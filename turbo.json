{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "eslint.config.mjs",
    "tsconfig.base.json",
    "pnpm-workspace.yaml",
    "tooling/eslint-config/**",
    "!tooling/eslint-config/node_modules/**"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/services/*/package.json"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "cache": false
    },
    "@esg/workspace-guard#lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/{services,packages,tooling}/*/package.json",
        "$TURBO_ROOT$/db/package.json",
        "$TURBO_ROOT$/test/e2e/package.json"
      ]
    },
    "@esg/workspace-guard#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/{services,packages,tooling}/*/package.json",
        "$TURBO_ROOT$/db/package.json",
        "$TURBO_ROOT$/test/e2e/package.json"
      ]
    },
    "@esg/lint-fixtures#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/eslint.config.mjs",
        "$TURBO_ROOT$/tooling/eslint-config/*.mjs",
        "$TURBO_ROOT$/tooling/eslint-config/*.d.mts",
        "$TURBO_ROOT$/tooling/eslint-config/package.json"
      ]
    },
    "@esg/repo-checks#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/turbo.json",
        "$TURBO_ROOT$/CLAUDE.md",
        "$TURBO_ROOT$/.gitignore",
        "$TURBO_ROOT$/.gitleaks.toml",
        "$TURBO_ROOT$/.env.example",
        "$TURBO_ROOT$/.npmrc",
        "$TURBO_ROOT$/.node-version",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/eslint.config.mjs",
        "$TURBO_ROOT$/.github/**",
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/tooling/**",
        "$TURBO_ROOT$/{services,packages}/**/{package.json,tsconfig*.json,eslint.config.*}",
        "$TURBO_ROOT$/{db,test/e2e}/**/{package.json,tsconfig*.json,eslint.config.*}",
        "$TURBO_ROOT$/{infra,deploy}/**",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/.turbo/**"
      ]
    }
  }
}
