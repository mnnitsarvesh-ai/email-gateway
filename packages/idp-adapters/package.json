{
  "name": "@email-gateway/idp-adapters",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "testing": [
        "dist/testing/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:integration": "echo 'no infrastructure suites in @email-gateway/idp-adapters (pure library; simulator suites run in test)'"
  },
  "dependencies": {
    "@email-gateway/ato-detection": "workspace:*",
    "@email-gateway/database": "workspace:*",
    "@email-gateway/provider-integrations": "workspace:*",
    "zod": "^4.1.5"
  },
  "devDependencies": {}
}
