  reasonCode     String?        @map("reason_code") @db.VarChar(64)
  eventId        String?        @map("event_id") @db.Char(36)
  changedAt      DateTime       @map("changed_at") @db.DateTime(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.DateTime(3)

  @@id([id, receivedAt])
  @@unique([messageId, version, receivedAt])
  @@map("email_message_status_history")
}

