// Primary transactional store (MySQL 8.4). Control-plane and pipeline-state tables live here;
// event history and analytics go to ClickHouse, searchable metadata to OpenSearch.
//
// Conventions (see docs/database/conventions.md):
// - Every tenant-owned table has a non-null `tenant_id` and indexes lead with it.
// - Entity ids are UUIDv7 strings generated by Prisma (time-ordered, append-friendly inserts).
// - Append-only logs (outbox, audit) use BIGINT AUTO_INCREMENT for strict ordering.
// - snake_case table and column names via @@map / @map.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "mysql"
  // Runtime connection: DML-only account.
  url       = env("DATABASE_URL")
  // Migrations run with a separate DDL-capable account.
  directUrl = env("MIGRATION_DATABASE_URL")
}

enum TenantStatus {
  active
  suspended
  deleted
}

enum DomainVerificationStatus {
  pending
  verified
  failed
}

enum UserRole {
  tenant_admin
  security_analyst
  helpdesk
  end_user
}

enum UserStatus {
  invited
  active
  disabled
}

enum AuditActorType {
  user
  system
  api_key
}

model Tenant {
  id        String       @id @default(uuid(7)) @db.Char(36)
  slug      String       @unique @db.VarChar(63)
  name      String       @db.VarChar(255)
  status    TenantStatus @default(active)
  createdAt DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.DateTime(3)

  domains TenantDomain[]
  users   User[]

  @@map("tenants")
}

model TenantDomain {
  id                 String                   @id @default(uuid(7)) @db.Char(36)
  tenantId           String                   @map("tenant_id") @db.Char(36)
  /// Lower-cased ASCII (punycode) domain. Globally unique: one domain belongs to one tenant.
  domain             String                   @unique @db.VarChar(253)
  verificationStatus DomainVerificationStatus @default(pending) @map("verification_status")
  verificationToken  String                   @map("verification_token") @db.VarChar(64)
  verifiedAt         DateTime?                @map("verified_at") @db.DateTime(3)
  createdAt          DateTime                 @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.DateTime(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, verificationStatus])
  @@map("tenant_domains")
}

model User {
  id          String     @id @default(uuid(7)) @db.Char(36)
  tenantId    String     @map("tenant_id") @db.Char(36)
  email       String     @db.VarChar(320)
  displayName String     @map("display_name") @db.VarChar(255)
  role        UserRole
  status      UserStatus @default(invited)
  lastLoginAt DateTime?  @map("last_login_at") @db.DateTime(3)
  createdAt   DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.DateTime(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, email])
  @@map("users")
}

/// Append-only audit trail of administrative actions. Never updated or deleted by services.
model AuditLog {
  id            BigInt         @id @default(autoincrement())
  /// Null only for platform-level actions.
  tenantId      String?        @map("tenant_id") @db.Char(36)
  actorType     AuditActorType @map("actor_type")
  actorId       String?        @map("actor_id") @db.VarChar(64)
  action        String         @db.VarChar(100)
  resourceType  String         @map("resource_type") @db.VarChar(64)
  resourceId    String?        @map("resource_id") @db.VarChar(64)
  correlationId String?        @map("correlation_id") @db.VarChar(128)
  sourceIp      String?        @map("source_ip") @db.VarChar(45)
  metadata      Json?
  createdAt     DateTime       @default(now()) @map("created_at") @db.DateTime(3)

  @@index([tenantId, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

/// Transactional outbox: written in the same transaction as the state change, then published
/// to RabbitMQ with publisher confirms by a relay. Guarantees no event is lost or invented.
model OutboxEvent {
  id            BigInt    @id @default(autoincrement())
  eventId       String    @unique @map("event_id") @db.Char(36)
  tenantId      String    @map("tenant_id") @db.Char(36)
  eventType     String    @map("event_type") @db.VarChar(100)
  correlationId String    @map("correlation_id") @db.VarChar(128)
  payload       Json
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  publishedAt   DateTime? @map("published_at") @db.DateTime(3)
  attempts      Int       @default(0) @db.UnsignedInt

  @@index([publishedAt, id])
  @@map("outbox_events")
}

/// Inbox / idempotency ledger. A consumer records (consumer, event_id) in the same transaction
/// as its side effects; a duplicate delivery hits the primary key and is skipped.
model ProcessedEvent {
  consumer    String   @db.VarChar(100)
  eventId     String   @map("event_id") @db.Char(36)
  processedAt DateTime @default(now()) @map("processed_at") @db.DateTime(3)

  @@id([consumer, eventId])
  @@index([processedAt])
  @@map("processed_events")
}
