/// Platform catalog of plans. `default_limits` maps limit_key → value, `default_features`
/// maps feature_key → bool.
model OrganizationPlan {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  code            String   @unique @db.VarChar(32)
  name            String   @db.VarChar(255)
  description     String?  @db.VarChar(512)
  isActive        Boolean  @default(true) @map("is_active")
  defaultLimits   Json     @map("default_limits")
  defaultFeatures Json     @map("default_features")
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organizations Organization[]

  @@map("organization_plans")
}

/// A tenant. Platform operators belong to the `kind = platform` organization (slug `platform`).
model Organization {
  id                        BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  publicId                  String              @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  slug                      String              @unique @db.VarChar(63)
  name                      String              @db.VarChar(255)
  kind                      OrganizationKind    @default(customer)
  status                    OrganizationStatus  @default(active)
  planId                    BigInt              @map("plan_id") @db.UnsignedBigInt
  deploymentMode            DeploymentMode      @default(saas) @map("deployment_mode")
  /// Cloud region, e.g. `ap-south-1`.
  dataRegion                String              @map("data_region") @db.VarChar(32)
  statusReason              String?             @map("status_reason") @db.VarChar(512)
  statusChangedAt           DateTime?           @map("status_changed_at") @db.DateTime(3)
  // Deletion workflow (step 1.2, D12): request → four-eyes confirm → purge after purge_after.
  deletionRequestedAt       DateTime?           @map("deletion_requested_at") @db.DateTime(3)
  /// No FK: the trail survives the deletion of the requesting user.
  deletionRequestedByUserId BigInt?             @map("deletion_requested_by_user_id") @db.UnsignedBigInt
  deletionReason            String?             @map("deletion_reason") @db.VarChar(512)
  deletionConfirmedAt       DateTime?           @map("deletion_confirmed_at") @db.DateTime(3)
  /// No FK: the trail survives the deletion of the confirming user.
  deletionConfirmedByUserId BigInt?             @map("deletion_confirmed_by_user_id") @db.UnsignedBigInt
  /// Status restored when a deletion request is cancelled.
  statusBeforeDeletion      OrganizationStatus? @map("status_before_deletion")
  /// Earliest time the (deferred) purge job may delete the tenant's data.
  purgeAfter                DateTime?           @map("purge_after") @db.DateTime(3)
  deletedAt                 DateTime?           @map("deleted_at") @db.DateTime(3)
  createdAt                 DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                 DateTime            @updatedAt @map("updated_at") @db.DateTime(3)
  /// Step API-1 (D1, ADR-0098): the organization's protection mode, the default of every domain
  /// without its own mode (`domains.protection_mode` NULL). `api` / `hybrid` need the feature
  /// `api_mode_protection`. Changed only through `PUT /organizations/{id}/protection-mode`
  /// (audited); never changes inline mail flow.
  protectionMode            ProtectionMode      @default(inline) @map("protection_mode")
  protectionModeChangedAt   DateTime?           @map("protection_mode_changed_at") @db.DateTime(3)

  plan OrganizationPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  settings                 OrganizationSetting?
  limits                   OrganizationLimit[]
  features                 OrganizationFeature[]
  deployments              OrganizationDeployment[]
  users                    User[]
  roles                    Role[]
  userRoles                UserRole[]
  userSessions             UserSession[]
  userTokens               UserToken[]
  userMfaRecoveryCodes     UserMfaRecoveryCode[]
  apiKeys                  ApiKey[]
  loginAuditLogs           LoginAuditLog[]
  domains                  Domain[]
  domainVerifications      DomainVerification[]
  domainDnsRecords         DomainDnsRecord[]
  domainDkimKeys           DomainDkimKey[]
  domainMxRecords          DomainMxRecord[]
  domainMailServers        DomainMailServer[]
  domainSettings           DomainSetting[]
  domainRecipientAddresses DomainRecipientAddress[]
  smtpConnectors           SmtpConnector[]
  smtpConnectorNetworks    SmtpConnectorNetwork[]
  messageIdentities        MessageIdentity[]
  threatIndicators         ThreatIndicator[]
  yaraRules                YaraRule[]
  emailPolicies            EmailPolicy[]
  policyVersions           PolicyVersion[]
  policyConditions         PolicyCondition[]
  policyActions            PolicyAction[]
  policyExceptions         PolicyException[]
  deliveryRoutes           DeliveryRoute[]
  deliverySuppressions     DeliverySuppression[]
  quarantineMessages       QuarantineMessage[]
  quarantineActions        QuarantineAction[]
  quarantineReleaseLogs    QuarantineReleaseLog[]
  quarantineApprovals      QuarantineApprovalRequest[]
  quarantineDownloadGrants QuarantineDownloadGrant[]
  quarantineSettings       QuarantineSettings?
  quarantineUserPrefs      QuarantineUserPreference[]
  quarantineObjectPurges   QuarantineObjectPurge[]
  quarantineDigestRuns     QuarantineDigestRun[]
  quarantineDigests        QuarantineDigest[]
  archiveSettings          ArchiveSetting?
  archiveRetentionPolicies ArchiveRetentionPolicy[]
  archiveLegalHolds        ArchiveLegalHold[]
  archiveEncryptionKeys    ArchiveEncryptionKey[]
  archiveIndexChecks       ArchiveIndexCheck[]
  archiveDownloadGrants    ArchiveDownloadGrant[]
  ediscoveryCases          EdiscoveryCase[]
  ediscoveryCustodians     EdiscoveryCustodian[]
  ediscoverySearches       EdiscoverySearch[]
  ediscoveryExports        EdiscoveryExport[]
  webhookSubscriptions     WebhookSubscription[]
  webhookReplays           WebhookReplay[]
  notificationSettings     NotificationSettings?
  notificationUserPrefs    NotificationUserPreference[]
  notificationAlertWindows NotificationAlertWindow[]
  savedViews               SavedView[]
  scanEngineSettings       ScanEngineSetting[]
  attachmentRescanJobs     AttachmentRescanJob[]
  becExecutiveProfiles     BecExecutiveProfile[]
  becVendorProfiles        BecVendorProfile[]
  becTrustedSenders        BecTrustedSender[]
  becFeedback              BecFeedback[]
  becSuppressionRules      BecSuppressionRule[]
  becContactHistory        BecContactHistory[]
  dlpPolicies              DlpPolicy[]
  dlpPolicyRules           DlpPolicyRule[]
  dlpExceptions            DlpException[]
  dlpCustomPatterns        DlpCustomPattern[]
  dlpKeywordDictionaries   DlpKeywordDictionary[]
  dlpComplianceSettings    DlpComplianceSettings?
  riskScoringProfile       RiskScoringProfile?
  riskScoringVersions      RiskScoringProfileVersion[]
  policySettings           PolicySettings?
  tenantDepartments        TenantDepartment[]
  tenantDepartmentMembers  TenantDepartmentMember[]
  securityIncidents        SecurityIncident[]
  atoSettings              AtoSetting?
  atoSettingsVersions      AtoSettingsVersion[]
  atoAccounts              AtoAccount[]
  atoRiskOverrides         AtoRiskOverride[]
  atoResponseActions       AtoResponseAction[]
  atoSmtpRestrictions      AtoSmtpRestriction[]
  atoProviderIntegrations  AtoProviderIntegration[]
  atoProviderStreams       AtoProviderStream[]
  atoProviderMailboxItems  AtoProviderMailboxItem[]
  providerConnections      ProviderConnection[]
  journalIntakeSources     JournalIntakeSource[]
  aiChatSettings           AiChatSettings?
