/// Typed 1:1 settings; rarely read preferences go in `preferences` JSON.
model OrganizationSetting {
  id                      BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId          BigInt   @unique @map("organization_id") @db.UnsignedBigInt
  timezone                String   @default("UTC") @db.VarChar(64)
  locale                  String   @default("en") @db.VarChar(16)
  quarantineRetentionDays Int      @default(30) @map("quarantine_retention_days") @db.UnsignedSmallInt
  digestEnabled           Boolean  @default(true) @map("digest_enabled")
  /// Cron expression.
  digestSchedule          String   @default("0 8 * * *") @map("digest_schedule") @db.VarChar(64)
  notificationEmail       String?  @map("notification_email") @db.VarChar(320)
  /// Members without MFA must enroll before using anything else (step 1.3, D7).
  mfaRequired             Boolean  @default(false) @map("mfa_required")
  preferences             Json?
  createdAt               DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("organization_settings")
}

/// Effective limits (messages_per_day, max_domains, max_users, max_message_size_bytes,
/// api_requests_per_minute, quarantine_retention_days, archive_retention_days).
model OrganizationLimit {
  id             BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId BigInt        @map("organization_id") @db.UnsignedBigInt
  limitKey       String        @map("limit_key") @db.VarChar(64)
  limitValue     BigInt        @map("limit_value") @db.UnsignedBigInt
  source         SettingSource @default(plan)
  createdAt      DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, limitKey])
  @@map("organization_limits")
}

/// Feature flags (inbound_filtering, outbound_filtering, internal_inspection, url_rewriting,
/// attachment_sandbox, dlp, bec_detection, archiving, api_access, sso, webhooks).
model OrganizationFeature {
  id             BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId BigInt        @map("organization_id") @db.UnsignedBigInt
  featureKey     String        @map("feature_key") @db.VarChar(64)
  enabled        Boolean       @default(false)
  config         Json?
  source         SettingSource @default(plan)
  createdAt      DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, featureKey])
  @@map("organization_features")
}

model OrganizationDeployment {
  id               BigInt                       @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId   BigInt                       @map("organization_id") @db.UnsignedBigInt
  deploymentMode   DeploymentMode               @map("deployment_mode")
  region           String                       @db.VarChar(32)
  environment      String                       @db.VarChar(32)
  status           OrganizationDeploymentStatus @default(provisioning)
  endpointHostname String?                      @map("endpoint_hostname") @db.VarChar(255)
  mxHostname       String?                      @map("mx_hostname") @db.VarChar(255)
  releaseVersion   String?                      @map("release_version") @db.VarChar(64)
  config           Json?
  provisionedAt    DateTime?                    @map("provisioned_at") @db.DateTime(3)
  decommissionedAt DateTime?                    @map("decommissioned_at") @db.DateTime(3)
  createdAt        DateTime                     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime                     @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@map("organization_deployments")
}

