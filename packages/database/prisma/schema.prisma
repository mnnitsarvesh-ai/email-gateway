// Primary transactional store (MySQL 8.4). Control-plane and pipeline-state tables live here;
// event history and analytics go to ClickHouse, searchable metadata to OpenSearch.
// Design: docs/plan/steps/01-database.md (section 3) and ADR-0014.
//
// Conventions:
// - Surrogate keys are BIGINT UNSIGNED AUTO_INCREMENT. Internal contracts (events, S3 keys, logs)
//   carry them as decimal strings (see src/ids.ts); never JSON.stringify a raw bigint.
// - Aggregate roots addressed from outside (organizations, users, domains, api_keys,
//   email_policies, webhook_subscriptions, quarantine_messages, message_identities) also carry a
//   `public_id` CHAR(36) UUIDv7. REST APIs expose only `public_id`.
// - Every tenant-owned table has `organization_id` (NOT NULL, except roles, threat_indicators,
//   yara_rules, audit_logs and login_audit_logs, where NULL means platform-level) and
//   tenant-scoped indexes lead with it. The tenant always comes from the authenticated context.
// - Timestamps are DATETIME(3) UTC. Append-only tables have no `updated_at`.
// - snake_case table and column names via @@map / @map. Enum values are only ever appended.
// - No email bodies or attachment content: only S3 object keys, sizes and hashes.
// - Partitioned tables (31, marked PARTITIONED below) use a composite primary key
//   (id, <partition column>), have no foreign keys in either direction, and every unique key
//   ends with the partition column. The PARTITION BY clause is hand-written in the migration
//   SQL; Prisma does not model partitions. Child rows of a message copy the message's
//   `received_at` so one message's graph lives in one partition.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  // Runtime connection: DML-only account.
  url               = env("DATABASE_URL")
  // Migrations run with a separate DDL-capable account.
  directUrl         = env("MIGRATION_DATABASE_URL")
  // `prisma migrate dev` only: a dedicated throwaway schema the migrator owns
  // (<db>_shadow), so the migrator needs no privileges on *.* (infrastructure/mysql/init).
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

