model User {
  id                  BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  publicId            String     @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  organizationId      BigInt     @map("organization_id") @db.UnsignedBigInt
  /// Lower-cased.
  email               String     @db.VarChar(320)
  displayName         String     @map("display_name") @db.VarChar(255)
  status              UserStatus @default(invited)
  /// Argon2id (step 1.3).
  passwordHash        String?    @map("password_hash") @db.VarChar(255)
  mfaEnabled          Boolean    @default(false) @map("mfa_enabled")
  /// Application-encrypted, never plaintext.
  mfaSecretCiphertext String?    @map("mfa_secret_ciphertext") @db.VarChar(512)
  /// Last accepted TOTP time step; a code is accepted only for a later step (replay protection).
  mfaLastUsedStep     BigInt?    @map("mfa_last_used_step") @db.UnsignedBigInt
  emailVerifiedAt     DateTime?  @map("email_verified_at") @db.DateTime(3)
  failedLoginCount    Int        @default(0) @map("failed_login_count") @db.UnsignedSmallInt
  lockedUntil         DateTime?  @map("locked_until") @db.DateTime(3)
  passwordChangedAt   DateTime?  @map("password_changed_at") @db.DateTime(3)
  lastLoginAt         DateTime?  @map("last_login_at") @db.DateTime(3)
  statusReason        String?    @map("status_reason") @db.VarChar(512)
  statusChangedAt     DateTime?  @map("status_changed_at") @db.DateTime(3)
  deletedAt           DateTime?  @map("deleted_at") @db.DateTime(3)
  createdAt           DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  userRoles                  UserRole[]               @relation("UserRoleUser")
  grantedUserRoles           UserRole[]               @relation("UserRoleGrantedBy")
  sessions                   UserSession[]
  tokens                     UserToken[]              @relation("UserTokenUser")
  createdTokens              UserToken[]              @relation("UserTokenCreatedBy")
  mfaRecoveryCodes           UserMfaRecoveryCode[]
  createdApiKeys             ApiKey[]
  updatedYaraRules           YaraRule[]
  createdEmailPolicies       EmailPolicy[]
  publishedPolicyVersions    PolicyVersion[]
  createdPolicyExceptions    PolicyException[]
  createdSuppressions        DeliverySuppression[]
  quarantineMessages         QuarantineMessage[]
  quarantineActions          QuarantineAction[]
  createdLegalHolds          ArchiveLegalHold[]       @relation("LegalHoldCreatedBy")
  releasedLegalHolds         ArchiveLegalHold[]       @relation("LegalHoldReleasedBy")
  createdWebhooks            WebhookSubscription[]
  updatedSystemSettings      SystemSetting[]
  createdSmtpConnectors      SmtpConnector[]
  createdRecipients          DomainRecipientAddress[]
  updatedScanEngineSettings  ScanEngineSetting[]
  addedMalwareSignatures     MalwareSignature[]
  requestedAttachmentRescans AttachmentRescanJob[]
  addedThreatIndicators      ThreatIndicator[]
  createdBecExecutives       BecExecutiveProfile[]    @relation("BecExecutiveCreatedBy")
  updatedBecExecutives       BecExecutiveProfile[]    @relation("BecExecutiveUpdatedBy")
  createdBecVendors          BecVendorProfile[]       @relation("BecVendorCreatedBy")
  updatedBecVendors          BecVendorProfile[]       @relation("BecVendorUpdatedBy")
  createdBecTrustedSenders   BecTrustedSender[]       @relation("BecTrustedSenderCreatedBy")
  createdBecFeedback         BecFeedback[]            @relation("BecFeedbackCreatedBy")
  createdBecSuppressions     BecSuppressionRule[]     @relation("BecSuppressionCreatedBy")

  @@unique([organizationId, email])
  @@index([organizationId, status])
  @@map("users")
}

/// `organization_id` NULL = built-in system role. MySQL unique keys do not collide on NULL, so
/// the seed enforces the uniqueness of system role keys.
model Role {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId BigInt?  @map("organization_id") @db.UnsignedBigInt
  key            String   @db.VarChar(64)
  name           String   @db.VarChar(255)
  description    String?  @db.VarChar(512)
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  permissions RolePermission[]
  userRoles   UserRole[]

  @@unique([organizationId, key])
  @@index([key])
  @@map("roles")
}

/// Platform catalog of `resource:action` permission keys.
model Permission {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  key         String   @unique @db.VarChar(100)
  description String   @db.VarChar(255)
  category    String   @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       BigInt   @map("role_id") @db.UnsignedBigInt
  permissionId BigInt   @map("permission_id") @db.UnsignedBigInt
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// `organization_id` is denormalized from the user for tenant-scoped queries.
model UserRole {
  userId          BigInt   @map("user_id") @db.UnsignedBigInt
  roleId          BigInt   @map("role_id") @db.UnsignedBigInt
  organizationId  BigInt   @map("organization_id") @db.UnsignedBigInt
  grantedByUserId BigInt?  @map("granted_by_user_id") @db.UnsignedBigInt
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)

  user         User         @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  grantedBy    User?        @relation("UserRoleGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([organizationId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// One row per issued refresh token; a session is a rotation family (step 1.3, D5). Exactly one
/// row of a live family has `revoked_at` NULL. Expired rows are purged hourly by the api.
model UserSession {
  id                BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId    BigInt    @map("organization_id") @db.UnsignedBigInt
  userId            BigInt    @map("user_id") @db.UnsignedBigInt
  /// SHA-256 of the refresh token; the token itself is never stored.
  refreshTokenHash  String    @unique @map("refresh_token_hash") @db.Char(64)
  /// Rotation family: reuse of a rotated token revokes the whole family.
  familyId          String    @map("family_id") @db.Char(36)
  ipAddress         String?   @map("ip_address") @db.VarChar(45)
  userAgent         String?   @map("user_agent") @db.VarChar(512)
  lastUsedAt        DateTime? @map("last_used_at") @db.DateTime(3)
  /// When the family was created by a login; copied to every rotated row.
  authenticatedAt   DateTime  @map("authenticated_at") @db.DateTime(3)
  /// Sliding idle expiry of this refresh token, never later than `absolute_expires_at`.
  expiresAt         DateTime  @map("expires_at") @db.DateTime(3)
  /// Hard cap for the whole family, independent of refreshes.
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.DateTime(3)
  /// The login completed a second factor (required by step-up operations).
  mfaAuthenticated  Boolean   @default(false) @map("mfa_authenticated")
  revokedAt         DateTime? @map("revoked_at") @db.DateTime(3)
  revokedReason     String?   @map("revoked_reason") @db.VarChar(64)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId, revokedAt])
  @@index([expiresAt])
  @@map("user_sessions")
}

/// Single-use tokens (invitation, password reset, email verification; step 1.3, D4). Only the
/// SHA-256 of the token is stored. Effectively append-only: `consumed_at` is the only mutation,
/// so there is no `updated_at`. Expired rows are purged by the api 7 days after `expires_at`.
model UserToken {
  id              BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId  BigInt           @map("organization_id") @db.UnsignedBigInt
  userId          BigInt           @map("user_id") @db.UnsignedBigInt
  purpose         UserTokenPurpose
  /// SHA-256 hex of the token; the token itself is never stored.
  tokenHash       String           @unique @map("token_hash") @db.Char(64)
  expiresAt       DateTime         @map("expires_at") @db.DateTime(3)
  consumedAt      DateTime?        @map("consumed_at") @db.DateTime(3)
  createdByUserId BigInt?          @map("created_by_user_id") @db.UnsignedBigInt
  createdIp       String?          @map("created_ip") @db.VarChar(45)
  createdAt       DateTime         @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation("UserTokenUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("UserTokenCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([userId, purpose, consumedAt])
  @@index([expiresAt])
  @@map("user_tokens")
}

/// MFA recovery codes (step 1.3, D4): HMAC-SHA256 with the server pepper, single use via
/// `used_at`. Regenerating replaces the user's whole set.
model UserMfaRecoveryCode {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId BigInt    @map("organization_id") @db.UnsignedBigInt
  userId         BigInt    @map("user_id") @db.UnsignedBigInt
  codeHash       String    @map("code_hash") @db.Char(64)
  usedAt         DateTime? @map("used_at") @db.DateTime(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@map("user_mfa_recovery_codes")
}

model ApiKey {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  publicId        String    @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  organizationId  BigInt    @map("organization_id") @db.UnsignedBigInt
  name            String    @db.VarChar(255)
  /// Shown to users and used for lookup.
  keyPrefix       String    @unique @map("key_prefix") @db.VarChar(16)
  /// HMAC-SHA256 of the secret; the secret is never stored.
  keyHash         String    @map("key_hash") @db.Char(64)
  /// Array of permission keys.
  scopes          Json
  createdByUserId BigInt?   @map("created_by_user_id") @db.UnsignedBigInt
  lastUsedAt      DateTime? @map("last_used_at") @db.DateTime(3)
  expiresAt       DateTime? @map("expires_at") @db.DateTime(3)
  revokedAt       DateTime? @map("revoked_at") @db.DateTime(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, revokedAt])
  @@map("api_keys")
}

/// Append-only. `organization_id` NULL = attempt for an unknown account. `user_id` has no FK so
/// the trail survives user deletion.
model LoginAuditLog {
  id             BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId BigInt?      @map("organization_id") @db.UnsignedBigInt
  userId         BigInt?      @map("user_id") @db.UnsignedBigInt
  emailAttempted String       @map("email_attempted") @db.VarChar(320)
  outcome        LoginOutcome
  failureReason  String?      @map("failure_reason") @db.VarChar(64)
  ipAddress      String?      @map("ip_address") @db.VarChar(45)
  userAgent      String?      @map("user_agent") @db.VarChar(512)
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("login_audit_logs")
}

// ---------------------------------------------------------------------------------------------
// 3.3 Domain management
// ---------------------------------------------------------------------------------------------

/// Soft-deleted (step 2.1): `DELETE /domains/{id}` sets `status = deleted` and `deleted_at`; the
/// row stays as history (DKIM keys, audit linkage) until the organization purge. A deleted row
/// frees both the global name (`verified_name`) and the per-organization name (`live_name`).
model Domain {
  id              BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  publicId        String       @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  organizationId  BigInt       @map("organization_id") @db.UnsignedBigInt
  /// Lower-cased ASCII (punycode). Unique per organization among non-deleted rows only (see
  /// `liveName`): several organizations may hold a pending claim on the same name, so an
  /// unverified claim cannot squat a domain.
  name            String       @db.VarChar(253)
  status          DomainStatus @default(pending_verification)
  /// Why the domain is in its status (e.g. `claimed_by_another_organization`, a suspension reason).
  statusReason    String?      @map("status_reason") @db.VarChar(512)
  statusChangedAt DateTime?    @map("status_changed_at") @db.DateTime(3)
  inboundEnabled  Boolean      @default(true) @map("inbound_enabled")
  outboundEnabled Boolean      @default(false) @map("outbound_enabled")
  verifiedAt      DateTime?    @map("verified_at") @db.DateTime(3)
  /// First activation (`verified` → `active`).
  activatedAt     DateTime?    @map("activated_at") @db.DateTime(3)
  deletedAt       DateTime?    @map("deleted_at") @db.DateTime(3)
  /// When the background job checks the DNS records next; NULL for `failed` and `deleted`.
  nextCheckAt     DateTime?    @map("next_check_at") @db.DateTime(3)
  lastCheckedAt   DateTime?    @map("last_checked_at") @db.DateTime(3)
  /// Consecutive checks with an indeterminate result (drives the retry backoff).
  checkFailures   Int          @default(0) @map("check_failures") @db.UnsignedInt
  /// READ-ONLY, generated by MySQL: `GENERATED ALWAYS AS (IF(status IN ('verified', 'active',
  /// 'suspended'), name, NULL)) STORED`. Its unique key makes verified ownership globally unique
  /// (one owner per name, in every post-verification state; a deleted domain frees it). Tenant
  /// resolution on the mail path looks up by this column, never by `name`. Never write it.
  verifiedName    String?      @unique @map("verified_name") @db.VarChar(253)
  /// READ-ONLY, generated by MySQL: `GENERATED ALWAYS AS (IF(status = 'deleted', NULL, name))
  /// STORED`. UNIQUE (organization_id, live_name): one non-deleted row per name and organization;
  /// an organization can re-add a name it deleted. Never write it.
  liveName        String?      @map("live_name") @db.VarChar(253)
  createdAt       DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  verifications  DomainVerification[]
  dnsRecords     DomainDnsRecord[]
  dkimKeys       DomainDkimKey[]
  mxRecords      DomainMxRecord[]
  mailServers    DomainMailServer[]
  settings       DomainSetting?
  deliveryRoutes DeliveryRoute[]
  recipients     DomainRecipientAddress[]

  @@unique([organizationId, liveName])
  @@index([name])
  @@index([organizationId, status])
  @@index([nextCheckAt])
  @@map("domains")
}

model DomainVerification {
  id             BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId BigInt                   @map("organization_id") @db.UnsignedBigInt
  domainId       BigInt                   @map("domain_id") @db.UnsignedBigInt
  method         DomainVerificationMethod @default(dns_txt)
  token          String                   @db.VarChar(128)
  status         DomainVerificationStatus @default(pending)
  attempts       Int                      @default(0) @db.UnsignedInt
  nextCheckAt    DateTime?                @map("next_check_at") @db.DateTime(3)
  lastCheckedAt  DateTime?                @map("last_checked_at") @db.DateTime(3)
  lastError      String?                  @map("last_error") @db.VarChar(512)
  lastOutcome    DnsCheckOutcome?         @map("last_outcome")
  /// JSON-safe DNS evidence of the last check (upstream, outcome, answers); public data only.
  evidence       Json?
  verifiedAt     DateTime?                @map("verified_at") @db.DateTime(3)
  expiresAt      DateTime                 @map("expires_at") @db.DateTime(3)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  domain       Domain       @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([domainId, status])
  @@index([status, nextCheckAt])
  @@map("domain_verifications")
}

/// One row per record the customer publishes (step 2.1 D6), keyed by `record_key`.
model DomainDnsRecord {
  id              BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId  BigInt           @map("organization_id") @db.UnsignedBigInt
  domainId        BigInt           @map("domain_id") @db.UnsignedBigInt
  /// Stable key for idempotent upserts: `verification`, `mx:<host>`, `spf`, `dkim:<selector>`,
  /// `dmarc`.
  recordKey       String           @map("record_key") @db.VarChar(191)
  purpose         DnsRecordPurpose
  recordType      DnsRecordType    @map("record_type")
  host            String           @db.VarChar(255)
  /// The DKIM key this record publishes (`purpose = dkim` only).
  dkimKeyId       BigInt?          @map("dkim_key_id") @db.UnsignedBigInt
  expectedValue   String           @map("expected_value") @db.Text
  observedValue   String?          @map("observed_value") @db.Text
  /// Last definitive outcome; an indeterminate check never changes it.
  status          DnsRecordStatus  @default(pending)
  statusChangedAt DateTime?        @map("status_changed_at") @db.DateTime(3)
  lastOutcome     DnsCheckOutcome? @map("last_outcome")
  lastError       String?          @map("last_error") @db.VarChar(512)
  /// JSON-safe DNS evidence of the last check (≤ 8 KiB, warnings included); public data only.
  evidence        Json?
  lastCheckedAt   DateTime?        @map("last_checked_at") @db.DateTime(3)
  createdAt       DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  domain       Domain         @relation(fields: [domainId], references: [id], onDelete: Cascade)
  dkimKey      DomainDkimKey? @relation(fields: [dkimKeyId], references: [id], onDelete: SetNull)

  @@unique([domainId, recordKey])
  @@index([domainId, purpose])
  @@map("domain_dns_records")
}

model DomainDkimKey {
  id                   BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId       BigInt        @map("organization_id") @db.UnsignedBigInt
  domainId             BigInt        @map("domain_id") @db.UnsignedBigInt
  selector             String        @db.VarChar(63)
  algorithm            DkimAlgorithm
  /// Public key as published in DNS (`p=` value: base64 SPKI for RSA, raw 32 bytes for Ed25519).
  publicKey            String        @map("public_key") @db.Text
  /// ADR-0018: the PKCS#8 PEM private key encrypted with the api's SecretBox (AES-256-GCM,
  /// `DATA_ENCRYPTION_KEY`), additional authenticated data `dkim:<domain public id>:<selector>`.
  /// Set to NULL when the key is retired or revoked (crypto-shredding). Never logged or returned.
  privateKeyCiphertext String?       @map("private_key_ciphertext") @db.Text
  /// Reserved for an external key store (Secrets Manager / KMS object reference); NULL when
  /// `private_key_ciphertext` is used. Exactly one of the two is set for pending/active/rotating
  /// keys. Never the key itself.
  privateKeyRef        String?       @map("private_key_ref") @db.VarChar(512)
  status               DkimKeyStatus @default(pending)
  activatedAt          DateTime?     @map("activated_at") @db.DateTime(3)
  /// `rotating` keys stay published until this time (rotation overlap), then are retired.
  retireAfter          DateTime?     @map("retire_after") @db.DateTime(3)
  retiredAt            DateTime?     @map("retired_at") @db.DateTime(3)
  createdAt            DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  domain       Domain            @relation(fields: [domainId], references: [id], onDelete: Cascade)
  dnsRecords   DomainDnsRecord[]

  @@unique([domainId, selector])
  @@index([organizationId, status])
  @@index([status, retireAfter])
  @@map("domain_dkim_keys")
}

/// Observed MX records of a domain.
model DomainMxRecord {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId  BigInt   @map("organization_id") @db.UnsignedBigInt
  domainId        BigInt   @map("domain_id") @db.UnsignedBigInt
  priority        Int      @db.UnsignedSmallInt
  host            String   @db.VarChar(255)
  pointsToGateway Boolean  @default(false) @map("points_to_gateway")
  lastSeenAt      DateTime @map("last_seen_at") @db.DateTime(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  domain       Domain       @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([domainId, host])
  @@map("domain_mx_records")
}

model DomainMailServer {
  id             BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  /// UUIDv7, the API id of a destination server (step 2.3 R13). Rows created before step 2.3
  /// were backfilled with UUID() (v1) by the mail_routing migration.
  publicId       String                  @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  organizationId BigInt                  @map("organization_id") @db.UnsignedBigInt
  domainId       BigInt                  @map("domain_id") @db.UnsignedBigInt
  /// `inbound_destination`: the tenant's own mail server that approved inbound and internal mail
  /// is delivered to (transport and TLS policy maps, step 2.2 D11; all enabled rows form an
  /// ordered next-hop list ordered by (priority, id), step 2.3 R2). `outbound_source` is
  /// DEPRECATED (step 2.2 D10): never read by the mail path; outbound senders are
  /// organization-level `smtp_connectors`.
  role           MailServerRole
  /// Normalized ASCII host name, validated with validateDestinationHost (step 2.3 R3) on write
  /// by the api and again on every map answer by the smtp-adapter.
  host           String?                 @db.VarChar(255)
  port           Int                     @default(25) @db.UnsignedSmallInt
  /// Source network of a deprecated `outbound_source` row (never read; see `role`).
  ipCidr         String?                 @map("ip_cidr") @db.VarChar(64)
  priority       Int                     @default(10) @db.UnsignedSmallInt
  tlsMode        TlsMode                 @default(opportunistic) @map("tls_mode")
  /// Preset the row was created from (step 2.3 R2); one provider per domain (api-enforced).
  provider       MailDestinationProvider @default(custom)
  /// Postfix `match=` list for tls_mode = verify (`:`-separated); NULL = `nexthop`.
  tlsVerifyNames String?                 @map("tls_verify_names") @db.VarChar(512)
  enabled        Boolean                 @default(true)
  createdAt      DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.DateTime(3)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  domain         Domain          @relation(fields: [domainId], references: [id], onDelete: Cascade)
  deliveryRoutes DeliveryRoute[]

  @@index([domainId, role, priority])
  // The smtp-adapter's tls_policy map looks rows up by `[host]:port`.
  @@index([host, port])
  @@map("domain_mail_servers")
}

model DomainSetting {
  id                      BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId          BigInt              @map("organization_id") @db.UnsignedBigInt
  domainId                BigInt              @unique @map("domain_id") @db.UnsignedBigInt
  maxMessageSizeBytes     Int?                @map("max_message_size_bytes") @db.UnsignedInt
  rejectUnknownRecipients Boolean             @default(false) @map("reject_unknown_recipients")
  recipientValidation     RecipientValidation @default(none) @map("recipient_validation")
  settings                Json?
  createdAt               DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt               DateTime            @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  domain       Domain       @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@map("domain_settings")
}

/// Recipient allow-list entry of a domain (step 2.2 D3). Used when
/// domain_settings.recipient_validation = list (authoritative when reject_unknown_recipients,
/// monitor-only otherwise). The domain part is never stored: rows belong to the domain.
model DomainRecipientAddress {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId  BigInt   @map("organization_id") @db.UnsignedBigInt
  domainId        BigInt   @map("domain_id") @db.UnsignedBigInt
  /// Lower-cased, NFC, 1..64 octets.
  localPart       String   @map("local_part") @db.VarChar(64)
  createdByUserId BigInt?  @map("created_by_user_id") @db.UnsignedBigInt
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  domain       Domain       @relation(fields: [domainId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([domainId, localPart])
  @@index([organizationId])
  @@map("domain_recipient_addresses")
}

/// Outbound relay connector of an organization (step 2.2 D10). Exactly one auth method.
/// Disabled connectors and connectors of non-active organizations never authorize anything.
model SmtpConnector {
  id                    BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  publicId              String                @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  organizationId        BigInt                @map("organization_id") @db.UnsignedBigInt
  name                  String                @db.VarChar(128)
  authType              SmtpConnectorAuthType @map("auth_type")
  status                SmtpConnectorStatus   @default(active)
  /// sasl only; generated (`egc-` + 20 lower-case base32 characters), globally unique.
  saslUsername          String?               @unique @map("sasl_username") @db.VarChar(64)
  /// sasl only; Argon2id PHC string. Never returned or logged.
  secretHash            String?               @map("secret_hash") @db.VarChar(255)
  secretSetAt           DateTime?             @map("secret_set_at") @db.DateTime(3)
  /// client_certificate only; lower-case hex SHA-256 of the DER certificate, no colons.
  certFingerprintSha256 String?               @unique @map("cert_fingerprint_sha256") @db.Char(64)
  /// Refuse sessions without TLS (source_ip; implied for sasl and client_certificate).
  requireTls            Boolean               @default(true) @map("require_tls")
  createdByUserId       BigInt?               @map("created_by_user_id") @db.UnsignedBigInt
  createdAt             DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?                  @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  networks     SmtpConnectorNetwork[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@map("smtp_connectors")
}

/// Allowed client network of a connector. Ranges never overlap across all connectors, in any
/// organization (enforced by the api under a MySQL named lock), so an IP maps to at most one
/// connector. Lookup: WHERE ip_version = ? AND range_start <= ? ORDER BY range_start DESC
/// LIMIT 1, then check range_end >= ?.
model SmtpConnectorNetwork {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId BigInt   @map("organization_id") @db.UnsignedBigInt
  connectorId    BigInt   @map("connector_id") @db.UnsignedBigInt
  /// Canonical CIDR text (network address, prefix).
  cidr           String   @db.VarChar(49)
  /// 4 or 6.
  ipVersion      Int      @map("ip_version") @db.UnsignedTinyInt
  /// First and last address, 4 or 16 bytes big-endian, for range lookups.
  rangeStart     Bytes    @map("range_start") @db.VarBinary(16)
  rangeEnd       Bytes    @map("range_end") @db.VarBinary(16)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  connector    SmtpConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@unique([connectorId, cidr])
  @@index([ipVersion, rangeStart])
  @@map("smtp_connector_networks")
}

// ---------------------------------------------------------------------------------------------
// 3.4 Email metadata
// ---------------------------------------------------------------------------------------------

/// Identity registry (not partitioned). Allocates the message id, owns the global uniqueness of
/// `public_id` and of the ingestion key, and maps id → received_at (the partition key of every
/// row of the message).
model MessageIdentity {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  publicId       String   @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  organizationId BigInt   @map("organization_id") @db.UnsignedBigInt
  /// Ingestion idempotency key (step 2.2 D7, §12.7): `v2:` + lower-case hex SHA-256 of
  /// `{mtaId}|{queueId}|{direction}|{contentSha256}|{recipientSetSha256}` (mtaId = the LMTP
  /// client's LHLO name, queueId = the Postfix queue id from XFORWARD IDENT, direction =
  /// inbound|outbound, contentSha256 = hex SHA-256 of the EML bytes, recipientSetSha256 = hex
  /// SHA-256 of this organization's accepted recipients, lower-cased, de-duplicated, sorted,
  /// LF-joined); 67 characters. A redelivery of the same queue file to the same recipients hits
  /// the unique key and is answered as a duplicate; a retry of other recipients is stored.
  /// `v1:` keys (without the recipient set) predate the step 2.2 review fix.
  ingestKey      String   @map("ingest_key") @db.VarChar(128)
  receivedAt     DateTime @map("received_at") @db.DateTime(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, ingestKey])
  @@map("message_identities")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly. `id` is the registry id
/// (message_identities.id), not an auto-increment. No foreign keys.
model EmailMessage {
  id                BigInt           @db.UnsignedBigInt
  receivedAt        DateTime         @map("received_at") @db.DateTime(3)
  organizationId    BigInt           @map("organization_id") @db.UnsignedBigInt
  domainId          BigInt?          @map("domain_id") @db.UnsignedBigInt
  direction         MessageDirection
  /// Lifecycle state (ADR-0025). status, status_changed_at, version, lifecycle_round and
  /// status_reason are written only through @email-gateway/message-lifecycle (step 3.3 L5).
  status            MessageStatus    @default(received)
  statusChangedAt   DateTime         @map("status_changed_at") @db.DateTime(3)
  /// Optimistic concurrency: +1 per applied lifecycle transition (0 = the `received` history
  /// row, 1 = `persisted`).
  version           Int              @default(0) @db.UnsignedInt
  /// Lifecycle round: +1 on rescan/release (re-entry edges), ADR-0025.
  lifecycleRound    Int              @default(0) @map("lifecycle_round") @db.UnsignedSmallInt
  /// Reason code of the last applied transition (`/^[a-z0-9_]{1,64}$/`, e.g. delivery_partial).
  statusReason      String?          @map("status_reason") @db.VarChar(64)
  internetMessageId String?          @map("internet_message_id") @db.VarChar(998)
  envelopeFrom      String           @map("envelope_from") @db.VarChar(320)
  headerFrom        String?          @map("header_from") @db.VarChar(320)
  subject           String?          @db.VarChar(998)
  sizeBytes         Int              @map("size_bytes") @db.UnsignedInt
  recipientCount    Int              @map("recipient_count") @db.UnsignedSmallInt
  attachmentCount   Int              @default(0) @map("attachment_count") @db.UnsignedSmallInt
  /// S3 key of the raw EML (step 2.2 D8):
  /// `org/{organizationId}/eml/{yyyy}/{mm}/{dd}/{objectRef}.eml`, UTC date of the ingestion
  /// attempt, objectRef = first 32 hex characters of SHA-256 of
  /// `{mtaId}|{queueId}|{direction}|{organizationId}`. Consumers read it, never derive it.
  emlObjectKey      String           @map("eml_object_key") @db.VarChar(512)
  emlSha256         String           @map("eml_sha256") @db.Char(64)
  clientIp          String?          @map("client_ip") @db.VarChar(45)
  clientHelo        String?          @map("client_helo") @db.VarChar(255)
  /// Verified client host name from Postfix XFORWARD NAME (step 4.1 §3): Postfix's literal
  /// `unknown` is stored as `unknown`; `[UNAVAILABLE]`, `[TEMPUNAVAIL]` and a missing attribute
  /// are NULL. Trusted envelope data for the scan engines (§2.0 invariant 7).
  clientName        String?          @map("client_name") @db.VarChar(255)
  /// Postfix queue id; collation utf8mb4_bin (case-sensitive Postfix queue ids, step 3.3).
  mtaQueueId        String?          @map("mta_queue_id") @db.VarChar(32)
  finalVerdict      MessageVerdict?  @map("final_verdict")
  finalAction       MessageAction?   @map("final_action")
  /// 0–1000.
  riskScore         Int?             @map("risk_score") @db.UnsignedSmallInt
  createdAt         DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.DateTime(3)

  @@id([id, receivedAt])
  @@index([organizationId, receivedAt, id])
  @@index([status, statusChangedAt])
  @@map("email_messages")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly. No foreign keys.
model EmailRecipient {
  id             BigInt            @default(autoincrement()) @db.UnsignedBigInt
  receivedAt     DateTime          @map("received_at") @db.DateTime(3)
  messageId      BigInt            @map("message_id") @db.UnsignedBigInt
  organizationId BigInt            @map("organization_id") @db.UnsignedBigInt
  rcptSeq        Int               @map("rcpt_seq") @db.UnsignedSmallInt
  address        String            @db.VarChar(320)
  userId         BigInt?           @map("user_id") @db.UnsignedBigInt
  status         RecipientStatus   @default(pending)
  finalAction    MessageAction?    @map("final_action")
  /// Routed direction (step 2.3 R1), classified at ingestion; NULL for rows ingested before
  /// step 2.3 (classified at planning).
  direction      MessageDirection?
  createdAt      DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.DateTime(3)

  @@id([id, receivedAt])
  @@unique([messageId, rcptSeq, receivedAt])
  @@index([organizationId, address(length: 100), receivedAt])
  @@map("email_recipients")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly. Allow-list of security-relevant headers
/// only (values truncated); the full header block stays in the EML in S3. Values are stored
/// decoded and unparsed; the bec engine (step 4.4 B5) parses From, Sender, Reply-To,
/// Return-Path, In-Reply-To and References from them. No foreign keys.
model EmailHeader {
  id             BigInt   @default(autoincrement()) @db.UnsignedBigInt
  receivedAt     DateTime @map("received_at") @db.DateTime(3)
  messageId      BigInt   @map("message_id") @db.UnsignedBigInt
  organizationId BigInt   @map("organization_id") @db.UnsignedBigInt
  seq            Int      @db.UnsignedSmallInt
  name           String   @db.VarChar(128)
  value          String   @db.VarChar(2048)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@id([id, receivedAt])
  @@unique([messageId, seq, receivedAt])
  @@map("email_headers")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly. Metadata and an S3 key only, never
/// content. No foreign keys.
model EmailAttachment {
  id                  BigInt                 @default(autoincrement()) @db.UnsignedBigInt
  receivedAt          DateTime               @map("received_at") @db.DateTime(3)
  messageId           BigInt                 @map("message_id") @db.UnsignedBigInt
  organizationId      BigInt                 @map("organization_id") @db.UnsignedBigInt
  /// Index of the leaf in the parse structure (email_message_parses.structure, step 3.1 M9).
  partIndex           Int                    @map("part_index") @db.UnsignedSmallInt
  /// Unused, always NULL (step 4.2 A18: archive entries are not rows; they are findings of their
  /// attachment's attachment_scan_results row).
  parentPartIndex     Int?                   @map("parent_part_index") @db.UnsignedSmallInt
  /// Step 3.1 M9: MIME part path of the leaf (for example `1.2.1`); NULL for rows before 3.1.
  partPath            String?                @map("part_path") @db.VarChar(128)
  /// Step 3.1 M9: nesting depth of the leaf (0 = root).
  depth               Int?                   @db.UnsignedTinyInt
  /// Step 3.1 M9: `attachment` or `inline`.
  disposition         AttachmentDisposition?
  /// Sanitized display filename (step 3.1 M9 `sanitizeFilename`); NULL when empty.
  filename            String?                @db.VarChar(255)
  /// Step 3.1 M9: the decoded original filename with non-printable, bidi and zero-width code
  /// points and `\` written as `\u{XXXX}` escapes, ≤ 1024 characters. Escaped metadata only:
  /// never used as a path or an S3 key, never logged.
  originalFilename    String?                @map("original_filename") @db.VarChar(1024)
  declaredContentType String?                @map("declared_content_type") @db.VarChar(255)
  detectedContentType String?                @map("detected_content_type") @db.VarChar(255)
  /// Decoded size in bytes.
  sizeBytes           Int                    @map("size_bytes") @db.UnsignedInt
  /// Step 3.1 M9: transfer-encoded size in bytes as read from the EML.
  encodedSizeBytes    Int?                   @map("encoded_size_bytes") @db.UnsignedInt
  /// Hex SHA-256 of the decoded bytes.
  sha256              String                 @db.Char(64)
  /// `org/{organizationId}/part/{yyyy}/{mm}/{dd}/{messageId}/{partIndex}.att` (step 3.1 M11);
  /// NULL when the part was not stored (flag `not_stored_size_limit`).
  objectKey           String?                @map("object_key") @db.VarChar(512)
  /// Step 3.1 M9: JSON array of ATTACHMENT_FLAGS codes (`@email-gateway/mime-parser`), for
  /// the scanning steps (4.x). Codes only.
  flags               Json?
  /// Step 3.1 M10: archive metadata `{ type, inspected, entries, declaredUncompressedBytes,
  /// maxRatio, encryptedEntries, nestedArchives }`. Numbers and the type only, never entry
  /// names. NULL when the part is not an archive.
  archiveInfo         Json?                  @map("archive_info")
  /// Not written (step 4.2 A18: per-round results are in attachment_scan_results).
  verdict             AttachmentVerdict?
  createdAt           DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.DateTime(3)

  @@id([id, receivedAt])
  @@unique([messageId, partIndex, receivedAt])
  @@index([organizationId, sha256])
  @@map("email_attachments")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly (6 months, core). Post-queue MIME parse
/// stage of one message (step 3.1, docs/plan/steps/06-mime-ingestion.md §3, M3, M13), written
/// by email-worker only. One row per message: inserted as `parsing` (M3.4), `attempts`
/// incremented per try, finalized once by a conditional update `WHERE status = 'parsing'`
/// (M3.9.1). `email_messages.status` is not changed by step 3.1 (step 3.3 owns it). Holds S3
/// keys, hashes, sizes, codes and counts only; never body bytes, filenames or header values.
/// No foreign keys.
model EmailMessageParse {
  id                BigInt             @default(autoincrement()) @db.UnsignedBigInt
  /// Copied from the message (one message's graph lives in one partition).
  receivedAt        DateTime           @map("received_at") @db.DateTime(3)
  messageId         BigInt             @map("message_id") @db.UnsignedBigInt
  organizationId    BigInt             @map("organization_id") @db.UnsignedBigInt
  /// `parsing` until finalized (M13); transitions none → parsing → final only.
  status            MessageParseStatus
  /// Parse attempts started (M3.4). An infrastructure error gives its attempt back; a crash
  /// does not, so `attempts > MIME_MAX_ATTEMPTS` is the poison-message guard.
  attempts          Int                @default(0) @db.UnsignedSmallInt
  /// `PARSER_VERSION` of `@email-gateway/mime-parser` that produced the row.
  parserVersion     String             @map("parser_version") @db.VarChar(32)
  /// Envelope id of the `mail.message.received.v1` event that started the parse.
  eventId           String?            @map("event_id") @db.Char(36)
  /// `parse_failed` reason (PARSE_FAILURE_REASONS of `@email-gateway/event-contracts`).
  failureReason     String?            @map("failure_reason") @db.VarChar(64)
  /// JSON array of MIME_LIMIT_NAMES that were exceeded.
  limitsExceeded    Json?              @map("limits_exceeded")
  /// JSON array of defect codes (M6, M7); codes only.
  defects           Json?
  partCount         Int?               @map("part_count") @db.UnsignedSmallInt
  attachmentCount   Int?               @map("attachment_count") @db.UnsignedSmallInt
  maxDepth          Int?               @map("max_depth") @db.UnsignedTinyInt
  /// Every field of the top-level header block (not only the stored ones).
  headerCount       Int?               @map("header_count") @db.UnsignedInt
  /// EML bytes read (must equal email_messages.size_bytes, M3.8).
  bytesRead         BigInt?            @map("bytes_read") @db.UnsignedBigInt
  /// Sum of transfer-decoded part bytes.
  decodedBytes      BigInt?            @map("decoded_bytes") @db.UnsignedBigInt
  /// `org/{organizationId}/part/{yyyy}/{mm}/{dd}/{messageId}/{partIndex}.text` (M11); NULL
  /// when there is no text body or it was not stored.
  textBodyObjectKey String?            @map("text_body_object_key") @db.VarChar(512)
  /// `…/{partIndex}.html` (M11); NULL when there is no HTML body or it was not stored.
  htmlBodyObjectKey String?            @map("html_body_object_key") @db.VarChar(512)
  /// Hex SHA-256 of the stored (decoded, UTF-8) body bytes.
  textBodySha256    String?            @map("text_body_sha256") @db.Char(64)
  htmlBodySha256    String?            @map("html_body_sha256") @db.Char(64)
  textBodySizeBytes Int?               @map("text_body_size_bytes") @db.UnsignedInt
  htmlBodySizeBytes Int?               @map("html_body_size_bytes") @db.UnsignedInt
  /// Declared charset of the body part (normalized).
  textBodyCharset   String?            @map("text_body_charset") @db.VarChar(64)
  htmlBodyCharset   String?            @map("html_body_charset") @db.VarChar(64)
  /// M13: one object per MIME node in document order (≤ MIME_MAX_PARTS); never filenames or
  /// header values.
  structure         Json?
  /// Start of the last attempt.
  startedAt         DateTime           @map("started_at") @db.DateTime(3)
  completedAt       DateTime?          @map("completed_at") @db.DateTime(3)
  durationMs        Int?               @map("duration_ms") @db.UnsignedInt
  createdAt         DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.DateTime(3)

  @@id([id, receivedAt])
  @@unique([messageId, receivedAt])
  @@index([organizationId, receivedAt, id])
  @@index([status, updatedAt])
  @@map("email_message_parses")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly. Append-only; idempotency comes from
/// processOnce. Long-term history lives in ClickHouse. No foreign keys.
model EmailEvent {
  id             BigInt    @default(autoincrement()) @db.UnsignedBigInt
  receivedAt     DateTime  @map("received_at") @db.DateTime(3)
  messageId      BigInt    @map("message_id") @db.UnsignedBigInt
  organizationId BigInt    @map("organization_id") @db.UnsignedBigInt
  eventType      String    @map("event_type") @db.VarChar(64)
  occurredAt     DateTime  @map("occurred_at") @db.DateTime(3)
  sourceService  String    @map("source_service") @db.VarChar(64)
  /// Originating envelope event id.
  eventId        String?   @map("event_id") @db.Char(36)
  actorType      ActorType @default(system) @map("actor_type")
  actorId        String?   @map("actor_id") @db.VarChar(64)
  details        Json?
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  @@id([id, receivedAt])
  @@index([messageId, receivedAt])
  @@map("email_events")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly. Append-only; one row per applied
/// lifecycle transition, written only through @email-gateway/message-lifecycle (step 3.3 L5).
/// Rows from before step 3.3 have actor_role/actor_service `legacy`. No foreign keys.
model EmailMessageStatusHistory {
  id             BigInt         @default(autoincrement()) @db.UnsignedBigInt
  receivedAt     DateTime       @map("received_at") @db.DateTime(3)
  messageId      BigInt         @map("message_id") @db.UnsignedBigInt
  organizationId BigInt         @map("organization_id") @db.UnsignedBigInt
  /// Message version after the transition.
  version        Int            @db.UnsignedInt
  fromStatus     MessageStatus? @map("from_status")
  toStatus       MessageStatus  @map("to_status")
  reasonCode     String?        @map("reason_code") @db.VarChar(64)
  /// Causing event id (envelope event id of the event that caused the transition).
  eventId        String?        @map("event_id") @db.Char(36)
  changedAt      DateTime       @map("changed_at") @db.DateTime(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  /// Lifecycle round after the transition.
  lifecycleRound Int            @default(0) @map("lifecycle_round") @db.UnsignedSmallInt
  /// ACTOR_ROLES value (ingestion, scanner, policy, …); `legacy` for pre-step-3.3 rows.
  actorRole      String         @default("legacy") @map("actor_role") @db.VarChar(32)
  /// Deployable that applied the transition (smtp-adapter, delivery-worker, api, event-relay).
  actorService   String         @default("legacy") @map("actor_service") @db.VarChar(64)
  actorType      ActorType      @default(system) @map("actor_type")
  /// Public id of the user or API key (operator actions); NULL for system actors.
  actorId        String?        @map("actor_id") @db.VarChar(64)
  correlationId  String?        @map("correlation_id") @db.VarChar(128)
  /// Hex SHA-256 of the transition key (idempotency, step 3.3 L5.3); NULL for legacy rows.
  transitionKey  String?        @map("transition_key") @db.Char(64)
  /// Event id of the mail.message.state_changed.v1 outbox row; NULL for creation and legacy rows.
  stateEventId   String?        @map("state_event_id") @db.Char(36)
  /// Producer-reported occurrence time (recorded, never compared).
  occurredAt     DateTime?      @map("occurred_at") @db.DateTime(3)

  @@id([id, receivedAt])
  @@unique([messageId, version, receivedAt])
  @@unique([messageId, transitionKey, receivedAt])
  @@map("email_message_status_history")
}

// ---------------------------------------------------------------------------------------------
// 3.5 Security
// ---------------------------------------------------------------------------------------------

/// PARTITIONED by RANGE COLUMNS(received_at), monthly. No foreign keys.
/// One row per scan round `(message_id, lifecycle_round, received_at)` (step 4.1 S3); old rounds'
/// rows are never updated or deleted by a newer round.
model EmailScan {
  id              BigInt          @default(autoincrement()) @db.UnsignedBigInt
  receivedAt      DateTime        @map("received_at") @db.DateTime(3)
  messageId       BigInt          @map("message_id") @db.UnsignedBigInt
  organizationId  BigInt          @map("organization_id") @db.UnsignedBigInt
  scanKind        ScanKind        @default(initial) @map("scan_kind")
  /// Unused since step 4.1 (always 1): a round is identified by `lifecycle_round`; engine attempts
  /// are rows of scan_engine_results.
  attempt         Int             @default(1) @db.UnsignedSmallInt
  status          ScanStatus      @default(pending)
  /// Risk scoring (step 5.1); not written by the scan stage.
  verdict         MessageVerdict?
  riskScore       Int?            @map("risk_score") @db.UnsignedSmallInt
  scoringVersion  String?         @map("scoring_version") @db.VarChar(32)
  startedAt       DateTime?       @map("started_at") @db.DateTime(3)
  completedAt     DateTime?       @map("completed_at") @db.DateTime(3)
  createdAt       DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  /// email_messages.lifecycle_round of the round this row scans (step 4.1 S3).
  lifecycleRound  Int             @default(0) @map("lifecycle_round") @db.UnsignedSmallInt
  /// Aggregate verdict of the round (S6); NULL while running.
  scanVerdict     ScanVerdict?    @map("scan_verdict")
  /// JSON array of engine names required when the round opened (snapshot, S4).
  requiredEngines Json?           @map("required_engines")
  /// JSON array of reason codes (≤ 32), set at completion (S6).
  reasonCodes     Json?           @map("reason_codes")
  /// Event id of the event that opened the round (parsed.v1 or rescan_requested.v1).
  triggerEventId  String?         @map("trigger_event_id") @db.Char(36)
  /// The deadline sweeper finalizes a round still running after this instant (S10).
  deadlineAt      DateTime?       @map("deadline_at") @db.DateTime(3)

  @@id([id, receivedAt])
  @@unique([messageId, lifecycleRound, receivedAt])
  @@index([status, deadlineAt])
  @@map("email_scans")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly. `evidence` holds variable engine
/// evidence. No foreign keys.
model ScanEngineResult {
  id              BigInt        @default(autoincrement()) @db.UnsignedBigInt
  receivedAt      DateTime      @map("received_at") @db.DateTime(3)
  scanId          BigInt        @map("scan_id") @db.UnsignedBigInt
  messageId       BigInt        @map("message_id") @db.UnsignedBigInt
  organizationId  BigInt        @map("organization_id") @db.UnsignedBigInt
  /// ENGINE_NAMES of @email-gateway/security-contracts: rspamd, attachment, url, bec, dlp,
  /// sandbox (step 4.2 A1: ClamAV and YARA are components of the `attachment` engine; step 4.3
  /// U1: `url` is written by the URL engine on scan.url; step 4.4 B1: `bec` is written by the
  /// phishing/BEC engine on scan.bec, a stage-2 engine that runs after `rspamd` and `url`).
  engine          String        @db.VarChar(32)
  engineVersion   String?       @map("engine_version") @db.VarChar(64)
  outcome         EngineOutcome
  score           Decimal?      @db.Decimal(8, 3)
  durationMs      Int           @map("duration_ms") @db.UnsignedInt
  /// `{ signals[], auth?, rcptTruncated? }` (step 4.1 S9): scores, symbol names and bounded
  /// symbol options; never message content.
  evidence        Json?
  completedAt     DateTime      @map("completed_at") @db.DateTime(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  /// 1-based attempt of this engine in the round (step 4.1 S5).
  attempt         Int           @default(1) @db.UnsignedSmallInt
  /// True for the one final result per (scan, engine); false for a failed attempt that was
  /// retried (outcome `timeout` or `error` only).
  isFinal         Boolean       @default(true) @map("is_final")
  /// READ-ONLY, generated by MySQL: `GENERATED ALWAYS AS (IF(is_final = 1, engine, NULL))
  /// VIRTUAL`. Its unique key (scan_id, final_engine, received_at) allows at most one final row
  /// per engine and round (NULLs are distinct). Never write it.
  finalEngine     String?       @map("final_engine") @db.VarChar(32)
  requiredScore   Decimal?      @map("required_score") @db.Decimal(8, 3)
  /// Engine action (Rspamd: `no action`, `reject`, ...), informational.
  action          String?       @db.VarChar(32)
  /// JSON array of reason codes (≤ 32).
  reasonCodes     Json?         @map("reason_codes")
  /// Failure code of a timeout/error row (e.g. `eml_unavailable`, `deadline_exceeded`).
  errorCode       String?       @map("error_code") @db.VarChar(64)
  /// `<mapping version>;p=<platform hash>;t=<row version | none>` (S8).
  settingsVersion String?       @map("settings_version") @db.VarChar(96)

  @@id([id, receivedAt])
  @@unique([scanId, engine, attempt, receivedAt])
  @@unique([scanId, finalEngine, receivedAt])
  @@map("scan_engine_results")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly (step 4.1 §3). Authentication results of a
/// scan round as reported by an engine (Rspamd: SPF, DKIM, DMARC, ARC). No foreign keys.
model EmailAuthResult {
  id             BigInt       @default(autoincrement()) @db.UnsignedBigInt
  receivedAt     DateTime     @map("received_at") @db.DateTime(3)
  messageId      BigInt       @map("message_id") @db.UnsignedBigInt
  organizationId BigInt       @map("organization_id") @db.UnsignedBigInt
  scanId         BigInt       @map("scan_id") @db.UnsignedBigInt
  engine         String       @db.VarChar(32)
  spf            AuthOutcome?
  spfDomain      String?      @map("spf_domain") @db.VarChar(253)
  dkim           AuthOutcome?
  /// JSON array (≤ 10) of `{ domain, result, selector }`.
  dkimSignatures Json?        @map("dkim_signatures")
  dmarc          AuthOutcome?
  dmarcPolicy    DmarcPolicy? @map("dmarc_policy")
  dmarcDomain    String?      @map("dmarc_domain") @db.VarChar(253)
  arc            AuthOutcome?
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)

  @@id([id, receivedAt])
  @@unique([scanId, engine, receivedAt])
  @@map("email_auth_results")
}

/// Per-tenant overrides of a scan engine's platform settings (step 4.1 S8). `settings` is
/// validated by the engine's tenant schema of @email-gateway/security-contracts on write and
/// again at use. `version` is the compare-and-set counter of the settings API.
model ScanEngineSetting {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId  BigInt   @map("organization_id") @db.UnsignedBigInt
  engine          String   @db.VarChar(32)
  settings        Json
  version         Int      @default(1) @db.UnsignedInt
  updatedByUserId BigInt?  @map("updated_by_user_id") @db.UnsignedBigInt
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  updatedBy    User?        @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, engine])
  @@map("scan_engine_settings")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly (6 months, core; step 4.2 §3, A18). One row
/// per attachment per scan round with a definite final result of the `attachment` engine,
/// written only in that final row's finalize transaction (unique per (scan, attachment)). Hashes,
/// sizes, type ids, signature and rule names, counts and codes only: never file content, never a
/// filename, never an archive entry name (entries are index paths). No foreign keys.
model AttachmentScanResult {
  id                  BigInt                @default(autoincrement()) @db.UnsignedBigInt
  receivedAt          DateTime              @map("received_at") @db.DateTime(3)
  messageId           BigInt                @map("message_id") @db.UnsignedBigInt
  organizationId      BigInt                @map("organization_id") @db.UnsignedBigInt
  /// email_scans.id of the round.
  scanId              BigInt                @map("scan_id") @db.UnsignedBigInt
  /// email_attachments.id of the scanned attachment.
  attachmentId        BigInt                @map("attachment_id") @db.UnsignedBigInt
  partIndex           Int                   @map("part_index") @db.UnsignedSmallInt
  /// Hex SHA-256 of the decoded attachment bytes.
  sha256              String                @db.Char(64)
  sizeBytes           Int                   @map("size_bytes") @db.UnsignedInt
  /// FILE_TYPES id of the detected type (A5).
  detectedType        String                @map("detected_type") @db.VarChar(32)
  /// FILE_TYPES family of the detected type (A5).
  typeFamily          String                @map("type_family") @db.VarChar(16)
  typeMismatch        Boolean               @map("type_mismatch")
  verdict             AttachmentScanVerdict
  /// JSON array (≤ 32) of ATTACHMENT_REASON_CODES.
  reasonCodes         Json                  @map("reason_codes")
  /// ClamAV signature name when ClamAV reported FOUND; NULL when clean or not scanned.
  clamavSignature     String?               @map("clamav_signature") @db.VarChar(128)
  clamavEngineVersion String?               @map("clamav_engine_version") @db.VarChar(32)
  clamavDbVersion     Int?                  @map("clamav_db_version") @db.UnsignedInt
  yaraBundleId        String?               @map("yara_bundle_id") @db.VarChar(48)
  /// JSON array (≤ 32) of `{ rule, severity, scope }`; rule names only, never matched strings.
  yaraMatches         Json?                 @map("yara_matches")
  /// `{ format, supported, entries, depthReached, decompressedBytes, maxRatio, encrypted,
  /// findings[≤ 20] { path, type, reasonCodes } }` (A16); index paths, never entry names.
  archive             Json?
  /// Most severe malware_signatures hit of the attachment or an archive entry.
  knownHashSeverity   Severity?             @map("known_hash_severity")
  cacheResult         AttachmentCacheResult @map("cache_result")
  /// Content version of the cache key (A9); NULL when the content was not scanned.
  contentVersion      String?               @map("content_version") @db.Char(16)
  durationMs          Int                   @map("duration_ms") @db.UnsignedInt
  createdAt           DateTime              @default(now()) @map("created_at") @db.DateTime(3)

  @@id([id, receivedAt])
  @@unique([scanId, attachmentId, receivedAt])
  @@index([organizationId, sha256])
  @@index([messageId, receivedAt])
  @@map("attachment_scan_results")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly (6 months, core; step 4.2 §3, A11). One row
/// per attachment of a round submitted to the sandbox, written in the attachment engine's
/// finalize transaction together with the `mail.attachment.sandbox_requested.v1` outbox row. The
/// part is referenced by its S3 key only. `external_ref`, `sandbox_verdict` and `completed_at`
/// are reserved for the sandbox orchestrator (step 4.6). No foreign keys.
model SandboxSubmission {
  id                BigInt                   @default(autoincrement()) @db.UnsignedBigInt
  receivedAt        DateTime                 @map("received_at") @db.DateTime(3)
  messageId         BigInt                   @map("message_id") @db.UnsignedBigInt
  organizationId    BigInt                   @map("organization_id") @db.UnsignedBigInt
  scanId            BigInt                   @map("scan_id") @db.UnsignedBigInt
  attachmentId      BigInt                   @map("attachment_id") @db.UnsignedBigInt
  partIndex         Int                      @map("part_index") @db.UnsignedSmallInt
  sha256            String                   @db.Char(64)
  sizeBytes         Int                      @map("size_bytes") @db.UnsignedInt
  detectedType      String                   @map("detected_type") @db.VarChar(32)
  /// `org/{organizationId}/part/…` (email_attachments.object_key of the attachment).
  objectKey         String                   @map("object_key") @db.VarChar(512)
  attachmentVerdict SandboxAttachmentVerdict @map("attachment_verdict")
  /// JSON array (≤ 16) of ATTACHMENT_REASON_CODES.
  reasonCodes       Json                     @map("reason_codes")
  status            SandboxSubmissionStatus  @default(pending)
  /// Envelope event id of the sandbox_requested.v1 outbox row.
  requestedEventId  String                   @map("requested_event_id") @db.Char(36)
  /// Reserved for step 4.6: the sandbox's own reference.
  externalRef       String?                  @map("external_ref") @db.VarChar(128)
  /// Reserved for step 4.6: the sandbox verdict.
  sandboxVerdict    String?                  @map("sandbox_verdict") @db.VarChar(16)
  /// Reserved for step 4.6.
  completedAt       DateTime?                @map("completed_at") @db.DateTime(3)
  createdAt         DateTime                 @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.DateTime(3)

  @@id([id, receivedAt])
  @@unique([scanId, attachmentId, receivedAt])
  @@index([status, createdAt])
  @@index([sha256])
  @@map("sandbox_submissions")
}

/// Bulk attachment rescan jobs (step 4.2 A13): written by the api (`admin`) or the signature
/// watcher (`signature_update`), executed by the email-worker's rescan runner through lifecycle
/// edge E19 (role scanner, reason signature_rescan). `organization_id` NULL = every organization.
/// `dedupe_key` (`sig:<component>:<version>`) makes the fleet create one job per signature change.
model AttachmentRescanJob {
  id                BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  publicId          String                  @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  trigger           AttachmentRescanTrigger
  status            AttachmentRescanStatus  @default(pending)
  dedupeKey         String?                 @unique @map("dedupe_key") @db.VarChar(128)
  organizationId    BigInt?                 @map("organization_id") @db.UnsignedBigInt
  windowStart       DateTime                @map("window_start") @db.DateTime(3)
  windowEnd         DateTime                @map("window_end") @db.DateTime(3)
  /// JSON array of message states the job selects (A13).
  states            Json
  /// Signature component of a `signature_update` job (`clamav_db`, `clamav_engine`, `yara_bundle`).
  component         String?                 @db.VarChar(32)
  fromVersion       String?                 @map("from_version") @db.VarChar(128)
  toVersion         String?                 @map("to_version") @db.VarChar(128)
  maxMessages       Int                     @map("max_messages") @db.UnsignedInt
  /// Keyset cursor `(received_at, message id)` of the last processed candidate.
  cursorReceivedAt  DateTime?               @map("cursor_received_at") @db.DateTime(3)
  cursorMessageId   BigInt?                 @map("cursor_message_id") @db.UnsignedBigInt
  selectedCount     Int                     @default(0) @map("selected_count") @db.UnsignedInt
  requestedCount    Int                     @default(0) @map("requested_count") @db.UnsignedInt
  skippedCount      Int                     @default(0) @map("skipped_count") @db.UnsignedInt
  requestedByUserId BigInt?                 @map("requested_by_user_id") @db.UnsignedBigInt
  reason            String?                 @db.VarChar(512)
  /// Error code or bounded message of a failed job; never content.
  lastError         String?                 @map("last_error") @db.VarChar(512)
  startedAt         DateTime?               @map("started_at") @db.DateTime(3)
  completedAt       DateTime?               @map("completed_at") @db.DateTime(3)
  createdAt         DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime                @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  requestedBy  User?         @relation(fields: [requestedByUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("attachment_rescan_jobs")
}

/// Versions of a scan engine's signature components seen by the signature watcher (step 4.2
/// A13): engine `attachment`, component `clamav_db`, `clamav_engine` or `yara_bundle`. Platform
/// catalog (no tenant data).
model ScanSignatureVersion {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  engine      String   @db.VarChar(32)
  component   String   @db.VarChar(32)
  version     String   @db.VarChar(128)
  firstSeenAt DateTime @map("first_seen_at") @db.DateTime(3)
  lastSeenAt  DateTime @map("last_seen_at") @db.DateTime(3)

  @@unique([engine, component, version])
  @@index([engine, component, firstSeenAt])
  @@map("scan_signature_versions")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly (6 months, core; step 4.3 §3, U3, U16).
/// One row per unique URL of a message (identity form, U5), written by the `url` engine in the
/// finalize transaction of a definite final result (`createMany … skipDuplicates`; a rescan keeps
/// the `url_seq` of a URL already stored). `url` is the redirect form (no userinfo, with the
/// fragment) and the only copy of the URL the click-service redirects to; never anchor text, page
/// content or HTML. No foreign keys.
model MessageUrl {
  id                  BigInt      @default(autoincrement()) @db.UnsignedBigInt
  receivedAt          DateTime    @map("received_at") @db.DateTime(3)
  messageId           BigInt      @map("message_id") @db.UnsignedBigInt
  organizationId      BigInt      @map("organization_id") @db.UnsignedBigInt
  /// Per-message sequence (0-based, stable across rounds); part of the click token (U12).
  urlSeq              Int         @map("url_seq") @db.UnsignedSmallInt
  /// Redirect form (U5); the first 2 048 characters when `truncated`.
  url                 String      @db.VarChar(2048)
  /// Hex SHA-256 of the identity form (no userinfo, no fragment) of the full URL.
  urlSha256           String      @map("url_sha256") @db.Char(64)
  /// `http` or `https`.
  scheme              String      @db.VarChar(8)
  /// ASCII host (A-labels; canonical IPv4/IPv6 text for IP hosts).
  host                String      @db.VarChar(253)
  /// U-label form of an IDN host; NULL when it equals `host`.
  unicodeHost         String?     @map("unicode_host") @db.VarChar(253)
  /// Registrable domain (tldts, private suffixes included); NULL for IP hosts.
  registrableDomain   String?     @map("registrable_domain") @db.VarChar(253)
  hostKind            UrlHostKind @map("host_kind")
  /// Non-default port; NULL for the scheme's default port.
  port                Int?        @db.UnsignedSmallInt
  /// True when the normalized URL was longer than 2 048 characters (never rewritten or fetched).
  truncated           Boolean     @default(false)
  /// JSON array of extraction reason codes (URL_REASON_CODES), e.g. `url.userinfo`.
  flags               Json?
  /// `{ <source>: count }` (sources of U18: text, html_href, html_src, form_action,
  /// meta_refresh, srcset, attachment).
  sources             Json
  occurrences         Int         @db.UnsignedSmallInt
  /// Lifecycle round of the scan that first stored the URL.
  firstLifecycleRound Int         @map("first_lifecycle_round") @db.UnsignedSmallInt
  /// `url-extract/<n>`.
  extractorVersion    String      @map("extractor_version") @db.VarChar(16)
  createdAt           DateTime    @default(now()) @map("created_at") @db.DateTime(3)

  @@id([id, receivedAt])
  @@unique([messageId, urlSeq, receivedAt])
  @@unique([messageId, urlSha256, receivedAt])
  @@index([organizationId, urlSha256])
  @@index([organizationId, registrableDomain(length: 100)])
  @@map("message_urls")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly (6 months, core; step 4.3 §3, U10, U16).
/// One row per URL per scan round with a definite final result of the `url` engine, written in
/// that final row's finalize transaction. Codes, provider answers, hosts and counts only: never
/// page bodies, titles or HTML. No foreign keys.
model UrlScanResult {
  id               BigInt         @default(autoincrement()) @db.UnsignedBigInt
  receivedAt       DateTime       @map("received_at") @db.DateTime(3)
  messageId        BigInt         @map("message_id") @db.UnsignedBigInt
  organizationId   BigInt         @map("organization_id") @db.UnsignedBigInt
  /// email_scans.id of the round.
  scanId           BigInt         @map("scan_id") @db.UnsignedBigInt
  /// message_urls.url_seq of the URL.
  urlSeq           Int            @map("url_seq") @db.UnsignedSmallInt
  urlSha256        String         @map("url_sha256") @db.Char(64)
  verdict          UrlVerdict
  /// JSON array (≤ 32) of URL_REASON_CODES.
  reasonCodes      Json           @map("reason_codes")
  /// JSON array (≤ 12) of `{ provider, version, kind, status, category, severity, cache }`;
  /// `cache` is never returned to tenants (U16).
  reputation       Json
  /// JSON array (≤ 5) of `{ rule, targetKind, targetDomain, score, distance }` (U7).
  lookalike        Json?
  fetchStatus      UrlFetchStatus @map("fetch_status")
  /// Fetcher error token (U8) when `fetch_status` is `error`.
  fetchError       String?        @map("fetch_error") @db.VarChar(32)
  hopCount         Int            @default(0) @map("hop_count") @db.UnsignedTinyInt
  /// JSON array (≤ 10) of `{ host, port, status, kind, blocked }`; hosts only, no paths.
  redirectChain    Json?          @map("redirect_chain")
  /// Final URL of the redirect chain (redirect form, ≤ 2 048 characters).
  finalUrl         String?        @map("final_url") @db.VarChar(2048)
  finalUrlSha256   String?        @map("final_url_sha256") @db.Char(64)
  finalHost        String?        @map("final_host") @db.VarChar(253)
  finalStatus      Int?           @map("final_status") @db.UnsignedSmallInt
  /// `{ passwordFields, forms, crossOriginFormAction, formActionHosts, titleBrandMatches }`
  /// (U9); counts, booleans, hosts and brand ids only.
  landing          Json?
  rewritten        Boolean
  dynamicRequested Boolean        @map("dynamic_requested")
  /// Chain cache result of the fetch (never returned to tenants).
  fetchCache       UrlFetchCache  @map("fetch_cache")
  durationMs       Int            @map("duration_ms") @db.UnsignedInt
  createdAt        DateTime       @default(now()) @map("created_at") @db.DateTime(3)

  @@id([id, receivedAt])
  @@unique([scanId, urlSeq, receivedAt])
  @@index([messageId, receivedAt])
  @@index([organizationId, urlSha256])
  @@map("url_scan_results")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly (6 months, core; step 4.3 §3, U11). One
/// row per scan round of the `url` engine: the rewritten copy of the EML (`org/<org>/rewrite/…`,
/// S3 reference only) or why the round was not rewritten (REWRITE_SKIP_REASONS). The original
/// EML is never modified. No foreign keys.
model UrlRewrite {
  id              BigInt           @default(autoincrement()) @db.UnsignedBigInt
  receivedAt      DateTime         @map("received_at") @db.DateTime(3)
  messageId       BigInt           @map("message_id") @db.UnsignedBigInt
  organizationId  BigInt           @map("organization_id") @db.UnsignedBigInt
  scanId          BigInt           @map("scan_id") @db.UnsignedBigInt
  lifecycleRound  Int              @map("lifecycle_round") @db.UnsignedSmallInt
  status          UrlRewriteStatus
  /// REWRITE_SKIP_REASONS when `status = skipped`.
  skipReason      String?          @map("skip_reason") @db.VarChar(32)
  /// `org/{organizationId}/rewrite/yyyy/mm/dd/{messageId}/r{round}-{uuid}.eml` when rewritten.
  objectKey       String?          @map("object_key") @db.VarChar(512)
  objectSha256    String?          @map("object_sha256") @db.Char(64)
  objectSizeBytes Int?             @map("object_size_bytes") @db.UnsignedInt
  linksRewritten  Int              @default(0) @map("links_rewritten") @db.UnsignedSmallInt
  linksUnmapped   Int              @default(0) @map("links_unmapped") @db.UnsignedSmallInt
  partsRewritten  Int              @default(0) @map("parts_rewritten") @db.UnsignedTinyInt
  partsSkipped    Int              @default(0) @map("parts_skipped") @db.UnsignedTinyInt
  /// True when the message carried a DKIM-Signature header (the rewrite breaks it downstream).
  dkimSigned      Boolean          @default(false) @map("dkim_signed")
  /// Key id of the click tokens (U12).
  tokenKid        Int?             @map("token_kid") @db.UnsignedTinyInt
  /// Expiry of the click tokens of this copy.
  expiresAt       DateTime?        @map("expires_at") @db.DateTime(3)
  settingsVersion String           @map("settings_version") @db.VarChar(96)
  createdAt       DateTime         @default(now()) @map("created_at") @db.DateTime(3)

  @@id([id, receivedAt])
  @@unique([scanId, receivedAt])
  @@index([messageId, lifecycleRound, receivedAt])
  @@map("url_rewrites")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly (6 months, core; step 4.3 §3, U15). One
/// row per URL of a round sent to the isolated browser worker, written in the `url` engine's
/// finalize transaction together with the `mail.url.inspection_requested.v1` outbox row; updated
/// from `pending` by the results consumer (or `expired` by the sweeper). Signals are counts,
/// booleans, hosts and brand ids only. No foreign keys.
model UrlDynamicInspection {
  id               BigInt              @default(autoincrement()) @db.UnsignedBigInt
  receivedAt       DateTime            @map("received_at") @db.DateTime(3)
  messageId        BigInt              @map("message_id") @db.UnsignedBigInt
  organizationId   BigInt              @map("organization_id") @db.UnsignedBigInt
  scanId           BigInt              @map("scan_id") @db.UnsignedBigInt
  urlSeq           Int                 @map("url_seq") @db.UnsignedSmallInt
  urlSha256        String              @map("url_sha256") @db.Char(64)
  status           UrlInspectionStatus @default(pending)
  /// Envelope event id of the inspection_requested.v1 outbox row.
  requestedEventId String              @map("requested_event_id") @db.Char(36)
  verdict          UrlVerdict?
  /// JSON array (≤ 16) of URL_REASON_CODES.
  reasonCodes      Json?               @map("reason_codes")
  /// The `signals` object of mail.url.inspection_completed.v1 plus the navigation hosts.
  signals          Json?
  finalUrlSha256   String?             @map("final_url_sha256") @db.Char(64)
  finalHost        String?             @map("final_host") @db.VarChar(253)
  workerVersion    String?             @map("worker_version") @db.VarChar(64)
  errorCode        String?             @map("error_code") @db.VarChar(32)
  completedAt      DateTime?           @map("completed_at") @db.DateTime(3)
  createdAt        DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.DateTime(3)

  @@id([id, receivedAt])
  @@unique([scanId, urlSeq, receivedAt])
  @@index([status, createdAt])
  @@index([organizationId, urlSha256])
  @@map("url_dynamic_inspections")
}

/// PARTITIONED by RANGE COLUMNS(clicked_at), monthly (6 months, core; step 4.3 §3, U14). One row
/// per decided click of a rewritten link, written by the click-service (account gateway_click)
/// together with the `mail.url.clicked.v1` outbox row. No URL, no user agent, no user identity;
/// the client address only as a truncated network. No foreign keys.
model UrlClickEvent {
  id                BigInt           @default(autoincrement()) @db.UnsignedBigInt
  clickedAt         DateTime         @map("clicked_at") @db.DateTime(3)
  /// UUIDv7; the `clickId` of the event and the reference id shown on pages.
  publicId          String           @map("public_id") @db.Char(36)
  organizationId    BigInt           @map("organization_id") @db.UnsignedBigInt
  messageId         BigInt           @map("message_id") @db.UnsignedBigInt
  /// received_at of the message (partition key of message_urls).
  messageReceivedAt DateTime         @map("message_received_at") @db.DateTime(3)
  urlSeq            Int              @map("url_seq") @db.UnsignedSmallInt
  decision          UrlClickDecision
  verdict           UrlVerdict?
  /// JSON array (≤ 16) of URL_REASON_CODES.
  reasonCodes       Json?            @map("reason_codes")
  /// `{ reputation, chain, dynamic }` (U14).
  recheck           Json?
  tokenKid          Int              @map("token_kid") @db.UnsignedTinyInt
  /// `/24` IPv4 or `/48` IPv6 network of the client (CLICK_STORE_CLIENT_NETWORK); else NULL.
  clientNetwork     String?          @map("client_network") @db.VarChar(49)
  durationMs        Int              @map("duration_ms") @db.UnsignedInt
  createdAt         DateTime         @default(now()) @map("created_at") @db.DateTime(3)

  @@id([id, clickedAt])
  @@index([organizationId, clickedAt])
  @@index([messageId, messageReceivedAt])
  @@index([publicId])
  @@map("url_click_events")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly (6 months, core; step 4.4 §3, B14). One row
/// per scan round with a definite final result of the `bec` engine, written in that final row's
/// finalize transaction (unique per scan). Codes, weights, scores, versions, input states, span
/// offsets and the parsed sender identity (the tenant's own header metadata, already in
/// `email_headers`) only: never body text, span text, excerpts or LLM output text. No foreign keys.
model BecScanResult {
  id                   BigInt     @default(autoincrement()) @db.UnsignedBigInt
  receivedAt           DateTime   @map("received_at") @db.DateTime(3)
  messageId            BigInt     @map("message_id") @db.UnsignedBigInt
  organizationId       BigInt     @map("organization_id") @db.UnsignedBigInt
  /// email_scans.id of the round.
  scanId               BigInt     @map("scan_id") @db.UnsignedBigInt
  lifecycleRound       Int        @map("lifecycle_round") @db.UnsignedSmallInt
  /// `bec/1;lex=<8 hex>;fm=<8 hex>;br=<8 hex>` (B16).
  engineVersion        String     @map("engine_version") @db.VarChar(64)
  /// `bec-map/1` (B6).
  rulesVersion         String     @map("rules_version") @db.VarChar(16)
  /// `bec-map/1;p=<12 hex>;t=<row version | none>` (B13).
  settingsVersion      String     @map("settings_version") @db.VarChar(96)
  lexiconVersion       String     @map("lexicon_version") @db.VarChar(16)
  /// `bec-text/1` (B8).
  textVersion          String     @map("text_version") @db.VarChar(16)
  /// 0–100, before the AI layer (B9).
  deterministicScore   Int        @map("deterministic_score") @db.UnsignedTinyInt
  /// 0–100, after the AI layer (equal to deterministic_score unless B9 rule 2 or 4 applied).
  score                Int        @db.UnsignedTinyInt
  deterministicVerdict BecVerdict @map("deterministic_verdict")
  verdict              BecVerdict
  /// `{ auth, url, text, history }` input states (B2).
  inputs               Json
  /// JSON array (≤ 32) of `{ id, code, category, severity, weight, suppressed, evidence }` (B14).
  rules                Json
  /// The AI feature vector (AI_FEATURE_NAMES → number | boolean), for the retraining export.
  features             Json?
  /// Parsed From / Reply-To / Sender / envelope summary (addresses ≤ 320, display name ≤ 128).
  identity             Json?
  /// Applied AI assessments (≤ 2): labels, confidence, indicators, cited features, span offsets,
  /// model ids/versions, response hash; never text.
  ai                   Json?
  /// Shadow AI assessments (≤ 3), never applied (B9 P5).
  aiShadow             Json?      @map("ai_shadow")
  durationMs           Int        @map("duration_ms") @db.UnsignedInt
  createdAt            DateTime   @default(now()) @map("created_at") @db.DateTime(3)

  @@id([id, receivedAt])
  @@unique([scanId, receivedAt])
  @@index([messageId, receivedAt])
  @@index([organizationId, receivedAt])
  @@map("bec_scan_results")
}

/// A tenant's executive profile for impersonation detection (step 4.4 B5, B6 X1–X3, B18).
/// `normalized_name` is the B5 normalization of `display_name` (unique per tenant). Deleted
/// explicitly by organization deletion (no cascade).
model BecExecutiveProfile {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  /// UUIDv7; the only id the API exposes.
  publicId        String   @unique @map("public_id") @db.Char(36)
  organizationId  BigInt   @map("organization_id") @db.UnsignedBigInt
  displayName     String   @map("display_name") @db.VarChar(128)
  normalizedName  String   @map("normalized_name") @db.VarChar(160)
  /// JSON array (≤ 10) of alias display names.
  aliases         Json
  /// JSON array (≤ 20) of normalized e-mail addresses the executive really uses.
  knownAddresses  Json     @map("known_addresses")
  title           String?  @db.VarChar(128)
  enabled         Boolean  @default(true)
  /// Compare-and-set counter of the API.
  version         Int      @default(1) @db.UnsignedInt
  createdByUserId BigInt?  @map("created_by_user_id") @db.UnsignedBigInt
  updatedByUserId BigInt?  @map("updated_by_user_id") @db.UnsignedBigInt
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("BecExecutiveCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy    User?        @relation("BecExecutiveUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, normalizedName])
  @@index([organizationId, enabled])
  @@map("bec_executive_profiles")
}

/// A tenant's vendor profile for vendor impersonation and payment-change detection (step 4.4 B5,
/// B6 V1–V4, L2, B18). Deleted explicitly by organization deletion (no cascade).
model BecVendorProfile {
  id                     BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  /// UUIDv7; the only id the API exposes.
  publicId               String   @unique @map("public_id") @db.Char(36)
  organizationId         BigInt   @map("organization_id") @db.UnsignedBigInt
  name                   String   @db.VarChar(128)
  normalizedName         String   @map("normalized_name") @db.VarChar(160)
  /// JSON array (≤ 10) of alias names.
  aliases                Json
  /// JSON array (1–20) of ASCII registrable domains (never a public suffix or a free-mail domain).
  domains                Json
  /// JSON array (≤ 50) of normalized e-mail addresses.
  knownSenders           Json     @map("known_senders")
  paymentChangeSensitive Boolean  @default(true) @map("payment_change_sensitive")
  enabled                Boolean  @default(true)
  version                Int      @default(1) @db.UnsignedInt
  createdByUserId        BigInt?  @map("created_by_user_id") @db.UnsignedBigInt
  updatedByUserId        BigInt?  @map("updated_by_user_id") @db.UnsignedBigInt
  createdAt              DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("BecVendorCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy    User?        @relation("BecVendorUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, normalizedName])
  @@map("bec_vendor_profiles")
}

/// A tenant's trusted sender (step 4.4 B7): an exact lower-case address or a registrable domain.
/// Trust applies only when the message authenticates as From. Deleted explicitly by
/// organization deletion (no cascade).
model BecTrustedSender {
  id              BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  /// UUIDv7; the only id the API exposes.
  publicId        String               @unique @map("public_id") @db.Char(36)
  organizationId  BigInt               @map("organization_id") @db.UnsignedBigInt
  kind            BecTrustedSenderKind
  /// Normalized lower-case address or ASCII registrable domain.
  value           String               @db.VarChar(320)
  reason          String               @db.VarChar(512)
  /// At most 365 days ahead (validated by the api); NULL = no expiry.
  expiresAt       DateTime?            @map("expires_at") @db.DateTime(3)
  version         Int                  @default(1) @db.UnsignedInt
  createdByUserId BigInt?              @map("created_by_user_id") @db.UnsignedBigInt
  createdAt       DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("BecTrustedSenderCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, kind, value])
  @@index([organizationId, expiresAt])
  @@map("bec_trusted_senders")
}

/// An analyst's false-positive / false-negative feedback on a `bec` result (step 4.4 B11).
/// Retention 24 months (training data; docs/database/retention.md). `message_id`, `scan_id` and
/// `bec_result_id` reference partitioned tables, so they carry no foreign keys. `note` is analyst
/// input (≤ 500 characters, never exported); never message content.
model BecFeedback {
  id                BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  /// UUIDv7; the only id the API exposes.
  publicId          String          @unique @map("public_id") @db.Char(36)
  organizationId    BigInt          @map("organization_id") @db.UnsignedBigInt
  messageId         BigInt          @map("message_id") @db.UnsignedBigInt
  /// received_at of the message (partition key of bec_scan_results).
  messageReceivedAt DateTime        @map("message_received_at") @db.DateTime(3)
  /// email_scans.id of the round.
  scanId            BigInt          @map("scan_id") @db.UnsignedBigInt
  /// bec_scan_results.id of the result.
  becResultId       BigInt          @map("bec_result_id") @db.UnsignedBigInt
  kind              BecFeedbackKind
  /// JSON array of disputed BEC_REASON_CODES (false positives: a subset of the result's codes).
  reasonCodes       Json?           @map("reason_codes")
  note              String?         @db.VarChar(500)
  createdByUserId   BigInt?         @map("created_by_user_id") @db.UnsignedBigInt
  createdAt         DateTime        @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("BecFeedbackCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([scanId, createdByUserId, kind])
  @@index([organizationId, createdAt])
  @@map("bec_feedback")
}

/// A bounded, expiring suppression of one suppressible BEC reason code for one sender, created
/// only from a false-positive feedback (step 4.4 B11). `feedback_id` is the bec_feedback.id it
/// came from (no foreign key: feedback is swept after 24 months, suppressions expire within 90
/// days). Deleted explicitly by organization deletion (no cascade).
model BecSuppressionRule {
  id              BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  /// UUIDv7; the only id the API exposes.
  publicId        String              @unique @map("public_id") @db.Char(36)
  organizationId  BigInt              @map("organization_id") @db.UnsignedBigInt
  /// One of BEC_SUPPRESSIBLE_CODES.
  reasonCode      String              @map("reason_code") @db.VarChar(64)
  senderScope     BecSuppressionScope @map("sender_scope")
  /// The From address or registrable domain of the scanned message (never a free-mail domain).
  senderValue     String              @map("sender_value") @db.VarChar(320)
  feedbackId      BigInt?             @map("feedback_id") @db.UnsignedBigInt
  /// At most 90 days after creation (no permanent suppression).
  expiresAt       DateTime            @map("expires_at") @db.DateTime(3)
  createdByUserId BigInt?             @map("created_by_user_id") @db.UnsignedBigInt
  createdAt       DateTime            @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("BecSuppressionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, reasonCode, senderScope, senderValue])
  @@index([organizationId, expiresAt])
  @@map("bec_suppression_rules")
}

/// Opt-in historical communication context (step 4.4 B12, ADR-0035): aggregate counts per keyed
/// hash. `key_hash` = HMAC-SHA256(BEC_CONTEXT_HMAC_KEY, "eg-bec-ctx/v1\0" ‖ organization ‖ scope ‖
/// canonical key), hex; no plaintext address, domain, IP or name. Retention per tenant
/// (`history.retentionDays`) by the email-worker sweeper; purge through the api. Deleted
/// explicitly by organization deletion (no cascade).
model BecContactHistory {
  id             BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId BigInt          @map("organization_id") @db.UnsignedBigInt
  scope          BecContactScope
  keyHash        String          @map("key_hash") @db.Char(64)
  /// Saturating at 2^32 − 1.
  messageCount   Int             @map("message_count") @db.UnsignedInt
  inboundCount   Int             @default(0) @map("inbound_count") @db.UnsignedInt
  outboundCount  Int             @default(0) @map("outbound_count") @db.UnsignedInt
  /// Sender scope only: ≤ 8 `{ fp, count, lastSeenAt }` (fp = first 16 hex of an HMAC).
  infra          Json?
  /// Message received_at of the first and last message counted.
  firstSeenAt    DateTime        @map("first_seen_at") @db.DateTime(3)
  lastSeenAt     DateTime        @map("last_seen_at") @db.DateTime(3)
  createdAt      DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, scope, keyHash])
  @@index([organizationId, lastSeenAt])
  @@map("bec_contact_history")
}

/// `organization_id` NULL = platform-wide intelligence. Step 4.3 (U6, U16) writes platform rows
/// only (`organization_id` NULL, `source = 'analyst'`, through the api's threat-indicator routes)
/// and the URL engine and the click-service read them on every scan and click (never cached).
/// `value` is normalized by `@email-gateway/url-security`: a `url` in its identity form (no
/// userinfo, no fragment), a `domain` as the ASCII registrable domain or host (never a public
/// suffix), an `ip` in canonical text form; `value_sha256` is the hex SHA-256 of that value.
model ThreatIndicator {
  id             BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId BigInt?         @map("organization_id") @db.UnsignedBigInt
  indicatorType  IndicatorType   @map("indicator_type")
  value          String          @db.VarChar(2048)
  valueSha256    String          @map("value_sha256") @db.Char(64)
  /// `feed:<name>`, `org:<id>` or `analyst`. Uniqueness is per tenant scope (`orgScope`), so the
  /// same source string in two organizations never collides.
  source         String          @db.VarChar(64)
  severity       Severity
  /// 0–100.
  confidence     Int             @db.UnsignedTinyInt
  firstSeenAt    DateTime        @map("first_seen_at") @db.DateTime(3)
  lastSeenAt     DateTime        @map("last_seen_at") @db.DateTime(3)
  expiresAt      DateTime?       @map("expires_at") @db.DateTime(3)
  metadata       Json?
  /// READ-ONLY, generated by MySQL: `GENERATED ALWAYS AS (IFNULL(organization_id, 0)) VIRTUAL`.
  /// 0 is the platform scope. It puts the tenant in the unique key below; a plain
  /// organization_id would not dedupe platform rows (MySQL treats NULLs as distinct). Never write it.
  orgScope       BigInt?         @map("org_scope") @db.UnsignedBigInt
  createdAt      DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  /// The analyst who added the indicator (NULL for feeds, or after the user is deleted).
  addedByUserId  BigInt?         @map("added_by_user_id") @db.UnsignedBigInt
  /// Why the indicator was added (analyst input; never message content).
  reason         String?         @db.VarChar(512)
  /// THREAT_CATEGORIES of @email-gateway/security-contracts; NULL for rows without a category.
  category       ThreatCategory?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  addedBy      User?         @relation(fields: [addedByUserId], references: [id], onDelete: SetNull)

  @@unique([orgScope, source, indicatorType, valueSha256])
  @@index([indicatorType, valueSha256])
  @@index([organizationId, indicatorType])
  @@index([source, createdAt])
  @@map("threat_indicators")
}

/// Platform catalog. Unused: reputation answers are cached in Redis (step 4.3 U6); reserved
/// for feed ingestion.
model IpReputation {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  ipAddress  String    @unique @map("ip_address") @db.VarChar(45)
  /// −100..100.
  score      Int       @db.SmallInt
  categories Json?
  source     String    @db.VarChar(64)
  lastSeenAt DateTime  @map("last_seen_at") @db.DateTime(3)
  expiresAt  DateTime? @map("expires_at") @db.DateTime(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([expiresAt])
  @@map("ip_reputation")
}

/// Platform catalog. Unused: reputation answers are cached in Redis (step 4.3 U6); reserved
/// for feed ingestion.
model DomainReputation {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  domain       String    @unique @db.VarChar(253)
  score        Int       @db.SmallInt
  categories   Json?
  registeredAt DateTime? @map("registered_at") @db.DateTime(3)
  source       String    @db.VarChar(64)
  lastSeenAt   DateTime  @map("last_seen_at") @db.DateTime(3)
  expiresAt    DateTime? @map("expires_at") @db.DateTime(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([expiresAt])
  @@map("domain_reputation")
}

/// Platform catalog. Unused: reputation answers are cached in Redis (step 4.3 U6); reserved
/// for feed ingestion.
model UrlReputation {
  id            BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  urlSha256     String     @unique @map("url_sha256") @db.Char(64)
  url           String     @db.VarChar(2048)
  host          String     @db.VarChar(253)
  verdict       UrlVerdict @default(unknown)
  score         Int        @db.SmallInt
  categories    Json?
  source        String     @db.VarChar(64)
  lastCheckedAt DateTime   @map("last_checked_at") @db.DateTime(3)
  expiresAt     DateTime?  @map("expires_at") @db.DateTime(3)
  createdAt     DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([host])
  @@index([expiresAt])
  @@map("url_reputation")
}

/// Platform catalog of known-threat file hashes (step 4.2 A17), platform-wide by design (never
/// tenant-scoped). Written by the api's threat-hash routes (`source = 'analyst'`); `feed:<name>`
/// (future feeds) and `sandbox` (step 4.6) are the other sources. Read by the attachment engine
/// on every scan (never cached). Delete is a hard delete (the audit log keeps the before-image).
model MalwareSignature {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  sha256        String    @unique @db.Char(64)
  md5           String?   @db.Char(32)
  family        String?   @db.VarChar(128)
  severity      Severity
  /// `analyst`, `feed:<name>` or `sandbox`.
  source        String    @db.VarChar(64)
  firstSeenAt   DateTime  @map("first_seen_at") @db.DateTime(3)
  lastSeenAt    DateTime  @map("last_seen_at") @db.DateTime(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  /// The analyst who added the hash (NULL for feeds and the sandbox, or after the user is deleted).
  addedByUserId BigInt?   @map("added_by_user_id") @db.UnsignedBigInt
  /// Why the hash was added (analyst input; no file content).
  reason        String?   @db.VarChar(512)
  /// The lookup ignores the row after this instant; NULL = no expiry.
  expiresAt     DateTime? @map("expires_at") @db.DateTime(3)

  addedBy User? @relation(fields: [addedByUserId], references: [id], onDelete: SetNull)

  @@index([source, createdAt])
  @@map("malware_signatures")
}

/// `organization_id` NULL = platform rule. `content` is rule source (configuration, not mail).
model YaraRule {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId  BigInt?  @map("organization_id") @db.UnsignedBigInt
  /// `platform/<name>` or `org-<id>/<name>`.
  ruleKey         String   @unique @map("rule_key") @db.VarChar(191)
  name            String   @db.VarChar(128)
  version         Int      @default(1) @db.UnsignedInt
  content         String   @db.MediumText
  contentSha256   String   @map("content_sha256") @db.Char(64)
  severity        Severity
  enabled         Boolean  @default(true)
  updatedByUserId BigInt?  @map("updated_by_user_id") @db.UnsignedBigInt
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  updatedBy    User?         @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, enabled])
  @@map("yara_rules")
}

// ---------------------------------------------------------------------------------------------
// 3.6 Policy
// ---------------------------------------------------------------------------------------------

/// `active_version_id` has no FK (it would form a cycle with policy_versions); the service
/// validates it.
model EmailPolicy {
  id              BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  publicId        String          @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  organizationId  BigInt          @map("organization_id") @db.UnsignedBigInt
  name            String          @db.VarChar(128)
  description     String?         @db.VarChar(512)
  direction       PolicyDirection
  priority        Int
  status          PolicyStatus    @default(draft)
  activeVersionId BigInt?         @map("active_version_id") @db.UnsignedBigInt
  createdByUserId BigInt?         @map("created_by_user_id") @db.UnsignedBigInt
  deletedAt       DateTime?       @map("deleted_at") @db.DateTime(3)
  createdAt       DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  versions   PolicyVersion[]
  exceptions PolicyException[]

  @@unique([organizationId, name])
  @@index([organizationId, status, direction, priority])
  @@map("email_policies")
}

/// `definition` is the compiled snapshot of the version.
model PolicyVersion {
  id                BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId    BigInt              @map("organization_id") @db.UnsignedBigInt
  policyId          BigInt              @map("policy_id") @db.UnsignedBigInt
  version           Int                 @db.UnsignedInt
  status            PolicyVersionStatus @default(draft)
  definition        Json
  definitionSha256  String              @map("definition_sha256") @db.Char(64)
  changeNote        String?             @map("change_note") @db.VarChar(512)
  publishedAt       DateTime?           @map("published_at") @db.DateTime(3)
  publishedByUserId BigInt?             @map("published_by_user_id") @db.UnsignedBigInt
  createdAt         DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  policy       EmailPolicy  @relation(fields: [policyId], references: [id], onDelete: Cascade)
  publishedBy  User?        @relation(fields: [publishedByUserId], references: [id], onDelete: SetNull)

  conditions PolicyCondition[]
  actions    PolicyAction[]

  @@unique([policyId, version])
  @@index([organizationId, status])
  @@map("policy_versions")
}

/// OR-groups (`group_seq`) of AND-ed conditions.
model PolicyCondition {
  id              BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId  BigInt         @map("organization_id") @db.UnsignedBigInt
  policyVersionId BigInt         @map("policy_version_id") @db.UnsignedBigInt
  seq             Int            @db.UnsignedSmallInt
  groupSeq        Int            @default(0) @map("group_seq") @db.UnsignedSmallInt
  field           String         @db.VarChar(64)
  operator        PolicyOperator
  value           Json
  negate          Boolean        @default(false)
  createdAt       DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.DateTime(3)

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  policyVersion PolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Cascade)

  @@unique([policyVersionId, seq])
  @@map("policy_conditions")
}

model PolicyAction {
  id              BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId  BigInt           @map("organization_id") @db.UnsignedBigInt
  policyVersionId BigInt           @map("policy_version_id") @db.UnsignedBigInt
  seq             Int              @db.UnsignedSmallInt
  action          PolicyActionType
  params          Json?
  createdAt       DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.DateTime(3)

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  policyVersion PolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Cascade)

  @@unique([policyVersionId, seq])
  @@map("policy_actions")
}

/// `policy_id` NULL = organization-wide exception.
model PolicyException {
  id              BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId  BigInt              @map("organization_id") @db.UnsignedBigInt
  policyId        BigInt?             @map("policy_id") @db.UnsignedBigInt
  exceptionType   PolicyExceptionType @map("exception_type")
  matchValue      String              @map("match_value") @db.VarChar(320)
  recipientScope  String?             @map("recipient_scope") @db.VarChar(320)
  reason          String?             @db.VarChar(512)
  expiresAt       DateTime?           @map("expires_at") @db.DateTime(3)
  createdByUserId BigInt?             @map("created_by_user_id") @db.UnsignedBigInt
  createdAt       DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  policy       EmailPolicy? @relation(fields: [policyId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, exceptionType, matchValue(length: 100)])
  @@map("policy_exceptions")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly. `trace` explains the evaluation. No
/// foreign keys.
model PolicyExecutionLog {
  id                      BigInt        @default(autoincrement()) @db.UnsignedBigInt
  receivedAt              DateTime      @map("received_at") @db.DateTime(3)
  messageId               BigInt        @map("message_id") @db.UnsignedBigInt
  organizationId          BigInt        @map("organization_id") @db.UnsignedBigInt
  evaluationSeq           Int           @map("evaluation_seq") @db.UnsignedSmallInt
  decisivePolicyVersionId BigInt?       @map("decisive_policy_version_id") @db.UnsignedBigInt
  action                  MessageAction
  /// Array of policy version ids (decimal strings).
  matchedPolicyVersionIds Json          @map("matched_policy_version_ids")
  trace                   Json?
  durationUs              Int           @map("duration_us") @db.UnsignedInt
  evaluatedAt             DateTime      @map("evaluated_at") @db.DateTime(3)
  createdAt               DateTime      @default(now()) @map("created_at") @db.DateTime(3)

  @@id([id, receivedAt])
  @@unique([messageId, evaluationSeq, receivedAt])
  @@map("policy_execution_logs")
}

// ---------------------------------------------------------------------------------------------
// 3.7 Delivery
// ---------------------------------------------------------------------------------------------

model DeliveryRoute {
  id             BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId BigInt         @map("organization_id") @db.UnsignedBigInt
  domainId       BigInt?        @map("domain_id") @db.UnsignedBigInt
  direction      RouteDirection
  matchType      RouteMatchType @map("match_type")
  matchValue     String?        @map("match_value") @db.VarChar(320)
  mailServerId   BigInt?        @map("mail_server_id") @db.UnsignedBigInt
  smartHost      String?        @map("smart_host") @db.VarChar(255)
  port           Int?           @db.UnsignedSmallInt
  tlsMode        TlsMode        @default(opportunistic) @map("tls_mode")
  priority       Int
  enabled        Boolean        @default(true)
  createdAt      DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  domain       Domain?           @relation(fields: [domainId], references: [id], onDelete: Cascade)
  mailServer   DomainMailServer? @relation(fields: [mailServerId], references: [id], onDelete: SetNull)

  @@index([organizationId, direction, enabled, priority])
  @@map("delivery_routes")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly. One row per recipient and delivery
/// (step 2.3 R7, R9): `delivery_seq` 0 = initial delivery, then releases or redirects. Status
/// changes only through the shared recorder (@email-gateway/mail-routing). No foreign keys.
model EmailDelivery {
  id                BigInt            @default(autoincrement()) @db.UnsignedBigInt
  receivedAt        DateTime          @map("received_at") @db.DateTime(3)
  messageId         BigInt            @map("message_id") @db.UnsignedBigInt
  recipientId       BigInt            @map("recipient_id") @db.UnsignedBigInt
  organizationId    BigInt            @map("organization_id") @db.UnsignedBigInt
  deliverySeq       Int               @default(0) @map("delivery_seq") @db.UnsignedSmallInt
  routeId           BigInt?           @map("route_id") @db.UnsignedBigInt
  status            DeliveryStatus    @default(pending)
  attemptCount      Int               @default(0) @map("attempt_count") @db.UnsignedSmallInt
  lastAttemptAt     DateTime?         @map("last_attempt_at") @db.DateTime(3)
  deliveredAt       DateTime?         @map("delivered_at") @db.DateTime(3)
  remoteHost        String?           @map("remote_host") @db.VarChar(255)
  finalSmtpCode     Int?              @map("final_smtp_code") @db.UnsignedSmallInt
  finalSmtpResponse String?           @map("final_smtp_response") @db.VarChar(512)
  /// Queue id of postfix-outbound for this recipient's reinjection; matched against the
  /// delivery log and DSN copies (step 2.3 R9).
  /// Collation utf8mb4_bin (case-sensitive Postfix queue ids, step 3.3).
  outboundQueueId   String?           @map("outbound_queue_id") @db.VarChar(32)
  /// delivery_reinjections.id of the group that carries this recipient (same received_at).
  reinjectionId     BigInt?           @map("reinjection_id") @db.UnsignedBigInt
  /// Routed direction of this recipient (step 2.3 R1).
  direction         MessageDirection?
  /// `tenant:<domainId>` | `mx:<recipient domain>`.
  destinationKey    String?           @map("destination_key") @db.VarChar(300)
  statusChangedAt   DateTime?         @map("status_changed_at") @db.DateTime(3)
  /// Time of the newest applied signal (out-of-order handling, step 2.3 R9.1).
  lastSignalAt      DateTime?         @map("last_signal_at") @db.DateTime(3)
  enhancedStatus    String?           @map("enhanced_status") @db.VarChar(16)
  /// Error class of the last failure or deferral (step 2.3 R9.2).
  lastErrorClass    String?           @map("last_error_class") @db.VarChar(32)
  /// Gateway-side reason: direction_changed, recipient_domain_inactive, loop_detected,
  /// reinjection_refused, reinjection_expired, content_missing, status_signal_missing, suppressed.
  failureReason     String?           @map("failure_reason") @db.VarChar(64)
  /// Queue id of the DSN Postfix generated to the original sender (step 2.3 R9). Collation
  /// utf8mb4_bin (case-sensitive Postfix queue ids, step 3.3).
  dsnQueueId        String?           @map("dsn_queue_id") @db.VarChar(32)
  createdAt         DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.DateTime(3)

  @@id([id, receivedAt])
  @@unique([recipientId, deliverySeq, receivedAt])
  @@index([messageId, receivedAt])
  @@index([status, lastAttemptAt])
  @@index([outboundQueueId])
  @@index([organizationId, receivedAt, id])
  /// The recipients of one reinjection: token matching, queue-id binding, reconciler scans.
  @@index([reinjectionId, receivedAt])
  @@map("email_deliveries")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly (6 months, core). One SMTP transaction into
/// postfix-outbound for a group of recipients of one message (step 2.3 R7, R8). No foreign keys.
model DeliveryReinjection {
  id                 BigInt              @default(autoincrement()) @db.UnsignedBigInt
  receivedAt         DateTime            @map("received_at") @db.DateTime(3)
  /// UUIDv7; the token `dw1-<32 hex>` (XFORWARD IDENT, ENVID) is derived from it.
  publicId           String              @default(uuid(7)) @map("public_id") @db.Char(36)
  messageId          BigInt              @map("message_id") @db.UnsignedBigInt
  organizationId     BigInt              @map("organization_id") @db.UnsignedBigInt
  deliverySeq        Int                 @default(0) @map("delivery_seq") @db.UnsignedSmallInt
  listener           ReinjectionListener
  direction          MessageDirection
  /// `tenant:<domainId>` | `mx:<recipient domain>`.
  destinationKey     String              @map("destination_key") @db.VarChar(300)
  /// S3 key of the EML to deliver (from the approval; `org/{organizationId}/…`).
  emlObjectKey       String              @map("eml_object_key") @db.VarChar(512)
  recipientCount     Int                 @map("recipient_count") @db.UnsignedSmallInt
  /// Hex SHA-256 of the group's addresses, lower-cased, de-duplicated, sorted, LF-joined.
  recipientSetSha256 String              @map("recipient_set_sha256") @db.Char(64)
  /// Hex SHA-256(`v1|{messageId}|{deliverySeq}|{listener}|{recipientSetSha256}`) (step 2.3 R7).
  idempotencyKey     String              @map("idempotency_key") @db.Char(64)
  /// Envelope event id of the approval that planned this group.
  approvalEventId    String              @map("approval_event_id") @db.Char(36)
  status             ReinjectionStatus   @default(pending)
  attempts           Int                 @default(0) @db.UnsignedSmallInt
  nextAttemptAt      DateTime            @map("next_attempt_at") @db.DateTime(3)
  leaseExpiresAt     DateTime?           @map("lease_expires_at") @db.DateTime(3)
  startedAt          DateTime?           @map("started_at") @db.DateTime(3)
  queuedAt           DateTime?           @map("queued_at") @db.DateTime(3)
  /// postfix-outbound queue id (from the `250 … queued as` reply or the log binding). Collation
  /// utf8mb4_bin (case-sensitive Postfix queue ids, step 3.3).
  queueId            String?             @map("queue_id") @db.VarChar(32)
  lastErrorClass     String?             @map("last_error_class") @db.VarChar(32)
  /// Last error text (reply or reason), ≤ 512 characters; never message content.
  lastError          String?             @map("last_error") @db.VarChar(512)
  createdAt          DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.DateTime(3)

  @@id([id, receivedAt])
  @@unique([messageId, idempotencyKey, receivedAt])
  @@index([status, nextAttemptAt])
  @@index([queueId])
  @@index([publicId])
  @@map("delivery_reinjections")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly (3 months, detail). Append-only delivery
/// audit: every status signal, applied or not (step 2.3 R9.1). Services never update or delete
/// it. No foreign keys.
model DeliveryStatusEvent {
  id             BigInt               @default(autoincrement()) @db.UnsignedBigInt
  receivedAt     DateTime             @map("received_at") @db.DateTime(3)
  deliveryId     BigInt               @map("delivery_id") @db.UnsignedBigInt
  messageId      BigInt               @map("message_id") @db.UnsignedBigInt
  recipientId    BigInt               @map("recipient_id") @db.UnsignedBigInt
  organizationId BigInt               @map("organization_id") @db.UnsignedBigInt
  source         DeliverySignalSource
  /// Hex SHA-256 of the source-specific signal key (step 2.3 R9.1 "Signal keys").
  signalKey      String               @map("signal_key") @db.Char(64)
  occurredAt     DateTime             @map("occurred_at") @db.DateTime(3)
  fromStatus     DeliveryStatus?      @map("from_status")
  toStatus       DeliveryStatus       @map("to_status")
  /// False for stale or conflicting signals (kept for the audit trail).
  applied        Boolean
  /// Collation utf8mb4_bin (case-sensitive Postfix queue ids, step 3.3).
  queueId        String?              @map("queue_id") @db.VarChar(32)
  smtpCode       Int?                 @map("smtp_code") @db.UnsignedSmallInt
  enhancedStatus String?              @map("enhanced_status") @db.VarChar(16)
  remoteHost     String?              @map("remote_host") @db.VarChar(255)
  errorClass     String?              @map("error_class") @db.VarChar(32)
  /// Remote reply or reason text, ≤ 1024 characters; never message content.
  detail         String?              @db.VarChar(1024)
  createdAt      DateTime             @default(now()) @map("created_at") @db.DateTime(3)

  @@id([id, receivedAt])
  @@unique([deliveryId, signalKey, receivedAt])
  @@index([messageId, receivedAt])
  @@map("delivery_status_events")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly. Append-only. No foreign keys.
model DeliveryAttempt {
  id             BigInt                 @default(autoincrement()) @db.UnsignedBigInt
  receivedAt     DateTime               @map("received_at") @db.DateTime(3)
  deliveryId     BigInt                 @map("delivery_id") @db.UnsignedBigInt
  messageId      BigInt                 @map("message_id") @db.UnsignedBigInt
  organizationId BigInt                 @map("organization_id") @db.UnsignedBigInt
  attemptNo      Int                    @map("attempt_no") @db.UnsignedSmallInt
  startedAt      DateTime               @map("started_at") @db.DateTime(3)
  completedAt    DateTime?              @map("completed_at") @db.DateTime(3)
  remoteHost     String?                @map("remote_host") @db.VarChar(255)
  remoteIp       String?                @map("remote_ip") @db.VarChar(45)
  smtpCode       Int?                   @map("smtp_code") @db.UnsignedSmallInt
  enhancedStatus String?                @map("enhanced_status") @db.VarChar(16)
  smtpResponse   String?                @map("smtp_response") @db.VarChar(512)
  outcome        DeliveryAttemptOutcome
  tlsProtocol    String?                @map("tls_protocol") @db.VarChar(16)
  createdAt      DateTime               @default(now()) @map("created_at") @db.DateTime(3)

  @@id([id, receivedAt])
  @@unique([deliveryId, attemptNo, receivedAt])
  @@map("delivery_attempts")
}

model DeliverySuppression {
  id              BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId  BigInt            @map("organization_id") @db.UnsignedBigInt
  address         String            @db.VarChar(320)
  reason          SuppressionReason
  source          String?           @db.VarChar(64)
  expiresAt       DateTime?         @map("expires_at") @db.DateTime(3)
  createdByUserId BigInt?           @map("created_by_user_id") @db.UnsignedBigInt
  createdAt       DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, address])
  @@index([expiresAt])
  @@map("delivery_suppressions")
}

/// PARTITIONED by RANGE COLUMNS(occurred_at), monthly. `occurred_at` is the parsed DSN arrival
/// date (deterministic), so the dedupe unique key works on redelivery. No foreign keys.
model BounceEvent {
  id                BigInt     @default(autoincrement()) @db.UnsignedBigInt
  occurredAt        DateTime   @map("occurred_at") @db.DateTime(3)
  organizationId    BigInt     @map("organization_id") @db.UnsignedBigInt
  /// Set when the notice matches a reinjection, step 2.3 (with message_received_at).
  messageId         BigInt?    @map("message_id") @db.UnsignedBigInt
  messageReceivedAt DateTime?  @map("message_received_at") @db.DateTime(3)
  recipientAddress  String     @map("recipient_address") @db.VarChar(320)
  bounceType        BounceType @map("bounce_type")
  smtpCode          Int?       @map("smtp_code") @db.UnsignedSmallInt
  enhancedStatus    String?    @map("enhanced_status") @db.VarChar(16)
  diagnostic        String?    @db.VarChar(1024)
  reportingMta      String?    @map("reporting_mta") @db.VarChar(255)
  dsnObjectKey      String?    @map("dsn_object_key") @db.VarChar(512)
  dedupeKey         String     @map("dedupe_key") @db.Char(64)
  createdAt         DateTime   @default(now()) @map("created_at") @db.DateTime(3)

  @@id([id, occurredAt])
  @@unique([organizationId, dedupeKey, occurredAt])
  @@index([organizationId, recipientAddress(length: 100), occurredAt])
  @@map("bounce_events")
}

// ---------------------------------------------------------------------------------------------
// 3.8 Quarantine (not partitioned)
// ---------------------------------------------------------------------------------------------

/// One row per quarantined recipient. `message_id`, `recipient_id` and `policy_version_id`
/// have no FK (the message tables are partitioned); `message_received_at` makes lookups prune.
model QuarantineMessage {
  id                BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  publicId          String           @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  organizationId    BigInt           @map("organization_id") @db.UnsignedBigInt
  messageId         BigInt           @map("message_id") @db.UnsignedBigInt
  messageReceivedAt DateTime         @map("message_received_at") @db.DateTime(3)
  recipientId       BigInt           @map("recipient_id") @db.UnsignedBigInt
  recipientAddress  String           @map("recipient_address") @db.VarChar(320)
  userId            BigInt?          @map("user_id") @db.UnsignedBigInt
  reason            QuarantineReason
  policyVersionId   BigInt?          @map("policy_version_id") @db.UnsignedBigInt
  status            QuarantineStatus @default(quarantined)
  envelopeFrom      String           @map("envelope_from") @db.VarChar(320)
  /// Copied for list views.
  subject           String?          @db.VarChar(998)
  riskScore         Int?             @map("risk_score") @db.UnsignedSmallInt
  emlObjectKey      String           @map("eml_object_key") @db.VarChar(512)
  quarantinedAt     DateTime         @map("quarantined_at") @db.DateTime(3)
  expiresAt         DateTime         @map("expires_at") @db.DateTime(3)
  releasedAt        DateTime?        @map("released_at") @db.DateTime(3)
  createdAt         DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  actions     QuarantineAction[]
  releaseLogs QuarantineReleaseLog[]

  @@unique([messageId, recipientId])
  @@index([organizationId, status, quarantinedAt])
  @@index([organizationId, recipientAddress(length: 100), status])
  @@index([status, expiresAt])
  @@map("quarantine_messages")
}

/// Append-only.
model QuarantineAction {
  id                  BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId      BigInt               @map("organization_id") @db.UnsignedBigInt
  quarantineMessageId BigInt               @map("quarantine_message_id") @db.UnsignedBigInt
  action              QuarantineActionType
  actorType           ActorType            @map("actor_type")
  actorUserId         BigInt?              @map("actor_user_id") @db.UnsignedBigInt
  reason              String?              @db.VarChar(512)
  idempotencyKey      String?              @map("idempotency_key") @db.VarChar(64)
  createdAt           DateTime             @default(now()) @map("created_at") @db.DateTime(3)

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  quarantineMessage QuarantineMessage @relation(fields: [quarantineMessageId], references: [id], onDelete: Cascade)
  actorUser         User?             @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  releaseLog QuarantineReleaseLog?

  @@unique([organizationId, idempotencyKey])
  @@index([quarantineMessageId, createdAt])
  @@map("quarantine_actions")
}

/// `revalidation_scan_id` and `delivery_id` have no FK (partitioned targets).
model QuarantineReleaseLog {
  id                  BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId      BigInt                  @map("organization_id") @db.UnsignedBigInt
  quarantineMessageId BigInt                  @map("quarantine_message_id") @db.UnsignedBigInt
  actionId            BigInt                  @unique @map("action_id") @db.UnsignedBigInt
  releasedTo          String                  @map("released_to") @db.VarChar(320)
  revalidationScanId  BigInt?                 @map("revalidation_scan_id") @db.UnsignedBigInt
  revalidationVerdict MessageVerdict?         @map("revalidation_verdict")
  deliveryId          BigInt?                 @map("delivery_id") @db.UnsignedBigInt
  status              QuarantineReleaseStatus @default(pending)
  completedAt         DateTime?               @map("completed_at") @db.DateTime(3)
  createdAt           DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime                @updatedAt @map("updated_at") @db.DateTime(3)

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  quarantineMessage QuarantineMessage @relation(fields: [quarantineMessageId], references: [id], onDelete: Cascade)
  action            QuarantineAction  @relation(fields: [actionId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@map("quarantine_release_logs")
}

// ---------------------------------------------------------------------------------------------
// 3.9 Archiving
// ---------------------------------------------------------------------------------------------

model ArchiveSetting {
  id                       BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId           BigInt         @unique @map("organization_id") @db.UnsignedBigInt
  enabled                  Boolean        @default(false)
  scope                    ArchiveScope   @default(all)
  defaultRetentionPolicyId BigInt?        @map("default_retention_policy_id") @db.UnsignedBigInt
  objectLockMode           ObjectLockMode @default(none) @map("object_lock_mode")
  encryptionKeyRef         String?        @map("encryption_key_ref") @db.VarChar(512)
  createdAt                DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                DateTime       @updatedAt @map("updated_at") @db.DateTime(3)

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  defaultRetentionPolicy ArchiveRetentionPolicy? @relation(fields: [defaultRetentionPolicyId], references: [id], onDelete: SetNull)

  @@map("archive_settings")
}

model ArchiveRetentionPolicy {
  id             BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId BigInt                @map("organization_id") @db.UnsignedBigInt
  name           String                @db.VarChar(128)
  retentionDays  Int                   @map("retention_days") @db.UnsignedInt
  criteria       Json?
  priority       Int
  isDefault      Boolean               @default(false) @map("is_default")
  onExpiry       RetentionExpiryAction @default(delete) @map("on_expiry")
  createdAt      DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.DateTime(3)

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  defaultSettings ArchiveSetting[]

  @@unique([organizationId, name])
  @@map("archive_retention_policies")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly, and never auto-dropped (legal holds and
/// per-tenant archive retention are row-level). No foreign keys.
model EmailArchive {
  id                BigInt    @default(autoincrement()) @db.UnsignedBigInt
  receivedAt        DateTime  @map("received_at") @db.DateTime(3)
  messageId         BigInt    @map("message_id") @db.UnsignedBigInt
  organizationId    BigInt    @map("organization_id") @db.UnsignedBigInt
  archiveObjectKey  String    @map("archive_object_key") @db.VarChar(512)
  sha256            String    @db.Char(64)
  sizeBytes         Int       @map("size_bytes") @db.UnsignedInt
  retentionPolicyId BigInt?   @map("retention_policy_id") @db.UnsignedBigInt
  retainUntil       DateTime  @map("retain_until") @db.DateTime(3)
  /// Denormalized from active legal holds.
  legalHold         Boolean   @default(false) @map("legal_hold")
  archivedAt        DateTime  @map("archived_at") @db.DateTime(3)
  deletedAt         DateTime? @map("deleted_at") @db.DateTime(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  @@id([id, receivedAt])
  @@unique([messageId, receivedAt])
  @@index([organizationId, receivedAt])
  @@index([organizationId, retainUntil])
  @@map("email_archives")
}

/// `criteria` holds custodians, date range and query.
model ArchiveLegalHold {
  id               BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId   BigInt          @map("organization_id") @db.UnsignedBigInt
  name             String          @db.VarChar(128)
  reason           String          @db.VarChar(1024)
  criteria         Json
  status           LegalHoldStatus @default(active)
  createdByUserId  BigInt?         @map("created_by_user_id") @db.UnsignedBigInt
  releasedAt       DateTime?       @map("released_at") @db.DateTime(3)
  releasedByUserId BigInt?         @map("released_by_user_id") @db.UnsignedBigInt
  createdAt        DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("LegalHoldCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  releasedBy   User?        @relation("LegalHoldReleasedBy", fields: [releasedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@map("archive_legal_holds")
}

// ---------------------------------------------------------------------------------------------
// 3.10 Platform operations
// ---------------------------------------------------------------------------------------------

/// PARTITIONED by RANGE COLUMNS(created_at), daily. Transactional outbox (ADR-0005, carried
/// forward by ADR-0024): written in the same transaction as the state change. The relay
/// (`apps/event-relay`, ADR-0023) publishes each row to RabbitMQ and sets `published_at` only
/// after the broker confirmed it; `attempts`/`available_at`/`last_error` are the relay's row
/// backoff, and `attempts >= RELAY_MAX_ATTEMPTS` marks a poison row (never published, alerted).
/// The reconciler re-drives published rows whose consumer left no ledger row (`redrive_count`,
/// `last_redriven_at`). A partition is dropped only once every row in it is published.
/// No unique on `event_id` (it would have to include `created_at`); downstream de-duplication is
/// message_idempotency.
model MessageOutbox {
  id             BigInt    @default(autoincrement()) @db.UnsignedBigInt
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  eventId        String    @map("event_id") @db.Char(36)
  organizationId BigInt    @map("organization_id") @db.UnsignedBigInt
  eventType      String    @map("event_type") @db.VarChar(100)
  aggregateType  String    @map("aggregate_type") @db.VarChar(64)
  aggregateId    String    @map("aggregate_id") @db.VarChar(64)
  correlationId  String    @map("correlation_id") @db.VarChar(128)
  payload        Json
  /// Earliest publish time (retry backoff).
  availableAt    DateTime  @default(now()) @map("available_at") @db.DateTime(3)
  /// Set by the relay once the broker confirmed the publish; NULL again while re-driven.
  publishedAt    DateTime? @map("published_at") @db.DateTime(3)
  /// Row-specific publish failures (nack, unroutable, contract); not broker outages.
  attempts       Int       @default(0) @db.UnsignedInt
  /// A failure code, never an error message.
  lastError      String?   @map("last_error") @db.VarChar(1024)
  /// Reconciliation re-drives (ADR-0023).
  redriveCount   Int       @default(0) @map("redrive_count") @db.UnsignedSmallInt
  /// Set while a re-drive awaits its re-check; NULL once settled or exhausted.
  lastRedrivenAt DateTime? @map("last_redriven_at") @db.DateTime(3)

  @@id([id, createdAt])
  @@index([publishedAt, id])
  @@index([lastRedrivenAt])
  /// Provenance lookups by event id (the delivery planner checks that an approval was issued).
  @@index([eventId])
  @@map("message_outbox")
}

/// Inbox / idempotency ledger (not partitioned: the key must not contain time). A consumer
/// records (consumer, event_id) in the same transaction as its side effects via processOnce; a
/// duplicate delivery hits the primary key and is skipped. Purged after 30 days.
model MessageIdempotency {
  consumer    String   @db.VarChar(100)
  eventId     String   @map("event_id") @db.Char(36)
  processedAt DateTime @default(now()) @map("processed_at") @db.DateTime(3)

  @@id([consumer, eventId])
  @@index([processedAt])
  @@map("message_idempotency")
}

/// Idempotency-Key store of the api (step 3.3 L11; reusable by 6.1). Not partitioned, no foreign
/// keys. One row per (organization, key): the first successful response of an operation, replayed
/// for the same principal, operation and request fingerprint until `expires_at` (24 h); another
/// request under the same key is refused (422). Owned by the api; purged by db:partitions one day
/// after expiry. No message content: ids, codes and the response body of the operation only.
model ApiIdempotencyKey {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId BigInt   @map("organization_id") @db.UnsignedBigInt
  /// The client's Idempotency-Key header (1–128 characters); collation utf8mb4_bin (case-sensitive).
  idempotencyKey String   @map("idempotency_key") @db.VarChar(128)
  /// Operation name, e.g. `message.rescan`, `message.release`.
  operation      String   @db.VarChar(64)
  /// `user:<publicId>` | `api_key:<publicId>`.
  principal      String   @db.VarChar(80)
  /// Hex SHA-256 of the canonical JSON { operation, resourceId, body }.
  requestSha256  String   @map("request_sha256") @db.Char(64)
  /// Public id of the addressed resource.
  resourceId     String   @map("resource_id") @db.VarChar(64)
  statusCode     Int      @map("status_code") @db.UnsignedSmallInt
  response       Json
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  expiresAt      DateTime @map("expires_at") @db.DateTime(3)

  @@unique([organizationId, idempotencyKey])
  @@index([expiresAt])
  @@map("api_idempotency_keys")
}

/// Where a RabbitMQ consumer left an event it has not handled (step 3.2, review round 1): the
/// QueueConsumer writes `retrying` after each confirmed retry hop and `dead_lettered` after the
/// confirmed dead-letter copy. The reconciler reads it so it never re-drives an event that is
/// still retrying or was dead-lettered on purpose (replay is the recovery path for those). The
/// ledger (`message_idempotency`) stays the record of handled events. Not partitioned (same key
/// as the ledger); purged after 30 days with the ledger.
model MessageConsumerProgress {
  consumer         String                       @db.VarChar(100)
  eventId          String                       @map("event_id") @db.Char(36)
  state            MessageConsumerProgressState
  /// A failure code (`/^[a-z0-9_]{1,48}$/`), never an error message.
  reason           String?                      @db.VarChar(48)
  attempt          Int                          @default(0) @db.UnsignedInt
  transientRetries Int                          @default(0) @map("transient_retries") @db.UnsignedInt
  updatedAt        DateTime                     @default(now()) @map("updated_at") @db.DateTime(3)

  @@id([consumer, eventId])
  @@index([updatedAt])
  @@map("message_consumer_progress")
}

enum MessageConsumerProgressState {
  retrying
  dead_lettered
}

/// PARTITIONED by RANGE COLUMNS(created_at), monthly, never auto-dropped. Append-only audit
/// trail of administrative actions; services never update or delete it. `organization_id` NULL
/// = platform action. No foreign keys.
model AuditLog {
  id             BigInt         @default(autoincrement()) @db.UnsignedBigInt
  createdAt      DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  organizationId BigInt?        @map("organization_id") @db.UnsignedBigInt
  actorType      AuditActorType @map("actor_type")
  actorId        String?        @map("actor_id") @db.VarChar(64)
  action         String         @db.VarChar(100)
  resourceType   String         @map("resource_type") @db.VarChar(64)
  resourceId     String?        @map("resource_id") @db.VarChar(64)
  correlationId  String?        @map("correlation_id") @db.VarChar(128)
  sourceIp       String?        @map("source_ip") @db.VarChar(45)
  metadata       Json?

  @@id([id, createdAt])
  @@index([organizationId, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

/// `event_types` is an array of event type names. The HMAC secret is application-encrypted.
model WebhookSubscription {
  id                  BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  publicId            String        @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  organizationId      BigInt        @map("organization_id") @db.UnsignedBigInt
  name                String        @db.VarChar(255)
  url                 String        @db.VarChar(2048)
  eventTypes          Json          @map("event_types")
  secretCiphertext    String        @map("secret_ciphertext") @db.VarChar(512)
  status              WebhookStatus @default(active)
  consecutiveFailures Int           @default(0) @map("consecutive_failures") @db.UnsignedInt
  lastSuccessAt       DateTime?     @map("last_success_at") @db.DateTime(3)
  lastFailureAt       DateTime?     @map("last_failure_at") @db.DateTime(3)
  createdByUserId     BigInt?       @map("created_by_user_id") @db.UnsignedBigInt
  createdAt           DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@map("webhook_subscriptions")
}

/// PARTITIONED by RANGE COLUMNS(event_occurred_at), monthly. `event_occurred_at` comes from the
/// envelope, so the unique key is deterministic across redeliveries. No foreign keys.
model WebhookDelivery {
  id               BigInt                @default(autoincrement()) @db.UnsignedBigInt
  eventOccurredAt  DateTime              @map("event_occurred_at") @db.DateTime(3)
  subscriptionId   BigInt                @map("subscription_id") @db.UnsignedBigInt
  organizationId   BigInt                @map("organization_id") @db.UnsignedBigInt
  eventId          String                @map("event_id") @db.Char(36)
  eventType        String                @map("event_type") @db.VarChar(100)
  status           WebhookDeliveryStatus @default(pending)
  attemptCount     Int                   @default(0) @map("attempt_count") @db.UnsignedSmallInt
  nextAttemptAt    DateTime?             @map("next_attempt_at") @db.DateTime(3)
  lastResponseCode Int?                  @map("last_response_code") @db.UnsignedSmallInt
  lastError        String?               @map("last_error") @db.VarChar(1024)
  completedAt      DateTime?             @map("completed_at") @db.DateTime(3)
  createdAt        DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.DateTime(3)

  @@id([id, eventOccurredAt])
  @@unique([subscriptionId, eventId, eventOccurredAt])
  @@index([status, nextAttemptAt])
  @@map("webhook_deliveries")
}

/// Platform configuration data (seeded): provider presets for destination servers (step 2.3
/// R2). Read by the api and the routing module; no tenant is special-cased in code.
model MailDestinationPreset {
  provider         MailDestinationProvider @id
  displayName      String                  @map("display_name") @db.VarChar(128)
  /// JSON array of anchored regular expressions (lower-case host names).
  hostPatterns     Json                    @map("host_patterns")
  hostHint         String?                 @map("host_hint") @db.VarChar(255)
  /// JSON array of { host, priority } or NULL (customer supplies the host).
  defaultServers   Json?                   @map("default_servers")
  port             Int                     @db.UnsignedSmallInt
  tlsMode          TlsMode                 @map("tls_mode")
  /// Postfix `match=` list (`:`-separated) for the preset's verified TLS.
  tlsVerifyNames   String                  @map("tls_verify_names") @db.VarChar(512)
  maxServers       Int                     @map("max_servers") @db.UnsignedTinyInt
  /// Relative documentation path (customer-side setup).
  documentationUrl String?                 @map("documentation_url") @db.VarChar(512)
  enabled          Boolean                 @default(true)
  createdAt        DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("mail_destination_presets")
}

/// Durable positions of stream consumers (outbox pollers, Postfix log tailers; step 2.3 R6, R9).
/// Not partitioned.
model StreamCursor {
  /// E.g. `outbox:delivery-worker.planner`, `postfix-log:out.gateway.local`.
  name        String    @id @db.VarChar(128)
  /// Outbox consumers: largest processed message_outbox.id below the safety lag.
  positionId  BigInt?   @map("position_id") @db.UnsignedBigInt
  /// Log tailers: file identity (device + inode) and byte offset.
  fileId      String?   @map("file_id") @db.VarChar(128)
  fileOffset  BigInt?   @map("file_offset") @db.UnsignedBigInt
  lastEventAt DateTime? @map("last_event_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("stream_cursors")
}

/// Platform catalog of settings.
model SystemSetting {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  key             String   @unique @db.VarChar(128)
  value           Json
  description     String?  @db.VarChar(512)
  updatedByUserId BigInt?  @map("updated_by_user_id") @db.UnsignedBigInt
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  updatedBy User? @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("system_settings")
}

/// Progress markers for maintenance jobs, written only by the partition-maintenance job
/// (migrator account). `message_identities.purged_below`: every registry id below this value has
/// been checked by the retention purge (D3.4); rows still below it are retained on purpose
/// because an email_archives or quarantine_messages row references them.
model MaintenanceWatermark {
  name      String   @id @db.VarChar(64)
  value     BigInt   @db.UnsignedBigInt
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("maintenance_watermarks")
}
