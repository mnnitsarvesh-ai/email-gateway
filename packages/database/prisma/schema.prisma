model User {
  id                  BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  publicId            String     @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  organizationId      BigInt     @map("organization_id") @db.UnsignedBigInt
  /// Lower-cased.
  email               String     @db.VarChar(320)
  displayName         String     @map("display_name") @db.VarChar(255)
  status              UserStatus @default(invited)
  /// Argon2id (step 1.3).
  passwordHash        String?    @map("password_hash") @db.VarChar(255)
  mfaEnabled          Boolean    @default(false) @map("mfa_enabled")
  /// Application-encrypted, never plaintext.
  mfaSecretCiphertext String?    @map("mfa_secret_ciphertext") @db.VarChar(512)
  /// Last accepted TOTP time step; a code is accepted only for a later step (replay protection).
  mfaLastUsedStep     BigInt?    @map("mfa_last_used_step") @db.UnsignedBigInt
  emailVerifiedAt     DateTime?  @map("email_verified_at") @db.DateTime(3)
  failedLoginCount    Int        @default(0) @map("failed_login_count") @db.UnsignedSmallInt
  lockedUntil         DateTime?  @map("locked_until") @db.DateTime(3)
  passwordChangedAt   DateTime?  @map("password_changed_at") @db.DateTime(3)
  lastLoginAt         DateTime?  @map("last_login_at") @db.DateTime(3)
  statusReason        String?    @map("status_reason") @db.VarChar(512)
  statusChangedAt     DateTime?  @map("status_changed_at") @db.DateTime(3)
  deletedAt           DateTime?  @map("deleted_at") @db.DateTime(3)
  createdAt           DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  userRoles                    UserRole[]                  @relation("UserRoleUser")
  grantedUserRoles             UserRole[]                  @relation("UserRoleGrantedBy")
  sessions                     UserSession[]
  tokens                       UserToken[]                 @relation("UserTokenUser")
  createdTokens                UserToken[]                 @relation("UserTokenCreatedBy")
  mfaRecoveryCodes             UserMfaRecoveryCode[]
  createdApiKeys               ApiKey[]
  updatedYaraRules             YaraRule[]
  createdEmailPolicies         EmailPolicy[]               @relation("EmailPolicyCreatedBy")
  updatedEmailPolicies         EmailPolicy[]               @relation("EmailPolicyUpdatedBy")
  createdPolicyVersions        PolicyVersion[]             @relation("PolicyVersionCreatedBy")
  updatedPolicyVersions        PolicyVersion[]             @relation("PolicyVersionUpdatedBy")
  publishedPolicyVersions      PolicyVersion[]             @relation("PolicyVersionPublishedBy")
  createdPolicyExceptions      PolicyException[]
  createdSuppressions          DeliverySuppression[]
  quarantineMessages           QuarantineMessage[]         @relation("QuarantineEntryUser")
  decidedQuarantineEntries     QuarantineMessage[]         @relation("QuarantineEntryDecidedBy")
  quarantineActions            QuarantineAction[]
  requestedQuarantineApprovals QuarantineApprovalRequest[] @relation("QuarantineApprovalRequestedBy")
  decidedQuarantineApprovals   QuarantineApprovalRequest[] @relation("QuarantineApprovalDecidedBy")
  quarantineDownloadGrants     QuarantineDownloadGrant[]   @relation("QuarantineDownloadGrantUser")
  updatedQuarantineSettings    QuarantineSettings[]        @relation("QuarantineSettingsUpdatedBy")
  quarantinePreference         QuarantineUserPreference?   @relation("QuarantineUserPreferenceUser")
  quarantineDigests            QuarantineDigest[]          @relation("QuarantineDigestUser")
  createdLegalHolds            ArchiveLegalHold[]          @relation("LegalHoldCreatedBy")
  releasedLegalHolds           ArchiveLegalHold[]          @relation("LegalHoldReleasedBy")
  updatedArchiveSettings       ArchiveSetting[]            @relation("ArchiveSettingsUpdatedBy")
  createdRetentionPolicies     ArchiveRetentionPolicy[]    @relation("ArchiveRetentionPolicyCreatedBy")
  updatedRetentionPolicies     ArchiveRetentionPolicy[]    @relation("ArchiveRetentionPolicyUpdatedBy")
  createdArchiveKeys           ArchiveEncryptionKey[]      @relation("ArchiveEncryptionKeyCreatedBy")
  archiveDownloadGrants        ArchiveDownloadGrant[]      @relation("ArchiveDownloadGrantUser")
  createdEdiscoveryCases       EdiscoveryCase[]            @relation("EdiscoveryCaseCreatedBy")
  updatedEdiscoveryCases       EdiscoveryCase[]            @relation("EdiscoveryCaseUpdatedBy")
  closedEdiscoveryCases        EdiscoveryCase[]            @relation("EdiscoveryCaseClosedBy")
  ediscoveryCustodianships     EdiscoveryCustodian[]       @relation("EdiscoveryCustodianUser")
  createdEdiscoveryCustodians  EdiscoveryCustodian[]       @relation("EdiscoveryCustodianCreatedBy")
  requestedEdiscoverySearches  EdiscoverySearch[]          @relation("EdiscoverySearchRequestedBy")
  reviewedEdiscoveryHits       EdiscoverySearchHit[]       @relation("EdiscoverySearchHitReviewedBy")
  requestedEdiscoveryExports   EdiscoveryExport[]          @relation("EdiscoveryExportRequestedBy")
  createdWebhooks              WebhookSubscription[]
  updatedNotificationSettings  NotificationSettings[]      @relation("NotificationSettingsUpdatedBy")
  notificationPreference       NotificationUserPreference? @relation("NotificationUserPreferenceUser")
  savedViews                   SavedView[]                 @relation("SavedViewUser")
  updatedSystemSettings        SystemSetting[]
  createdSmtpConnectors        SmtpConnector[]
  createdRecipients            DomainRecipientAddress[]
  updatedScanEngineSettings    ScanEngineSetting[]
  addedMalwareSignatures       MalwareSignature[]
  requestedAttachmentRescans   AttachmentRescanJob[]
  addedThreatIndicators        ThreatIndicator[]
  createdBecExecutives         BecExecutiveProfile[]       @relation("BecExecutiveCreatedBy")
  updatedBecExecutives         BecExecutiveProfile[]       @relation("BecExecutiveUpdatedBy")
  createdBecVendors            BecVendorProfile[]          @relation("BecVendorCreatedBy")
  updatedBecVendors            BecVendorProfile[]          @relation("BecVendorUpdatedBy")
  createdBecTrustedSenders     BecTrustedSender[]          @relation("BecTrustedSenderCreatedBy")
  createdBecFeedback           BecFeedback[]               @relation("BecFeedbackCreatedBy")
  createdBecSuppressions       BecSuppressionRule[]        @relation("BecSuppressionCreatedBy")
  createdDlpPolicies           DlpPolicy[]                 @relation("DlpPolicyCreatedBy")
  updatedDlpPolicies           DlpPolicy[]                 @relation("DlpPolicyUpdatedBy")
  createdDlpRules              DlpPolicyRule[]             @relation("DlpRuleCreatedBy")
  updatedDlpRules              DlpPolicyRule[]             @relation("DlpRuleUpdatedBy")
  createdDlpExceptions         DlpException[]              @relation("DlpExceptionCreatedBy")
  updatedDlpExceptions         DlpException[]              @relation("DlpExceptionUpdatedBy")
  createdDlpPatterns           DlpCustomPattern[]          @relation("DlpPatternCreatedBy")
  updatedDlpPatterns           DlpCustomPattern[]          @relation("DlpPatternUpdatedBy")
  createdDlpDictionaries       DlpKeywordDictionary[]      @relation("DlpDictionaryCreatedBy")
  updatedDlpDictionaries       DlpKeywordDictionary[]      @relation("DlpDictionaryUpdatedBy")
  recordedDlpAadhaarSettings   DlpComplianceSettings[]     @relation("DlpAadhaarRecordedBy")
  updatedRiskProfiles          RiskScoringProfile[]        @relation("RiskProfileUpdatedBy")
  createdRiskVersions          RiskScoringProfileVersion[] @relation("RiskVersionCreatedBy")
  updatedRiskVersions          RiskScoringProfileVersion[] @relation("RiskVersionUpdatedBy")
  publishedRiskVersions        RiskScoringProfileVersion[] @relation("RiskVersionPublishedBy")
  updatedPolicySettings        PolicySettings[]            @relation("PolicySettingsUpdatedBy")
  createdDepartments           TenantDepartment[]          @relation("DepartmentCreatedBy")
  updatedDepartments           TenantDepartment[]          @relation("DepartmentUpdatedBy")
  departmentMemberships        TenantDepartmentMember[]    @relation("DepartmentMemberUser")
  createdDepartmentMembers     TenantDepartmentMember[]    @relation("DepartmentMemberCreatedBy")
  assignedSecurityIncidents    SecurityIncident[]          @relation("SecurityIncidentAssignee")
  updatedAtoSettings           AtoSetting[]                @relation("AtoSettingsUpdatedBy")
  createdProviderConnections   ProviderConnection[]        @relation("ProviderConnectionCreatedBy")
  providerConsentStates        ProviderConsentState[]
  aiChatConversations          AiChatConversation[]        @relation("AiChatConversationUser")

  @@unique([organizationId, email])
  @@index([organizationId, status])
  @@map("users")
}

/// `organization_id` NULL = built-in system role. MySQL unique keys do not collide on NULL, so
/// the seed enforces the uniqueness of system role keys.
model Role {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId BigInt?  @map("organization_id") @db.UnsignedBigInt
  key            String   @db.VarChar(64)
  name           String   @db.VarChar(255)
  description    String?  @db.VarChar(512)
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  permissions RolePermission[]
  userRoles   UserRole[]

  @@unique([organizationId, key])
  @@index([key])
  @@map("roles")
}

/// Platform catalog of `resource:action` permission keys.
model Permission {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  key         String   @unique @db.VarChar(100)
  description String   @db.VarChar(255)
  category    String   @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       BigInt   @map("role_id") @db.UnsignedBigInt
  permissionId BigInt   @map("permission_id") @db.UnsignedBigInt
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// `organization_id` is denormalized from the user for tenant-scoped queries.
model UserRole {
  userId          BigInt   @map("user_id") @db.UnsignedBigInt
  roleId          BigInt   @map("role_id") @db.UnsignedBigInt
  organizationId  BigInt   @map("organization_id") @db.UnsignedBigInt
  grantedByUserId BigInt?  @map("granted_by_user_id") @db.UnsignedBigInt
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)

  user         User         @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  grantedBy    User?        @relation("UserRoleGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([organizationId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// One row per issued refresh token; a session is a rotation family (step 1.3, D5). Exactly one
/// row of a live family has `revoked_at` NULL. Expired rows are purged hourly by the api.
model UserSession {
  id                BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId    BigInt    @map("organization_id") @db.UnsignedBigInt
  userId            BigInt    @map("user_id") @db.UnsignedBigInt
  /// SHA-256 of the refresh token; the token itself is never stored.
  refreshTokenHash  String    @unique @map("refresh_token_hash") @db.Char(64)
  /// Rotation family: reuse of a rotated token revokes the whole family.
  familyId          String    @map("family_id") @db.Char(36)
  ipAddress         String?   @map("ip_address") @db.VarChar(45)
  userAgent         String?   @map("user_agent") @db.VarChar(512)
  lastUsedAt        DateTime? @map("last_used_at") @db.DateTime(3)
  /// When the family was created by a login; copied to every rotated row.
  authenticatedAt   DateTime  @map("authenticated_at") @db.DateTime(3)
  /// Sliding idle expiry of this refresh token, never later than `absolute_expires_at`.
  expiresAt         DateTime  @map("expires_at") @db.DateTime(3)
  /// Hard cap for the whole family, independent of refreshes.
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.DateTime(3)
  /// The login completed a second factor (required by step-up operations).
  mfaAuthenticated  Boolean   @default(false) @map("mfa_authenticated")
  revokedAt         DateTime? @map("revoked_at") @db.DateTime(3)
  revokedReason     String?   @map("revoked_reason") @db.VarChar(64)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId, revokedAt])
  @@index([expiresAt])
  @@map("user_sessions")
}

/// Single-use tokens (invitation, password reset, email verification; step 1.3, D4). Only the
/// SHA-256 of the token is stored. Effectively append-only: `consumed_at` is the only mutation,
/// so there is no `updated_at`. Expired rows are purged by the api 7 days after `expires_at`.
model UserToken {
  id              BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId  BigInt           @map("organization_id") @db.UnsignedBigInt
  userId          BigInt           @map("user_id") @db.UnsignedBigInt
  purpose         UserTokenPurpose
  /// SHA-256 hex of the token; the token itself is never stored.
  tokenHash       String           @unique @map("token_hash") @db.Char(64)
  expiresAt       DateTime         @map("expires_at") @db.DateTime(3)
  consumedAt      DateTime?        @map("consumed_at") @db.DateTime(3)
  createdByUserId BigInt?          @map("created_by_user_id") @db.UnsignedBigInt
  createdIp       String?          @map("created_ip") @db.VarChar(45)
  createdAt       DateTime         @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation("UserTokenUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("UserTokenCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([userId, purpose, consumedAt])
  @@index([expiresAt])
  @@map("user_tokens")
}

/// MFA recovery codes (step 1.3, D4): HMAC-SHA256 with the server pepper, single use via
/// `used_at`. Regenerating replaces the user's whole set.
model UserMfaRecoveryCode {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId BigInt    @map("organization_id") @db.UnsignedBigInt
  userId         BigInt    @map("user_id") @db.UnsignedBigInt
  codeHash       String    @map("code_hash") @db.Char(64)
  usedAt         DateTime? @map("used_at") @db.DateTime(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@map("user_mfa_recovery_codes")
}

model ApiKey {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  publicId        String    @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  organizationId  BigInt    @map("organization_id") @db.UnsignedBigInt
  name            String    @db.VarChar(255)
  /// Shown to users and used for lookup.
  keyPrefix       String    @unique @map("key_prefix") @db.VarChar(16)
  /// HMAC-SHA256 of the secret; the secret is never stored.
  keyHash         String    @map("key_hash") @db.Char(64)
  /// Array of permission keys.
  scopes          Json
  createdByUserId BigInt?   @map("created_by_user_id") @db.UnsignedBigInt
  lastUsedAt      DateTime? @map("last_used_at") @db.DateTime(3)
  expiresAt       DateTime? @map("expires_at") @db.DateTime(3)
  revokedAt       DateTime? @map("revoked_at") @db.DateTime(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, revokedAt])
  @@map("api_keys")
}

/// Append-only. `organization_id` NULL = attempt for an unknown account. `user_id` has no FK so
/// the trail survives user deletion.
model LoginAuditLog {
  id             BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId BigInt?      @map("organization_id") @db.UnsignedBigInt
  userId         BigInt?      @map("user_id") @db.UnsignedBigInt
  emailAttempted String       @map("email_attempted") @db.VarChar(320)
  outcome        LoginOutcome
  failureReason  String?      @map("failure_reason") @db.VarChar(64)
  ipAddress      String?      @map("ip_address") @db.VarChar(45)
  userAgent      String?      @map("user_agent") @db.VarChar(512)
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("login_audit_logs")
}

// ---------------------------------------------------------------------------------------------
// 3.3 Domain management
// ---------------------------------------------------------------------------------------------

/// Soft-deleted (step 2.1): `DELETE /domains/{id}` sets `status = deleted` and `deleted_at`; the
/// row stays as history (DKIM keys, audit linkage) until the organization purge. A deleted row
/// frees both the global name (`verified_name`) and the per-organization name (`live_name`).
model Domain {
  id                      BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  publicId                String          @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  organizationId          BigInt          @map("organization_id") @db.UnsignedBigInt
  /// Lower-cased ASCII (punycode). Unique per organization among non-deleted rows only (see
  /// `liveName`): several organizations may hold a pending claim on the same name, so an
  /// unverified claim cannot squat a domain.
  name                    String          @db.VarChar(253)
  status                  DomainStatus    @default(pending_verification)
  /// Why the domain is in its status (e.g. `claimed_by_another_organization`, a suspension reason).
  statusReason            String?         @map("status_reason") @db.VarChar(512)
  statusChangedAt         DateTime?       @map("status_changed_at") @db.DateTime(3)
  inboundEnabled          Boolean         @default(true) @map("inbound_enabled")
  outboundEnabled         Boolean         @default(false) @map("outbound_enabled")
  verifiedAt              DateTime?       @map("verified_at") @db.DateTime(3)
  /// First activation (`verified` → `active`).
  activatedAt             DateTime?       @map("activated_at") @db.DateTime(3)
  deletedAt               DateTime?       @map("deleted_at") @db.DateTime(3)
  /// When the background job checks the DNS records next; NULL for `failed` and `deleted`.
  nextCheckAt             DateTime?       @map("next_check_at") @db.DateTime(3)
  lastCheckedAt           DateTime?       @map("last_checked_at") @db.DateTime(3)
  /// Consecutive checks with an indeterminate result (drives the retry backoff).
  checkFailures           Int             @default(0) @map("check_failures") @db.UnsignedInt
  /// READ-ONLY, generated by MySQL: `GENERATED ALWAYS AS (IF(status IN ('verified', 'active',
  /// 'suspended'), name, NULL)) STORED`. Its unique key makes verified ownership globally unique
  /// (one owner per name, in every post-verification state; a deleted domain frees it). Tenant
  /// resolution on the mail path looks up by this column, never by `name`. Never write it.
  verifiedName            String?         @unique @map("verified_name") @db.VarChar(253)
  /// READ-ONLY, generated by MySQL: `GENERATED ALWAYS AS (IF(status = 'deleted', NULL, name))
  /// STORED`. UNIQUE (organization_id, live_name): one non-deleted row per name and organization;
  /// an organization can re-add a name it deleted. Never write it.
  liveName                String?         @map("live_name") @db.VarChar(253)
  createdAt               DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt               DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  /// Step API-1 (D1, D2, ADR-0098): the domain's own protection mode; NULL = inherit the
  /// organization's. Effective mode = COALESCE(domains.protection_mode,
  /// organizations.protection_mode). A change to effective `api` is refused while the domain's MX
  /// points to the gateway; never changes `inbound_enabled` / `outbound_enabled`.
  protectionMode          ProtectionMode? @map("protection_mode")
  protectionModeChangedAt DateTime?       @map("protection_mode_changed_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  verifications            DomainVerification[]
  dnsRecords               DomainDnsRecord[]
  dkimKeys                 DomainDkimKey[]
  mxRecords                DomainMxRecord[]
  mailServers              DomainMailServer[]
  settings                 DomainSetting?
  deliveryRoutes           DeliveryRoute[]
  recipients               DomainRecipientAddress[]
  providerConnectionDomain ProviderConnectionDomain?

  @@unique([organizationId, liveName])
  @@index([name])
  @@index([organizationId, status])
  @@index([nextCheckAt])
  @@map("domains")
}

model DomainVerification {
  id             BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId BigInt                   @map("organization_id") @db.UnsignedBigInt
  domainId       BigInt                   @map("domain_id") @db.UnsignedBigInt
  method         DomainVerificationMethod @default(dns_txt)
  token          String                   @db.VarChar(128)
  status         DomainVerificationStatus @default(pending)
  attempts       Int                      @default(0) @db.UnsignedInt
  nextCheckAt    DateTime?                @map("next_check_at") @db.DateTime(3)
  lastCheckedAt  DateTime?                @map("last_checked_at") @db.DateTime(3)
  lastError      String?                  @map("last_error") @db.VarChar(512)
  lastOutcome    DnsCheckOutcome?         @map("last_outcome")
  /// JSON-safe DNS evidence of the last check (upstream, outcome, answers); public data only.
  evidence       Json?
  verifiedAt     DateTime?                @map("verified_at") @db.DateTime(3)
  expiresAt      DateTime                 @map("expires_at") @db.DateTime(3)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  domain       Domain       @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([domainId, status])
  @@index([status, nextCheckAt])
  @@map("domain_verifications")
}

/// One row per record the customer publishes (step 2.1 D6), keyed by `record_key`.
model DomainDnsRecord {
  id              BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId  BigInt           @map("organization_id") @db.UnsignedBigInt
  domainId        BigInt           @map("domain_id") @db.UnsignedBigInt
  /// Stable key for idempotent upserts: `verification`, `mx:<host>`, `spf`, `dkim:<selector>`,
  /// `dmarc`.
  recordKey       String           @map("record_key") @db.VarChar(191)
  purpose         DnsRecordPurpose
  recordType      DnsRecordType    @map("record_type")
  host            String           @db.VarChar(255)
  /// The DKIM key this record publishes (`purpose = dkim` only).
  dkimKeyId       BigInt?          @map("dkim_key_id") @db.UnsignedBigInt
  expectedValue   String           @map("expected_value") @db.Text
  observedValue   String?          @map("observed_value") @db.Text
  /// Last definitive outcome; an indeterminate check never changes it.
  status          DnsRecordStatus  @default(pending)
  statusChangedAt DateTime?        @map("status_changed_at") @db.DateTime(3)
  lastOutcome     DnsCheckOutcome? @map("last_outcome")
  lastError       String?          @map("last_error") @db.VarChar(512)
  /// JSON-safe DNS evidence of the last check (≤ 8 KiB, warnings included); public data only.
  evidence        Json?
  lastCheckedAt   DateTime?        @map("last_checked_at") @db.DateTime(3)
  createdAt       DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  domain       Domain         @relation(fields: [domainId], references: [id], onDelete: Cascade)
  dkimKey      DomainDkimKey? @relation(fields: [dkimKeyId], references: [id], onDelete: SetNull)

  @@unique([domainId, recordKey])
  @@index([domainId, purpose])
  @@map("domain_dns_records")
}

model DomainDkimKey {
  id                   BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId       BigInt        @map("organization_id") @db.UnsignedBigInt
  domainId             BigInt        @map("domain_id") @db.UnsignedBigInt
  selector             String        @db.VarChar(63)
  algorithm            DkimAlgorithm
  /// Public key as published in DNS (`p=` value: base64 SPKI for RSA, raw 32 bytes for Ed25519).
  publicKey            String        @map("public_key") @db.Text
  /// ADR-0018: the PKCS#8 PEM private key encrypted with the api's SecretBox (AES-256-GCM,
  /// `DATA_ENCRYPTION_KEY`), additional authenticated data `dkim:<domain public id>:<selector>`.
  /// Set to NULL when the key is retired or revoked (crypto-shredding). Never logged or returned.
  privateKeyCiphertext String?       @map("private_key_ciphertext") @db.Text
  /// Reserved for an external key store (Secrets Manager / KMS object reference); NULL when
  /// `private_key_ciphertext` is used. Exactly one of the two is set for pending/active/rotating
  /// keys. Never the key itself.
  privateKeyRef        String?       @map("private_key_ref") @db.VarChar(512)
  status               DkimKeyStatus @default(pending)
  activatedAt          DateTime?     @map("activated_at") @db.DateTime(3)
  /// `rotating` keys stay published until this time (rotation overlap), then are retired.
  retireAfter          DateTime?     @map("retire_after") @db.DateTime(3)
  retiredAt            DateTime?     @map("retired_at") @db.DateTime(3)
  createdAt            DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  domain       Domain            @relation(fields: [domainId], references: [id], onDelete: Cascade)
  dnsRecords   DomainDnsRecord[]

  @@unique([domainId, selector])
  @@index([organizationId, status])
  @@index([status, retireAfter])
  @@map("domain_dkim_keys")
}

/// Observed MX records of a domain.
model DomainMxRecord {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId  BigInt   @map("organization_id") @db.UnsignedBigInt
  domainId        BigInt   @map("domain_id") @db.UnsignedBigInt
  priority        Int      @db.UnsignedSmallInt
  host            String   @db.VarChar(255)
  pointsToGateway Boolean  @default(false) @map("points_to_gateway")
  lastSeenAt      DateTime @map("last_seen_at") @db.DateTime(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  domain       Domain       @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([domainId, host])
  @@map("domain_mx_records")
}

model DomainMailServer {
  id             BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  /// UUIDv7, the API id of a destination server (step 2.3 R13). Rows created before step 2.3
  /// were backfilled with UUID() (v1) by the mail_routing migration.
  publicId       String                  @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  organizationId BigInt                  @map("organization_id") @db.UnsignedBigInt
  domainId       BigInt                  @map("domain_id") @db.UnsignedBigInt
  /// `inbound_destination`: the tenant's own mail server that approved inbound and internal mail
  /// is delivered to (transport and TLS policy maps, step 2.2 D11; all enabled rows form an
  /// ordered next-hop list ordered by (priority, id), step 2.3 R2). `outbound_source` is
  /// DEPRECATED (step 2.2 D10): never read by the mail path; outbound senders are
  /// organization-level `smtp_connectors`.
  role           MailServerRole
  /// Normalized ASCII host name, validated with validateDestinationHost (step 2.3 R3) on write
  /// by the api and again on every map answer by the smtp-adapter.
  host           String?                 @db.VarChar(255)
  port           Int                     @default(25) @db.UnsignedSmallInt
  /// Source network of a deprecated `outbound_source` row (never read; see `role`).
  ipCidr         String?                 @map("ip_cidr") @db.VarChar(64)
  priority       Int                     @default(10) @db.UnsignedSmallInt
  tlsMode        TlsMode                 @default(opportunistic) @map("tls_mode")
  /// Preset the row was created from (step 2.3 R2); one provider per domain (api-enforced).
  provider       MailDestinationProvider @default(custom)
  /// Postfix `match=` list for tls_mode = verify (`:`-separated); NULL = `nexthop`.
  tlsVerifyNames String?                 @map("tls_verify_names") @db.VarChar(512)
  enabled        Boolean                 @default(true)
  createdAt      DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.DateTime(3)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  domain         Domain          @relation(fields: [domainId], references: [id], onDelete: Cascade)
  deliveryRoutes DeliveryRoute[]

  @@index([domainId, role, priority])
  // The smtp-adapter's tls_policy map looks rows up by `[host]:port`.
  @@index([host, port])
  @@map("domain_mail_servers")
}

model DomainSetting {
  id                      BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId          BigInt              @map("organization_id") @db.UnsignedBigInt
  domainId                BigInt              @unique @map("domain_id") @db.UnsignedBigInt
  maxMessageSizeBytes     Int?                @map("max_message_size_bytes") @db.UnsignedInt
  rejectUnknownRecipients Boolean             @default(false) @map("reject_unknown_recipients")
  recipientValidation     RecipientValidation @default(none) @map("recipient_validation")
  settings                Json?
  createdAt               DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt               DateTime            @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  domain       Domain       @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@map("domain_settings")
}

/// Recipient allow-list entry of a domain (step 2.2 D3). Used when
/// domain_settings.recipient_validation = list (authoritative when reject_unknown_recipients,
/// monitor-only otherwise). The domain part is never stored: rows belong to the domain.
model DomainRecipientAddress {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId  BigInt   @map("organization_id") @db.UnsignedBigInt
  domainId        BigInt   @map("domain_id") @db.UnsignedBigInt
  /// Lower-cased, NFC, 1..64 octets.
  localPart       String   @map("local_part") @db.VarChar(64)
  createdByUserId BigInt?  @map("created_by_user_id") @db.UnsignedBigInt
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  domain       Domain       @relation(fields: [domainId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([domainId, localPart])
  @@index([organizationId])
  @@map("domain_recipient_addresses")
}

/// Outbound relay connector of an organization (step 2.2 D10). Exactly one auth method.
/// Disabled connectors and connectors of non-active organizations never authorize anything.
model SmtpConnector {
  id                    BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  publicId              String                @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  organizationId        BigInt                @map("organization_id") @db.UnsignedBigInt
  name                  String                @db.VarChar(128)
  authType              SmtpConnectorAuthType @map("auth_type")
  status                SmtpConnectorStatus   @default(active)
  /// sasl only; generated (`egc-` + 20 lower-case base32 characters), globally unique.
  saslUsername          String?               @unique @map("sasl_username") @db.VarChar(64)
  /// sasl only; Argon2id PHC string. Never returned or logged.
  secretHash            String?               @map("secret_hash") @db.VarChar(255)
  secretSetAt           DateTime?             @map("secret_set_at") @db.DateTime(3)
  /// client_certificate only; lower-case hex SHA-256 of the DER certificate, no colons.
  certFingerprintSha256 String?               @unique @map("cert_fingerprint_sha256") @db.Char(64)
  /// Refuse sessions without TLS (source_ip; implied for sasl and client_certificate).
  requireTls            Boolean               @default(true) @map("require_tls")
  createdByUserId       BigInt?               @map("created_by_user_id") @db.UnsignedBigInt
  createdAt             DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.DateTime(3)
  /// provider_relay only (step 8.2 D7): the provider connection this relay connector serves.
  providerConnectionId  BigInt?               @unique @map("provider_connection_id") @db.UnsignedBigInt

  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy          User?                  @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  networks           SmtpConnectorNetwork[]
  providerConnection ProviderConnection?    @relation(fields: [providerConnectionId], references: [id], onDelete: Restrict)

  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@map("smtp_connectors")
}

/// Allowed client network of a connector. Ranges never overlap across all connectors, in any
/// organization (enforced by the api under a MySQL named lock), so an IP maps to at most one
/// connector. Lookup: WHERE ip_version = ? AND range_start <= ? ORDER BY range_start DESC
/// LIMIT 1, then check range_end >= ?.
model SmtpConnectorNetwork {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId BigInt   @map("organization_id") @db.UnsignedBigInt
  connectorId    BigInt   @map("connector_id") @db.UnsignedBigInt
  /// Canonical CIDR text (network address, prefix).
  cidr           String   @db.VarChar(49)
  /// 4 or 6.
  ipVersion      Int      @map("ip_version") @db.UnsignedTinyInt
  /// First and last address, 4 or 16 bytes big-endian, for range lookups.
  rangeStart     Bytes    @map("range_start") @db.VarBinary(16)
  rangeEnd       Bytes    @map("range_end") @db.VarBinary(16)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  connector    SmtpConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@unique([connectorId, cidr])
  @@index([ipVersion, rangeStart])
  @@map("smtp_connector_networks")
}

// ---------------------------------------------------------------------------------------------
// 3.4 Email metadata
// ---------------------------------------------------------------------------------------------

/// Identity registry (not partitioned). Allocates the message id, owns the global uniqueness of
/// `public_id` and of the ingestion key, and maps id → received_at (the partition key of every
/// row of the message).
model MessageIdentity {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  publicId       String   @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  organizationId BigInt   @map("organization_id") @db.UnsignedBigInt
  /// Ingestion idempotency key (step 2.2 D7, §12.7): `v2:` + lower-case hex SHA-256 of
  /// `{mtaId}|{queueId}|{direction}|{contentSha256}|{recipientSetSha256}` (mtaId = the LMTP
  /// client's LHLO name, queueId = the Postfix queue id from XFORWARD IDENT, direction =
  /// inbound|outbound, contentSha256 = hex SHA-256 of the EML bytes, recipientSetSha256 = hex
  /// SHA-256 of this organization's accepted recipients, lower-cased, de-duplicated, sorted,
  /// LF-joined); 67 characters. A redelivery of the same queue file to the same recipients hits
  /// the unique key and is answered as a duplicate; a retry of other recipients is stored.
  /// `v1:` keys (without the recipient set) predate the step 2.2 review fix.
  ingestKey      String   @map("ingest_key") @db.VarChar(128)
  receivedAt     DateTime @map("received_at") @db.DateTime(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, ingestKey])
  @@map("message_identities")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly. `id` is the registry id
/// (message_identities.id), not an auto-increment. No foreign keys.
model EmailMessage {
  id                BigInt              @db.UnsignedBigInt
  receivedAt        DateTime            @map("received_at") @db.DateTime(3)
  organizationId    BigInt              @map("organization_id") @db.UnsignedBigInt
  domainId          BigInt?             @map("domain_id") @db.UnsignedBigInt
  direction         MessageDirection
  /// Lifecycle state (ADR-0025). status, status_changed_at, version, lifecycle_round and
  /// status_reason are written only through @email-gateway/message-lifecycle (step 3.3 L5).
  status            MessageStatus       @default(received)
  statusChangedAt   DateTime            @map("status_changed_at") @db.DateTime(3)
  /// Optimistic concurrency: +1 per applied lifecycle transition (0 = the `received` history
  /// row, 1 = `persisted`).
  version           Int                 @default(0) @db.UnsignedInt
  /// Lifecycle round: +1 on rescan/release (re-entry edges), ADR-0025.
  lifecycleRound    Int                 @default(0) @map("lifecycle_round") @db.UnsignedSmallInt
  /// Reason code of the last applied transition (`/^[a-z0-9_]{1,64}$/`, e.g. delivery_partial).
  statusReason      String?             @map("status_reason") @db.VarChar(64)
  internetMessageId String?             @map("internet_message_id") @db.VarChar(998)
  envelopeFrom      String              @map("envelope_from") @db.VarChar(320)
  headerFrom        String?             @map("header_from") @db.VarChar(320)
  subject           String?             @db.VarChar(998)
  sizeBytes         Int                 @map("size_bytes") @db.UnsignedInt
  recipientCount    Int                 @map("recipient_count") @db.UnsignedSmallInt
  attachmentCount   Int                 @default(0) @map("attachment_count") @db.UnsignedSmallInt
  /// S3 key of the raw EML (step 2.2 D8):
  /// `org/{organizationId}/eml/{yyyy}/{mm}/{dd}/{objectRef}.eml`, UTC date of the ingestion
  /// attempt, objectRef = first 32 hex characters of SHA-256 of
  /// `{mtaId}|{queueId}|{direction}|{organizationId}`. Consumers read it, never derive it.
  emlObjectKey      String              @map("eml_object_key") @db.VarChar(512)
  emlSha256         String              @map("eml_sha256") @db.Char(64)
  clientIp          String?             @map("client_ip") @db.VarChar(45)
  clientHelo        String?             @map("client_helo") @db.VarChar(255)
  /// Verified client host name from Postfix XFORWARD NAME (step 4.1 §3): Postfix's literal
  /// `unknown` is stored as `unknown`; `[UNAVAILABLE]`, `[TEMPUNAVAIL]` and a missing attribute
  /// are NULL. Trusted envelope data for the scan engines (§2.0 invariant 7).
  clientName        String?             @map("client_name") @db.VarChar(255)
  /// Postfix queue id; collation utf8mb4_bin (case-sensitive Postfix queue ids, step 3.3).
  mtaQueueId        String?             @map("mta_queue_id") @db.VarChar(32)
  finalVerdict      MessageVerdict?     @map("final_verdict")
  finalAction       MessageAction?      @map("final_action")
  /// 0–1000.
  riskScore         Int?                @map("risk_score") @db.UnsignedSmallInt
  createdAt         DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.DateTime(3)
  /// READ-ONLY, generated by MySQL (step 7.2 §3.1, ADR-0061): `GENERATED ALWAYS AS (IF(subject
  /// IS NULL, NULL, LEFT(<subject without leading reply/forward markers, whitespace runs
  /// collapsed, trimmed>, 128))) VIRTUAL`; the exact expression is in migration
  /// `email_explorer_search` and mirrored by `normalizeSubjectKey` of the api
  /// (`modules/messages/domain/search-keys.ts`). Case and accents are ignored by the column
  /// collation. Search key of the explorer's subject driver. Never write it.
  subjectKey        String?             @map("subject_key") @db.VarChar(128)
  /// READ-ONLY, generated by MySQL (step 7.2): `GENERATED ALWAYS AS (IF(LOCATE('@',
  /// envelope_from) = 0, NULL, LEFT(SUBSTRING_INDEX(envelope_from, '@', -1), 253))) VIRTUAL`:
  /// the domain of the envelope sender, NULL for the null sender. Never write it.
  senderDomain      String?             @map("sender_domain") @db.VarChar(253)
  /// READ-ONLY, generated by MySQL (step 7.2): `GENERATED ALWAYS AS (IF(internet_message_id IS
  /// NULL, NULL, LEFT(TRIM(TRAILING '>' FROM TRIM(LEADING '<' FROM TRIM(internet_message_id))),
  /// 255))) VIRTUAL`: the Message-ID without angle brackets. Never write it.
  messageIdKey      String?             @map("message_id_key") @db.VarChar(255)
  /// Step 8.6 (D3, D5, ADR-0087): `journal_intake` = a journal intake copy (status ends in
  /// `journaled`; details in `journal_intake_messages`). Step API-1 (ADR-0098): `mailbox_api` = a
  /// copy fetched from a provider mailbox feed (its per-mailbox record is `api_message_copies`).
  /// Every gateway-facing read filters `ingest_source = 'gateway'`.
  ingestSource      MessageIngestSource @default(gateway) @map("ingest_source")

  @@id([id, receivedAt])
  @@index([organizationId, receivedAt, id])
  @@index([status, statusChangedAt])
  /// Step 6.1 D5 plan 2: verdict-filtered message list.
  @@index([organizationId, finalVerdict, receivedAt, id], map: "email_messages_org_verdict_received_idx")
  /// Step 6.1 D12: index-only report counts (traffic, directions, and the threats outcomes by
  /// verdict and action; final_action since migration rest_api_index_coverage). Step 7.1 §3.2:
  /// domain_id appended (migration admin_portal_reports) so the top attacked domains report
  /// (inbound messages by domain and verdict) is index-only too. Step 8.6 (D5): rebuilt as
  /// `…_src_idx` with ingest_source appended (migration journal_intake), so the reports stay
  /// index-only with the `ingest_source = 'gateway'` predicate.
  @@index([organizationId, receivedAt, direction, finalVerdict, finalAction, domainId, ingestSource], map: "email_messages_org_received_dir_verdict_src_idx")
  /// Step 7.2 §3.1 (ADR-0061): driver indexes of the Email Explorer search (`GET /messages`),
  /// each read in keyset order (received_at, id) after an equality on its key.
  @@index([organizationId, envelopeFrom, receivedAt, id], map: "email_messages_org_envelope_from_received_idx")
  @@index([organizationId, headerFrom, receivedAt, id], map: "email_messages_org_header_from_received_idx")
  @@index([organizationId, senderDomain, receivedAt, id], map: "email_messages_org_sender_domain_received_idx")
  @@index([organizationId, subjectKey, receivedAt, id], map: "email_messages_org_subject_key_received_idx")
  @@index([organizationId, messageIdKey, receivedAt, id], map: "email_messages_org_message_id_key_received_idx")
  @@map("email_messages")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly. No foreign keys.
model EmailRecipient {
  id             BigInt            @default(autoincrement()) @db.UnsignedBigInt
  receivedAt     DateTime          @map("received_at") @db.DateTime(3)
  messageId      BigInt            @map("message_id") @db.UnsignedBigInt
  organizationId BigInt            @map("organization_id") @db.UnsignedBigInt
  rcptSeq        Int               @map("rcpt_seq") @db.UnsignedSmallInt
  address        String            @db.VarChar(320)
  userId         BigInt?           @map("user_id") @db.UnsignedBigInt
  status         RecipientStatus   @default(pending)
  finalAction    MessageAction?    @map("final_action")
  /// Routed direction (step 2.3 R1), classified at ingestion; NULL for rows ingested before
  /// step 2.3 (classified at planning).
  direction      MessageDirection?
  createdAt      DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.DateTime(3)
  /// READ-ONLY, generated by MySQL (step 7.2 §3.1): `GENERATED ALWAYS AS (IF(LOCATE('@',
  /// address) = 0, NULL, LEFT(SUBSTRING_INDEX(address, '@', -1), 253))) VIRTUAL`: the domain of
  /// the recipient address (the explorer's `recipientDomain` driver). Never write it.
  addressDomain  String?           @map("address_domain") @db.VarChar(253)

  @@id([id, receivedAt])
  @@unique([messageId, rcptSeq, receivedAt])
  @@index([organizationId, address(length: 100), receivedAt])
  /// Step 7.2 §3.1: the `recipientDomain` driver (grouped by message in keyset order).
  @@index([organizationId, addressDomain, receivedAt, messageId], map: "email_recipients_org_address_domain_received_idx")
  @@map("email_recipients")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly. Allow-list of security-relevant headers
/// only (values truncated); the full header block stays in the EML in S3. Values are stored
/// decoded and unparsed; the bec engine (step 4.4 B5) parses From, Sender, Reply-To,
/// Return-Path, In-Reply-To and References from them. No foreign keys.
model EmailHeader {
  id             BigInt   @default(autoincrement()) @db.UnsignedBigInt
  receivedAt     DateTime @map("received_at") @db.DateTime(3)
  messageId      BigInt   @map("message_id") @db.UnsignedBigInt
  organizationId BigInt   @map("organization_id") @db.UnsignedBigInt
  seq            Int      @db.UnsignedSmallInt
  name           String   @db.VarChar(128)
  value          String   @db.VarChar(2048)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@id([id, receivedAt])
  @@unique([messageId, seq, receivedAt])
  @@map("email_headers")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly. Metadata and an S3 key only, never
/// content. No foreign keys. The `dlp` engine (step 4.5 D4) reads the stored part through
/// `object_key` and extracts its text in memory only (in the isolated extractor child); no
/// extracted text is ever stored.
model EmailAttachment {
  id                  BigInt                 @default(autoincrement()) @db.UnsignedBigInt
  receivedAt          DateTime               @map("received_at") @db.DateTime(3)
  messageId           BigInt                 @map("message_id") @db.UnsignedBigInt
  organizationId      BigInt                 @map("organization_id") @db.UnsignedBigInt
  /// Index of the leaf in the parse structure (email_message_parses.structure, step 3.1 M9).
  partIndex           Int                    @map("part_index") @db.UnsignedSmallInt
  /// Unused, always NULL (step 4.2 A18: archive entries are not rows; they are findings of their
  /// attachment's attachment_scan_results row).
  parentPartIndex     Int?                   @map("parent_part_index") @db.UnsignedSmallInt
  /// Step 3.1 M9: MIME part path of the leaf (for example `1.2.1`); NULL for rows before 3.1.
  partPath            String?                @map("part_path") @db.VarChar(128)
  /// Step 3.1 M9: nesting depth of the leaf (0 = root).
  depth               Int?                   @db.UnsignedTinyInt
  /// Step 3.1 M9: `attachment` or `inline`.
  disposition         AttachmentDisposition?
  /// Sanitized display filename (step 3.1 M9 `sanitizeFilename`); NULL when empty.
  filename            String?                @db.VarChar(255)
  /// Step 3.1 M9: the decoded original filename with non-printable, bidi and zero-width code
  /// points and `\` written as `\u{XXXX}` escapes, ≤ 1024 characters. Escaped metadata only:
  /// never used as a path or an S3 key, never logged.
  originalFilename    String?                @map("original_filename") @db.VarChar(1024)
  declaredContentType String?                @map("declared_content_type") @db.VarChar(255)
  detectedContentType String?                @map("detected_content_type") @db.VarChar(255)
  /// Decoded size in bytes.
  sizeBytes           Int                    @map("size_bytes") @db.UnsignedInt
  /// Step 3.1 M9: transfer-encoded size in bytes as read from the EML.
  encodedSizeBytes    Int?                   @map("encoded_size_bytes") @db.UnsignedInt
  /// Hex SHA-256 of the decoded bytes.
  sha256              String                 @db.Char(64)
  /// `org/{organizationId}/part/{yyyy}/{mm}/{dd}/{messageId}/{partIndex}.att` (step 3.1 M11);
  /// NULL when the part was not stored (flag `not_stored_size_limit`).
  objectKey           String?                @map("object_key") @db.VarChar(512)
  /// Step 3.1 M9: JSON array of ATTACHMENT_FLAGS codes (`@email-gateway/mime-parser`), for
  /// the scanning steps (4.x). Codes only.
  flags               Json?
  /// Step 3.1 M10: archive metadata `{ type, inspected, entries, declaredUncompressedBytes,
  /// maxRatio, encryptedEntries, nestedArchives }`. Numbers and the type only, never entry
  /// names. NULL when the part is not an archive.
  archiveInfo         Json?                  @map("archive_info")
  /// Not written (step 4.2 A18: per-round results are in attachment_scan_results).
  verdict             AttachmentVerdict?
  createdAt           DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.DateTime(3)

  @@id([id, receivedAt])
  @@unique([messageId, partIndex, receivedAt])
  /// Hash lookups and the step 6.1 `GET /attachments?sha256=` keyset (received_at DESC, id DESC
  /// from the index, no filesort; received_at and id since migration rest_api_index_coverage).
  @@index([organizationId, sha256, receivedAt, id], map: "email_attachments_organization_id_sha256_idx")
  @@map("email_attachments")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly (6 months, core). Post-queue MIME parse
/// stage of one message (step 3.1, docs/plan/steps/06-mime-ingestion.md §3, M3, M13), written
/// by email-worker only. One row per message: inserted as `parsing` (M3.4), `attempts`
/// incremented per try, finalized once by a conditional update `WHERE status = 'parsing'`
/// (M3.9.1). `email_messages.status` is not changed by step 3.1 (step 3.3 owns it). Holds S3
/// keys, hashes, sizes, codes and counts only; never body bytes, filenames or header values.
/// No foreign keys.
model EmailMessageParse {
  id                BigInt             @default(autoincrement()) @db.UnsignedBigInt
  /// Copied from the message (one message's graph lives in one partition).
  receivedAt        DateTime           @map("received_at") @db.DateTime(3)
  messageId         BigInt             @map("message_id") @db.UnsignedBigInt
  organizationId    BigInt             @map("organization_id") @db.UnsignedBigInt
  /// `parsing` until finalized (M13); transitions none → parsing → final only.
  status            MessageParseStatus
  /// Parse attempts started (M3.4). An infrastructure error gives its attempt back; a crash
  /// does not, so `attempts > MIME_MAX_ATTEMPTS` is the poison-message guard.
  attempts          Int                @default(0) @db.UnsignedSmallInt
  /// `PARSER_VERSION` of `@email-gateway/mime-parser` that produced the row.
  parserVersion     String             @map("parser_version") @db.VarChar(32)
  /// Envelope id of the `mail.message.received.v1` event that started the parse.
  eventId           String?            @map("event_id") @db.Char(36)
  /// `parse_failed` reason (PARSE_FAILURE_REASONS of `@email-gateway/event-contracts`).
  failureReason     String?            @map("failure_reason") @db.VarChar(64)
  /// JSON array of MIME_LIMIT_NAMES that were exceeded.
  limitsExceeded    Json?              @map("limits_exceeded")
  /// JSON array of defect codes (M6, M7); codes only.
  defects           Json?
  partCount         Int?               @map("part_count") @db.UnsignedSmallInt
  attachmentCount   Int?               @map("attachment_count") @db.UnsignedSmallInt
  maxDepth          Int?               @map("max_depth") @db.UnsignedTinyInt
  /// Every field of the top-level header block (not only the stored ones).
  headerCount       Int?               @map("header_count") @db.UnsignedInt
  /// EML bytes read (must equal email_messages.size_bytes, M3.8).
  bytesRead         BigInt?            @map("bytes_read") @db.UnsignedBigInt
  /// Sum of transfer-decoded part bytes.
  decodedBytes      BigInt?            @map("decoded_bytes") @db.UnsignedBigInt
  /// `org/{organizationId}/part/{yyyy}/{mm}/{dd}/{messageId}/{partIndex}.text` (M11); NULL
  /// when there is no text body or it was not stored.
  textBodyObjectKey String?            @map("text_body_object_key") @db.VarChar(512)
  /// `…/{partIndex}.html` (M11); NULL when there is no HTML body or it was not stored.
  htmlBodyObjectKey String?            @map("html_body_object_key") @db.VarChar(512)
  /// Hex SHA-256 of the stored (decoded, UTF-8) body bytes.
  textBodySha256    String?            @map("text_body_sha256") @db.Char(64)
  htmlBodySha256    String?            @map("html_body_sha256") @db.Char(64)
  textBodySizeBytes Int?               @map("text_body_size_bytes") @db.UnsignedInt
  htmlBodySizeBytes Int?               @map("html_body_size_bytes") @db.UnsignedInt
  /// Declared charset of the body part (normalized).
  textBodyCharset   String?            @map("text_body_charset") @db.VarChar(64)
  htmlBodyCharset   String?            @map("html_body_charset") @db.VarChar(64)
  /// M13: one object per MIME node in document order (≤ MIME_MAX_PARTS); never filenames or
  /// header values.
  structure         Json?
  /// Start of the last attempt.
  startedAt         DateTime           @map("started_at") @db.DateTime(3)
  completedAt       DateTime?          @map("completed_at") @db.DateTime(3)
  durationMs        Int?               @map("duration_ms") @db.UnsignedInt
  createdAt         DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.DateTime(3)

  @@id([id, receivedAt])
  @@unique([messageId, receivedAt])
  @@index([organizationId, receivedAt, id])
  @@index([status, updatedAt])
  @@map("email_message_parses")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly. Append-only; idempotency comes from
/// processOnce. Long-term history lives in ClickHouse. No foreign keys.
model EmailEvent {
  id             BigInt    @default(autoincrement()) @db.UnsignedBigInt
  receivedAt     DateTime  @map("received_at") @db.DateTime(3)
  messageId      BigInt    @map("message_id") @db.UnsignedBigInt
  organizationId BigInt    @map("organization_id") @db.UnsignedBigInt
  eventType      String    @map("event_type") @db.VarChar(64)
  occurredAt     DateTime  @map("occurred_at") @db.DateTime(3)
  sourceService  String    @map("source_service") @db.VarChar(64)
  /// Originating envelope event id.
  eventId        String?   @map("event_id") @db.Char(36)
  actorType      ActorType @default(system) @map("actor_type")
  actorId        String?   @map("actor_id") @db.VarChar(64)
  details        Json?
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  @@id([id, receivedAt])
  @@index([messageId, receivedAt])
  @@map("email_events")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly. Append-only; one row per applied
/// lifecycle transition, written only through @email-gateway/message-lifecycle (step 3.3 L5).
/// Rows from before step 3.3 have actor_role/actor_service `legacy`. No foreign keys.
model EmailMessageStatusHistory {
  id             BigInt         @default(autoincrement()) @db.UnsignedBigInt
  receivedAt     DateTime       @map("received_at") @db.DateTime(3)
  messageId      BigInt         @map("message_id") @db.UnsignedBigInt
  organizationId BigInt         @map("organization_id") @db.UnsignedBigInt
  /// Message version after the transition.
  version        Int            @db.UnsignedInt
  fromStatus     MessageStatus? @map("from_status")
  toStatus       MessageStatus  @map("to_status")
  reasonCode     String?        @map("reason_code") @db.VarChar(64)
  /// Causing event id (envelope event id of the event that caused the transition).
  eventId        String?        @map("event_id") @db.Char(36)
  changedAt      DateTime       @map("changed_at") @db.DateTime(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  /// Lifecycle round after the transition.
  lifecycleRound Int            @default(0) @map("lifecycle_round") @db.UnsignedSmallInt
  /// ACTOR_ROLES value (ingestion, scanner, policy, …); `legacy` for pre-step-3.3 rows.
  actorRole      String         @default("legacy") @map("actor_role") @db.VarChar(32)
  /// Deployable that applied the transition (smtp-adapter, delivery-worker, api, event-relay).
  actorService   String         @default("legacy") @map("actor_service") @db.VarChar(64)
  actorType      ActorType      @default(system) @map("actor_type")
  /// Public id of the user or API key (operator actions); NULL for system actors.
  actorId        String?        @map("actor_id") @db.VarChar(64)
  correlationId  String?        @map("correlation_id") @db.VarChar(128)
  /// Hex SHA-256 of the transition key (idempotency, step 3.3 L5.3); NULL for legacy rows.
  transitionKey  String?        @map("transition_key") @db.Char(64)
  /// Event id of the mail.message.state_changed.v1 outbox row; NULL for creation and legacy rows.
  stateEventId   String?        @map("state_event_id") @db.Char(36)
  /// Producer-reported occurrence time (recorded, never compared).
  occurredAt     DateTime?      @map("occurred_at") @db.DateTime(3)

  @@id([id, receivedAt])
  @@unique([messageId, version, receivedAt])
  @@unique([messageId, transitionKey, receivedAt])
  @@map("email_message_status_history")
}

// ---------------------------------------------------------------------------------------------
// 3.5 Security
// ---------------------------------------------------------------------------------------------

/// PARTITIONED by RANGE COLUMNS(received_at), monthly. No foreign keys.
/// One row per scan round `(message_id, lifecycle_round, received_at)` (step 4.1 S3); old rounds'
/// rows are never updated or deleted by a newer round.
model EmailScan {
  id                   BigInt          @default(autoincrement()) @db.UnsignedBigInt
  receivedAt           DateTime        @map("received_at") @db.DateTime(3)
  messageId            BigInt          @map("message_id") @db.UnsignedBigInt
  organizationId       BigInt          @map("organization_id") @db.UnsignedBigInt
  scanKind             ScanKind        @default(initial) @map("scan_kind")
  /// Unused since step 4.1 (always 1): a round is identified by `lifecycle_round`; engine attempts
  /// are rows of scan_engine_results.
  attempt              Int             @default(1) @db.UnsignedSmallInt
  status               ScanStatus      @default(pending)
  /// Risk verdict of the round: written at round completion by the email-worker from the
  /// revision-0 risk score (message_risk_scores; step 5.1 R13). NULL while running and for rounds
  /// completed before step 5.1.
  verdict              MessageVerdict?
  /// Risk score 0-1000 of the round: written at round completion by the email-worker from the
  /// revision-0 risk score (step 5.1 R13).
  riskScore            Int?            @map("risk_score") @db.UnsignedSmallInt
  /// Scorer version of that score (`risk-score/1`): written at round completion by the
  /// email-worker from the revision-0 risk score (step 5.1 R13).
  scoringVersion       String?         @map("scoring_version") @db.VarChar(32)
  startedAt            DateTime?       @map("started_at") @db.DateTime(3)
  completedAt          DateTime?       @map("completed_at") @db.DateTime(3)
  createdAt            DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  /// email_messages.lifecycle_round of the round this row scans (step 4.1 S3).
  lifecycleRound       Int             @default(0) @map("lifecycle_round") @db.UnsignedSmallInt
  /// Aggregate verdict of the round (S6); NULL while running.
  scanVerdict          ScanVerdict?    @map("scan_verdict")
  /// JSON array of engine names required when the round opened (snapshot, S4).
  requiredEngines      Json?           @map("required_engines")
  /// JSON array of reason codes (≤ 32), set at completion (S6).
  reasonCodes          Json?           @map("reason_codes")
  /// Event id of the event that opened the round (parsed.v1 or rescan_requested.v1).
  triggerEventId       String?         @map("trigger_event_id") @db.Char(36)
  /// The deadline sweeper finalizes a round still running after this instant (S10).
  deadlineAt           DateTime?       @map("deadline_at") @db.DateTime(3)
  /// Snapshot of risk_scoring_profiles.active_version_id of the organization when the round
  /// opened (step 5.1 R13): the round is scored with this profile version even if the pointer
  /// changes later. NULL = the platform default profile. A risk_scoring_profile_versions.id; no
  /// foreign key (partitioned table).
  riskProfileVersionId BigInt?         @map("risk_profile_version_id") @db.UnsignedBigInt

  @@id([id, receivedAt])
  @@unique([messageId, lifecycleRound, receivedAt])
  @@index([status, deadlineAt])
  /// Step 7.1 §3.2: index-only processing report (initial rounds by status, time to verdict).
  @@index([organizationId, receivedAt, scanKind, status, completedAt], map: "email_scans_org_received_kind_status_idx")
  @@map("email_scans")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly. `evidence` holds variable engine
/// evidence. No foreign keys.
model ScanEngineResult {
  id              BigInt        @default(autoincrement()) @db.UnsignedBigInt
  receivedAt      DateTime      @map("received_at") @db.DateTime(3)
  scanId          BigInt        @map("scan_id") @db.UnsignedBigInt
  messageId       BigInt        @map("message_id") @db.UnsignedBigInt
  organizationId  BigInt        @map("organization_id") @db.UnsignedBigInt
  /// ENGINE_NAMES of @email-gateway/security-contracts: rspamd, attachment, url, bec, dlp,
  /// sandbox (step 4.2 A1: ClamAV and YARA are components of the `attachment` engine; step 4.3
  /// U1: `url` is written by the URL engine on scan.url; step 4.4 B1: `bec` is written by the
  /// phishing/BEC engine on scan.bec, a stage-2 engine that runs after `rspamd` and `url`; step
  /// 4.5 D1: `dlp` is written by the data loss prevention engine on scan.dlp, a stage-1 engine).
  engine          String        @db.VarChar(32)
  engineVersion   String?       @map("engine_version") @db.VarChar(64)
  outcome         EngineOutcome
  score           Decimal?      @db.Decimal(8, 3)
  durationMs      Int           @map("duration_ms") @db.UnsignedInt
  /// `{ signals[], auth?, rcptTruncated? }` (step 4.1 S9): scores, symbol names and bounded
  /// symbol options; never message content.
  evidence        Json?
  completedAt     DateTime      @map("completed_at") @db.DateTime(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  /// 1-based attempt of this engine in the round (step 4.1 S5).
  attempt         Int           @default(1) @db.UnsignedSmallInt
  /// True for the one final result per (scan, engine); false for a failed attempt that was
  /// retried (outcome `timeout` or `error` only).
  isFinal         Boolean       @default(true) @map("is_final")
  /// READ-ONLY, generated by MySQL: `GENERATED ALWAYS AS (IF(is_final = 1, engine, NULL))
  /// VIRTUAL`. Its unique key (scan_id, final_engine, received_at) allows at most one final row
  /// per engine and round (NULLs are distinct). Never write it.
  finalEngine     String?       @map("final_engine") @db.VarChar(32)
  requiredScore   Decimal?      @map("required_score") @db.Decimal(8, 3)
  /// Engine action (Rspamd: `no action`, `reject`, ...), informational.
  action          String?       @db.VarChar(32)
  /// JSON array of reason codes (≤ 32).
  reasonCodes     Json?         @map("reason_codes")
  /// Failure code of a timeout/error row (e.g. `eml_unavailable`, `deadline_exceeded`).
  errorCode       String?       @map("error_code") @db.VarChar(64)
  /// `<mapping version>;p=<platform hash>;t=<row version | none>` (S8).
  settingsVersion String?       @map("settings_version") @db.VarChar(96)

  @@id([id, receivedAt])
  @@unique([scanId, engine, attempt, receivedAt])
  @@unique([scanId, finalEngine, receivedAt])
  @@map("scan_engine_results")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly (step 4.1 §3). Authentication results of a
/// scan round as reported by an engine (Rspamd: SPF, DKIM, DMARC, ARC). No foreign keys.
model EmailAuthResult {
  id             BigInt       @default(autoincrement()) @db.UnsignedBigInt
  receivedAt     DateTime     @map("received_at") @db.DateTime(3)
  messageId      BigInt       @map("message_id") @db.UnsignedBigInt
  organizationId BigInt       @map("organization_id") @db.UnsignedBigInt
  scanId         BigInt       @map("scan_id") @db.UnsignedBigInt
  engine         String       @db.VarChar(32)
  spf            AuthOutcome?
  spfDomain      String?      @map("spf_domain") @db.VarChar(253)
  dkim           AuthOutcome?
  /// JSON array (≤ 10) of `{ domain, result, selector }`.
  dkimSignatures Json?        @map("dkim_signatures")
  dmarc          AuthOutcome?
  dmarcPolicy    DmarcPolicy? @map("dmarc_policy")
  dmarcDomain    String?      @map("dmarc_domain") @db.VarChar(253)
  arc            AuthOutcome?
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)

  @@id([id, receivedAt])
  @@unique([scanId, engine, receivedAt])
  @@map("email_auth_results")
}

/// Per-tenant overrides of a scan engine's platform settings (step 4.1 S8). `settings` is
/// validated by the engine's tenant schema of @email-gateway/security-contracts on write and
/// again at use. `version` is the compare-and-set counter of the settings API.
model ScanEngineSetting {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId  BigInt   @map("organization_id") @db.UnsignedBigInt
  engine          String   @db.VarChar(32)
  settings        Json
  version         Int      @default(1) @db.UnsignedInt
  updatedByUserId BigInt?  @map("updated_by_user_id") @db.UnsignedBigInt
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  updatedBy    User?        @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, engine])
  @@map("scan_engine_settings")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly (6 months, core; step 4.2 §3, A18). One row
/// per attachment per scan round with a definite final result of the `attachment` engine,
/// written only in that final row's finalize transaction (unique per (scan, attachment)). Hashes,
/// sizes, type ids, signature and rule names, counts and codes only: never file content, never a
/// filename, never an archive entry name (entries are index paths). No foreign keys.
model AttachmentScanResult {
  id                  BigInt                @default(autoincrement()) @db.UnsignedBigInt
  receivedAt          DateTime              @map("received_at") @db.DateTime(3)
  messageId           BigInt                @map("message_id") @db.UnsignedBigInt
  organizationId      BigInt                @map("organization_id") @db.UnsignedBigInt
  /// email_scans.id of the round.
  scanId              BigInt                @map("scan_id") @db.UnsignedBigInt
  /// email_attachments.id of the scanned attachment.
  attachmentId        BigInt                @map("attachment_id") @db.UnsignedBigInt
  partIndex           Int                   @map("part_index") @db.UnsignedSmallInt
  /// Hex SHA-256 of the decoded attachment bytes.
  sha256              String                @db.Char(64)
  sizeBytes           Int                   @map("size_bytes") @db.UnsignedInt
  /// FILE_TYPES id of the detected type (A5).
  detectedType        String                @map("detected_type") @db.VarChar(32)
  /// FILE_TYPES family of the detected type (A5).
  typeFamily          String                @map("type_family") @db.VarChar(16)
  typeMismatch        Boolean               @map("type_mismatch")
  verdict             AttachmentScanVerdict
  /// JSON array (≤ 32) of ATTACHMENT_REASON_CODES.
  reasonCodes         Json                  @map("reason_codes")
  /// ClamAV signature name when ClamAV reported FOUND; NULL when clean or not scanned.
  clamavSignature     String?               @map("clamav_signature") @db.VarChar(128)
  clamavEngineVersion String?               @map("clamav_engine_version") @db.VarChar(32)
  clamavDbVersion     Int?                  @map("clamav_db_version") @db.UnsignedInt
  yaraBundleId        String?               @map("yara_bundle_id") @db.VarChar(48)
  /// JSON array (≤ 32) of `{ rule, severity, scope }`; rule names only, never matched strings.
  yaraMatches         Json?                 @map("yara_matches")
  /// `{ format, supported, entries, depthReached, decompressedBytes, maxRatio, encrypted,
  /// findings[≤ 20] { path, type, reasonCodes } }` (A16); index paths, never entry names.
  archive             Json?
  /// Most severe malware_signatures hit of the attachment or an archive entry.
  knownHashSeverity   Severity?             @map("known_hash_severity")
  cacheResult         AttachmentCacheResult @map("cache_result")
  /// Content version of the cache key (A9); NULL when the content was not scanned.
  contentVersion      String?               @map("content_version") @db.Char(16)
  durationMs          Int                   @map("duration_ms") @db.UnsignedInt
  createdAt           DateTime              @default(now()) @map("created_at") @db.DateTime(3)

  @@id([id, receivedAt])
  @@unique([scanId, attachmentId, receivedAt])
  @@index([organizationId, sha256])
  @@index([messageId, receivedAt])
  @@map("attachment_scan_results")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly (6 months, core; step 4.2 §3, A11). One row
/// per attachment of a round submitted to the sandbox, written in the attachment engine's
/// finalize transaction together with the `mail.attachment.sandbox_requested.v1` outbox row. The
/// part is referenced by its S3 key only. Step 4.6 (§3, X13, X15): the sandbox engine of the
/// email-worker links the row to a content-addressed `sandbox_analyses` row (`analysis_id`, no
/// foreign key: partitioned) and completes it (`external_ref` = the analysis public id,
/// `sandbox_verdict`, `sandbox_reason_codes`, `completed_at`) or skips it (`skip_reason`). No
/// foreign keys.
model SandboxSubmission {
  id                 BigInt                   @default(autoincrement()) @db.UnsignedBigInt
  receivedAt         DateTime                 @map("received_at") @db.DateTime(3)
  messageId          BigInt                   @map("message_id") @db.UnsignedBigInt
  organizationId     BigInt                   @map("organization_id") @db.UnsignedBigInt
  scanId             BigInt                   @map("scan_id") @db.UnsignedBigInt
  attachmentId       BigInt                   @map("attachment_id") @db.UnsignedBigInt
  partIndex          Int                      @map("part_index") @db.UnsignedSmallInt
  sha256             String                   @db.Char(64)
  sizeBytes          Int                      @map("size_bytes") @db.UnsignedInt
  detectedType       String                   @map("detected_type") @db.VarChar(32)
  /// `org/{organizationId}/part/…` (email_attachments.object_key of the attachment).
  objectKey          String                   @map("object_key") @db.VarChar(512)
  attachmentVerdict  SandboxAttachmentVerdict @map("attachment_verdict")
  /// JSON array (≤ 16) of ATTACHMENT_REASON_CODES.
  reasonCodes        Json                     @map("reason_codes")
  status             SandboxSubmissionStatus  @default(pending)
  /// Envelope event id of the sandbox_requested.v1 outbox row.
  requestedEventId   String                   @map("requested_event_id") @db.Char(36)
  /// Step 4.6: the public id (UUIDv7) of the linked `sandbox_analyses` row, set on completion.
  externalRef        String?                  @map("external_ref") @db.VarChar(128)
  /// Step 4.6: a `SANDBOX_VERDICTS` value of the linked analysis, or NULL (pending, skipped).
  sandboxVerdict     String?                  @map("sandbox_verdict") @db.VarChar(16)
  /// Step 4.6: the terminal time (completed, failed, expired, skipped).
  completedAt        DateTime?                @map("completed_at") @db.DateTime(3)
  /// Step 4.6 X13: `sandbox_analyses.id` once linked (no foreign key: partitioned table).
  analysisId         BigInt?                  @map("analysis_id") @db.UnsignedBigInt
  /// Step 4.6: a `SANDBOX_SKIP_REASONS` value when `status = skipped`.
  skipReason         String?                  @map("skip_reason") @db.VarChar(48)
  /// Step 4.6: JSON array (≤ 16) of `SANDBOX_REASON_CODES` of the submission's outcome.
  sandboxReasonCodes Json?                    @map("sandbox_reason_codes")
  /// Step 4.6 X14: `settings_version` of the dispatch-time `resolveSandboxSettings` resolution.
  settingsVersion    String?                  @map("settings_version") @db.VarChar(96)
  createdAt          DateTime                 @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.DateTime(3)

  @@id([id, receivedAt])
  @@unique([scanId, attachmentId, receivedAt])
  @@index([status, createdAt])
  @@index([sha256])
  @@index([analysisId])
  @@map("sandbox_submissions")
}

/// One sandbox analysis of one sample (step 4.6 §3, X13): platform-level and content-addressed
/// (`dedupe_key` = `<sha256>:<analysis_key>`; NULL once superseded, failed or expired, so a new
/// analysis can take the key). Tenants reach it only through their `sandbox_submissions`;
/// `organization_id` is the dispatching organization (routing of the task and result only). The
/// sample lives sealed in the sandbox bucket (`sample_object_key`, deleted after the result);
/// `report` is the bounded `sandboxReportViewSchema` (codes, counts, hosts, hashes; never
/// content). Not partitioned; retention by the sandbox sweeper (X16, `expires_at`).
model SandboxAnalysis {
  id                BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  /// UUIDv7; the task id of `mail.sandbox.task_requested.v1` / `task_completed.v1`.
  publicId          String                @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  sha256            String                @db.Char(64)
  sizeBytes         Int                   @map("size_bytes") @db.UnsignedInt
  detectedType      String                @map("detected_type") @db.VarChar(32)
  profile           SandboxProfile
  /// First 16 hex of SHA-256 over { profile, limits, epoch, map } (`analysisKey`, X13).
  analysisKey       String                @map("analysis_key") @db.Char(16)
  /// `<sha256>:<analysis_key>`; NULL when superseded or failed (many NULLs allowed).
  dedupeKey         String?               @unique @map("dedupe_key") @db.VarChar(81)
  status            SandboxAnalysisStatus @default(pending)
  /// The dispatching organization (task/result routing only; not an owner of the result).
  organizationId    BigInt                @map("organization_id") @db.UnsignedBigInt
  /// `samples/<yyyy>/<mm>/<taskId>.bin` in the sandbox bucket (`sandbox-sample/1`).
  sampleObjectKey   String?               @map("sample_object_key") @db.VarChar(512)
  sampleDeletedAt   DateTime?             @map("sample_deleted_at") @db.DateTime(3)
  /// Envelope event id of the task_requested.v1 outbox row.
  requestedEventId  String?               @map("requested_event_id") @db.Char(36)
  /// Envelope event id of the applied task_completed.v1.
  resultEventId     String?               @map("result_event_id") @db.Char(36)
  dispatchedAt      DateTime?             @map("dispatched_at") @db.DateTime(3)
  /// SHA-256 (hex) of the task's one-time result token (X11), set when the task is dispatched;
  /// the token itself travels only sealed in the task. A result is accepted only with a MAC
  /// keyed to it.
  resultTokenSha256 String?               @map("result_token_sha256") @db.Char(64)
  /// After this instant a pending/dispatched analysis expires (verdict `timeout`).
  deadlineAt        DateTime              @map("deadline_at") @db.DateTime(3)
  completedAt       DateTime?             @map("completed_at") @db.DateTime(3)
  verdict           SandboxVerdict?
  /// JSON array (≤ 16) of `SANDBOX_REASON_CODES`.
  reasonCodes       Json?                 @map("reason_codes")
  /// The bounded `sandboxReportViewSchema` (no content).
  report            Json?
  /// A `SANDBOX_BACKENDS` value.
  backend           String?               @db.VarChar(32)
  backendVersion    String?               @map("backend_version") @db.VarChar(64)
  /// A `SANDBOX_ISOLATION_CLASSES` value (`container` is NOT a VM boundary).
  isolation         String?               @db.VarChar(16)
  executed          Boolean?
  controllerVersion String?               @map("controller_version") @db.VarChar(64)
  analyzerVersion   String?               @map("analyzer_version") @db.VarChar(64)
  /// `sandbox-map/1`.
  mapVersion        String?               @map("map_version") @db.VarChar(16)
  /// A `SANDBOX_NOT_EXECUTED_REASONS` value.
  notExecutedReason String?               @map("not_executed_reason") @db.VarChar(48)
  /// A `SANDBOX_ERROR_CODES` value.
  errorCode         String?               @map("error_code") @db.VarChar(48)
  durationMs        Int?                  @map("duration_ms") @db.UnsignedInt
  /// A terminal analysis is reused for the same dedupe key until then (NULL: never).
  reuseUntil        DateTime?             @map("reuse_until") @db.DateTime(3)
  /// The sweeper deletes the row (after its artifacts) from then on.
  expiresAt         DateTime              @map("expires_at") @db.DateTime(3)
  createdAt         DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.DateTime(3)

  artifacts SandboxArtifact[]

  @@index([status, deadlineAt])
  @@index([sha256])
  @@index([expiresAt])
  @@index([sampleDeletedAt, status])
  @@map("sandbox_analyses")
}

/// One sealed artifact of a sandbox analysis (step 4.6 §3, X12): the object lives in the sandbox
/// bucket (`artifacts/<yyyy>/<mm>/<taskId>/<seq>-<kind>.bin`, `sandbox-artifact/1`); its data key
/// is wrapped to the artifact X25519 public key (`wrapped_key`, NULL after the purge:
/// crypto-shredding first, then the object delete). Not partitioned; foreign key to the analysis
/// ON DELETE RESTRICT (the sweeper deletes artifacts first).
model SandboxArtifact {
  id              BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  analysisId      BigInt              @map("analysis_id") @db.UnsignedBigInt
  /// 0..15 within the analysis.
  seq             Int                 @db.UnsignedSmallInt
  kind            SandboxArtifactKind
  /// An `ARTIFACT_CONTENT_TYPES` value.
  contentType     String              @map("content_type") @db.VarChar(64)
  objectKey       String              @map("object_key") @db.VarChar(512)
  /// Hex SHA-256 of the sealed object.
  objectSha256    String              @map("object_sha256") @db.Char(64)
  /// Hex SHA-256 of the plaintext artifact.
  plainSha256     String              @map("plain_sha256") @db.Char(64)
  sizeBytes       Int                 @map("size_bytes") @db.UnsignedInt
  /// `x1.<kid>.<ephemeralPub>.<iv>.<tag>.<ct>`; NULL = crypto-shredded.
  wrappedKey      String?             @map("wrapped_key") @db.VarChar(256)
  keyId           String              @map("key_id") @db.VarChar(16)
  /// `sandbox-artifact/1`.
  algorithm       String              @db.VarChar(32)
  expiresAt       DateTime            @map("expires_at") @db.DateTime(3)
  purgedAt        DateTime?           @map("purged_at") @db.DateTime(3)
  /// E.g. `retention`.
  purgeReason     String?             @map("purge_reason") @db.VarChar(32)
  objectDeletedAt DateTime?           @map("object_deleted_at") @db.DateTime(3)
  createdAt       DateTime            @default(now()) @map("created_at") @db.DateTime(3)

  analysis SandboxAnalysis @relation(fields: [analysisId], references: [id], onDelete: Restrict)

  @@unique([analysisId, seq])
  @@index([expiresAt, purgedAt])
  @@map("sandbox_artifacts")
}

/// Bulk attachment rescan jobs (step 4.2 A13): written by the api (`admin`) or the signature
/// watcher (`signature_update`), executed by the email-worker's rescan runner through lifecycle
/// edge E19 (role scanner, reason signature_rescan). `organization_id` NULL = every organization.
/// `dedupe_key` (`sig:<component>:<version>`) makes the fleet create one job per signature change.
model AttachmentRescanJob {
  id                BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  publicId          String                  @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  trigger           AttachmentRescanTrigger
  status            AttachmentRescanStatus  @default(pending)
  dedupeKey         String?                 @unique @map("dedupe_key") @db.VarChar(128)
  organizationId    BigInt?                 @map("organization_id") @db.UnsignedBigInt
  windowStart       DateTime                @map("window_start") @db.DateTime(3)
  windowEnd         DateTime                @map("window_end") @db.DateTime(3)
  /// JSON array of message states the job selects (A13).
  states            Json
  /// Signature component of a `signature_update` job (`clamav_db`, `clamav_engine`, `yara_bundle`).
  component         String?                 @db.VarChar(32)
  fromVersion       String?                 @map("from_version") @db.VarChar(128)
  toVersion         String?                 @map("to_version") @db.VarChar(128)
  maxMessages       Int                     @map("max_messages") @db.UnsignedInt
  /// Keyset cursor `(received_at, message id)` of the last processed candidate.
  cursorReceivedAt  DateTime?               @map("cursor_received_at") @db.DateTime(3)
  cursorMessageId   BigInt?                 @map("cursor_message_id") @db.UnsignedBigInt
  selectedCount     Int                     @default(0) @map("selected_count") @db.UnsignedInt
  requestedCount    Int                     @default(0) @map("requested_count") @db.UnsignedInt
  skippedCount      Int                     @default(0) @map("skipped_count") @db.UnsignedInt
  requestedByUserId BigInt?                 @map("requested_by_user_id") @db.UnsignedBigInt
  reason            String?                 @db.VarChar(512)
  /// Error code or bounded message of a failed job; never content.
  lastError         String?                 @map("last_error") @db.VarChar(512)
  startedAt         DateTime?               @map("started_at") @db.DateTime(3)
  completedAt       DateTime?               @map("completed_at") @db.DateTime(3)
  createdAt         DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime                @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  requestedBy  User?         @relation(fields: [requestedByUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("attachment_rescan_jobs")
}

/// Versions of a scan engine's signature components seen by the signature watcher (step 4.2
/// A13): engine `attachment`, component `clamav_db`, `clamav_engine` or `yara_bundle`. Platform
/// catalog (no tenant data).
model ScanSignatureVersion {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  engine      String   @db.VarChar(32)
  component   String   @db.VarChar(32)
  version     String   @db.VarChar(128)
  firstSeenAt DateTime @map("first_seen_at") @db.DateTime(3)
  lastSeenAt  DateTime @map("last_seen_at") @db.DateTime(3)

  @@unique([engine, component, version])
  @@index([engine, component, firstSeenAt])
  @@map("scan_signature_versions")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly (6 months, core; step 4.3 §3, U3, U16).
/// One row per unique URL of a message (identity form, U5), written by the `url` engine in the
/// finalize transaction of a definite final result (`createMany … skipDuplicates`; a rescan keeps
/// the `url_seq` of a URL already stored). `url` is the redirect form (no userinfo, with the
/// fragment) and the only copy of the URL the click-service redirects to; never anchor text, page
/// content or HTML. No foreign keys.
model MessageUrl {
  id                  BigInt      @default(autoincrement()) @db.UnsignedBigInt
  receivedAt          DateTime    @map("received_at") @db.DateTime(3)
  messageId           BigInt      @map("message_id") @db.UnsignedBigInt
  organizationId      BigInt      @map("organization_id") @db.UnsignedBigInt
  /// Per-message sequence (0-based, stable across rounds); part of the click token (U12).
  urlSeq              Int         @map("url_seq") @db.UnsignedSmallInt
  /// Redirect form (U5); the first 2 048 characters when `truncated`.
  url                 String      @db.VarChar(2048)
  /// Hex SHA-256 of the identity form (no userinfo, no fragment) of the full URL.
  urlSha256           String      @map("url_sha256") @db.Char(64)
  /// `http` or `https`.
  scheme              String      @db.VarChar(8)
  /// ASCII host (A-labels; canonical IPv4/IPv6 text for IP hosts).
  host                String      @db.VarChar(253)
  /// U-label form of an IDN host; NULL when it equals `host`.
  unicodeHost         String?     @map("unicode_host") @db.VarChar(253)
  /// Registrable domain (tldts, private suffixes included); NULL for IP hosts.
  registrableDomain   String?     @map("registrable_domain") @db.VarChar(253)
  hostKind            UrlHostKind @map("host_kind")
  /// Non-default port; NULL for the scheme's default port.
  port                Int?        @db.UnsignedSmallInt
  /// True when the normalized URL was longer than 2 048 characters (never rewritten or fetched).
  truncated           Boolean     @default(false)
  /// JSON array of extraction reason codes (URL_REASON_CODES), e.g. `url.userinfo`.
  flags               Json?
  /// `{ <source>: count }` (sources of U18: text, html_href, html_src, form_action,
  /// meta_refresh, srcset, attachment).
  sources             Json
  occurrences         Int         @db.UnsignedSmallInt
  /// Lifecycle round of the scan that first stored the URL.
  firstLifecycleRound Int         @map("first_lifecycle_round") @db.UnsignedSmallInt
  /// `url-extract/<n>`.
  extractorVersion    String      @map("extractor_version") @db.VarChar(16)
  createdAt           DateTime    @default(now()) @map("created_at") @db.DateTime(3)

  @@id([id, receivedAt])
  @@unique([messageId, urlSeq, receivedAt])
  @@unique([messageId, urlSha256, receivedAt])
  @@index([organizationId, urlSha256])
  @@index([organizationId, registrableDomain(length: 100)])
  @@map("message_urls")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly (6 months, core; step 4.3 §3, U10, U16).
/// One row per URL per scan round with a definite final result of the `url` engine, written in
/// that final row's finalize transaction. Codes, provider answers, hosts and counts only: never
/// page bodies, titles or HTML. No foreign keys.
model UrlScanResult {
  id               BigInt         @default(autoincrement()) @db.UnsignedBigInt
  receivedAt       DateTime       @map("received_at") @db.DateTime(3)
  messageId        BigInt         @map("message_id") @db.UnsignedBigInt
  organizationId   BigInt         @map("organization_id") @db.UnsignedBigInt
  /// email_scans.id of the round.
  scanId           BigInt         @map("scan_id") @db.UnsignedBigInt
  /// message_urls.url_seq of the URL.
  urlSeq           Int            @map("url_seq") @db.UnsignedSmallInt
  urlSha256        String         @map("url_sha256") @db.Char(64)
  verdict          UrlVerdict
  /// JSON array (≤ 32) of URL_REASON_CODES.
  reasonCodes      Json           @map("reason_codes")
  /// JSON array (≤ 12) of `{ provider, version, kind, status, category, severity, cache }`;
  /// `cache` is never returned to tenants (U16).
  reputation       Json
  /// JSON array (≤ 5) of `{ rule, targetKind, targetDomain, score, distance }` (U7).
  lookalike        Json?
  fetchStatus      UrlFetchStatus @map("fetch_status")
  /// Fetcher error token (U8) when `fetch_status` is `error`.
  fetchError       String?        @map("fetch_error") @db.VarChar(32)
  hopCount         Int            @default(0) @map("hop_count") @db.UnsignedTinyInt
  /// JSON array (≤ 10) of `{ host, port, status, kind, blocked }`; hosts only, no paths.
  redirectChain    Json?          @map("redirect_chain")
  /// Final URL of the redirect chain (redirect form, ≤ 2 048 characters).
  finalUrl         String?        @map("final_url") @db.VarChar(2048)
  finalUrlSha256   String?        @map("final_url_sha256") @db.Char(64)
  finalHost        String?        @map("final_host") @db.VarChar(253)
  finalStatus      Int?           @map("final_status") @db.UnsignedSmallInt
  /// `{ passwordFields, forms, crossOriginFormAction, formActionHosts, titleBrandMatches }`
  /// (U9); counts, booleans, hosts and brand ids only.
  landing          Json?
  rewritten        Boolean
  dynamicRequested Boolean        @map("dynamic_requested")
  /// Chain cache result of the fetch (never returned to tenants).
  fetchCache       UrlFetchCache  @map("fetch_cache")
  durationMs       Int            @map("duration_ms") @db.UnsignedInt
  createdAt        DateTime       @default(now()) @map("created_at") @db.DateTime(3)

  @@id([id, receivedAt])
  @@unique([scanId, urlSeq, receivedAt])
  @@index([messageId, receivedAt])
  @@index([organizationId, urlSha256])
  @@map("url_scan_results")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly (6 months, core; step 4.3 §3, U11). One
/// row per scan round of the `url` engine: the rewritten copy of the EML (`org/<org>/rewrite/…`,
/// S3 reference only) or why the round was not rewritten (REWRITE_SKIP_REASONS). The original
/// EML is never modified. No foreign keys.
model UrlRewrite {
  id              BigInt           @default(autoincrement()) @db.UnsignedBigInt
  receivedAt      DateTime         @map("received_at") @db.DateTime(3)
  messageId       BigInt           @map("message_id") @db.UnsignedBigInt
  organizationId  BigInt           @map("organization_id") @db.UnsignedBigInt
  scanId          BigInt           @map("scan_id") @db.UnsignedBigInt
  lifecycleRound  Int              @map("lifecycle_round") @db.UnsignedSmallInt
  status          UrlRewriteStatus
  /// REWRITE_SKIP_REASONS when `status = skipped`.
  skipReason      String?          @map("skip_reason") @db.VarChar(32)
  /// `org/{organizationId}/rewrite/yyyy/mm/dd/{messageId}/r{round}-{uuid}.eml` when rewritten.
  objectKey       String?          @map("object_key") @db.VarChar(512)
  objectSha256    String?          @map("object_sha256") @db.Char(64)
  objectSizeBytes Int?             @map("object_size_bytes") @db.UnsignedInt
  linksRewritten  Int              @default(0) @map("links_rewritten") @db.UnsignedSmallInt
  linksUnmapped   Int              @default(0) @map("links_unmapped") @db.UnsignedSmallInt
  partsRewritten  Int              @default(0) @map("parts_rewritten") @db.UnsignedTinyInt
  partsSkipped    Int              @default(0) @map("parts_skipped") @db.UnsignedTinyInt
  /// True when the message carried a DKIM-Signature header (the rewrite breaks it downstream).
  dkimSigned      Boolean          @default(false) @map("dkim_signed")
  /// Key id of the click tokens (U12).
  tokenKid        Int?             @map("token_kid") @db.UnsignedTinyInt
  /// Expiry of the click tokens of this copy.
  expiresAt       DateTime?        @map("expires_at") @db.DateTime(3)
  settingsVersion String           @map("settings_version") @db.VarChar(96)
  createdAt       DateTime         @default(now()) @map("created_at") @db.DateTime(3)

  @@id([id, receivedAt])
  @@unique([scanId, receivedAt])
  @@index([messageId, lifecycleRound, receivedAt])
  @@map("url_rewrites")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly (6 months, core; step 4.3 §3, U15). One
/// row per URL of a round sent to the isolated browser worker, written in the `url` engine's
/// finalize transaction together with the `mail.url.inspection_requested.v1` outbox row; updated
/// from `pending` by the results consumer (or `expired` by the sweeper). Signals are counts,
/// booleans, hosts and brand ids only. No foreign keys.
model UrlDynamicInspection {
  id               BigInt              @default(autoincrement()) @db.UnsignedBigInt
  receivedAt       DateTime            @map("received_at") @db.DateTime(3)
  messageId        BigInt              @map("message_id") @db.UnsignedBigInt
  organizationId   BigInt              @map("organization_id") @db.UnsignedBigInt
  scanId           BigInt              @map("scan_id") @db.UnsignedBigInt
  urlSeq           Int                 @map("url_seq") @db.UnsignedSmallInt
  urlSha256        String              @map("url_sha256") @db.Char(64)
  status           UrlInspectionStatus @default(pending)
  /// Envelope event id of the inspection_requested.v1 outbox row.
  requestedEventId String              @map("requested_event_id") @db.Char(36)
  verdict          UrlVerdict?
  /// JSON array (≤ 16) of URL_REASON_CODES.
  reasonCodes      Json?               @map("reason_codes")
  /// The `signals` object of mail.url.inspection_completed.v1 plus the navigation hosts.
  signals          Json?
  finalUrlSha256   String?             @map("final_url_sha256") @db.Char(64)
  finalHost        String?             @map("final_host") @db.VarChar(253)
  workerVersion    String?             @map("worker_version") @db.VarChar(64)
  errorCode        String?             @map("error_code") @db.VarChar(32)
  completedAt      DateTime?           @map("completed_at") @db.DateTime(3)
  createdAt        DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.DateTime(3)

  @@id([id, receivedAt])
  @@unique([scanId, urlSeq, receivedAt])
  @@index([status, createdAt])
  @@index([organizationId, urlSha256])
  @@map("url_dynamic_inspections")
}

/// PARTITIONED by RANGE COLUMNS(clicked_at), monthly (6 months, core; step 4.3 §3, U14). One row
/// per decided click of a rewritten link, written by the click-service (account gateway_click)
/// together with the `mail.url.clicked.v1` outbox row. No URL, no user agent, no user identity;
/// the client address only as a truncated network. No foreign keys.
model UrlClickEvent {
  id                BigInt           @default(autoincrement()) @db.UnsignedBigInt
  clickedAt         DateTime         @map("clicked_at") @db.DateTime(3)
  /// UUIDv7; the `clickId` of the event and the reference id shown on pages.
  publicId          String           @map("public_id") @db.Char(36)
  organizationId    BigInt           @map("organization_id") @db.UnsignedBigInt
  messageId         BigInt           @map("message_id") @db.UnsignedBigInt
  /// received_at of the message (partition key of message_urls).
  messageReceivedAt DateTime         @map("message_received_at") @db.DateTime(3)
  urlSeq            Int              @map("url_seq") @db.UnsignedSmallInt
  decision          UrlClickDecision
  verdict           UrlVerdict?
  /// JSON array (≤ 16) of URL_REASON_CODES.
  reasonCodes       Json?            @map("reason_codes")
  /// `{ reputation, chain, dynamic }` (U14).
  recheck           Json?
  tokenKid          Int              @map("token_kid") @db.UnsignedTinyInt
  /// `/24` IPv4 or `/48` IPv6 network of the client (CLICK_STORE_CLIENT_NETWORK); else NULL.
  clientNetwork     String?          @map("client_network") @db.VarChar(49)
  durationMs        Int              @map("duration_ms") @db.UnsignedInt
  createdAt         DateTime         @default(now()) @map("created_at") @db.DateTime(3)

  @@id([id, clickedAt])
  @@index([organizationId, clickedAt])
  @@index([messageId, messageReceivedAt])
  @@index([publicId])
  @@map("url_click_events")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly (6 months, core; step 4.4 §3, B14). One row
/// per scan round with a definite final result of the `bec` engine, written in that final row's
/// finalize transaction (unique per scan). Codes, weights, scores, versions, input states, span
/// offsets and the parsed sender identity (the tenant's own header metadata, already in
/// `email_headers`) only: never body text, span text, excerpts or LLM output text. No foreign keys.
model BecScanResult {
  id                   BigInt     @default(autoincrement()) @db.UnsignedBigInt
  receivedAt           DateTime   @map("received_at") @db.DateTime(3)
  messageId            BigInt     @map("message_id") @db.UnsignedBigInt
  organizationId       BigInt     @map("organization_id") @db.UnsignedBigInt
  /// email_scans.id of the round.
  scanId               BigInt     @map("scan_id") @db.UnsignedBigInt
  lifecycleRound       Int        @map("lifecycle_round") @db.UnsignedSmallInt
  /// `bec/1;lex=<8 hex>;fm=<8 hex>;br=<8 hex>` (B16).
  engineVersion        String     @map("engine_version") @db.VarChar(64)
  /// `bec-map/1` (B6).
  rulesVersion         String     @map("rules_version") @db.VarChar(16)
  /// `bec-map/1;p=<12 hex>;t=<row version | none>` (B13).
  settingsVersion      String     @map("settings_version") @db.VarChar(96)
  lexiconVersion       String     @map("lexicon_version") @db.VarChar(16)
  /// `bec-text/1` (B8).
  textVersion          String     @map("text_version") @db.VarChar(16)
  /// 0–100, before the AI layer (B9).
  deterministicScore   Int        @map("deterministic_score") @db.UnsignedTinyInt
  /// 0–100, after the AI layer (equal to deterministic_score unless B9 rule 2 or 4 applied).
  score                Int        @db.UnsignedTinyInt
  deterministicVerdict BecVerdict @map("deterministic_verdict")
  verdict              BecVerdict
  /// `{ auth, url, text, history }` input states (B2).
  inputs               Json
  /// JSON array (≤ 32) of `{ id, code, category, severity, weight, suppressed, evidence }` (B14).
  rules                Json
  /// The AI feature vector (AI_FEATURE_NAMES → number | boolean), for the retraining export.
  features             Json?
  /// Parsed From / Reply-To / Sender / envelope summary (addresses ≤ 320, display name ≤ 128).
  identity             Json?
  /// Applied AI assessments (≤ 2): labels, confidence, indicators, cited features, span offsets,
  /// model ids/versions, response hash; never text.
  ai                   Json?
  /// Shadow AI assessments (≤ 3), never applied (B9 P5).
  aiShadow             Json?      @map("ai_shadow")
  durationMs           Int        @map("duration_ms") @db.UnsignedInt
  createdAt            DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  /// Step 8.4 D6 (ADR-0070): outbound observations of outbound and internal mail of organizations
  /// with ATO enabled: `{ version: 'bec-outbound-obs/1', status: 'complete' | 'incomplete' |
  /// 'unavailable', reason, categories, financialIdentifiers, links }` (counts and booleans only,
  /// no spans, no text). The verdict stays `skipped` (`bec.not_inbound`); NULL otherwise.
  outboundObservations Json?      @map("outbound_observations")

  @@id([id, receivedAt])
  @@unique([scanId, receivedAt])
  @@index([messageId, receivedAt])
  @@index([organizationId, receivedAt])
  @@map("bec_scan_results")
}

/// A tenant's executive profile for impersonation detection (step 4.4 B5, B6 X1–X3, B18).
/// `normalized_name` is the B5 normalization of `display_name` (unique per tenant). Deleted
/// explicitly by organization deletion (no cascade).
model BecExecutiveProfile {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  /// UUIDv7; the only id the API exposes.
  publicId        String   @unique @map("public_id") @db.Char(36)
  organizationId  BigInt   @map("organization_id") @db.UnsignedBigInt
  displayName     String   @map("display_name") @db.VarChar(128)
  normalizedName  String   @map("normalized_name") @db.VarChar(160)
  /// JSON array (≤ 10) of alias display names.
  aliases         Json
  /// JSON array (≤ 20) of normalized e-mail addresses the executive really uses.
  knownAddresses  Json     @map("known_addresses")
  title           String?  @db.VarChar(128)
  enabled         Boolean  @default(true)
  /// Compare-and-set counter of the API.
  version         Int      @default(1) @db.UnsignedInt
  createdByUserId BigInt?  @map("created_by_user_id") @db.UnsignedBigInt
  updatedByUserId BigInt?  @map("updated_by_user_id") @db.UnsignedBigInt
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("BecExecutiveCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy    User?        @relation("BecExecutiveUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, normalizedName])
  @@index([organizationId, enabled])
  @@map("bec_executive_profiles")
}

/// A tenant's vendor profile for vendor impersonation and payment-change detection (step 4.4 B5,
/// B6 V1–V4, L2, B18). Deleted explicitly by organization deletion (no cascade).
model BecVendorProfile {
  id                     BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  /// UUIDv7; the only id the API exposes.
  publicId               String   @unique @map("public_id") @db.Char(36)
  organizationId         BigInt   @map("organization_id") @db.UnsignedBigInt
  name                   String   @db.VarChar(128)
  normalizedName         String   @map("normalized_name") @db.VarChar(160)
  /// JSON array (≤ 10) of alias names.
  aliases                Json
  /// JSON array (1–20) of ASCII registrable domains (never a public suffix or a free-mail domain).
  domains                Json
  /// JSON array (≤ 50) of normalized e-mail addresses.
  knownSenders           Json     @map("known_senders")
  paymentChangeSensitive Boolean  @default(true) @map("payment_change_sensitive")
  enabled                Boolean  @default(true)
  version                Int      @default(1) @db.UnsignedInt
  createdByUserId        BigInt?  @map("created_by_user_id") @db.UnsignedBigInt
  updatedByUserId        BigInt?  @map("updated_by_user_id") @db.UnsignedBigInt
  createdAt              DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("BecVendorCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy    User?        @relation("BecVendorUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, normalizedName])
  @@map("bec_vendor_profiles")
}

/// A tenant's trusted sender (step 4.4 B7): an exact lower-case address or a registrable domain.
/// Trust applies only when the message authenticates as From. Deleted explicitly by
/// organization deletion (no cascade).
model BecTrustedSender {
  id              BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  /// UUIDv7; the only id the API exposes.
  publicId        String               @unique @map("public_id") @db.Char(36)
  organizationId  BigInt               @map("organization_id") @db.UnsignedBigInt
  kind            BecTrustedSenderKind
  /// Normalized lower-case address or ASCII registrable domain.
  value           String               @db.VarChar(320)
  reason          String               @db.VarChar(512)
  /// At most 365 days ahead (validated by the api); NULL = no expiry.
  expiresAt       DateTime?            @map("expires_at") @db.DateTime(3)
  version         Int                  @default(1) @db.UnsignedInt
  createdByUserId BigInt?              @map("created_by_user_id") @db.UnsignedBigInt
  createdAt       DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("BecTrustedSenderCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, kind, value])
  @@index([organizationId, expiresAt])
  @@map("bec_trusted_senders")
}

/// An analyst's false-positive / false-negative feedback on a `bec` result (step 4.4 B11).
/// Retention 24 months (training data; docs/database/retention.md). `message_id`, `scan_id` and
/// `bec_result_id` reference partitioned tables, so they carry no foreign keys. `note` is analyst
/// input (≤ 500 characters, never exported); never message content.
model BecFeedback {
  id                BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  /// UUIDv7; the only id the API exposes.
  publicId          String          @unique @map("public_id") @db.Char(36)
  organizationId    BigInt          @map("organization_id") @db.UnsignedBigInt
  messageId         BigInt          @map("message_id") @db.UnsignedBigInt
  /// received_at of the message (partition key of bec_scan_results).
  messageReceivedAt DateTime        @map("message_received_at") @db.DateTime(3)
  /// email_scans.id of the round.
  scanId            BigInt          @map("scan_id") @db.UnsignedBigInt
  /// bec_scan_results.id of the result.
  becResultId       BigInt          @map("bec_result_id") @db.UnsignedBigInt
  kind              BecFeedbackKind
  /// JSON array of disputed BEC_REASON_CODES (false positives: a subset of the result's codes).
  reasonCodes       Json?           @map("reason_codes")
  note              String?         @db.VarChar(500)
  createdByUserId   BigInt?         @map("created_by_user_id") @db.UnsignedBigInt
  createdAt         DateTime        @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("BecFeedbackCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([scanId, createdByUserId, kind])
  @@index([organizationId, createdAt])
  @@map("bec_feedback")
}

/// A bounded, expiring suppression of one suppressible BEC reason code for one sender, created
/// only from a false-positive feedback (step 4.4 B11). `feedback_id` is the bec_feedback.id it
/// came from (no foreign key: feedback is swept after 24 months, suppressions expire within 90
/// days). Deleted explicitly by organization deletion (no cascade).
model BecSuppressionRule {
  id              BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  /// UUIDv7; the only id the API exposes.
  publicId        String              @unique @map("public_id") @db.Char(36)
  organizationId  BigInt              @map("organization_id") @db.UnsignedBigInt
  /// One of BEC_SUPPRESSIBLE_CODES.
  reasonCode      String              @map("reason_code") @db.VarChar(64)
  senderScope     BecSuppressionScope @map("sender_scope")
  /// The From address or registrable domain of the scanned message (never a free-mail domain).
  senderValue     String              @map("sender_value") @db.VarChar(320)
  feedbackId      BigInt?             @map("feedback_id") @db.UnsignedBigInt
  /// At most 90 days after creation (no permanent suppression).
  expiresAt       DateTime            @map("expires_at") @db.DateTime(3)
  createdByUserId BigInt?             @map("created_by_user_id") @db.UnsignedBigInt
  createdAt       DateTime            @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("BecSuppressionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, reasonCode, senderScope, senderValue])
  @@index([organizationId, expiresAt])
  @@map("bec_suppression_rules")
}

/// Opt-in historical communication context (step 4.4 B12, ADR-0035): aggregate counts per keyed
/// hash. `key_hash` = HMAC-SHA256(BEC_CONTEXT_HMAC_KEY, "eg-bec-ctx/v1\0" ‖ organization ‖ scope ‖
/// canonical key), hex; no plaintext address, domain, IP or name. Retention per tenant
/// (`history.retentionDays`) by the email-worker sweeper; purge through the api. Deleted
/// explicitly by organization deletion (no cascade).
model BecContactHistory {
  id             BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId BigInt          @map("organization_id") @db.UnsignedBigInt
  scope          BecContactScope
  keyHash        String          @map("key_hash") @db.Char(64)
  /// Saturating at 2^32 − 1.
  messageCount   Int             @map("message_count") @db.UnsignedInt
  inboundCount   Int             @default(0) @map("inbound_count") @db.UnsignedInt
  outboundCount  Int             @default(0) @map("outbound_count") @db.UnsignedInt
  /// Sender scope only: ≤ 8 `{ fp, count, lastSeenAt }` (fp = first 16 hex of an HMAC).
  infra          Json?
  /// Message received_at of the first and last message counted.
  firstSeenAt    DateTime        @map("first_seen_at") @db.DateTime(3)
  lastSeenAt     DateTime        @map("last_seen_at") @db.DateTime(3)
  createdAt      DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, scope, keyHash])
  @@index([organizationId, lastSeenAt])
  @@map("bec_contact_history")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly (6 months, core; step 4.5 §3, D10, D19).
/// One row per scan round with a definite final result of the `dlp` engine, written in that final
/// row's finalize transaction (unique per scan). Codes, counts, confidences, offsets-free source
/// references, versions and **masked** values only (D15): never a raw matched value, context
/// text, extracted text or dictionary terms. `matched_policy_id` / `matched_rule_id` are internal
/// dlp_policies / dlp_policy_rules ids (no foreign keys: partitioned table). No foreign keys.
model DlpScanResult {
  id               BigInt            @default(autoincrement()) @db.UnsignedBigInt
  receivedAt       DateTime          @map("received_at") @db.DateTime(3)
  messageId        BigInt            @map("message_id") @db.UnsignedBigInt
  organizationId   BigInt            @map("organization_id") @db.UnsignedBigInt
  /// email_scans.id of the round.
  scanId           BigInt            @map("scan_id") @db.UnsignedBigInt
  lifecycleRound   Int               @map("lifecycle_round") @db.UnsignedSmallInt
  /// email_messages.direction at scan time (trusted).
  direction        MessageDirection
  /// `dlp/1;dict=<8 hex>;data=<8 hex>;ext=dlp-extract/1` (D23).
  engineVersion    String            @map("engine_version") @db.VarChar(96)
  /// `dlp-map/1` (D5).
  rulesVersion     String            @map("rules_version") @db.VarChar(16)
  /// `dlp-map/1;p=<12 hex>;t=<row version | none>` (D18).
  settingsVersion  String            @map("settings_version") @db.VarChar(96)
  /// `pol/1;h=<12 hex>` (D11).
  policyVersion    String            @map("policy_version") @db.VarChar(32)
  /// `dlp-extract/1` (D4).
  extractorVersion String            @map("extractor_version") @db.VarChar(32)
  verdict          DlpVerdict
  /// Effective DLP action of the tenant policy (D11); applied by the delivery stage (D13).
  action           DlpAction
  actionSource     DlpActionSource   @map("action_source")
  /// dlp_policies.id / dlp_policy_rules.id of the winning rule (NULL without a winner).
  matchedPolicyId  BigInt?           @map("matched_policy_id") @db.UnsignedBigInt
  matchedRuleId    BigInt?           @map("matched_rule_id") @db.UnsignedBigInt
  coverage         DlpCoverage
  /// JSON object `{ aadhaar: 'enabled'|'disabled', sources: [≤ 64 × { source, partIndex?, path?, format, status, reasons, chars, truncated }] }` (D10, D17).
  coverageDetail   Json              @map("coverage_detail")
  /// JSON array (≤ 10) of `{ category, count, maxSeverity, maxConfidence }`.
  categories       Json
  /// JSON array (≤ 64) of findings with masked samples only (≤ 3 each, D15).
  findings         Json
  /// `{ winner, matched (≤ 16), matchedTruncated, defaultPolicyMatched, exceptionsApplied (≤ 16) }` with public ids (UUIDv7; internal ids only in matched_policy_id / matched_rule_id).
  policy           Json
  findingCount     Int               @map("finding_count") @db.UnsignedInt
  evidenceStatus   DlpEvidenceStatus @map("evidence_status")
  durationMs       Int               @map("duration_ms") @db.UnsignedInt
  createdAt        DateTime          @default(now()) @map("created_at") @db.DateTime(3)

  @@id([id, receivedAt])
  @@unique([scanId, receivedAt])
  @@index([messageId, receivedAt])
  @@index([organizationId, receivedAt])
  @@index([organizationId, action, receivedAt])
  @@map("dlp_scan_results")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly (7 months, core; step 4.5 D16, ADR-0038).
/// Metadata of one envelope-encrypted DLP evidence object in S3 (`object_key` under
/// `org/<org>/dlp-evidence/`): never content. `wrapped_key` is the data key wrapped under
/// DLP_EVIDENCE_KEY (SecretBox format); it exists only here, so purge = crypto-shred
/// (`wrapped_key` NULL + `purged_at`) then delete the object (`object_key` NULL after a successful
/// delete). `expires_at` = received_at + the tenant's evidence retention (≤ 180 days); partitions
/// are dropped at 7 months. No foreign keys.
model DlpEvidence {
  id              BigInt                  @default(autoincrement()) @db.UnsignedBigInt
  receivedAt      DateTime                @map("received_at") @db.DateTime(3)
  organizationId  BigInt                  @map("organization_id") @db.UnsignedBigInt
  messageId       BigInt                  @map("message_id") @db.UnsignedBigInt
  /// email_scans.id of the round (one evidence per round).
  scanId          BigInt                  @map("scan_id") @db.UnsignedBigInt
  /// NULL after the object was deleted.
  objectKey       String?                 @map("object_key") @db.VarChar(512)
  /// Hex SHA-256 of the stored ciphertext object.
  objectSha256    String                  @map("object_sha256") @db.Char(64)
  objectSizeBytes Int                     @map("object_size_bytes") @db.UnsignedInt
  /// `v1.<kid>.<iv>.<tag>.<ct>`; NULL = crypto-shredded.
  wrappedKey      String?                 @map("wrapped_key") @db.VarChar(255)
  keyId           String                  @map("key_id") @db.VarChar(16)
  /// `dlp-evidence/1`.
  algorithm       String                  @db.VarChar(32)
  matchCount      Int                     @map("match_count") @db.UnsignedSmallInt
  expiresAt       DateTime                @map("expires_at") @db.DateTime(3)
  purgedAt        DateTime?               @map("purged_at") @db.DateTime(3)
  purgeReason     DlpEvidencePurgeReason? @map("purge_reason")
  createdAt       DateTime                @default(now()) @map("created_at") @db.DateTime(3)

  @@id([id, receivedAt])
  @@unique([scanId, receivedAt])
  @@index([messageId, receivedAt])
  @@index([organizationId, purgedAt, expiresAt])
  @@index([expiresAt])
  @@map("dlp_evidence")
}

/// A tenant DLP policy (step 4.5 D11): ordered rules, evaluated at scan time. `directions` is a
/// JSON array ⊆ ["outbound","internal","inbound"]. Deleted explicitly by organization deletion
/// (no cascade).
model DlpPolicy {
  id              BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  /// UUIDv7; the only id the API exposes.
  publicId        String        @unique @map("public_id") @db.Char(36)
  organizationId  BigInt        @map("organization_id") @db.UnsignedBigInt
  name            String        @db.VarChar(128)
  description     String?       @db.VarChar(512)
  enabled         Boolean       @default(true)
  mode            DlpPolicyMode @default(enforce)
  /// 0..1000, ascending evaluation order (ties broken by id).
  priority        Int           @default(100) @db.UnsignedSmallInt
  directions      Json
  /// Compare-and-set counter of the API.
  version         Int           @default(1) @db.UnsignedInt
  createdByUserId BigInt?       @map("created_by_user_id") @db.UnsignedBigInt
  updatedByUserId BigInt?       @map("updated_by_user_id") @db.UnsignedBigInt
  createdAt       DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?           @relation("DlpPolicyCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy    User?           @relation("DlpPolicyUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  rules        DlpPolicyRule[]
  exceptions   DlpException[]

  @@unique([organizationId, name])
  @@index([organizationId, enabled, priority])
  @@map("dlp_policies")
}

/// A rule of a DLP policy (step 4.5 D11). `conditions` is validated by `dlpRuleConditionsSchema`
/// (security-contracts). Deleted with its policy in the api transaction (no cascade).
model DlpPolicyRule {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  /// UUIDv7; the only id the API exposes.
  publicId        String    @unique @map("public_id") @db.Char(36)
  organizationId  BigInt    @map("organization_id") @db.UnsignedBigInt
  policyId        BigInt    @map("policy_id") @db.UnsignedBigInt
  name            String    @db.VarChar(128)
  enabled         Boolean   @default(true)
  priority        Int       @db.UnsignedSmallInt
  conditions      Json
  action          DlpAction
  version         Int       @default(1) @db.UnsignedInt
  createdByUserId BigInt?   @map("created_by_user_id") @db.UnsignedBigInt
  updatedByUserId BigInt?   @map("updated_by_user_id") @db.UnsignedBigInt
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  policy       DlpPolicy      @relation(fields: [policyId], references: [id], onDelete: Restrict)
  createdBy    User?          @relation("DlpRuleCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy    User?          @relation("DlpRuleUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  exceptions   DlpException[]

  @@unique([policyId, name])
  @@index([organizationId, policyId, priority])
  @@map("dlp_policy_rules")
}

/// A DLP exception (step 4.5 D12): removes findings of a sender, or recipients, from the targeted
/// rules. `target_key` = `all` | `policy:<id>` | `rule:<id>` (so the unique key has no NULLs);
/// `expires_at` is required (≤ 365 days ahead). Deleted explicitly by organization deletion (no
/// cascade).
model DlpException {
  id              BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  /// UUIDv7; the only id the API exposes.
  publicId        String            @unique @map("public_id") @db.Char(36)
  organizationId  BigInt            @map("organization_id") @db.UnsignedBigInt
  scope           DlpExceptionScope
  /// Normalized lower-case address or ASCII domain.
  value           String            @db.VarChar(320)
  policyId        BigInt?           @map("policy_id") @db.UnsignedBigInt
  ruleId          BigInt?           @map("rule_id") @db.UnsignedBigInt
  targetKey       String            @map("target_key") @db.VarChar(48)
  /// `{ detectors?, categories? }`; NULL = every finding.
  filters         Json?
  reason          String            @db.VarChar(512)
  expiresAt       DateTime          @map("expires_at") @db.DateTime(3)
  enabled         Boolean           @default(true)
  version         Int               @default(1) @db.UnsignedInt
  createdByUserId BigInt?           @map("created_by_user_id") @db.UnsignedBigInt
  updatedByUserId BigInt?           @map("updated_by_user_id") @db.UnsignedBigInt
  createdAt       DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  policy       DlpPolicy?     @relation(fields: [policyId], references: [id], onDelete: Restrict)
  rule         DlpPolicyRule? @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  createdBy    User?          @relation("DlpExceptionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy    User?          @relation("DlpExceptionUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, scope, value, targetKey])
  @@index([organizationId, expiresAt])
  @@map("dlp_exceptions")
}

/// A tenant custom DLP pattern (step 4.5 D9): RE2 syntax (re2js), validated by
/// `compileCustomPattern` at write and at load (≤ 256 characters enforced by the api). The pattern
/// is tenant configuration, never matched content. Deleted explicitly by organization deletion
/// (no cascade).
model DlpCustomPattern {
  id              BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  /// UUIDv7; the only id the API exposes.
  publicId        String              @unique @map("public_id") @db.Char(36)
  organizationId  BigInt              @map("organization_id") @db.UnsignedBigInt
  name            String              @db.VarChar(128)
  pattern         String              @db.VarChar(512)
  caseInsensitive Boolean             @default(false) @map("case_insensitive")
  validator       DlpPatternValidator @default(none)
  /// JSON array (≤ 20) of keywords (1..64 characters).
  contextKeywords Json                @map("context_keywords")
  requireContext  Boolean             @default(false) @map("require_context")
  severity        DlpSeverity
  /// 0.50..1.00.
  baseConfidence  Decimal             @map("base_confidence") @db.Decimal(3, 2)
  maskStyle       DlpMaskStyle        @default(last4) @map("mask_style")
  enabled         Boolean             @default(true)
  version         Int                 @default(1) @db.UnsignedInt
  createdByUserId BigInt?             @map("created_by_user_id") @db.UnsignedBigInt
  updatedByUserId BigInt?             @map("updated_by_user_id") @db.UnsignedBigInt
  createdAt       DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("DlpPatternCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy    User?        @relation("DlpPatternUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, name])
  @@map("dlp_custom_patterns")
}

/// A tenant DLP keyword dictionary (step 4.5 D8). `terms` (1..1000, each 1..64 characters) are
/// tenant configuration shown only to `dlp:read` holders; results reference a term by index.
/// Deleted explicitly by organization deletion (no cascade).
model DlpKeywordDictionary {
  id              BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  /// UUIDv7; the only id the API exposes.
  publicId        String                @unique @map("public_id") @db.Char(36)
  organizationId  BigInt                @map("organization_id") @db.UnsignedBigInt
  name            String                @db.VarChar(128)
  category        DlpDictionaryCategory
  terms           Json
  termCount       Int                   @map("term_count") @db.UnsignedSmallInt
  severity        DlpSeverity
  /// 0.50..1.00 (default 0.70).
  baseConfidence  Decimal               @default(0.70) @map("base_confidence") @db.Decimal(3, 2)
  minMatches      Int                   @default(1) @map("min_matches") @db.UnsignedSmallInt
  enabled         Boolean               @default(true)
  version         Int                   @default(1) @db.UnsignedInt
  createdByUserId BigInt?               @map("created_by_user_id") @db.UnsignedBigInt
  updatedByUserId BigInt?               @map("updated_by_user_id") @db.UnsignedBigInt
  createdAt       DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("DlpDictionaryCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy    User?        @relation("DlpDictionaryUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, name])
  @@map("dlp_keyword_dictionaries")
}

/// One row per organization (step 4.5 D17, ADR-0038): the recorded compliance basis that enables
/// Aadhaar detection. The worker runs NI2 only when enabled, attested, with basis and reference,
/// and `aadhaar_review_due_at` in the future. Deleted explicitly by organization deletion (no
/// cascade).
model DlpComplianceSettings {
  id                      BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId          BigInt           @unique @map("organization_id") @db.UnsignedBigInt
  aadhaarEnabled          Boolean          @default(false) @map("aadhaar_enabled")
  aadhaarBasis            DlpAadhaarBasis? @map("aadhaar_basis")
  /// The tenant's document or approval reference (1..256).
  aadhaarReference        String?          @map("aadhaar_reference") @db.VarChar(256)
  aadhaarAttested         Boolean          @default(false) @map("aadhaar_attested")
  aadhaarRecordedByUserId BigInt?          @map("aadhaar_recorded_by_user_id") @db.UnsignedBigInt
  aadhaarRecordedAt       DateTime?        @map("aadhaar_recorded_at") @db.DateTime(3)
  /// ≤ recorded + 365 days.
  aadhaarReviewDueAt      DateTime?        @map("aadhaar_review_due_at") @db.DateTime(3)
  version                 Int              @default(1) @db.UnsignedInt
  createdAt               DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt               DateTime         @updatedAt @map("updated_at") @db.DateTime(3)

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  aadhaarRecordedBy User?        @relation("DlpAadhaarRecordedBy", fields: [aadhaarRecordedByUserId], references: [id], onDelete: SetNull)

  @@map("dlp_compliance_settings")
}

/// Risk scoring profile pointer of one organization (step 5.1 R10, R15), created lazily by the
/// api. `active_version_id` is the risk_scoring_profile_versions.id of the active **published**
/// version, or NULL = the platform default profile (RISK_PLATFORM_PROFILE). No foreign key on
/// `active_version_id` (it would form a cycle with the versions' `profile_id`): the api checks
/// that it names a published version of the same organization, and the email-worker echo-checks
/// it (organization, status) when it resolves the snapshot. Deleted explicitly by organization
/// deletion, after its versions (no cascade).
model RiskScoringProfile {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  /// UUIDv7; the only id the API exposes.
  publicId        String   @unique @map("public_id") @db.Char(36)
  organizationId  BigInt   @unique @map("organization_id") @db.UnsignedBigInt
  /// risk_scoring_profile_versions.id of the active published version; NULL = platform default.
  activeVersionId BigInt?  @map("active_version_id") @db.UnsignedBigInt
  /// Compare-and-set counter of pointer changes (publish with activation, activate, reset).
  version         Int      @default(1) @db.UnsignedInt
  updatedByUserId BigInt?  @map("updated_by_user_id") @db.UnsignedBigInt
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  updatedBy    User?                       @relation("RiskProfileUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  versions     RiskScoringProfileVersion[]

  @@map("risk_scoring_profiles")
}

/// A version of an organization's risk scoring profile (step 5.1 R10, R15): bounded tenant
/// overrides (`riskProfileOverridesSchema` of @email-gateway/risk-scoring) on a shipped platform
/// profile (`base_profile`, e.g. `rsk-default/1`). `draft` versions are editable (CAS on
/// `row_version`) and deletable; **published versions are immutable**: the api updates and
/// deletes only `WHERE status = 'draft'`, and no route changes a published row. Activation is a
/// pointer change on risk_scoring_profiles. Deleted explicitly by organization deletion (no
/// cascade).
model RiskScoringProfileVersion {
  id                BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  /// UUIDv7; the only id the API exposes.
  publicId          String                   @unique @map("public_id") @db.Char(36)
  organizationId    BigInt                   @map("organization_id") @db.UnsignedBigInt
  profileId         BigInt                   @map("profile_id") @db.UnsignedBigInt
  /// 1, 2, ... per profile (assigned by the api under the profile row lock).
  versionNo         Int                      @map("version_no") @db.UnsignedInt
  status            RiskProfileVersionStatus @default(draft)
  /// Platform profile id the overrides apply to (`rsk-default/1` at creation).
  baseProfile       String                   @map("base_profile") @db.VarChar(32)
  /// JSON object: the tenant overrides document (every key optional, bounded, R10).
  overrides         Json
  /// Hex SHA-256 of the canonical JSON of `overrides`.
  overridesSha256   String                   @map("overrides_sha256") @db.Char(64)
  /// Hex SHA-256 of the canonical effective profile; set at publish.
  profileSha256     String?                  @map("profile_sha256") @db.Char(64)
  changeNote        String?                  @map("change_note") @db.VarChar(512)
  /// Compare-and-set counter of draft edits and publish.
  rowVersion        Int                      @default(1) @map("row_version") @db.UnsignedInt
  createdByUserId   BigInt?                  @map("created_by_user_id") @db.UnsignedBigInt
  updatedByUserId   BigInt?                  @map("updated_by_user_id") @db.UnsignedBigInt
  publishedByUserId BigInt?                  @map("published_by_user_id") @db.UnsignedBigInt
  publishedAt       DateTime?                @map("published_at") @db.DateTime(3)
  createdAt         DateTime                 @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  profile      RiskScoringProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  createdBy    User?              @relation("RiskVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy    User?              @relation("RiskVersionUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  publishedBy  User?              @relation("RiskVersionPublishedBy", fields: [publishedByUserId], references: [id], onDelete: SetNull)

  @@unique([profileId, versionNo])
  @@index([organizationId, status, versionNo])
  @@map("risk_scoring_profile_versions")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly (6 months, core; step 5.1 §3, R11, R13,
/// R14). One risk score per scan round and revision: revision 0 is written by the email-worker
/// in the transaction that completes the round, revision 1 (the round's inputs plus the late
/// sandbox final) once, by whichever of completion and the sandbox finalizer comes second; both
/// under the email_scans row lock, the unique key is the backstop. Never updated; deleted only
/// by retention and organization purge. Engine names, outcomes, reason codes, signal ids,
/// integers and versions only: never message content (no addresses, domains, URLs, subjects,
/// file names). The JSON columns hold the bounded `RiskResult` fields of
/// @email-gateway/risk-scoring (mapping fixed in R11). No foreign keys.
model MessageRiskScore {
  id                BigInt            @default(autoincrement()) @db.UnsignedBigInt
  receivedAt        DateTime          @map("received_at") @db.DateTime(3)
  messageId         BigInt            @map("message_id") @db.UnsignedBigInt
  organizationId    BigInt            @map("organization_id") @db.UnsignedBigInt
  /// email_scans.id of the round.
  scanId            BigInt            @map("scan_id") @db.UnsignedBigInt
  lifecycleRound    Int               @map("lifecycle_round") @db.UnsignedSmallInt
  /// 0 = the round; 1 = the round with the late sandbox final (ADR-0042).
  revision          Int               @db.UnsignedTinyInt
  /// email_messages.direction at scan time (trusted).
  direction         MessageDirection
  status            RiskScoreStatus
  /// 0-1000.
  score             Int               @db.UnsignedSmallInt
  level             RiskLevel
  verdict           MessageVerdict
  recommendedAction RiskAction        @map("recommended_action")
  /// JSON array (≤ 9) of `{ id, verdict, action }`.
  hardBlocks        Json              @map("hard_blocks")
  /// JSON array (≤ 32) of reason codes.
  reasonCodes       Json              @map("reason_codes")
  /// JSON array (≤ 64) of `{ signal, group, weight, codes, applied }` (fired signals only).
  contributions     Json
  /// JSON array of `{ group, rule, raw, multiplierPermille, trustFactorPermille, cap, total }`.
  groups            Json
  /// JSON array (≤ 8) of `{ engine, required, status, outcome, errorCode, engineVersion, settingsVersion, attempts }`.
  engines           Json
  /// JSON array of `{ engine, status, weight }`.
  failures          Json
  /// JSON array of `{ source, level }`.
  floors            Json
  /// JSON object `{ status, factorPermille, reducedGroups, pointsRemoved }` (R7).
  trust             Json
  /// JSON object `{ auth, dlp, bec, sandbox, unmappedCodes, aiRaiseOnly }` (outcomes only).
  evidence          Json
  /// JSON array (≤ 20) of explanation lines `{ code, params }`.
  explanation       Json
  /// Rendered explanation (fixed templates over codes and integers).
  explanationText   String            @map("explanation_text") @db.VarChar(2048)
  profileSource     RiskProfileSource @map("profile_source")
  /// risk_scoring_profile_versions.id of the profile used; NULL = platform default (no FK).
  profileVersionId  BigInt?           @map("profile_version_id") @db.UnsignedBigInt
  /// `rsk-default/1` or `rsk-default/1+t:<version public id>#<versionNo>`.
  profileIdText     String            @map("profile_id_text") @db.VarChar(96)
  /// Hex SHA-256 of the canonical effective profile.
  profileSha256     String            @map("profile_sha256") @db.Char(64)
  /// Hex SHA-256 of the canonical scoring input (`risk-input/1`).
  inputSha256       String            @map("input_sha256") @db.Char(64)
  /// `risk-score/1`.
  scorerVersion     String            @map("scorer_version") @db.VarChar(32)
  /// `risk-signals/1`.
  signalMapVersion  String            @map("signal_map_version") @db.VarChar(32)
  /// `risk-input/1`.
  inputVersion      String            @map("input_version") @db.VarChar(32)
  durationUs        Int               @map("duration_us") @db.UnsignedInt
  createdAt         DateTime          @default(now()) @map("created_at") @db.DateTime(3)

  @@id([id, receivedAt])
  @@unique([scanId, revision, receivedAt])
  @@index([messageId, receivedAt])
  @@index([organizationId, receivedAt])
  @@index([organizationId, level, receivedAt])
  @@map("message_risk_scores")
}

/// `organization_id` NULL = platform-wide intelligence. Step 4.3 (U6, U16) writes platform rows
/// only (`organization_id` NULL, `source = 'analyst'`, through the api's threat-indicator routes)
/// and the URL engine and the click-service read them on every scan and click (never cached).
/// `value` is normalized by `@email-gateway/url-security`: a `url` in its identity form (no
/// userinfo, no fragment), a `domain` as the ASCII registrable domain or host (never a public
/// suffix), an `ip` in canonical text form; `value_sha256` is the hex SHA-256 of that value.
model ThreatIndicator {
  id             BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId BigInt?         @map("organization_id") @db.UnsignedBigInt
  indicatorType  IndicatorType   @map("indicator_type")
  value          String          @db.VarChar(2048)
  valueSha256    String          @map("value_sha256") @db.Char(64)
  /// `feed:<name>`, `org:<id>` or `analyst`. Uniqueness is per tenant scope (`orgScope`), so the
  /// same source string in two organizations never collides.
  source         String          @db.VarChar(64)
  severity       Severity
  /// 0–100.
  confidence     Int             @db.UnsignedTinyInt
  firstSeenAt    DateTime        @map("first_seen_at") @db.DateTime(3)
  lastSeenAt     DateTime        @map("last_seen_at") @db.DateTime(3)
  expiresAt      DateTime?       @map("expires_at") @db.DateTime(3)
  metadata       Json?
  /// READ-ONLY, generated by MySQL: `GENERATED ALWAYS AS (IFNULL(organization_id, 0)) VIRTUAL`.
  /// 0 is the platform scope. It puts the tenant in the unique key below; a plain
  /// organization_id would not dedupe platform rows (MySQL treats NULLs as distinct). Never write it.
  orgScope       BigInt?         @map("org_scope") @db.UnsignedBigInt
  createdAt      DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  /// The analyst who added the indicator (NULL for feeds, or after the user is deleted).
  addedByUserId  BigInt?         @map("added_by_user_id") @db.UnsignedBigInt
  /// Why the indicator was added (analyst input; never message content).
  reason         String?         @db.VarChar(512)
  /// THREAT_CATEGORIES of @email-gateway/security-contracts; NULL for rows without a category.
  category       ThreatCategory?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  addedBy      User?         @relation(fields: [addedByUserId], references: [id], onDelete: SetNull)

  @@unique([orgScope, source, indicatorType, valueSha256])
  @@index([indicatorType, valueSha256])
  @@index([organizationId, indicatorType])
  @@index([source, createdAt])
  @@map("threat_indicators")
}

/// Platform catalog. Unused: reputation answers are cached in Redis (step 4.3 U6); reserved
/// for feed ingestion.
model IpReputation {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  ipAddress  String    @unique @map("ip_address") @db.VarChar(45)
  /// −100..100.
  score      Int       @db.SmallInt
  categories Json?
  source     String    @db.VarChar(64)
  lastSeenAt DateTime  @map("last_seen_at") @db.DateTime(3)
  expiresAt  DateTime? @map("expires_at") @db.DateTime(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([expiresAt])
  @@map("ip_reputation")
}

/// Platform catalog. Unused: reputation answers are cached in Redis (step 4.3 U6); reserved
/// for feed ingestion.
model DomainReputation {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  domain       String    @unique @db.VarChar(253)
  score        Int       @db.SmallInt
  categories   Json?
  registeredAt DateTime? @map("registered_at") @db.DateTime(3)
  source       String    @db.VarChar(64)
  lastSeenAt   DateTime  @map("last_seen_at") @db.DateTime(3)
  expiresAt    DateTime? @map("expires_at") @db.DateTime(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([expiresAt])
  @@map("domain_reputation")
}

/// Platform catalog. Unused: reputation answers are cached in Redis (step 4.3 U6); reserved
/// for feed ingestion.
model UrlReputation {
  id            BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  urlSha256     String     @unique @map("url_sha256") @db.Char(64)
  url           String     @db.VarChar(2048)
  host          String     @db.VarChar(253)
  verdict       UrlVerdict @default(unknown)
  score         Int        @db.SmallInt
  categories    Json?
  source        String     @db.VarChar(64)
  lastCheckedAt DateTime   @map("last_checked_at") @db.DateTime(3)
  expiresAt     DateTime?  @map("expires_at") @db.DateTime(3)
  createdAt     DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([host])
  @@index([expiresAt])
  @@map("url_reputation")
}

/// Platform catalog of known-threat file hashes (step 4.2 A17), platform-wide by design (never
/// tenant-scoped). Written by the api's threat-hash routes (`source = 'analyst'`); `feed:<name>`
/// (future feeds) and `sandbox` (step 4.6) are the other sources. Read by the attachment engine
/// on every scan (never cached). Delete is a hard delete (the audit log keeps the before-image).
model MalwareSignature {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  sha256        String    @unique @db.Char(64)
  md5           String?   @db.Char(32)
  family        String?   @db.VarChar(128)
  severity      Severity
  /// `analyst`, `feed:<name>` or `sandbox`.
  source        String    @db.VarChar(64)
  firstSeenAt   DateTime  @map("first_seen_at") @db.DateTime(3)
  lastSeenAt    DateTime  @map("last_seen_at") @db.DateTime(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  /// The analyst who added the hash (NULL for feeds and the sandbox, or after the user is deleted).
  addedByUserId BigInt?   @map("added_by_user_id") @db.UnsignedBigInt
  /// Why the hash was added (analyst input; no file content).
  reason        String?   @db.VarChar(512)
  /// The lookup ignores the row after this instant; NULL = no expiry.
  expiresAt     DateTime? @map("expires_at") @db.DateTime(3)

  addedBy User? @relation(fields: [addedByUserId], references: [id], onDelete: SetNull)

  @@index([source, createdAt])
  @@map("malware_signatures")
}

/// `organization_id` NULL = platform rule. `content` is rule source (configuration, not mail).
model YaraRule {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId  BigInt?  @map("organization_id") @db.UnsignedBigInt
  /// `platform/<name>` or `org-<id>/<name>`.
  ruleKey         String   @unique @map("rule_key") @db.VarChar(191)
  name            String   @db.VarChar(128)
  version         Int      @default(1) @db.UnsignedInt
  content         String   @db.MediumText
  contentSha256   String   @map("content_sha256") @db.Char(64)
  severity        Severity
  enabled         Boolean  @default(true)
  updatedByUserId BigInt?  @map("updated_by_user_id") @db.UnsignedBigInt
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  updatedBy    User?         @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, enabled])
  @@map("yara_rules")
}

// ---------------------------------------------------------------------------------------------
// 3.6 Policy
// ---------------------------------------------------------------------------------------------

/// A tenant mail policy (step 5.2 P17, ADR-0043). `status`: `draft` (never activated), `active`
/// (has an active published version and is evaluated), `disabled` (has versions, not evaluated),
/// `archived` (soft-deleted: `deleted_at` set, versions kept for history). `direction` and
/// `priority` are copied from the active version's definition at activation (from the newest
/// draft while never activated). `row_version` is the compare-and-set counter of metadata and
/// pointer changes. `active_version_id` has no FK (it would form a cycle with policy_versions);
/// the service validates it. The name stays unique per organization, archived policies included.
model EmailPolicy {
  id              BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  publicId        String          @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  organizationId  BigInt          @map("organization_id") @db.UnsignedBigInt
  name            String          @db.VarChar(128)
  description     String?         @db.VarChar(512)
  direction       PolicyDirection
  priority        Int
  status          PolicyStatus    @default(draft)
  activeVersionId BigInt?         @map("active_version_id") @db.UnsignedBigInt
  rowVersion      Int             @default(1) @map("row_version") @db.UnsignedInt
  createdByUserId BigInt?         @map("created_by_user_id") @db.UnsignedBigInt
  updatedByUserId BigInt?         @map("updated_by_user_id") @db.UnsignedBigInt
  deletedAt       DateTime?       @map("deleted_at") @db.DateTime(3)
  createdAt       DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("EmailPolicyCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy    User?        @relation("EmailPolicyUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  versions   PolicyVersion[]
  exceptions PolicyException[]

  @@unique([organizationId, name])
  @@index([organizationId, status, direction, priority])
  @@map("email_policies")
}

/// A version of a tenant policy (step 5.2 P17). `definition` is the `policy-dsl/1` document
/// (`policyDefinitionSchema` of @email-gateway/policy-dsl); `definition_sha256` = sha256 of its
/// canonical JSON. `draft` versions are editable (CAS on `row_version`) and deletable;
/// **published versions are immutable** (the api updates and deletes only `WHERE status =
/// 'draft'`). Publishing stores `dsl_version`, `references` (`{ departmentIds, userIds }`, public
/// ids of the directory objects the definition names), `has_override_rules` and `rule_count`.
/// `dsl_version` NULL = a legacy (step 1.1) row: the migration `policy_engine` set every such row
/// to `superseded` and deactivated its policy (nothing deleted). Statuses used: `draft`,
/// `published`; `superseded` only for retired legacy rows; `rolled_back` is unused.
model PolicyVersion {
  id                BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId    BigInt              @map("organization_id") @db.UnsignedBigInt
  policyId          BigInt              @map("policy_id") @db.UnsignedBigInt
  version           Int                 @db.UnsignedInt
  status            PolicyVersionStatus @default(draft)
  definition        Json
  definitionSha256  String              @map("definition_sha256") @db.Char(64)
  /// `policy-dsl/1`; NULL = legacy format (retired).
  dslVersion        String?             @map("dsl_version") @db.VarChar(32)
  /// `{ departmentIds: string[], userIds: string[] }` (public ids); NULL for legacy rows.
  /// Note: `references` is a reserved word in MySQL; hand-written SQL must quote it.
  references        Json?
  hasOverrideRules  Boolean             @default(false) @map("has_override_rules")
  ruleCount         Int                 @default(0) @map("rule_count") @db.UnsignedSmallInt
  rowVersion        Int                 @default(1) @map("row_version") @db.UnsignedInt
  changeNote        String?             @map("change_note") @db.VarChar(512)
  createdByUserId   BigInt?             @map("created_by_user_id") @db.UnsignedBigInt
  updatedByUserId   BigInt?             @map("updated_by_user_id") @db.UnsignedBigInt
  publishedAt       DateTime?           @map("published_at") @db.DateTime(3)
  publishedByUserId BigInt?             @map("published_by_user_id") @db.UnsignedBigInt
  createdAt         DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  policy       EmailPolicy  @relation(fields: [policyId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("PolicyVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy    User?        @relation("PolicyVersionUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  publishedBy  User?        @relation("PolicyVersionPublishedBy", fields: [publishedByUserId], references: [id], onDelete: SetNull)

  conditions PolicyCondition[]
  actions    PolicyAction[]

  @@unique([policyId, version])
  @@index([organizationId, status])
  @@map("policy_versions")
}

/// RETIRED in step 5.2 (docs/plan/steps/16-policy-engine.md §3): the step 1.1 relational
/// decomposition of a policy version (OR-groups `group_seq` of AND-ed conditions). No reader or
/// writer from 5.2 on; rows of legacy versions are kept and removed only by organization purge.
model PolicyCondition {
  id              BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId  BigInt         @map("organization_id") @db.UnsignedBigInt
  policyVersionId BigInt         @map("policy_version_id") @db.UnsignedBigInt
  seq             Int            @db.UnsignedSmallInt
  groupSeq        Int            @default(0) @map("group_seq") @db.UnsignedSmallInt
  field           String         @db.VarChar(64)
  operator        PolicyOperator
  value           Json
  negate          Boolean        @default(false)
  createdAt       DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.DateTime(3)

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  policyVersion PolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Cascade)

  @@unique([policyVersionId, seq])
  @@map("policy_conditions")
}

/// RETIRED in step 5.2 (as policy_conditions): legacy actions of a policy version. No reader or
/// writer; actions live in the `policy-dsl/1` definition.
model PolicyAction {
  id              BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId  BigInt           @map("organization_id") @db.UnsignedBigInt
  policyVersionId BigInt           @map("policy_version_id") @db.UnsignedBigInt
  seq             Int              @db.UnsignedSmallInt
  action          PolicyActionType
  params          Json?
  createdAt       DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.DateTime(3)

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  policyVersion PolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Cascade)

  @@unique([policyVersionId, seq])
  @@map("policy_actions")
}

/// RETIRED in step 5.2 (as policy_conditions): legacy organization-wide or per-policy
/// exceptions (`policy_id` NULL = organization-wide). No reader or writer; exceptions live in the
/// `policy-dsl/1` definition (`unless`, `exceptions`).
model PolicyException {
  id              BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId  BigInt              @map("organization_id") @db.UnsignedBigInt
  policyId        BigInt?             @map("policy_id") @db.UnsignedBigInt
  exceptionType   PolicyExceptionType @map("exception_type")
  matchValue      String              @map("match_value") @db.VarChar(320)
  recipientScope  String?             @map("recipient_scope") @db.VarChar(320)
  reason          String?             @db.VarChar(512)
  expiresAt       DateTime?           @map("expires_at") @db.DateTime(3)
  createdByUserId BigInt?             @map("created_by_user_id") @db.UnsignedBigInt
  createdAt       DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  policy       EmailPolicy? @relation(fields: [policyId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, exceptionType, matchValue(length: 100)])
  @@map("policy_exceptions")
}

/// Per-organization policy settings and the evaluation snapshot generation (step 5.2 P11, P12).
/// One row per organization, created lazily by the api. `settings` is the strict
/// `policyTenantSettingsSchema` document of @email-gateway/policy-dsl (`{}` = defaults);
/// `settings_sha256` = sha256 of its canonical JSON. **Every api transaction that changes what
/// evaluation sees** (publish with activation, activate/rollback, enable/disable/delete of a
/// policy, a settings change) locks this row `FOR UPDATE` (creating it if absent) and increments
/// `generation`: the single serialization point per organization; the policy-engine reads it in
/// every evaluation transaction (no row = generation 0). `row_version` is the CAS counter of
/// settings edits. Deleted explicitly by organization deletion (no cascade).
model PolicySettings {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId  BigInt   @unique @map("organization_id") @db.UnsignedBigInt
  generation      BigInt   @default(0) @db.UnsignedBigInt
  settings        Json
  settingsSha256  String   @map("settings_sha256") @db.Char(64)
  rowVersion      Int      @default(1) @map("row_version") @db.UnsignedInt
  updatedByUserId BigInt?  @map("updated_by_user_id") @db.UnsignedBigInt
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  updatedBy    User?        @relation("PolicySettingsUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("policy_settings")
}

/// A tenant directory department (step 5.2 P5): named group of addresses and users referenced
/// by policies (`recipient.department`, `sender.department`). Managed by the api under
/// `user:read` / `user:manage`; a department referenced by an active policy version cannot be
/// deleted (the api checks `policy_versions.references`). Membership is live data (no publish
/// needed). Deleted explicitly by organization deletion (no cascade).
model TenantDepartment {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  /// UUIDv7; the only id the API and policy definitions use.
  publicId        String   @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  organizationId  BigInt   @map("organization_id") @db.UnsignedBigInt
  name            String   @db.VarChar(128)
  description     String?  @db.VarChar(512)
  rowVersion      Int      @default(1) @map("row_version") @db.UnsignedInt
  createdByUserId BigInt?  @map("created_by_user_id") @db.UnsignedBigInt
  updatedByUserId BigInt?  @map("updated_by_user_id") @db.UnsignedBigInt
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("DepartmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy    User?        @relation("DepartmentUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  members TenantDepartmentMember[]

  @@unique([organizationId, name])
  @@map("tenant_departments")
}

/// A member of a department (step 5.2 P5): **exactly one** of a normalized (lower-cased) address
/// or a `users` id of the organization. A user member resolves through that user's `email` while
/// the user is active and not deleted; deleting the user deletes the membership (CASCADE).
/// "Exactly one of" is enforced by the api only: MySQL refuses a CHECK constraint on `user_id`
/// because the column carries a foreign key referential action (ER 3823; step 5.2 WP1 note).
model TenantDepartmentMember {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  publicId        String   @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  organizationId  BigInt   @map("organization_id") @db.UnsignedBigInt
  departmentId    BigInt   @map("department_id") @db.UnsignedBigInt
  /// Normalized address (lower-cased); NULL for a user member.
  address         String?  @db.VarChar(320)
  userId          BigInt?  @map("user_id") @db.UnsignedBigInt
  createdByUserId BigInt?  @map("created_by_user_id") @db.UnsignedBigInt
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  department   TenantDepartment @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  user         User?            @relation("DepartmentMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy    User?            @relation("DepartmentMemberCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([departmentId, address])
  @@unique([departmentId, userId])
  @@index([organizationId, address(length: 100)])
  @@map("tenant_department_members")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly (6 months, core; step 5.2 §3, P10, P16).
/// One policy evaluation per message and lifecycle round, written by the policy-engine in the
/// evaluation transaction: **`evaluation_seq` = the lifecycle round** (unique
/// `(message_id, evaluation_seq, received_at)` is the idempotency backstop). Never updated;
/// deleted only by retention and organization purge. Ids, codes, enums, integers, hashes and
/// tenant policy identifiers only: never message content (no subject, body, file name, URL,
/// header value or address). The JSON columns hold the bounded `PolicyEvaluationResult` fields of
/// @email-gateway/policy-dsl (mapping `evaluationResultToRow` / `rowToEvaluationView`). No foreign
/// keys. Note: `trigger` is a reserved word in MySQL; hand-written SQL must quote it.
model PolicyExecutionLog {
  id                      BigInt                  @default(autoincrement()) @db.UnsignedBigInt
  receivedAt              DateTime                @map("received_at") @db.DateTime(3)
  messageId               BigInt                  @map("message_id") @db.UnsignedBigInt
  organizationId          BigInt                  @map("organization_id") @db.UnsignedBigInt
  /// The lifecycle round evaluated (email_messages.lifecycle_round of the round).
  evaluationSeq           Int                     @map("evaluation_seq") @db.UnsignedSmallInt
  /// email_scans.id of the round; NULL for a parse-failure evaluation (no round scanned).
  scanId                  BigInt?                 @map("scan_id") @db.UnsignedBigInt
  trigger                 PolicyEvaluationTrigger
  /// email_messages.direction (trusted).
  direction               MessageDirection
  disposition             PolicyDisposition
  decisionSource          PolicyDecisionSource    @map("decision_source")
  /// policy_versions.id of the decisive tenant rule's version; NULL otherwise (no FK).
  decisivePolicyVersionId BigInt?                 @map("decisive_policy_version_id") @db.UnsignedBigInt
  /// email_policies.public_id of the decisive tenant rule; NULL otherwise.
  decisivePolicyPublicId  String?                 @map("decisive_policy_public_id") @db.Char(36)
  decisiveRuleId          String?                 @map("decisive_rule_id") @db.VarChar(48)
  /// The final action written to email_messages.final_action (P18).
  action                  MessageAction
  finalVerdict            MessageVerdict          @map("final_verdict")
  /// Max risk score over the round's revisions; NULL without a risk row.
  riskScore               Int?                    @map("risk_score") @db.UnsignedSmallInt
  overrideApplied         Boolean                 @default(false) @map("override_applied")
  /// JSON array of policy_versions.id (decimal strings) of matched rules' versions.
  matchedPolicyVersionIds Json                    @map("matched_policy_version_ids")
  /// JSON array (≤ 9) of `{ type, params, origin, ruleRefs, applicability, status }`.
  actions                 Json
  /// JSON array (≤ 64) of `{ ref, policyPublicId, versionNo, ruleId, disposition, actionTypes, override }`.
  matchedRules            Json                    @map("matched_rules")
  /// JSON array (≤ 200) of `{ ref, result, at, path, field, op }` (P10 trace) plus truncation.
  trace                   Json?
  /// JSON object `{ disposition, tag, reasons }`.
  floor                   Json
  /// JSON object `{ disposition, tag, levelOnly, riskAction, revisions }`.
  recommendation          Json
  /// JSON object `{ applied, ref, from, to }`; NULL when no override applied.
  overrideDetail          Json?                   @map("override_detail")
  /// JSON array (≤ 16) of `{ ref, from, to, reason }`.
  clamps                  Json
  /// JSON array (≤ 32) of `policy.*` reason codes.
  reasonCodes             Json                    @map("reason_codes")
  /// JSON object `{ headers, subjectPrefix, bodyBanner, urlRewrite }` built from policy data only
  /// (never message data); NULL when nothing is delivered.
  delivery                Json?
  deliveredObject         PolicyDeliveredObject   @map("delivered_object")
  /// S3 key of the policy copy (`org/<org>/policy/...`) only; NULL otherwise.
  objectKey               String?                 @map("object_key") @db.VarChar(512)
  /// JSON array (≤ 24) of explanation lines `{ code, params }`.
  explanation             Json
  /// Rendered explanation (fixed templates over codes, ids and integers).
  explanationText         String                  @map("explanation_text") @db.VarChar(2048)
  /// Step 5.3 Q4: true when the recipients were decided differently (per-recipient evaluation).
  recipientSplit          Boolean                 @default(false) @map("recipient_split")
  /// Step 5.3 Q4: JSON array (≤ 200) of `{ rcptSeq, disposition, source, decisiveRuleRef,
  /// reasonCodes }` when the evaluation ran per recipient; NULL for a message-level evaluation.
  /// Sequence numbers, enums and codes only (never addresses).
  recipientDecisions      Json?                   @map("recipient_decisions")
  /// policy_settings.generation read in the evaluation transaction (0 = no settings row).
  policyGeneration        BigInt                  @map("policy_generation") @db.UnsignedBigInt
  snapshotSha256          String                  @map("snapshot_sha256") @db.Char(64)
  /// JSON array of `{ policyPublicId, versionNo, definitionSha256 }` of the snapshot (sorted).
  policyVersions          Json                    @map("policy_versions")
  /// `pol-default/1`.
  platformDefaultId       String                  @map("platform_default_id") @db.VarChar(32)
  /// `policy-dsl/1`.
  dslVersion              String                  @map("dsl_version") @db.VarChar(32)
  /// `policy-eval/1` (5.2) or `policy-eval/2` (5.3: per-recipient).
  evaluatorVersion        String                  @map("evaluator_version") @db.VarChar(32)
  /// `policy-input/1`.
  inputVersion            String                  @map("input_version") @db.VarChar(32)
  /// Hex SHA-256 of the canonical evaluation input.
  inputSha256             String                  @map("input_sha256") @db.Char(64)
  /// ICU time-zone data version used for time conditions.
  tzdataVersion           String                  @map("tzdata_version") @db.VarChar(16)
  durationUs              Int                     @map("duration_us") @db.UnsignedInt
  evaluatedAt             DateTime                @map("evaluated_at") @db.DateTime(3)
  createdAt               DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  /// `ato-policy-facts/1` block used by the evaluation (step 8.4 D23); NULL when absent.
  atoFacts                Json?                   @map("ato_facts")

  @@id([id, receivedAt])
  @@unique([messageId, evaluationSeq, receivedAt])
  @@index([organizationId, receivedAt])
  @@index([organizationId, disposition, receivedAt])
  @@index([organizationId, decisivePolicyPublicId, receivedAt])
  /// Step 7.3: direction-filtered history and sample dry-run read a bounded index range.
  @@index([organizationId, direction, receivedAt])
  @@map("policy_execution_logs")
}

// ---------------------------------------------------------------------------------------------
// 3.7 Delivery
// ---------------------------------------------------------------------------------------------

model DeliveryRoute {
  id             BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId BigInt         @map("organization_id") @db.UnsignedBigInt
  domainId       BigInt?        @map("domain_id") @db.UnsignedBigInt
  direction      RouteDirection
  matchType      RouteMatchType @map("match_type")
  matchValue     String?        @map("match_value") @db.VarChar(320)
  mailServerId   BigInt?        @map("mail_server_id") @db.UnsignedBigInt
  smartHost      String?        @map("smart_host") @db.VarChar(255)
  port           Int?           @db.UnsignedSmallInt
  tlsMode        TlsMode        @default(opportunistic) @map("tls_mode")
  priority       Int
  enabled        Boolean        @default(true)
  createdAt      DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  domain       Domain?           @relation(fields: [domainId], references: [id], onDelete: Cascade)
  mailServer   DomainMailServer? @relation(fields: [mailServerId], references: [id], onDelete: SetNull)

  @@index([organizationId, direction, enabled, priority])
  @@map("delivery_routes")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly. One row per recipient and delivery
/// (step 2.3 R7, R9): `delivery_seq` 0 = initial delivery, then releases or redirects. Status
/// changes only through the shared recorder (@email-gateway/mail-routing). No foreign keys.
model EmailDelivery {
  id                BigInt            @default(autoincrement()) @db.UnsignedBigInt
  receivedAt        DateTime          @map("received_at") @db.DateTime(3)
  messageId         BigInt            @map("message_id") @db.UnsignedBigInt
  recipientId       BigInt            @map("recipient_id") @db.UnsignedBigInt
  organizationId    BigInt            @map("organization_id") @db.UnsignedBigInt
  deliverySeq       Int               @default(0) @map("delivery_seq") @db.UnsignedSmallInt
  routeId           BigInt?           @map("route_id") @db.UnsignedBigInt
  status            DeliveryStatus    @default(pending)
  attemptCount      Int               @default(0) @map("attempt_count") @db.UnsignedSmallInt
  lastAttemptAt     DateTime?         @map("last_attempt_at") @db.DateTime(3)
  deliveredAt       DateTime?         @map("delivered_at") @db.DateTime(3)
  remoteHost        String?           @map("remote_host") @db.VarChar(255)
  finalSmtpCode     Int?              @map("final_smtp_code") @db.UnsignedSmallInt
  finalSmtpResponse String?           @map("final_smtp_response") @db.VarChar(512)
  /// Queue id of postfix-outbound for this recipient's reinjection; matched against the
  /// delivery log and DSN copies (step 2.3 R9).
  /// Collation utf8mb4_bin (case-sensitive Postfix queue ids, step 3.3).
  outboundQueueId   String?           @map("outbound_queue_id") @db.VarChar(32)
  /// delivery_reinjections.id of the group that carries this recipient (same received_at).
  reinjectionId     BigInt?           @map("reinjection_id") @db.UnsignedBigInt
  /// Routed direction of this recipient (step 2.3 R1).
  direction         MessageDirection?
  /// `tenant:<domainId>` | `mx:<recipient domain>`.
  destinationKey    String?           @map("destination_key") @db.VarChar(300)
  statusChangedAt   DateTime?         @map("status_changed_at") @db.DateTime(3)
  /// Time of the newest applied signal (out-of-order handling, step 2.3 R9.1).
  lastSignalAt      DateTime?         @map("last_signal_at") @db.DateTime(3)
  enhancedStatus    String?           @map("enhanced_status") @db.VarChar(16)
  /// Error class of the last failure or deferral (step 2.3 R9.2).
  lastErrorClass    String?           @map("last_error_class") @db.VarChar(32)
  /// Gateway-side reason: direction_changed, recipient_domain_inactive, loop_detected,
  /// reinjection_refused, reinjection_expired, content_missing, status_signal_missing, suppressed.
  failureReason     String?           @map("failure_reason") @db.VarChar(64)
  /// Queue id of the DSN Postfix generated to the original sender (step 2.3 R9). Collation
  /// utf8mb4_bin (case-sensitive Postfix queue ids, step 3.3).
  dsnQueueId        String?           @map("dsn_queue_id") @db.VarChar(32)
  createdAt         DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.DateTime(3)

  @@id([id, receivedAt])
  @@unique([recipientId, deliverySeq, receivedAt])
  @@index([messageId, receivedAt])
  @@index([status, lastAttemptAt])
  @@index([outboundQueueId])
  @@index([organizationId, receivedAt, id])
  /// The recipients of one reinjection: token matching, queue-id binding, reconciler scans.
  @@index([reinjectionId, receivedAt])
  /// Step 7.1 §3.2: index-only delivery report (status counts and delivery latency per bucket).
  @@index([organizationId, receivedAt, status, deliveredAt], map: "email_deliveries_org_received_status_idx")
  /// Step 7.2 §3.1: the explorer's `deliveryStatus` driver (grouped by message in keyset order).
  @@index([organizationId, status, receivedAt, messageId], map: "email_deliveries_org_status_received_message_idx")
  @@map("email_deliveries")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly (6 months, core). One SMTP transaction into
/// postfix-outbound for a group of recipients of one message (step 2.3 R7, R8). No foreign keys.
model DeliveryReinjection {
  id                 BigInt              @default(autoincrement()) @db.UnsignedBigInt
  receivedAt         DateTime            @map("received_at") @db.DateTime(3)
  /// UUIDv7; the token `dw1-<32 hex>` (XFORWARD IDENT, ENVID) is derived from it.
  publicId           String              @default(uuid(7)) @map("public_id") @db.Char(36)
  messageId          BigInt              @map("message_id") @db.UnsignedBigInt
  organizationId     BigInt              @map("organization_id") @db.UnsignedBigInt
  deliverySeq        Int                 @default(0) @map("delivery_seq") @db.UnsignedSmallInt
  listener           ReinjectionListener
  direction          MessageDirection
  /// `tenant:<domainId>` | `mx:<recipient domain>`.
  destinationKey     String              @map("destination_key") @db.VarChar(300)
  /// S3 key of the EML to deliver (from the approval; `org/{organizationId}/…`).
  emlObjectKey       String              @map("eml_object_key") @db.VarChar(512)
  recipientCount     Int                 @map("recipient_count") @db.UnsignedSmallInt
  /// Hex SHA-256 of the group's addresses, lower-cased, de-duplicated, sorted, LF-joined.
  recipientSetSha256 String              @map("recipient_set_sha256") @db.Char(64)
  /// Hex SHA-256(`v1|{messageId}|{deliverySeq}|{listener}|{recipientSetSha256}`) (step 2.3 R7).
  idempotencyKey     String              @map("idempotency_key") @db.Char(64)
  /// Envelope event id of the approval that planned this group.
  approvalEventId    String              @map("approval_event_id") @db.Char(36)
  status             ReinjectionStatus   @default(pending)
  attempts           Int                 @default(0) @db.UnsignedSmallInt
  nextAttemptAt      DateTime            @map("next_attempt_at") @db.DateTime(3)
  leaseExpiresAt     DateTime?           @map("lease_expires_at") @db.DateTime(3)
  startedAt          DateTime?           @map("started_at") @db.DateTime(3)
  queuedAt           DateTime?           @map("queued_at") @db.DateTime(3)
  /// postfix-outbound queue id (from the `250 … queued as` reply or the log binding). Collation
  /// utf8mb4_bin (case-sensitive Postfix queue ids, step 3.3).
  queueId            String?             @map("queue_id") @db.VarChar(32)
  lastErrorClass     String?             @map("last_error_class") @db.VarChar(32)
  /// Last error text (reply or reason), ≤ 512 characters; never message content.
  lastError          String?             @map("last_error") @db.VarChar(512)
  createdAt          DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.DateTime(3)

  @@id([id, receivedAt])
  @@unique([messageId, idempotencyKey, receivedAt])
  @@index([status, nextAttemptAt])
  @@index([queueId])
  @@index([publicId])
  @@map("delivery_reinjections")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly (3 months, detail). Append-only delivery
/// audit: every status signal, applied or not (step 2.3 R9.1). Services never update or delete
/// it. No foreign keys.
model DeliveryStatusEvent {
  id             BigInt               @default(autoincrement()) @db.UnsignedBigInt
  receivedAt     DateTime             @map("received_at") @db.DateTime(3)
  deliveryId     BigInt               @map("delivery_id") @db.UnsignedBigInt
  messageId      BigInt               @map("message_id") @db.UnsignedBigInt
  recipientId    BigInt               @map("recipient_id") @db.UnsignedBigInt
  organizationId BigInt               @map("organization_id") @db.UnsignedBigInt
  source         DeliverySignalSource
  /// Hex SHA-256 of the source-specific signal key (step 2.3 R9.1 "Signal keys").
  signalKey      String               @map("signal_key") @db.Char(64)
  occurredAt     DateTime             @map("occurred_at") @db.DateTime(3)
  fromStatus     DeliveryStatus?      @map("from_status")
  toStatus       DeliveryStatus       @map("to_status")
  /// False for stale or conflicting signals (kept for the audit trail).
  applied        Boolean
  /// Collation utf8mb4_bin (case-sensitive Postfix queue ids, step 3.3).
  queueId        String?              @map("queue_id") @db.VarChar(32)
  smtpCode       Int?                 @map("smtp_code") @db.UnsignedSmallInt
  enhancedStatus String?              @map("enhanced_status") @db.VarChar(16)
  remoteHost     String?              @map("remote_host") @db.VarChar(255)
  errorClass     String?              @map("error_class") @db.VarChar(32)
  /// Remote reply or reason text, ≤ 1024 characters; never message content.
  detail         String?              @db.VarChar(1024)
  createdAt      DateTime             @default(now()) @map("created_at") @db.DateTime(3)

  @@id([id, receivedAt])
  @@unique([deliveryId, signalKey, receivedAt])
  @@index([messageId, receivedAt])
  @@map("delivery_status_events")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly. Append-only. No foreign keys.
model DeliveryAttempt {
  id             BigInt                 @default(autoincrement()) @db.UnsignedBigInt
  receivedAt     DateTime               @map("received_at") @db.DateTime(3)
  deliveryId     BigInt                 @map("delivery_id") @db.UnsignedBigInt
  messageId      BigInt                 @map("message_id") @db.UnsignedBigInt
  organizationId BigInt                 @map("organization_id") @db.UnsignedBigInt
  attemptNo      Int                    @map("attempt_no") @db.UnsignedSmallInt
  startedAt      DateTime               @map("started_at") @db.DateTime(3)
  completedAt    DateTime?              @map("completed_at") @db.DateTime(3)
  remoteHost     String?                @map("remote_host") @db.VarChar(255)
  remoteIp       String?                @map("remote_ip") @db.VarChar(45)
  smtpCode       Int?                   @map("smtp_code") @db.UnsignedSmallInt
  enhancedStatus String?                @map("enhanced_status") @db.VarChar(16)
  smtpResponse   String?                @map("smtp_response") @db.VarChar(512)
  outcome        DeliveryAttemptOutcome
  tlsProtocol    String?                @map("tls_protocol") @db.VarChar(16)
  createdAt      DateTime               @default(now()) @map("created_at") @db.DateTime(3)

  @@id([id, receivedAt])
  @@unique([deliveryId, attemptNo, receivedAt])
  @@map("delivery_attempts")
}

model DeliverySuppression {
  id              BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId  BigInt            @map("organization_id") @db.UnsignedBigInt
  address         String            @db.VarChar(320)
  reason          SuppressionReason
  source          String?           @db.VarChar(64)
  expiresAt       DateTime?         @map("expires_at") @db.DateTime(3)
  createdByUserId BigInt?           @map("created_by_user_id") @db.UnsignedBigInt
  createdAt       DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, address])
  @@index([expiresAt])
  /// Step 6.1: keyset list newest first per organization.
  @@index([organizationId, id], map: "delivery_suppressions_organization_id_id_idx")
  @@map("delivery_suppressions")
}

/// PARTITIONED by RANGE COLUMNS(occurred_at), monthly. `occurred_at` is the parsed DSN arrival
/// date (deterministic), so the dedupe unique key works on redelivery. No foreign keys.
model BounceEvent {
  id                BigInt     @default(autoincrement()) @db.UnsignedBigInt
  occurredAt        DateTime   @map("occurred_at") @db.DateTime(3)
  organizationId    BigInt     @map("organization_id") @db.UnsignedBigInt
  /// Set when the notice matches a reinjection, step 2.3 (with message_received_at).
  messageId         BigInt?    @map("message_id") @db.UnsignedBigInt
  messageReceivedAt DateTime?  @map("message_received_at") @db.DateTime(3)
  recipientAddress  String     @map("recipient_address") @db.VarChar(320)
  bounceType        BounceType @map("bounce_type")
  smtpCode          Int?       @map("smtp_code") @db.UnsignedSmallInt
  enhancedStatus    String?    @map("enhanced_status") @db.VarChar(16)
  diagnostic        String?    @db.VarChar(1024)
  reportingMta      String?    @map("reporting_mta") @db.VarChar(255)
  dsnObjectKey      String?    @map("dsn_object_key") @db.VarChar(512)
  dedupeKey         String     @map("dedupe_key") @db.Char(64)
  createdAt         DateTime   @default(now()) @map("created_at") @db.DateTime(3)

  @@id([id, occurredAt])
  @@unique([organizationId, dedupeKey, occurredAt])
  @@index([organizationId, recipientAddress(length: 100), occurredAt])
  @@map("bounce_events")
}

// ---------------------------------------------------------------------------------------------
// 3.8 Quarantine (not partitioned)
// ---------------------------------------------------------------------------------------------

/// Quarantine entry (step 5.3 Q3, ADR-0046): one row per (message, lifecycle round, recipient),
/// unique `(message_id, lifecycle_round, rcpt_seq)`. The SQL column `status` is the entry
/// **state** of the design and the API.
/// Writers (Q31): created by the policy-engine (evaluation transaction, adoption by the sweeper)
/// and the api (manual quarantine); state changes by the api (user actions) and the policy-engine
/// (executor, sweeper, supersede), always under the message lifecycle lock with a compare-and-set
/// on `row_version` (lock order message → entries → approval requests).
/// Content-free (§2.0 invariant 1): ids, enums, codes, integers, hashes, addresses already stored
/// by earlier steps (recipient, envelope sender, header From) and the content-free policy
/// explanation. `subject` (1.1) is RETIRED: never written from 5.3 on; a subject is read from
/// `email_messages.subject` at response time only. The bytes stay in S3 (`eml_object_key`).
/// `message_id`, `recipient_id`, `scan_id`, `policy_version_id` and `approval_request_id` have
/// no FK (partitioned targets; the approval request FK would be a cycle).
model QuarantineMessage {
  id                      BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  publicId                String                  @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  organizationId          BigInt                  @map("organization_id") @db.UnsignedBigInt
  messageId               BigInt                  @map("message_id") @db.UnsignedBigInt
  messageReceivedAt       DateTime                @map("message_received_at") @db.DateTime(3)
  /// email_messages.lifecycle_round of the evaluation that created the entry.
  lifecycleRound          Int                     @default(0) @map("lifecycle_round") @db.UnsignedSmallInt
  /// email_scans.id of the round; NULL for a parse-failure evaluation or an adoption without one.
  scanId                  BigInt?                 @map("scan_id") @db.UnsignedBigInt
  /// policy_execution_logs.evaluation_seq (= the round) of the deciding evaluation.
  evaluationSeq           Int?                    @map("evaluation_seq") @db.UnsignedSmallInt
  recipientId             BigInt                  @map("recipient_id") @db.UnsignedBigInt
  /// email_recipients.rcpt_seq.
  rcptSeq                 Int                     @default(0) @map("rcpt_seq") @db.UnsignedSmallInt
  /// Lower-cased.
  recipientAddress        String                  @map("recipient_address") @db.VarChar(320)
  /// The organization's active user whose email equals the recipient (informational; self-service
  /// scopes by address, Q15).
  userId                  BigInt?                 @map("user_id") @db.UnsignedBigInt
  direction               MessageDirection
  kind                    QuarantineEntryKind
  origin                  QuarantineOrigin
  reason                  QuarantineReason
  /// policy_versions.id of the decisive tenant rule's version (no FK).
  policyVersionId         BigInt?                 @map("policy_version_id") @db.UnsignedBigInt
  /// The entry state (Q3).
  status                  QuarantineStatus        @default(held)
  envelopeFrom            String                  @map("envelope_from") @db.VarChar(320)
  headerFrom              String?                 @map("header_from") @db.VarChar(320)
  /// RETIRED (step 5.3 §2.0): never written; kept only so no data is dropped.
  subject                 String?                 @db.VarChar(998)
  hasAttachments          Boolean                 @default(false) @map("has_attachments")
  attachmentCount         Int                     @default(0) @map("attachment_count") @db.UnsignedSmallInt
  sizeBytes               Int                     @default(0) @map("size_bytes") @db.UnsignedInt
  /// Max over the round's risk revisions (5.1).
  riskScore               Int?                    @map("risk_score") @db.UnsignedSmallInt
  riskLevel               RiskLevel?              @map("risk_level")
  recommendedAction       RiskAction?             @map("recommended_action")
  riskVerdict             MessageVerdict?         @map("risk_verdict")
  hasHardBlock            Boolean                 @default(false) @map("has_hard_block")
  /// JSON array (≤ 9) of hard-block ids (`hb.*`).
  hardBlocks              Json?                   @map("hard_blocks")
  /// JSON array (≤ 32) of reason codes.
  reasonCodes             Json?                   @map("reason_codes")
  /// JSON array (≤ 16) of floor reasons.
  floorReasons            Json?                   @map("floor_reasons")
  primaryEngine           QuarantinePrimaryEngine @default(none) @map("primary_engine")
  decisionSource          PolicyDecisionSource?   @map("decision_source")
  decisivePolicyPublicId  String?                 @map("decisive_policy_public_id") @db.Char(36)
  decisivePolicyVersionNo Int?                    @map("decisive_policy_version_no") @db.UnsignedInt
  decisiveRuleId          String?                 @map("decisive_rule_id") @db.VarChar(48)
  /// JSON array (≤ 24) of the evaluation's explanation lines `{ code, params }`.
  explanation             Json?
  /// The rendered policy explanation (≤ 2048; content-free by construction, 5.2 P10).
  explanationText         String?                 @map("explanation_text") @db.VarChar(2048)
  /// The ORIGINAL EML (`email_messages.eml_object_key`).
  emlObjectKey            String                  @map("eml_object_key") @db.VarChar(512)
  quarantinedAt           DateTime                @map("quarantined_at") @db.DateTime(3)
  /// Fixed at creation (`computeExpiry`); a settings change applies to new entries.
  expiresAt               DateTime                @map("expires_at") @db.DateTime(3)
  stateChangedAt          DateTime                @map("state_changed_at") @db.DateTime(3)
  releasedAt              DateTime?               @map("released_at") @db.DateTime(3)
  /// Last operator decision (release, reject, delete, approval) on the entry.
  decidedAt               DateTime?               @map("decided_at") @db.DateTime(3)
  decidedByUserId         BigInt?                 @map("decided_by_user_id") @db.UnsignedBigInt
  decidedByType           ActorType?              @map("decided_by_type")
  /// Code of the terminal cause (e.g. `expired`, `superseded`, `rejected`); never free text.
  terminalReason          String?                 @map("terminal_reason") @db.VarChar(64)
  /// quarantine_approval_requests.id of the entry's current pending request (no FK: cycle).
  approvalRequestId       BigInt?                 @map("approval_request_id") @db.UnsignedBigInt
  /// Set by the purge sweeper when the message's objects were deleted (Q17).
  objectPurgedAt          DateTime?               @map("object_purged_at") @db.DateTime(3)
  /// Compare-and-set counter of every state change.
  rowVersion              Int                     @default(1) @map("row_version") @db.UnsignedInt
  createdAt               DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt               DateTime                @updatedAt @map("updated_at") @db.DateTime(3)

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user          User?        @relation("QuarantineEntryUser", fields: [userId], references: [id], onDelete: SetNull)
  decidedByUser User?        @relation("QuarantineEntryDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  actions          QuarantineAction[]
  releaseLogs      QuarantineReleaseLog[]
  approvalRequests QuarantineApprovalRequest[]
  downloadGrants   QuarantineDownloadGrant[]

  @@unique([messageId, lifecycleRound, rcptSeq])
  @@index([organizationId, quarantinedAt, id])
  @@index([organizationId, status, quarantinedAt, id])
  @@index([organizationId, recipientAddress(length: 100), quarantinedAt, id])
  @@index([organizationId, envelopeFrom(length: 100), quarantinedAt])
  @@index([organizationId, reason, quarantinedAt])
  @@index([organizationId, decisivePolicyPublicId, quarantinedAt])
  @@index([organizationId, primaryEngine, quarantinedAt])
  @@index([status, expiresAt])
  @@index([status, stateChangedAt])
  /// Step 7.2 §3.1: the explorer's `quarantineStatus` driver, keyed by the message's time.
  @@index([organizationId, status, messageReceivedAt, messageId], map: "quarantine_messages_org_status_received_message_idx")
  @@map("quarantine_messages")
}

/// Append-only audit of every action on an entry (step 5.3 Q21): user actions (api) and system
/// actions (policy-engine: creation, executor outcomes, expiry, adoption, supersede, purge).
/// `reason` = the operator's typed reason (≤ 512); `details` = ids, codes and counts only.
model QuarantineAction {
  id                  BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId      BigInt               @map("organization_id") @db.UnsignedBigInt
  quarantineMessageId BigInt               @map("quarantine_message_id") @db.UnsignedBigInt
  action              QuarantineActionType
  actorType           ActorType            @map("actor_type")
  actorUserId         BigInt?              @map("actor_user_id") @db.UnsignedBigInt
  /// Public id of the acting user or API key; NULL for system actions.
  actorId             String?              @map("actor_id") @db.VarChar(64)
  reason              String?              @db.VarChar(512)
  /// Outcome code (e.g. `queued`, `approval_required`, `refused`).
  result              String?              @db.VarChar(64)
  details             Json?
  /// quarantine_release_logs.id / quarantine_approval_requests.id concerned (no FK).
  releaseLogId        BigInt?              @map("release_log_id") @db.UnsignedBigInt
  approvalRequestId   BigInt?              @map("approval_request_id") @db.UnsignedBigInt
  /// Hash of the request's Idempotency-Key (unique per organization).
  idempotencyKey      String?              @map("idempotency_key") @db.VarChar(64)
  createdAt           DateTime             @default(now()) @map("created_at") @db.DateTime(3)

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  quarantineMessage QuarantineMessage @relation(fields: [quarantineMessageId], references: [id], onDelete: Cascade)
  actorUser         User?             @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  releaseLog QuarantineReleaseLog?

  @@unique([organizationId, idempotencyKey])
  @@index([quarantineMessageId, createdAt])
  @@index([organizationId, createdAt])
  @@map("quarantine_actions")
}

/// One entry's release attempt (step 5.3 Q13). The api inserts it (`pending`, `precheck`); the
/// policy-engine executor completes it (`revalidation`, delivered object, delivery sequence).
/// `release_public_id` groups the rows of one release request (unique per entry). JSON columns
/// hold the content-free 13.3 summary (dispositions, codes, levels, hashes, ids).
/// `revalidation_scan_id` and `delivery_id` have no FK (partitioned targets).
model QuarantineReleaseLog {
  id                  BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId      BigInt                  @map("organization_id") @db.UnsignedBigInt
  quarantineMessageId BigInt                  @map("quarantine_message_id") @db.UnsignedBigInt
  actionId            BigInt                  @unique @map("action_id") @db.UnsignedBigInt
  releasePublicId     String                  @map("release_public_id") @db.Char(36)
  mode                QuarantineReleaseMode
  /// quarantine_approval_requests.id when `mode = approved` (no FK).
  approvalRequestId   BigInt?                 @map("approval_request_id") @db.UnsignedBigInt
  requestedByType     ActorType               @map("requested_by_type")
  /// Public id of the requesting user or API key; NULL for the system.
  requestedById       String?                 @map("requested_by_id") @db.VarChar(64)
  releasedTo          String                  @map("released_to") @db.VarChar(320)
  revalidationScanId  BigInt?                 @map("revalidation_scan_id") @db.UnsignedBigInt
  revalidationVerdict MessageVerdict?         @map("revalidation_verdict")
  /// The api's advisory pre-check (13.1).
  precheck            Json?
  /// The executor's authoritative re-validation (13.3 summary, reasons, staleness).
  revalidation        Json?
  deliveredObject     PolicyDeliveredObject?  @map("delivered_object")
  /// S3 key of the delivered object (release policy copy or base).
  objectKey           String?                 @map("object_key") @db.VarChar(512)
  deliverySeq         Int?                    @map("delivery_seq") @db.UnsignedInt
  /// JSON array of the `mail.delivery.approved.v1` event ids written.
  approvalEventIds    Json?                   @map("approval_event_ids")
  lifecycleRoundAfter Int?                    @map("lifecycle_round_after") @db.UnsignedSmallInt
  blockedReason       String?                 @map("blocked_reason") @db.VarChar(64)
  deliveryId          BigInt?                 @map("delivery_id") @db.UnsignedBigInt
  status              QuarantineReleaseStatus @default(pending)
  completedAt         DateTime?               @map("completed_at") @db.DateTime(3)
  createdAt           DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime                @updatedAt @map("updated_at") @db.DateTime(3)

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  quarantineMessage QuarantineMessage @relation(fields: [quarantineMessageId], references: [id], onDelete: Cascade)
  action            QuarantineAction  @relation(fields: [actionId], references: [id], onDelete: Restrict)

  @@unique([quarantineMessageId, releasePublicId])
  @@index([organizationId, createdAt])
  @@index([releasePublicId])
  @@map("quarantine_release_logs")
}

/// The one approval model (step 5.3 Q14, ADR-0047): `policy_review` (REQUIRE_APPROVAL; created by
/// the policy-engine), `release_approval` (a release with approval reasons; api or executor),
/// `release_request` (a user or end-user request; api). Decisions by the api (separation of
/// duties: decider ≠ requester ≠ recipient); expiry by the policy-engine sweeper. One `pending`
/// request per entry (entry `approval_request_id`, enforced under the entry lock).
/// Content-free: `approval_reasons` / `approved_reasons` are JSON arrays of reason codes;
/// `request_reason` / `decision_reason` are the operator's typed reasons.
/// `requested_by_api_key_id` has no FK (the trail survives the key).
model QuarantineApprovalRequest {
  id                     BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  publicId               String                   @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  organizationId         BigInt                   @map("organization_id") @db.UnsignedBigInt
  quarantineMessageId    BigInt                   @map("quarantine_message_id") @db.UnsignedBigInt
  kind                   QuarantineApprovalKind
  status                 QuarantineApprovalStatus @default(pending)
  approvalReasons        Json                     @map("approval_reasons")
  approvedReasons        Json?                    @map("approved_reasons")
  requestedByType        ActorType                @map("requested_by_type")
  requestedByUserId      BigInt?                  @map("requested_by_user_id") @db.UnsignedBigInt
  requestedByApiKeyId    BigInt?                  @map("requested_by_api_key_id") @db.UnsignedBigInt
  requestReason          String?                  @map("request_reason") @db.VarChar(512)
  decidedByUserId        BigInt?                  @map("decided_by_user_id") @db.UnsignedBigInt
  decisionReason         String?                  @map("decision_reason") @db.VarChar(512)
  /// Hex SHA-256 of the decider's permission set at decision time.
  deciderPermissionsHash String?                  @map("decider_permissions_hash") @db.Char(64)
  expiresAt              DateTime                 @map("expires_at") @db.DateTime(3)
  decidedAt              DateTime?                @map("decided_at") @db.DateTime(3)
  rowVersion             Int                      @default(1) @map("row_version") @db.UnsignedInt
  createdAt              DateTime                 @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt              DateTime                 @updatedAt @map("updated_at") @db.DateTime(3)

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  quarantineMessage QuarantineMessage @relation(fields: [quarantineMessageId], references: [id], onDelete: Cascade)
  requestedByUser   User?             @relation("QuarantineApprovalRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  decidedByUser     User?             @relation("QuarantineApprovalDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@index([status, expiresAt])
  @@index([quarantineMessageId, createdAt])
  @@map("quarantine_approval_requests")
}

/// Single-use download grant (step 5.3 Q12, ADR-0048). Written and consumed by the api only
/// (`UPDATE … SET consumed_at WHERE jti AND organization_id AND user_id AND consumed_at IS NULL
/// AND expires_at > now`). The token itself is never stored (only its `jti`). Deleted by the
/// policy-engine sweeper one day after expiry.
model QuarantineDownloadGrant {
  id                  BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  /// UUIDv7 token id.
  jti                 String                   @unique @db.Char(36)
  organizationId      BigInt                   @map("organization_id") @db.UnsignedBigInt
  userId              BigInt                   @map("user_id") @db.UnsignedBigInt
  quarantineMessageId BigInt                   @map("quarantine_message_id") @db.UnsignedBigInt
  object              QuarantineDownloadObject
  /// email_attachments.part_index for `object = attachment`.
  partIndex           Int?                     @map("part_index") @db.UnsignedSmallInt
  expiresAt           DateTime                 @map("expires_at") @db.DateTime(3)
  consumedAt          DateTime?                @map("consumed_at") @db.DateTime(3)
  sourceIp            String?                  @map("source_ip") @db.VarChar(45)
  createdAt           DateTime                 @default(now()) @map("created_at") @db.DateTime(3)

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user              User              @relation("QuarantineDownloadGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  quarantineMessage QuarantineMessage @relation(fields: [quarantineMessageId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("quarantine_download_grants")
}

/// Tenant quarantine settings (step 5.3 Q24): strict `quarantineSettingsSchema` of
/// @email-gateway/quarantine, every key optional (`{}` = defaults). Written by the api only
/// (`PUT /quarantine/settings`, CAS on `row_version`). No message data.
model QuarantineSettings {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId  BigInt   @unique @map("organization_id") @db.UnsignedBigInt
  settings        Json
  /// Hex SHA-256 of the canonical settings JSON.
  settingsSha256  String   @map("settings_sha256") @db.Char(64)
  rowVersion      Int      @default(1) @map("row_version") @db.UnsignedInt
  updatedByUserId BigInt?  @map("updated_by_user_id") @db.UnsignedBigInt
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  updatedByUser User?        @relation("QuarantineSettingsUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("quarantine_settings")
}

/// End-user quarantine preferences (step 5.3 Q15, Q20). Written by the api only.
model QuarantineUserPreference {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId BigInt   @map("organization_id") @db.UnsignedBigInt
  userId         BigInt   @unique @map("user_id") @db.UnsignedBigInt
  digestOptOut   Boolean  @default(false) @map("digest_opt_out")
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation("QuarantineUserPreferenceUser", fields: [userId], references: [id], onDelete: Cascade)

  @@map("quarantine_user_preferences")
}

/// Object purge request of one message's S3 objects (step 5.3 Q17): inserted by the api (delete)
/// and the policy-engine (expiry), processed by the policy-engine sweeper, which re-checks legal
/// hold, retention, archive pending and shared-object rules at purge time. `reason` is a code
/// (`legal_hold`, `retention`, `archive_pending`, `shared`); never content. `message_id` has no FK.
model QuarantineObjectPurge {
  id                BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId    BigInt                @map("organization_id") @db.UnsignedBigInt
  messageId         BigInt                @map("message_id") @db.UnsignedBigInt
  messageReceivedAt DateTime              @map("message_received_at") @db.DateTime(3)
  status            QuarantinePurgeStatus @default(pending)
  reason            String?               @db.VarChar(64)
  purgeAfter        DateTime              @map("purge_after") @db.DateTime(3)
  attempts          Int                   @default(0) @db.UnsignedSmallInt
  lastErrorCode     String?               @map("last_error_code") @db.VarChar(64)
  purgedAt          DateTime?             @map("purged_at") @db.DateTime(3)
  createdAt         DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([messageId, messageReceivedAt])
  @@index([status, purgeAfter])
  @@map("quarantine_object_purges")
}

/// One digest or admin-alert run per organization and schedule instant (step 5.3 Q20; ≤ 1 per
/// hour, coalesced). Written by the policy-engine scheduler only. Kept 90 days (with its digests).
model QuarantineDigestRun {
  id             BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId BigInt               @map("organization_id") @db.UnsignedBigInt
  kind           QuarantineDigestKind
  scheduledFor   DateTime             @map("scheduled_for") @db.DateTime(3)
  windowFrom     DateTime             @map("window_from") @db.DateTime(3)
  usersTotal     Int                  @default(0) @map("users_total") @db.UnsignedInt
  usersDone      Int                  @default(0) @map("users_done") @db.UnsignedInt
  completedAt    DateTime?            @map("completed_at") @db.DateTime(3)
  createdAt      DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  digests QuarantineDigest[]

  @@unique([organizationId, kind, scheduledFor])
  @@index([createdAt])
  @@map("quarantine_digest_runs")
}

/// One user's digest of a run (step 5.3 Q20): ids and a count only; the notification-worker reads
/// the entries at send time. `event_id` = the outbox event id. Written by the policy-engine.
model QuarantineDigest {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  publicId       String   @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  runId          BigInt   @map("run_id") @db.UnsignedBigInt
  organizationId BigInt   @map("organization_id") @db.UnsignedBigInt
  userId         BigInt   @map("user_id") @db.UnsignedBigInt
  entryCount     Int      @default(0) @map("entry_count") @db.UnsignedInt
  eventId        String   @map("event_id") @db.Char(36)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  run          QuarantineDigestRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User                @relation("QuarantineDigestUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([runId, userId])
  @@map("quarantine_digests")
}

// ---------------------------------------------------------------------------------------------
// 3.9 Archiving (step 1.1 tables, extended by step 8.1: docs/plan/steps/23-journaling-archiving.md
// §3, ADR-0064 .. ADR-0069). No message content: bodies and attachments exist only inside the
// encrypted objects of the archive bucket; MySQL holds metadata, hashes, keys (wrapped) and codes.
// ---------------------------------------------------------------------------------------------

/// One row per organization; no row = archiving disabled (step 8.1 A22). `settings` is the strict
/// `archive-settings/1` document of @email-gateway/archive, every key optional, `NULL` = every
/// default (rows created before 8.1 keep working). The typed columns `enabled`, `object_lock_mode`
/// (API `immutability`) and `default_retention_policy_id` are authoritative. `generation` + 1 on
/// every change (capture intents record it); `journal_enabled_at` = last false → true of
/// `enabled` (no backfill before it). Written by the api only (`PUT /archive/settings`, CAS on
/// `row_version`).
model ArchiveSetting {
  id                       BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId           BigInt         @unique @map("organization_id") @db.UnsignedBigInt
  enabled                  Boolean        @default(false)
  /// RETIRED by step 8.1 (A22): kept for the rolling upgrade, never read or written; replaced by
  /// `settings.directions` / `settings.scope`. Dropped by a later contract migration.
  scope                    ArchiveScope   @default(all)
  defaultRetentionPolicyId BigInt?        @map("default_retention_policy_id") @db.UnsignedBigInt
  objectLockMode           ObjectLockMode @default(none) @map("object_lock_mode")
  /// RETIRED by step 8.1 (A8, A22): tenant keys live in `archive_encryption_keys`. Kept, never
  /// read or written; dropped by a later contract migration.
  encryptionKeyRef         String?        @map("encryption_key_ref") @db.VarChar(512)
  /// `archive-settings/1`; NULL = every default.
  settings                 Json?
  /// Hex SHA-256 of the canonical settings JSON (NULL while `settings` is NULL).
  settingsSha256           String?        @map("settings_sha256") @db.Char(64)
  generation               BigInt         @default(0) @db.UnsignedBigInt
  rowVersion               Int            @default(1) @map("row_version") @db.UnsignedInt
  journalEnabledAt         DateTime?      @map("journal_enabled_at") @db.DateTime(3)
  updatedByUserId          BigInt?        @map("updated_by_user_id") @db.UnsignedBigInt
  createdAt                DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                DateTime       @updatedAt @map("updated_at") @db.DateTime(3)

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  defaultRetentionPolicy ArchiveRetentionPolicy? @relation(fields: [defaultRetentionPolicyId], references: [id], onDelete: SetNull)
  updatedByUser          User?                   @relation("ArchiveSettingsUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("archive_settings")
}

/// Tenant retention policy (step 8.1 A11). `criteria` = `archive-retention/1` (NULL = matches
/// every record); live policies (`deleted_at IS NULL`) are evaluated by `priority` ascending then
/// id, the first match wins, else the settings' default policy. `retention_days` ≤ min(plan limit
/// `archive_retention_days`, ARCHIVE_MAX_RETENTION_DAYS). Soft-deleted (records keep their
/// `retention_policy_id`); the default policy cannot be deleted. Written by the api only.
model ArchiveRetentionPolicy {
  id              BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  /// UUIDv7 (rows created before step 8.1 were backfilled with MySQL `UUID()`).
  publicId        String                @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  organizationId  BigInt                @map("organization_id") @db.UnsignedBigInt
  name            String                @db.VarChar(128)
  retentionDays   Int                   @map("retention_days") @db.UnsignedInt
  criteria        Json?
  priority        Int
  /// RETIRED by step 8.1 (A11): the default is `archive_settings.default_retention_policy_id`.
  /// Kept, never read or written; dropped by a later contract migration.
  isDefault       Boolean               @default(false) @map("is_default")
  onExpiry        RetentionExpiryAction @default(delete) @map("on_expiry")
  rowVersion      Int                   @default(1) @map("row_version") @db.UnsignedInt
  deletedAt       DateTime?             @map("deleted_at") @db.DateTime(3)
  createdByUserId BigInt?               @map("created_by_user_id") @db.UnsignedBigInt
  updatedByUserId BigInt?               @map("updated_by_user_id") @db.UnsignedBigInt
  createdAt       DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.DateTime(3)

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdByUser   User?            @relation("ArchiveRetentionPolicyCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUser   User?            @relation("ArchiveRetentionPolicyUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  defaultSettings ArchiveSetting[]

  @@unique([organizationId, name])
  @@index([organizationId, deletedAt, priority])
  @@map("archive_retention_policies")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly, and never auto-dropped (compliance): legal
/// holds and per-tenant archive retention are row-level, the archive-worker's lifecycle role
/// disposes of records one by one (step 8.1 A13, A14). One archive record per message (unique
/// `(message_id, received_at)`, capture idempotency), written only by the archive-worker. Metadata
/// only: the original EML, the journal report and the scan snapshots are `archive-object/1`
/// encrypted objects in the archive bucket named by `objects`; `wrapped_dek` is the record data
/// key wrapped under tenant key `key_version` and is set to NULL by the disposal decision
/// (crypto-shredding). `deleted_at` is set when disposal starts (NULL = live: the registry purge
/// and the step 1.2 organization deletion contracts). No foreign keys. Step 8.6 (ADR-0088): a record
/// may also hold merged copies of the same message from another source (journal intake), each in
/// `archive_record_sources`, with their objects under `objects.merged`; `source_*` are OR-ed.
model EmailArchive {
  id                  BigInt                @default(autoincrement()) @db.UnsignedBigInt
  receivedAt          DateTime              @map("received_at") @db.DateTime(3)
  messageId           BigInt                @map("message_id") @db.UnsignedBigInt
  organizationId      BigInt                @map("organization_id") @db.UnsignedBigInt
  /// message_identities.public_id of the message (the REST `messageId`).
  messagePublicId     String                @map("message_public_id") @db.Char(36)
  direction           MessageDirection
  capturedByJournal   Boolean               @default(false) @map("captured_by_journal")
  capturedByPolicy    Boolean               @default(false) @map("captured_by_policy")
  /// `ruleRef` of the policy ARCHIVE action that requested the capture.
  policyRuleRef       String?               @map("policy_rule_ref") @db.VarChar(128)
  category            ArchiveCategory
  status              ArchiveRecordStatus   @default(active)
  /// email_messages.status / status_reason at the last outcome refresh (A7).
  messageState        MessageStatus         @map("message_state")
  messageStateReason  String?               @map("message_state_reason") @db.VarChar(64)
  envelopeFrom        String                @map("envelope_from") @db.VarChar(320)
  headerFrom          String?               @map("header_from") @db.VarChar(320)
  /// Metadata (masked in every API response, ADR-0062); never a body.
  subject             String?               @db.VarChar(998)
  internetMessageId   String?               @map("internet_message_id") @db.VarChar(998)
  /// `archive-parties/1`: envelope sender, header From and every envelope recipient with
  /// direction, status and final action.
  parties             Json
  recipientCount      Int                   @map("recipient_count") @db.UnsignedSmallInt
  attachmentCount     Int                   @default(0) @map("attachment_count") @db.UnsignedSmallInt
  /// EML object key in the archive bucket (`org/<org>/archive/.../<captureId>/eml.bin`).
  archiveObjectKey    String                @map("archive_object_key") @db.VarChar(512)
  /// Hex SHA-256 of the original EML (= email_messages.eml_sha256, re-verified at capture).
  sha256              String                @db.Char(64)
  /// Size of the original EML in bytes.
  sizeBytes           Int                   @map("size_bytes") @db.UnsignedInt
  /// Capture id, object keys, version ids, ciphertext SHA-256s and sizes of every object.
  objects             Json
  storedBytes         BigInt                @map("stored_bytes") @db.UnsignedBigInt
  /// `archive-object/1`.
  encryptionFormat    String                @map("encryption_format") @db.VarChar(32)
  keyVersion          Int                   @map("key_version") @db.UnsignedInt
  /// `v1.k<version>.<iv>.<tag>.<ct>`; NULL once disposal started (crypto-shredded).
  wrappedDek          String?               @map("wrapped_dek") @db.VarChar(255)
  lockMode            ObjectLockMode        @default(none) @map("lock_mode")
  lockUntil           DateTime?             @map("lock_until") @db.DateTime(3)
  retentionPolicyId   BigInt?               @map("retention_policy_id") @db.UnsignedBigInt
  retainUntil         DateTime              @map("retain_until") @db.DateTime(3)
  expiryAction        RetentionExpiryAction @default(delete) @map("expiry_action")
  /// Informational: set when an active legal hold blocked an expiry (A12). Holds are evaluated
  /// authoritatively at disposal time.
  legalHold           Boolean               @default(false) @map("legal_hold")
  finalVerdict        MessageVerdict?       @map("final_verdict")
  finalAction         MessageAction?        @map("final_action")
  riskScore           Int?                  @map("risk_score") @db.UnsignedSmallInt
  malicious           Boolean               @default(false)
  /// ≤ 16 links (round, revision, snapshot object) to frozen `archive-scan/1` snapshots.
  scanRounds          Json                  @map("scan_rounds")
  settingsGeneration  BigInt                @map("settings_generation") @db.UnsignedBigInt
  indexedAt           DateTime?             @map("indexed_at") @db.DateTime(3)
  outcomeRefreshedAt  DateTime?             @map("outcome_refreshed_at") @db.DateTime(3)
  /// Captured at.
  archivedAt          DateTime              @map("archived_at") @db.DateTime(3)
  deletedAt           DateTime?             @map("deleted_at") @db.DateTime(3)
  createdAt           DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.DateTime(3)
  /// Step 8.6 (ADR-0088): the record holds a gateway copy (default: every 8.1 record).
  sourceGateway       Boolean               @default(true) @map("source_gateway")
  /// Step 8.6: the record holds a journal intake copy (primary or merged).
  sourceJournalIntake Boolean               @default(false) @map("source_journal_intake")
  /// Step 8.6: journal_intake_sources.id of the primary intake copy (no FK: partitioned).
  intakeSourceId      BigInt?               @map("intake_source_id") @db.UnsignedBigInt
  /// Step 8.6: merged copies (`archive_record_sources` rows; ≤ ARCHIVE_MAX_MERGED_COPIES).
  mergedCount         Int                   @default(0) @map("merged_count") @db.UnsignedSmallInt

  @@id([id, receivedAt])
  @@unique([messageId, receivedAt])
  @@index([organizationId, receivedAt])
  @@index([organizationId, status, retainUntil])
  @@map("email_archives")
}

/// Legal hold (step 8.1 A12): created inside an eDiscovery case and immutable afterwards (change
/// = create a new hold and release the old one). `criteria` = `archive-hold/1` when
/// `criteria_version` is set; legacy rows (no case, `criteria_version` NULL) use the step 5.3
/// subset `{custodians, from, to}`; unparsable criteria match every record (fail-safe).
/// Evaluated authoritatively at disposal, organization deletion and quarantine purge.
model ArchiveLegalHold {
  id               BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  /// UUIDv7 (rows created before step 8.1 were backfilled with MySQL `UUID()`).
  publicId         String          @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  organizationId   BigInt          @map("organization_id") @db.UnsignedBigInt
  caseId           BigInt?         @map("case_id") @db.UnsignedBigInt
  name             String          @db.VarChar(128)
  reason           String          @db.VarChar(1024)
  criteria         Json
  /// `archive-hold/1`; NULL = legacy subset.
  criteriaVersion  String?         @map("criteria_version") @db.VarChar(32)
  status           LegalHoldStatus @default(active)
  createdByUserId  BigInt?         @map("created_by_user_id") @db.UnsignedBigInt
  releasedAt       DateTime?       @map("released_at") @db.DateTime(3)
  releasedByUserId BigInt?         @map("released_by_user_id") @db.UnsignedBigInt
  releaseReason    String?         @map("release_reason") @db.VarChar(1024)
  rowVersion       Int             @default(1) @map("row_version") @db.UnsignedInt
  createdAt        DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  case         EdiscoveryCase? @relation(fields: [caseId], references: [id], onDelete: Restrict)
  createdBy    User?           @relation("LegalHoldCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  releasedBy   User?           @relation("LegalHoldReleasedBy", fields: [releasedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([caseId])
  @@map("archive_legal_holds")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly (2 months, operational; step 8.1 §3, A2).
/// Capture intent: one row per message in archive scope, created by the journal completeness
/// sweep, the `email.archive` consumer or the policy reconciler (`INSERT … ON DUPLICATE KEY
/// UPDATE` on `(message_id, received_at)`, sources OR-ed in); the capture scheduler's work queue
/// (`status`, `next_check_at`, lease) and the anchor of the capture-issues view. Written by the
/// archive-worker (the api only re-queues `failed` intents). No foreign keys.
model ArchiveCaptureIntent {
  id                 BigInt              @default(autoincrement()) @db.UnsignedBigInt
  receivedAt         DateTime            @map("received_at") @db.DateTime(3)
  organizationId     BigInt              @map("organization_id") @db.UnsignedBigInt
  messageId          BigInt              @map("message_id") @db.UnsignedBigInt
  direction          MessageDirection
  sourceJournal      Boolean             @default(false) @map("source_journal")
  sourcePolicy       Boolean             @default(false) @map("source_policy")
  policyRuleRef      String?             @map("policy_rule_ref") @db.VarChar(128)
  status             ArchiveIntentStatus @default(pending)
  category           ArchiveCategory?
  /// `category_excluded`, `not_entitled`, `archiving_disabled`, `policy_archive_disabled`,
  /// `max_age`, … (codes only).
  skipReason         String?             @map("skip_reason") @db.VarChar(64)
  attempts           Int                 @default(0) @db.UnsignedSmallInt
  nextCheckAt        DateTime            @map("next_check_at") @db.DateTime(3)
  leaseUntil         DateTime?           @map("lease_until") @db.DateTime(3)
  lastErrorCode      String?             @map("last_error_code") @db.VarChar(64)
  settingsGeneration BigInt              @map("settings_generation") @db.UnsignedBigInt
  /// email_archives.id of the captured record (no FK: partitioned).
  archiveId          BigInt?             @map("archive_id") @db.UnsignedBigInt
  capturedAt         DateTime?           @map("captured_at") @db.DateTime(3)
  closedAt           DateTime?           @map("closed_at") @db.DateTime(3)
  createdAt          DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.DateTime(3)
  /// Step 8.6 (ADR-0088): email_archives.received_at of the record `archive_id` names; NULL = the
  /// intent's own `received_at` (every non-merged capture).
  archiveReceivedAt  DateTime?           @map("archive_received_at") @db.DateTime(3)
  /// Step 8.6: the message was merged into another message's record (cross-source dedupe).
  merged             Boolean             @default(false)

  @@id([id, receivedAt])
  @@unique([messageId, receivedAt])
  @@index([status, nextCheckAt])
  @@index([organizationId, status, receivedAt])
  @@map("archive_capture_intents")
}

/// Tenant archive key version (step 8.1 A8, A9): 32 random bytes stored only wrapped under the
/// root key (`wrapped_key`, SecretBox format `v1.<rootKid>.<iv>.<tag>.<ct>`, AAD bound to the
/// organization and version). One `active` version per organization; `retired` versions are
/// decrypt-only; `destroyed` (`wrapped_key` NULL) only by the organization purge. Version 1 is
/// created by the archive-worker on first capture; rotations by the api. Never key material in
/// any response.
model ArchiveEncryptionKey {
  id              BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  publicId        String           @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  organizationId  BigInt           @map("organization_id") @db.UnsignedBigInt
  version         Int              @db.UnsignedInt
  status          ArchiveKeyStatus
  wrappedKey      String?          @map("wrapped_key") @db.VarChar(512)
  /// ARCHIVE_ROOT_KEY_ID that wraps `wrapped_key` (root re-wrap finds the previous id).
  rootKeyId       String           @map("root_key_id") @db.VarChar(32)
  algorithm       String           @db.VarChar(32)
  rotationReason  String?          @map("rotation_reason") @db.VarChar(256)
  createdByUserId BigInt?          @map("created_by_user_id") @db.UnsignedBigInt
  createdAt       DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  activatedAt     DateTime?        @map("activated_at") @db.DateTime(3)
  retiredAt       DateTime?        @map("retired_at") @db.DateTime(3)
  destroyedAt     DateTime?        @map("destroyed_at") @db.DateTime(3)

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdByUser User?        @relation("ArchiveEncryptionKeyCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, version])
  @@index([organizationId, status])
  @@index([rootKeyId])
  @@map("archive_encryption_keys")
}

/// Transient search-index work queue (step 8.1 A16): one row per record change, written in the
/// same transaction as the change (capture, refresh, status, extension, disposal, organization
/// purge); the archive-worker's index role claims rows in id order, builds each document from the
/// current MySQL row and deletes applied rows. No foreign keys (rows outlive nothing; a
/// `purge_org` op may be the last trace of an organization's records).
model ArchiveIndexQueue {
  id              BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId  BigInt         @map("organization_id") @db.UnsignedBigInt
  messageId       BigInt         @map("message_id") @db.UnsignedBigInt
  receivedAt      DateTime       @map("received_at") @db.DateTime(3)
  messagePublicId String         @map("message_public_id") @db.Char(36)
  op              ArchiveIndexOp
  attempts        Int            @default(0) @db.UnsignedSmallInt
  availableAt     DateTime       @default(now()) @map("available_at") @db.DateTime(3)
  lastErrorCode   String?        @map("last_error_code") @db.VarChar(64)
  createdAt       DateTime       @default(now()) @map("created_at") @db.DateTime(3)

  @@index([availableAt, id])
  @@index([organizationId, createdAt])
  @@map("archive_index_queue")
}

/// Per organization and UTC day: MySQL count of live records vs the tenant alias `_count`
/// (step 8.1 A15); eDiscovery completeness reads it (A18). Written by the archive-worker.
model ArchiveIndexCheck {
  id             BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId BigInt                 @map("organization_id") @db.UnsignedBigInt
  day            DateTime               @db.Date
  mysqlCount     Int                    @map("mysql_count") @db.UnsignedInt
  indexCount     Int                    @map("index_count") @db.UnsignedInt
  state          ArchiveIndexCheckState
  checkedAt      DateTime               @map("checked_at") @db.DateTime(3)
  repairedAt     DateTime?              @map("repaired_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, day])
  @@map("archive_index_checks")
}

/// PARTITIONED by RANGE COLUMNS(requested_at), monthly, never dropped (compliance; step 8.1 A14,
/// A21). Append-only disposal log and pipeline state of one archive record: inserted by the
/// disposal decision transaction (state `shredded`, the record's data key already destroyed),
/// advanced by the lifecycle role through `objects_deleted`, `index_deleted` to `completed`.
/// `objects` = object keys and version ids (no content); `replica_status` = per replica target
/// progress. `requested_by_user_id` has no FK (the trail survives the user). No foreign keys.
model ArchiveDisposal {
  id                BigInt                @default(autoincrement()) @db.UnsignedBigInt
  requestedAt       DateTime              @map("requested_at") @db.DateTime(3)
  organizationId    BigInt                @map("organization_id") @db.UnsignedBigInt
  messageId         BigInt                @map("message_id") @db.UnsignedBigInt
  messagePublicId   String                @map("message_public_id") @db.Char(36)
  messageReceivedAt DateTime              @map("message_received_at") @db.DateTime(3)
  archiveRecordId   BigInt                @map("archive_record_id") @db.UnsignedBigInt
  reason            ArchiveDisposalReason
  /// Hex SHA-256 of the original EML.
  sha256            String                @db.Char(64)
  sizeBytes         Int                   @map("size_bytes") @db.UnsignedInt
  objects           Json
  replicaStatus     Json?                 @map("replica_status")
  state             ArchiveDisposalState  @default(shredded)
  attempts          Int                   @default(0) @db.UnsignedSmallInt
  nextAttemptAt     DateTime              @map("next_attempt_at") @db.DateTime(3)
  lastErrorCode     String?               @map("last_error_code") @db.VarChar(64)
  requestedByUserId BigInt?               @map("requested_by_user_id") @db.UnsignedBigInt
  completedAt       DateTime?             @map("completed_at") @db.DateTime(3)
  createdAt         DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.DateTime(3)

  @@id([id, requestedAt])
  @@index([state, nextAttemptAt])
  @@index([organizationId, requestedAt])
  @@map("archive_disposals")
}

/// Single-use download grant (step 8.1 A18, A19): an archived original (`kind = message`,
/// `message_id` + `message_received_at`, no FK: partitioned target) or an eDiscovery export
/// package (`kind = export`). The HMAC token carries `jti`; consumption is atomic
/// (`consumed_at`). Written by the api only.
model ArchiveDownloadGrant {
  id                BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  /// UUIDv7 token id.
  jti               String              @unique @db.Char(36)
  organizationId    BigInt              @map("organization_id") @db.UnsignedBigInt
  userId            BigInt              @map("user_id") @db.UnsignedBigInt
  kind              ArchiveDownloadKind
  messageId         BigInt?             @map("message_id") @db.UnsignedBigInt
  messageReceivedAt DateTime?           @map("message_received_at") @db.DateTime(3)
  exportId          BigInt?             @map("export_id") @db.UnsignedBigInt
  expiresAt         DateTime            @map("expires_at") @db.DateTime(3)
  consumedAt        DateTime?           @map("consumed_at") @db.DateTime(3)
  sourceIp          String?             @map("source_ip") @db.VarChar(45)
  createdAt         DateTime            @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User              @relation("ArchiveDownloadGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  export       EdiscoveryExport? @relation(fields: [exportId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId, createdAt])
  @@map("archive_download_grants")
}

/// eDiscovery case (step 8.1 A18): name unique per organization, `open | closed` (close requires
/// no active hold of the case), CAS on `row_version`. Written by the api only.
model EdiscoveryCase {
  id              BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  publicId        String               @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  organizationId  BigInt               @map("organization_id") @db.UnsignedBigInt
  name            String               @db.VarChar(128)
  description     String?              @db.VarChar(1024)
  matterReference String?              @map("matter_reference") @db.VarChar(128)
  status          EdiscoveryCaseStatus @default(open)
  rowVersion      Int                  @default(1) @map("row_version") @db.UnsignedInt
  createdByUserId BigInt?              @map("created_by_user_id") @db.UnsignedBigInt
  updatedByUserId BigInt?              @map("updated_by_user_id") @db.UnsignedBigInt
  closedByUserId  BigInt?              @map("closed_by_user_id") @db.UnsignedBigInt
  closedAt        DateTime?            @map("closed_at") @db.DateTime(3)
  createdAt       DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.DateTime(3)

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdByUser User?        @relation("EdiscoveryCaseCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUser User?        @relation("EdiscoveryCaseUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  closedByUser  User?        @relation("EdiscoveryCaseClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)

  custodians EdiscoveryCustodian[]
  holds      ArchiveLegalHold[]
  searches   EdiscoverySearch[]
  exports    EdiscoveryExport[]

  @@unique([organizationId, name])
  @@index([organizationId, status, id])
  @@map("ediscovery_cases")
}

/// Custodian of a case (step 8.1 A18): a lower-cased address, optionally linked to a user.
/// Replaced as a list by `PATCH /ediscovery/cases/{caseId}`. Written by the api only.
model EdiscoveryCustodian {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  publicId        String   @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  caseId          BigInt   @map("case_id") @db.UnsignedBigInt
  organizationId  BigInt   @map("organization_id") @db.UnsignedBigInt
  /// Lower-cased.
  address         String   @db.VarChar(320)
  userId          BigInt?  @map("user_id") @db.UnsignedBigInt
  createdByUserId BigInt?  @map("created_by_user_id") @db.UnsignedBigInt
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)

  case          EdiscoveryCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user          User?          @relation("EdiscoveryCustodianUser", fields: [userId], references: [id], onDelete: SetNull)
  createdByUser User?          @relation("EdiscoveryCustodianCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([caseId, address])
  @@map("ediscovery_custodians")
}

/// Case search (step 8.1 A18): criteria `archive-search/1`, requested by the api (`queued`) and
/// executed by the archive-worker's ediscovery role through the tenant alias, every hit verified
/// against MySQL. `index_complete` / `incomplete_reason` report completeness (never assumed).
model EdiscoverySearch {
  id                BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  publicId          String                 @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  caseId            BigInt                 @map("case_id") @db.UnsignedBigInt
  organizationId    BigInt                 @map("organization_id") @db.UnsignedBigInt
  criteria          Json
  /// Hex SHA-256 of the canonical criteria JSON.
  criteriaSha256    String                 @map("criteria_sha256") @db.Char(64)
  status            EdiscoverySearchStatus @default(queued)
  hitCount          Int                    @default(0) @map("hit_count") @db.UnsignedInt
  truncated         Boolean                @default(false)
  indexComplete     Boolean?               @map("index_complete")
  /// `index_lag`, `unverified_days`, `mismatched_days`.
  incompleteReason  String?                @map("incomplete_reason") @db.VarChar(32)
  errorCode         String?                @map("error_code") @db.VarChar(64)
  requestedByUserId BigInt?                @map("requested_by_user_id") @db.UnsignedBigInt
  startedAt         DateTime?              @map("started_at") @db.DateTime(3)
  completedAt       DateTime?              @map("completed_at") @db.DateTime(3)
  createdAt         DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.DateTime(3)

  case            EdiscoveryCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  requestedByUser User?          @relation("EdiscoverySearchRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)

  hits    EdiscoverySearchHit[]
  exports EdiscoveryExport[]

  @@index([caseId, id])
  @@index([status, createdAt])
  @@map("ediscovery_searches")
}

/// One verified hit of a case search (step 8.1 A18) with its review tag. `message_id` +
/// `message_received_at` reference the archive record (no FK: partitioned target). Written by the
/// archive-worker (hits) and the api (review tags).
model EdiscoverySearchHit {
  id                BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  searchId          BigInt              @map("search_id") @db.UnsignedBigInt
  organizationId    BigInt              @map("organization_id") @db.UnsignedBigInt
  messageId         BigInt              @map("message_id") @db.UnsignedBigInt
  messageReceivedAt DateTime            @map("message_received_at") @db.DateTime(3)
  messagePublicId   String              @map("message_public_id") @db.Char(36)
  reviewTag         EdiscoveryReviewTag @default(untagged) @map("review_tag")
  reviewedByUserId  BigInt?             @map("reviewed_by_user_id") @db.UnsignedBigInt
  reviewedAt        DateTime?           @map("reviewed_at") @db.DateTime(3)
  createdAt         DateTime            @default(now()) @map("created_at") @db.DateTime(3)

  search         EdiscoverySearch @relation(fields: [searchId], references: [id], onDelete: Restrict)
  reviewedByUser User?            @relation("EdiscoverySearchHitReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@unique([searchId, messageId, messageReceivedAt])
  @@index([searchId, id])
  @@index([searchId, reviewTag, id])
  @@map("ediscovery_search_hits")
}

/// eDiscovery export (step 8.1 A18): built from one completed search by the archive-worker into
/// one encrypted ZIP object (`org/<org>/exports/<yyyy>/<mm>/<exportId>.bin`, tag
/// `eg-object=archive-export`, never locked), with a signed `archive-export-manifest/1`.
/// `wrapped_dek` = the export data key under tenant key `key_version`. Expires after
/// ARCHIVE_EXPORT_TTL_HOURS (object deleted, status `expired`).
model EdiscoveryExport {
  id                   BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  publicId             String                 @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  caseId               BigInt                 @map("case_id") @db.UnsignedBigInt
  searchId             BigInt                 @map("search_id") @db.UnsignedBigInt
  organizationId       BigInt                 @map("organization_id") @db.UnsignedBigInt
  status               EdiscoveryExportStatus @default(queued)
  /// Review tags selected (JSON array of EdiscoveryReviewTag values).
  reviewTags           Json                   @map("review_tags")
  acknowledgeMalicious Boolean                @default(false) @map("acknowledge_malicious")
  itemCount            Int                    @default(0) @map("item_count") @db.UnsignedInt
  maliciousCount       Int                    @default(0) @map("malicious_count") @db.UnsignedInt
  packageBytes         BigInt?                @map("package_bytes") @db.UnsignedBigInt
  /// Hex SHA-256 of the plaintext ZIP.
  packageSha256        String?                @map("package_sha256") @db.Char(64)
  manifestSha256       String?                @map("manifest_sha256") @db.Char(64)
  signingKeyId         String?                @map("signing_key_id") @db.VarChar(32)
  objectKey            String?                @map("object_key") @db.VarChar(512)
  objectVersionId      String?                @map("object_version_id") @db.VarChar(255)
  keyVersion           Int?                   @map("key_version") @db.UnsignedInt
  wrappedDek           String?                @map("wrapped_dek") @db.VarChar(255)
  expiresAt            DateTime?              @map("expires_at") @db.DateTime(3)
  errorCode            String?                @map("error_code") @db.VarChar(64)
  requestedByUserId    BigInt?                @map("requested_by_user_id") @db.UnsignedBigInt
  completedAt          DateTime?              @map("completed_at") @db.DateTime(3)
  createdAt            DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime               @updatedAt @map("updated_at") @db.DateTime(3)

  case            EdiscoveryCase   @relation(fields: [caseId], references: [id], onDelete: Restrict)
  search          EdiscoverySearch @relation(fields: [searchId], references: [id], onDelete: Restrict)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  requestedByUser User?            @relation("EdiscoveryExportRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)

  downloadGrants ArchiveDownloadGrant[]

  @@index([caseId, id])
  @@index([status, createdAt])
  @@index([status, expiresAt])
  @@map("ediscovery_exports")
}

// ---------------------------------------------------------------------------------------------
// 3.11 Security incidents (step 8.4, shared by ATO and ATP: docs/plan/steps/24-account-takeover-core.md
// D24, §3.1, ADR-0075) and account takeover (step 8.4 §3.2, ADR-0070..0074). No message content
// in any of these tables (ids, codes, counts, hashes; never a password, token, subject, body or
// recipient address). Written only through the shared IncidentStore and the ATO store
// (ato-worker and api); the policy-engine reads ato_accounts and security_incidents (D23).
// ---------------------------------------------------------------------------------------------

/// A security incident of any category (D24): ATO (`account_takeover`, subject an `ato_accounts`
/// row) in 8.4; ATP-4 appends categories. Category detail lives in category tables
/// (`ato_incident_details`). One active incident per category and subject (unique key over the
/// generated `active_marker`). Retention per category (ATO: closed incidents purged after
/// ATO_RETENTION_INCIDENT_DAYS by the ato-worker).
model SecurityIncident {
  id                BigInt                          @id @default(autoincrement()) @db.UnsignedBigInt
  /// UUIDv7; the only id the API exposes.
  publicId          String                          @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  organizationId    BigInt                          @map("organization_id") @db.UnsignedBigInt
  category          SecurityIncidentCategory
  subjectType       SecurityIncidentSubjectType     @map("subject_type")
  /// Id of the subject row (`ato_accounts.id` for `ato_account`; no FK, category-dependent).
  subjectRefId      BigInt                          @map("subject_ref_id") @db.UnsignedBigInt
  /// Partition key of a partitioned subject (ATP: a message's `received_at`); NULL for `ato_account`.
  subjectRefTime    DateTime?                       @map("subject_ref_time") @db.DateTime(3)
  /// The subject's public id (`ato_accounts.public_id`).
  subjectPublicId   String                          @map("subject_public_id") @db.VarChar(64)
  origin            SecurityIncidentOrigin
  status            SecurityIncidentStatus          @default(open)
  severity          SecurityIncidentSeverity
  /// The top contribution's code (ATO: a rule code).
  titleCode         String?                         @map("title_code") @db.VarChar(64)
  /// JSON array (≤ 16) of reason codes (ATO: the contributing rule codes).
  reasonCodes       Json                            @map("reason_codes")
  /// Detector catalogue version (`ato-rules/1`); NULL for manual incidents.
  detectorVersion   String?                         @map("detector_version") @db.VarChar(32)
  detectedAt        DateTime                        @map("detected_at") @db.DateTime(3)
  firstEvidenceAt   DateTime?                       @map("first_evidence_at") @db.DateTime(3)
  lastEvidenceAt    DateTime?                       @map("last_evidence_at") @db.DateTime(3)
  evidenceCount     Int                             @default(0) @map("evidence_count") @db.UnsignedInt
  assignedUserId    BigInt?                         @map("assigned_user_id") @db.UnsignedBigInt
  assignedAt        DateTime?                       @map("assigned_at") @db.DateTime(3)
  escalatedAt       DateTime?                       @map("escalated_at") @db.DateTime(3)
  confirmedAt       DateTime?                       @map("confirmed_at") @db.DateTime(3)
  mitigatedAt       DateTime?                       @map("mitigated_at") @db.DateTime(3)
  resolvedAt        DateTime?                       @map("resolved_at") @db.DateTime(3)
  /// No FK: the trail survives the deletion of the user.
  resolvedByUserId  BigInt?                         @map("resolved_by_user_id") @db.UnsignedBigInt
  resolutionCode    SecurityIncidentResolutionCode? @map("resolution_code")
  resolutionNote    String?                         @map("resolution_note") @db.VarChar(4000)
  /// Last `security.incident.updated.v1` with `evidence` (the 15-minute throttle, D12).
  lastUpdateEventAt DateTime?                       @map("last_update_event_at") @db.DateTime(3)
  createdByType     ActorType                       @map("created_by_type")
  /// Public id of the creating user or API key; NULL for `system`.
  createdById       String?                         @map("created_by_id") @db.VarChar(64)
  /// READ-ONLY, generated by MySQL: `GENERATED ALWAYS AS (IF(status IN ('open', 'investigating',
  /// 'confirmed', 'mitigated'), 1, NULL)) STORED`. With the unique key below: one active incident
  /// per organization, category and subject. Never write it.
  activeMarker      Int?                            @map("active_marker") @db.UnsignedTinyInt
  /// Optimistic concurrency (CAS) of the api.
  rowVersion        Int                             @default(1) @map("row_version") @db.UnsignedInt
  createdAt         DateTime                        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime                        @updatedAt @map("updated_at") @db.DateTime(3)

  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignedUser       User?                   @relation("SecurityIncidentAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  events             SecurityIncidentEvent[]
  links              SecurityIncidentLink[]
  atoDetail          AtoIncidentDetail?
  atoResponseActions AtoResponseAction[]

  @@unique([organizationId, category, subjectType, subjectRefId, activeMarker])
  @@index([organizationId, detectedAt, id])
  @@index([organizationId, category, status, detectedAt, id])
  @@index([organizationId, category, severity, detectedAt, id])
  @@index([organizationId, assignedUserId, status])
  @@index([organizationId, subjectType, subjectRefId, detectedAt])
  /// Retention purge per category (closed incidents by resolution time).
  @@index([category, status, resolvedAt])
  @@map("security_incidents")
}

/// Timeline and audit trail of an incident (D24): generic event types (`created`,
/// `evidence_linked`, `severity_changed`, `status_changed`, `assigned`, `note_added`, `escalated`,
/// `report_exported`) and category-prefixed ones (`ato.response_requested`, …,
/// `ato.feedback_applied`). Append-only; deleted with the incident.
model SecurityIncidentEvent {
  id             BigInt                    @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId BigInt                    @map("organization_id") @db.UnsignedBigInt
  incidentId     BigInt                    @map("incident_id") @db.UnsignedBigInt
  eventType      String                    @map("event_type") @db.VarChar(48)
  actorType      ActorType                 @map("actor_type")
  /// Public id of the acting user or API key; NULL for `system`.
  actorId        String?                   @map("actor_id") @db.VarChar(64)
  fromStatus     SecurityIncidentStatus?   @map("from_status")
  toStatus       SecurityIncidentStatus?   @map("to_status")
  fromSeverity   SecurityIncidentSeverity? @map("from_severity")
  toSeverity     SecurityIncidentSeverity? @map("to_severity")
  /// Analyst note (investigation notes, transition reasons); never message content.
  note           String?                   @db.Text
  /// Bounded JSON (codes, ids, counts).
  details        Json?
  createdAt      DateTime                  @default(now()) @map("created_at") @db.DateTime(3)

  incident SecurityIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt, id])
  @@index([organizationId, createdAt])
  @@map("security_incident_events")
}

/// Typed evidence reference of an incident (D24): `(ref_id, ref_time)` of a message
/// (`email_messages.id`, `received_at`), an ATO signal (`ato_risk_signals.id`, `detected_at`) or
/// an ATO authentication event (`ato_auth_events.id`, `occurred_at`). No FK (partitioned targets).
/// Per-type caps are enforced by the store (ATO: 2 000 signals, 1 000 auth events, 500 messages).
model SecurityIncidentLink {
  id             BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId BigInt                   @map("organization_id") @db.UnsignedBigInt
  incidentId     BigInt                   @map("incident_id") @db.UnsignedBigInt
  linkType       SecurityIncidentLinkType @map("link_type")
  refId          BigInt                   @map("ref_id") @db.UnsignedBigInt
  /// Partition key of the referenced row.
  refTime        DateTime                 @map("ref_time") @db.DateTime(3)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.DateTime(3)

  incident SecurityIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@unique([incidentId, linkType, refId, refTime])
  @@index([organizationId, incidentId, linkType, refTime])
  @@map("security_incident_links")
}

/// Per-organization ATO settings (`ato-settings/1`, §4.3; normalized, every key optional with
/// defaults from DEFAULT_ATO_SETTINGS). One row per organization; written by the api (CAS on
/// `row_version`); every change also appends `ato_settings_versions`. The feature itself is the
/// plan/organization feature `ato_detection` (off by default, D21).
model AtoSetting {
  id                BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId    BigInt   @unique @map("organization_id") @db.UnsignedBigInt
  settings          Json
  /// Hex SHA-256 of the canonical settings JSON.
  settingsSha256    String   @map("settings_sha256") @db.Char(64)
  /// 1, +1 per change (recorded with every signal and score).
  version           Int      @default(1) @db.UnsignedInt
  rowVersion        Int      @default(1) @map("row_version") @db.UnsignedInt
  /// Start of the tenant learning period (baseline-relative rules suppressed until it ends).
  learningStartedAt DateTime @map("learning_started_at") @db.DateTime(3)
  updatedByUserId   BigInt?  @map("updated_by_user_id") @db.UnsignedBigInt
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  updatedByUser User?        @relation("AtoSettingsUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("ato_settings")
}

/// Append-only history of `ato_settings` (one row per version; purged after 730 days except the
/// current version).
model AtoSettingsVersion {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId  BigInt   @map("organization_id") @db.UnsignedBigInt
  version         Int      @db.UnsignedInt
  settings        Json
  settingsSha256  String   @map("settings_sha256") @db.Char(64)
  /// No FK: the trail survives the deletion of the user.
  createdByUserId BigInt?  @map("created_by_user_id") @db.UnsignedBigInt
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, version])
  @@map("ato_settings_versions")
}

/// A monitored subject (D1): a tenant mailbox (`address`), a portal user (`user_id`) or an SMTP
/// connector (`connector_id`), keyed by `subject_hash` = atoSubjectHash(kind, subject) of
/// @email-gateway/security-contracts. No directory data is copied (names, status, roles are
/// joined live); `user_id` / `connector_id` have no FK so the trail survives deletion (the
/// maintenance role marks the account `retired`). The policy-engine reads `risk_score`,
/// `risk_level` and `active_incident_id` by the unique key (D23).
model AtoAccount {
  id                BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  /// UUIDv7; the only id the API exposes.
  publicId          String           @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  organizationId    BigInt           @map("organization_id") @db.UnsignedBigInt
  kind              AtoAccountKind
  /// Hex SHA-256 of `mailbox:<address>`, `user:<users.id>` or `connector:<smtp_connectors.id>`.
  subjectHash       String           @map("subject_hash") @db.Char(64)
  /// Lower-cased mailbox address (`mailbox` kind only; it has no other table).
  address           String?          @db.VarChar(320)
  /// domains.id of the address's domain (no FK).
  domainId          BigInt?          @map("domain_id") @db.UnsignedBigInt
  /// users.id (`gateway_user`; no FK).
  userId            BigInt?          @map("user_id") @db.UnsignedBigInt
  /// smtp_connectors.id (`smtp_connector`; no FK).
  connectorId       BigInt?          @map("connector_id") @db.UnsignedBigInt
  status            AtoAccountStatus @default(active)
  /// Never acted on automatically (D13).
  protected         Boolean          @default(false)
  protectedReason   String?          @map("protected_reason") @db.VarChar(512)
  protectedByUserId BigInt?          @map("protected_by_user_id") @db.UnsignedBigInt
  protectedAt       DateTime?        @map("protected_at") @db.DateTime(3)
  /// Current `ato-score/1` score, 0–100 (D11).
  riskScore         Int              @default(0) @map("risk_score") @db.UnsignedTinyInt
  riskLevel         AtoRiskLevel     @default(low) @map("risk_level")
  riskUpdatedAt     DateTime?        @map("risk_updated_at") @db.DateTime(3)
  /// The latest score explanation (copy of `ato_risk_scores.explanation`).
  riskExplanation   Json?            @map("risk_explanation")
  lastSignalAt      DateTime?        @map("last_signal_at") @db.DateTime(3)
  /// security_incidents.id of the active `account_takeover` incident (no FK).
  activeIncidentId  BigInt?          @map("active_incident_id") @db.UnsignedBigInt
  /// ato_risk_overrides.id of the active override (no FK).
  overrideId        BigInt?          @map("override_id") @db.UnsignedBigInt
  firstSeenAt       DateTime         @map("first_seen_at") @db.DateTime(3)
  lastSeenAt        DateTime         @map("last_seen_at") @db.DateTime(3)
  lastAuthSuccessAt DateTime?        @map("last_auth_success_at") @db.DateTime(3)
  /// Last successful authentication location `{ cc, lat, lon, km, at }` (fallback of Redis).
  lastAuthGeo       Json?            @map("last_auth_geo")
  rowVersion        Int              @default(1) @map("row_version") @db.UnsignedInt
  createdAt         DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.DateTime(3)

  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  baseline        AtoAccountBaseline?
  overrides       AtoRiskOverride[]
  trustedContexts AtoTrustedContext[]
  incidentDetails AtoIncidentDetail[]
  responseActions AtoResponseAction[]
  identities      AtoAccountIdentity[]
  mailboxItems    AtoProviderMailboxItem[]

  @@unique([organizationId, kind, subjectHash])
  @@index([organizationId, riskScore, id])
  @@index([organizationId, lastSignalAt, id])
  @@index([organizationId, address, id])
  @@index([organizationId, kind, lastSeenAt])
  @@index([organizationId, domainId, riskScore, id])
  /// Decay sweep (accounts with a score whose last rescore is older than the interval).
  @@index([riskUpdatedAt, riskScore])
  @@map("ato_accounts")
}

/// Behavioural baseline of an account (`ato-baseline/1`, D9; rebuilt daily by the maintenance
/// role from `ato_account_activity_daily` and `ato_auth_events`).
model AtoAccountBaseline {
  accountId      BigInt    @id @map("account_id") @db.UnsignedBigInt
  organizationId BigInt    @map("organization_id") @db.UnsignedBigInt
  baseline       Json
  version        String    @db.VarChar(32)
  eventCount     Int       @default(0) @map("event_count") @db.UnsignedInt
  activeDays     Int       @default(0) @map("active_days") @db.UnsignedSmallInt
  mature         Boolean   @default(false)
  maturedAt      DateTime? @map("matured_at") @db.DateTime(3)
  windowStart    DateTime  @map("window_start") @db.DateTime(3)
  windowEnd      DateTime  @map("window_end") @db.DateTime(3)
  rebuiltAt      DateTime  @map("rebuilt_at") @db.DateTime(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  account AtoAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([organizationId, rebuiltAt])
  @@map("ato_account_baselines")
}

/// PARTITIONED by RANGE COLUMNS(day_start), monthly, 6 months (tier core). Daily per-account
/// aggregates (D9): counters and bounded JSON summaries; never an address, subject or body
/// (recipient registrable domains and counts only). One row per account and UTC day.
model AtoAccountActivityDaily {
  id                 BigInt   @default(autoincrement()) @db.UnsignedBigInt
  /// UTC midnight of the day.
  dayStart           DateTime @map("day_start") @db.DateTime(3)
  organizationId     BigInt   @map("organization_id") @db.UnsignedBigInt
  /// ato_accounts.id (no FK: partitioned).
  accountId          BigInt   @map("account_id") @db.UnsignedBigInt
  authSuccess        Int      @default(0) @map("auth_success") @db.UnsignedInt
  authFailure        Int      @default(0) @map("auth_failure") @db.UnsignedInt
  messages           Int      @default(0) @db.UnsignedInt
  recipients         Int      @default(0) @db.UnsignedInt
  externalRecipients Int      @default(0) @map("external_recipients") @db.UnsignedInt
  internalRecipients Int      @default(0) @map("internal_recipients") @db.UnsignedInt
  attachments        Int      @default(0) @db.UnsignedInt
  findings           Int      @default(0) @db.UnsignedInt
  maxHourMessages    Int      @default(0) @map("max_hour_messages") @db.UnsignedInt
  /// 24 × `{ m, a }` (messages, authentications per UTC hour).
  hourCounts         Json     @map("hour_counts")
  /// ≤ 20 `{ p, n, cc?, asn? }` (IP prefixes).
  ipPrefixes         Json     @map("ip_prefixes")
  /// ≤ 100 `{ d, n }` (registrable recipient domains).
  recipientDomains   Json     @map("recipient_domains")
  /// ≤ 20 attachment types with counts.
  attachmentTypes    Json     @map("attachment_types")
  /// ≤ 10 connectors of a mailbox or ≤ 50 sender hashes of a connector.
  peers              Json
  /// Content counts (finding categories, observation categories).
  content            Json
  createdAt          DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@id([id, dayStart])
  @@unique([organizationId, accountId, dayStart])
  @@index([organizationId, dayStart])
  @@map("ato_account_activity_daily")
}

/// PARTITIONED by RANGE COLUMNS(occurred_at), monthly, 3 months (tier detail). Enriched
/// authentication events (portal/API logins and MFA, SMTP AUTH, identity-provider sign-ins; D5,
/// D7): geolocation, ASN, anonymizer flags, reputation, device. Never the attempted e-mail of an
/// unknown account, a password or a raw SMTP username. Successful SMTP AUTHs are aggregated per
/// (connector, IP, hour): `occurred_at` = hour start, `attempt_count`, `last_occurred_at`.
model AtoAuthEvent {
  id              BigInt         @default(autoincrement()) @db.UnsignedBigInt
  occurredAt      DateTime       @map("occurred_at") @db.DateTime(3)
  organizationId  BigInt         @map("organization_id") @db.UnsignedBigInt
  /// ato_accounts.id; NULL for an unknown account (platform organization).
  accountId       BigInt?        @map("account_id") @db.UnsignedBigInt
  source          AtoAuthSource
  channel         AtoAuthChannel
  outcome         AtoAuthOutcome
  failureCode     String?        @map("failure_code") @db.VarChar(64)
  ipAddress       String?        @map("ip_address") @db.VarChar(45)
  /// /24 (IPv4) or /48 (IPv6) prefix in CIDR notation.
  ipPrefix        String?        @map("ip_prefix") @db.VarChar(49)
  countryCode     String?        @map("country_code") @db.Char(2)
  region          String?        @db.VarChar(64)
  city            String?        @db.VarChar(64)
  latitude        Decimal?       @db.Decimal(8, 4)
  longitude       Decimal?       @db.Decimal(9, 4)
  accuracyKm      Int?           @map("accuracy_km") @db.UnsignedSmallInt
  geoStatus       AtoGeoStatus   @map("geo_status")
  asn             Int?           @db.UnsignedInt
  asnOrg          String?        @map("asn_org") @db.VarChar(128)
  /// Bitmask of the Anonymous IP database flags (D7); NULL without that database.
  anonymizerFlags Int?           @map("anonymizer_flags") @db.UnsignedSmallInt
  /// `AtoIpReputation { status, severity, category, confidence, providers }` (D7).
  reputation      Json?
  /// First 16 hex of SHA-256 of `browser|major|os|platform`.
  deviceHash      String?        @map("device_hash") @db.Char(16)
  deviceLabel     String?        @map("device_label") @db.VarChar(96)
  /// SASL mechanism (`plain`, `login`) of SMTP AUTH.
  mechanism       String?        @db.VarChar(16)
  attemptCount    Int            @default(1) @map("attempt_count") @db.UnsignedInt
  lastOccurredAt  DateTime       @map("last_occurred_at") @db.DateTime(3)
  /// Source row reference (`login_audit_logs.id`, `<eventId>:<seq>`, provider event id).
  sourceRef       String?        @map("source_ref") @db.VarChar(64)
  /// Hex SHA-256 of the source key (idempotency).
  dedupeKey       String         @map("dedupe_key") @db.Char(64)
  createdAt       DateTime       @default(now()) @map("created_at") @db.DateTime(3)

  @@id([id, occurredAt])
  @@unique([organizationId, dedupeKey, occurredAt])
  @@index([organizationId, accountId, occurredAt, id])
  @@index([organizationId, occurredAt, id])
  @@index([organizationId, ipAddress, occurredAt])
  @@map("ato_auth_events")
}

/// PARTITIONED by RANGE COLUMNS(detected_at), monthly, 13 months (tier core). A detection signal
/// of `ato-rules/1` (D10): stable rule code, category, strength, weight, evidence (bounded JSON,
/// no content) and its source. Deduplicated under the account row lock by
/// `(organization_id, account_id, dedupe_key)` within the rule's window (repetitions increase
/// `occurrences`, never the score).
model AtoRiskSignal {
  id                  BigInt              @default(autoincrement()) @db.UnsignedBigInt
  detectedAt          DateTime            @map("detected_at") @db.DateTime(3)
  organizationId      BigInt              @map("organization_id") @db.UnsignedBigInt
  /// ato_accounts.id (no FK: partitioned).
  accountId           BigInt              @map("account_id") @db.UnsignedBigInt
  ruleCode            String              @map("rule_code") @db.VarChar(64)
  category            AtoSignalCategory
  strength            AtoSignalStrength
  weight              Int                 @db.UnsignedTinyInt
  status              AtoSignalStatus     @default(active)
  dedupeKey           String              @map("dedupe_key") @db.Char(64)
  occurrences         Int                 @default(1) @db.UnsignedInt
  firstOccurredAt     DateTime            @map("first_occurred_at") @db.DateTime(3)
  lastOccurredAt      DateTime            @map("last_occurred_at") @db.DateTime(3)
  evidence            Json
  sourceKind          AtoSignalSourceKind @map("source_kind")
  sourceRef           String?             @map("source_ref") @db.VarChar(64)
  /// email_messages.id / received_at of a message signal (no FK).
  messageId           BigInt?             @map("message_id") @db.UnsignedBigInt
  messageReceivedAt   DateTime?           @map("message_received_at") @db.DateTime(3)
  /// ato_auth_events.id / occurred_at of an authentication signal (no FK).
  authEventId         BigInt?             @map("auth_event_id") @db.UnsignedBigInt
  authEventOccurredAt DateTime?           @map("auth_event_occurred_at") @db.DateTime(3)
  /// security_incidents.id the signal is linked to (no FK).
  incidentId          BigInt?             @map("incident_id") @db.UnsignedBigInt
  /// `ato-rules/1`.
  rulesVersion        String              @map("rules_version") @db.VarChar(16)
  /// ato_settings.version in force.
  settingsVersion     Int                 @map("settings_version") @db.UnsignedInt
  dismissedAt         DateTime?           @map("dismissed_at") @db.DateTime(3)
  dismissedByUserId   BigInt?             @map("dismissed_by_user_id") @db.UnsignedBigInt
  dismissReason       String?             @map("dismiss_reason") @db.VarChar(512)
  createdAt           DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.DateTime(3)

  @@id([id, detectedAt])
  @@index([organizationId, accountId, detectedAt, id])
  @@index([organizationId, accountId, dedupeKey])
  @@index([organizationId, incidentId, detectedAt])
  @@index([organizationId, detectedAt, id])
  @@index([organizationId, category, detectedAt])
  @@map("ato_risk_signals")
}

/// PARTITIONED by RANGE COLUMNS(computed_at), monthly, 13 months (tier core). Score history
/// (`ato-score/1`, D11): a row per change with its explanation and the scorer, rules and settings
/// versions.
model AtoRiskScore {
  id              BigInt          @default(autoincrement()) @db.UnsignedBigInt
  computedAt      DateTime        @map("computed_at") @db.DateTime(3)
  organizationId  BigInt          @map("organization_id") @db.UnsignedBigInt
  /// ato_accounts.id (no FK: partitioned).
  accountId       BigInt          @map("account_id") @db.UnsignedBigInt
  score           Int             @db.UnsignedTinyInt
  level           AtoRiskLevel
  previousScore   Int             @map("previous_score") @db.UnsignedTinyInt
  previousLevel   AtoRiskLevel    @map("previous_level")
  trigger         AtoScoreTrigger
  /// Top 10 contributions, group totals and caps, gates, override (`ato-score/1`).
  explanation     Json
  scorerVersion   String          @map("scorer_version") @db.VarChar(16)
  rulesVersion    String          @map("rules_version") @db.VarChar(16)
  settingsVersion Int             @map("settings_version") @db.UnsignedInt
  createdAt       DateTime        @default(now()) @map("created_at") @db.DateTime(3)

  @@id([id, computedAt])
  @@index([organizationId, accountId, computedAt, id])
  @@index([organizationId, computedAt, level])
  @@map("ato_risk_scores")
}

/// Analyst verdict on an account (D11): `compromised` raises the score to ≥ 90, `benign` caps it
/// below the medium band unless a later strong signal contradicts it. Expires; cleared rows kept
/// 730 days.
model AtoRiskOverride {
  id              BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  publicId        String             @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  organizationId  BigInt             @map("organization_id") @db.UnsignedBigInt
  accountId       BigInt             @map("account_id") @db.UnsignedBigInt
  verdict         AtoOverrideVerdict
  reason          String             @db.VarChar(1000)
  expiresAt       DateTime           @map("expires_at") @db.DateTime(3)
  /// No FK: the trail survives the deletion of the user.
  createdByUserId BigInt?            @map("created_by_user_id") @db.UnsignedBigInt
  createdAt       DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  clearedAt       DateTime?          @map("cleared_at") @db.DateTime(3)
  clearedByUserId BigInt?            @map("cleared_by_user_id") @db.UnsignedBigInt
  clearReason     String?            @map("clear_reason") @db.VarChar(1000)
  contradictedAt  DateTime?          @map("contradicted_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  account      AtoAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([organizationId, accountId, createdAt])
  @@map("ato_risk_overrides")
}

/// A trusted context of an account (IP CIDR, ASN, country, device; expiry ≤ 365 days) that
/// suppresses novelty rules, added by an analyst or by false-positive feedback. Removal deletes
/// the row (the audit log keeps the trail).
model AtoTrustedContext {
  id              BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  publicId        String                  @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  organizationId  BigInt                  @map("organization_id") @db.UnsignedBigInt
  accountId       BigInt                  @map("account_id") @db.UnsignedBigInt
  kind            AtoTrustedContextKind
  /// Canonical CIDR, ASN number, ISO country code or device hash.
  value           String                  @db.VarChar(64)
  ipVersion       Int?                    @map("ip_version") @db.UnsignedTinyInt
  /// First and last address of an `ip_cidr` range (16 bytes, IPv4 mapped).
  rangeStart      Bytes?                  @map("range_start") @db.VarBinary(16)
  rangeEnd        Bytes?                  @map("range_end") @db.VarBinary(16)
  reason          String                  @db.VarChar(512)
  source          AtoTrustedContextSource
  /// security_incidents.id of the false-positive resolution (no FK).
  incidentId      BigInt?                 @map("incident_id") @db.UnsignedBigInt
  createdByUserId BigInt?                 @map("created_by_user_id") @db.UnsignedBigInt
  createdAt       DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  expiresAt       DateTime                @map("expires_at") @db.DateTime(3)

  account AtoAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, kind, value])
  @@index([organizationId, accountId])
  @@map("ato_trusted_contexts")
}

/// ATO category detail of a security incident (D12; one row per `account_takeover` incident,
/// written in the opening transaction): scores, detection reason, recommendations, summaries and
/// evidence counts beyond the link caps. No message content.
model AtoIncidentDetail {
  incidentId         BigInt    @id @map("incident_id") @db.UnsignedBigInt
  organizationId     BigInt    @map("organization_id") @db.UnsignedBigInt
  accountId          BigInt    @map("account_id") @db.UnsignedBigInt
  riskScoreAtOpen    Int       @map("risk_score_at_open") @db.UnsignedTinyInt
  peakRiskScore      Int       @map("peak_risk_score") @db.UnsignedTinyInt
  /// Codes, contributions and versions at opening.
  detectionReason    Json      @map("detection_reason")
  /// `recommendResponses` output with availability (`available`, `requires_provider`, `manual`,
  /// `policy`).
  recommendedActions Json      @map("recommended_actions")
  /// ≤ 20 `{ ip, cc, asn, reputation, counts }`.
  relatedIps         Json      @map("related_ips")
  geoSummary         Json?     @map("geo_summary")
  deviceSummary      Json?     @map("device_summary")
  signalCount        Int       @default(0) @map("signal_count") @db.UnsignedInt
  authEventCount     Int       @default(0) @map("auth_event_count") @db.UnsignedInt
  messageCount       Int       @default(0) @map("message_count") @db.UnsignedInt
  findingCount       Int       @default(0) @map("finding_count") @db.UnsignedInt
  lastSignalsEventAt DateTime? @map("last_signals_event_at") @db.DateTime(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  incident SecurityIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  account  AtoAccount       @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([organizationId, accountId])
  @@map("ato_incident_details")
}

/// A response action (D13, ADR-0072): gateway actions run inline in the authorizing transaction,
/// provider actions asynchronously through `ato.response.requested.v1`, manual actions are
/// `attested`. One non-terminal action per (incident, type, target): unique key over
/// `dedupe_hash` and the generated `active_marker`.
model AtoResponseAction {
  id                 BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  publicId           String                   @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  organizationId     BigInt                   @map("organization_id") @db.UnsignedBigInt
  incidentId         BigInt?                  @map("incident_id") @db.UnsignedBigInt
  accountId          BigInt                   @map("account_id") @db.UnsignedBigInt
  /// RESPONSE_CATALOGUE type (`restrict_smtp_sending`, `revoke_sessions`, …).
  actionType         String                   @map("action_type") @db.VarChar(48)
  /// `gateway`, `manual` or a provider kind.
  provider           String                   @db.VarChar(32)
  impact             AtoResponseImpact
  /// The target (connector id, mailbox hash, CIDR, provider identity), bounded JSON.
  target             Json
  params             Json
  status             AtoResponseStatus
  requiresApproval   Boolean                  @map("requires_approval")
  authorization      AtoResponseAuthorization
  requestedByType    ActorType                @map("requested_by_type")
  requestedById      String?                  @map("requested_by_id") @db.VarChar(64)
  requestReason      String?                  @map("request_reason") @db.VarChar(1000)
  approvedByUserId   BigInt?                  @map("approved_by_user_id") @db.UnsignedBigInt
  decidedAt          DateTime?                @map("decided_at") @db.DateTime(3)
  decisionReason     String?                  @map("decision_reason") @db.VarChar(1000)
  approvalExpiresAt  DateTime?                @map("approval_expires_at") @db.DateTime(3)
  executedAt         DateTime?                @map("executed_at") @db.DateTime(3)
  completedAt        DateTime?                @map("completed_at") @db.DateTime(3)
  effectiveUntil     DateTime?                @map("effective_until") @db.DateTime(3)
  nextCheckAt        DateTime?                @map("next_check_at") @db.DateTime(3)
  providerReference  String?                  @map("provider_reference") @db.VarChar(128)
  providerStatus     AtoProviderStatus?       @map("provider_status")
  resultCode         String?                  @map("result_code") @db.VarChar(64)
  attempts           Int                      @default(0) @db.UnsignedSmallInt
  /// ato_smtp_restrictions.id of a gateway restriction (no FK).
  restrictionId      BigInt?                  @map("restriction_id") @db.UnsignedBigInt
  rolledBackByUserId BigInt?                  @map("rolled_back_by_user_id") @db.UnsignedBigInt
  rollbackReason     String?                  @map("rollback_reason") @db.VarChar(1000)
  /// Step 8.5: ato_provider_integrations.id that executed a provider action (no FK: the action
  /// history survives unbinding).
  integrationId      BigInt?                  @map("integration_id") @db.UnsignedBigInt
  /// Step 8.5: provider pre-state and progress (`providerActionStateSchema` v1, ≤ 2 KiB, ids,
  /// booleans and enums only; never an address).
  providerState      Json?                    @map("provider_state")
  /// Hex SHA-256 of (incident, type, target).
  dedupeHash         String                   @map("dedupe_hash") @db.Char(64)
  /// READ-ONLY, generated by MySQL: `GENERATED ALWAYS AS (IF(status IN ('pending_approval',
  /// 'approved', 'executing', 'rollback_requested'), 1, NULL)) STORED`. Never write it.
  activeMarker       Int?                     @map("active_marker") @db.UnsignedTinyInt
  rowVersion         Int                      @default(1) @map("row_version") @db.UnsignedInt
  createdAt          DateTime                 @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  incident     SecurityIncident?      @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  account      AtoAccount             @relation(fields: [accountId], references: [id], onDelete: Restrict)
  logs         AtoResponseActionLog[]

  @@unique([organizationId, dedupeHash, activeMarker])
  @@index([organizationId, status, createdAt, id])
  @@index([organizationId, incidentId])
  @@index([organizationId, accountId, createdAt])
  /// Approval expiry sweep.
  @@index([status, approvalExpiresAt])
  /// Provider confirmation polling.
  @@index([status, nextCheckAt])
  /// Step 8.5: pending provider actions of an integration (unbinding).
  @@index([integrationId, status])
  @@map("ato_response_actions")
}

/// Attempt log of a response action (one row per authorize / execute / confirm / rollback
/// attempt; 730 days).
model AtoResponseActionLog {
  id             BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId BigInt              @map("organization_id") @db.UnsignedBigInt
  actionId       BigInt              @map("action_id") @db.UnsignedBigInt
  phase          AtoActionLogPhase
  attemptNo      Int                 @map("attempt_no") @db.UnsignedSmallInt
  outcome        AtoActionLogOutcome
  providerStatus String?             @map("provider_status") @db.VarChar(32)
  errorCode      String?             @map("error_code") @db.VarChar(64)
  durationMs     Int                 @map("duration_ms") @db.UnsignedInt
  createdAt      DateTime            @default(now()) @map("created_at") @db.DateTime(3)

  action AtoResponseAction @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([actionId, createdAt])
  @@index([createdAt])
  @@map("ato_response_action_logs")
}

/// A temporary SMTP enforcement row (D14, ADR-0073; ≤ 7 days): `send_block` (mailbox or
/// connector, checked by the smtp-adapter policy service at RCPT) or `auth_block` (connector or
/// connector + CIDR, checked by the SASL service). Written only through the ATO store; cached
/// per organization in Redis by the smtp-adapter. `mailbox_sha256` = atoMailboxSha256(address).
/// One active row per subject: unique key over `subject_hash` and the generated `active_marker`.
model AtoSmtpRestriction {
  id               BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  publicId         String               @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  organizationId   BigInt               @map("organization_id") @db.UnsignedBigInt
  kind             AtoRestrictionKind
  scope            AtoRestrictionScope
  /// smtp_connectors.id (no FK).
  connectorId      BigInt?              @map("connector_id") @db.UnsignedBigInt
  mailboxSha256    String?              @map("mailbox_sha256") @db.Char(64)
  /// Lower-cased address for display (portal); never on the SMTP path.
  mailboxAddress   String?              @map("mailbox_address") @db.VarChar(320)
  ipCidr           String?              @map("ip_cidr") @db.VarChar(49)
  ipVersion        Int?                 @map("ip_version") @db.UnsignedTinyInt
  rangeStart       Bytes?               @map("range_start") @db.VarBinary(16)
  rangeEnd         Bytes?               @map("range_end") @db.VarBinary(16)
  mode             AtoRestrictionMode
  status           AtoRestrictionStatus
  reasonCode       String               @map("reason_code") @db.VarChar(64)
  /// ato_response_actions.id that applied it (no FK).
  responseActionId BigInt?              @map("response_action_id") @db.UnsignedBigInt
  startsAt         DateTime             @map("starts_at") @db.DateTime(3)
  expiresAt        DateTime             @map("expires_at") @db.DateTime(3)
  liftedAt         DateTime?            @map("lifted_at") @db.DateTime(3)
  liftedByType     AtoLiftedByType?     @map("lifted_by_type")
  liftedById       String?              @map("lifted_by_id") @db.VarChar(64)
  liftReason       String?              @map("lift_reason") @db.VarChar(512)
  /// Hex SHA-256 of `kind|scope|connectorId|mailboxSha256|cidr`.
  subjectHash      String               @map("subject_hash") @db.Char(64)
  /// READ-ONLY, generated by MySQL: `GENERATED ALWAYS AS (IF(status = 'active', 1, NULL))
  /// STORED`. Never write it.
  activeMarker     Int?                 @map("active_marker") @db.UnsignedTinyInt
  createdAt        DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, subjectHash, activeMarker])
  @@index([organizationId, status, expiresAt])
  /// Expiry sweep.
  @@index([status, expiresAt])
  @@map("ato_smtp_restrictions")
}

/// An identity-provider binding of the provider ingestion runner (D15): capabilities and health.
/// Step 8.5 binds it to a step 8.2 connection (`connector_ref` = the connection public id, no FK
/// to 8.2 tables), adds settings (`ato-idp-binding/1`), probe health and the directory guard;
/// stream state lives in `ato_provider_streams`. No secret is stored here (credentials stay with
/// the 8.2 connection). One non-disabled integration per directory platform-wide: unique key over
/// (`provider`, `directory_ref_hash`, `active_marker`).
model AtoProviderIntegration {
  id                  BigInt                       @id @default(autoincrement()) @db.UnsignedBigInt
  publicId            String                       @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  organizationId      BigInt                       @map("organization_id") @db.UnsignedBigInt
  provider            String                       @db.VarChar(32)
  /// Step 8.2 connection public id (opaque in 8.4; the binding target in 8.5).
  connectorRef        String?                      @map("connector_ref") @db.VarChar(64)
  /// Hex SHA-256 of `provider|connector_ref or -`.
  bindingKey          String                       @map("binding_key") @db.Char(64)
  status              AtoProviderIntegrationStatus @default(active)
  capabilities        Json
  /// DEPRECATED by step 8.5: no longer written; cursors live in ato_provider_streams.
  cursors             Json
  lastSuccessAt       DateTime?                    @map("last_success_at") @db.DateTime(3)
  lastErrorCode       String?                      @map("last_error_code") @db.VarChar(64)
  consecutiveFailures Int                          @default(0) @map("consecutive_failures") @db.UnsignedSmallInt
  nextPollAt          DateTime                     @map("next_poll_at") @db.DateTime(3)
  /// Step 8.5: display name of the bound connection (≤ 128).
  displayName         String?                      @map("display_name") @db.VarChar(128)
  /// Step 8.5: hex SHA-256 of `provider|external tenant id` (directory guard, ADR-0084).
  directoryRefHash    String?                      @map("directory_ref_hash") @db.Char(64)
  /// Step 8.5: provider-verified linked domains of the connection (≤ 500 names).
  directoryDomains    Json?                        @map("directory_domains")
  /// Step 8.5: permission names observed on the ATO grants (≤ 64 names).
  grantedPermissions  Json?                        @map("granted_permissions")
  /// Step 8.5: `ato-idp-binding/1` settings (D10; validated in code; `{}` for 8.4 rows).
  settings            Json                         @default(dbgenerated("(json_object())"))
  settingsVersion     Int                          @default(1) @map("settings_version") @db.UnsignedInt
  healthStatus        AtoProviderHealthStatus      @default(unknown) @map("health_status")
  /// Step 8.5: last `ProbeReport` minus domains and permissions (≤ 8 KiB).
  healthDetail        Json?                        @map("health_detail")
  healthCheckedAt     DateTime?                    @map("health_checked_at") @db.DateTime(3)
  nextHealthAt        DateTime?                    @map("next_health_at") @db.DateTime(3)
  pausedReason        String?                      @map("paused_reason") @db.VarChar(64)
  disabledReason      String?                      @map("disabled_reason") @db.VarChar(64)
  disabledAt          DateTime?                    @map("disabled_at") @db.DateTime(3)
  createdByUserId     BigInt?                      @map("created_by_user_id") @db.UnsignedBigInt
  updatedByUserId     BigInt?                      @map("updated_by_user_id") @db.UnsignedBigInt
  /// READ-ONLY, generated by MySQL: `GENERATED ALWAYS AS (IF(status <> 'disabled', 1, NULL))
  /// STORED`. Never write it.
  activeMarker        Int?                         @map("active_marker") @db.UnsignedTinyInt
  rowVersion          Int                          @default(1) @map("row_version") @db.UnsignedInt
  createdAt           DateTime                     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime                     @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  streams      AtoProviderStream[]
  mailboxItems AtoProviderMailboxItem[]
  identities   AtoAccountIdentity[]

  @@unique([organizationId, bindingKey])
  @@unique([provider, directoryRefHash, activeMarker], map: "ato_provider_integrations_directory_active_key")
  @@index([status, nextPollAt])
  @@index([organizationId, status, id])
  /// Probe scheduling.
  @@index([status, nextHealthAt])
  @@map("ato_provider_integrations")
}

/// Step 8.5 (D7, ADR-0083): one polling state row per integration and 8.4 stream: role, cursor
/// (versioned, ≤ 4 096 characters, validated in code), watermark, backfill, throttling and
/// counters. Claimed by the ato-worker `provider` role with `FOR UPDATE SKIP LOCKED`.
model AtoProviderStream {
  id                  BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId      BigInt                  @map("organization_id") @db.UnsignedBigInt
  integrationId       BigInt                  @map("integration_id") @db.UnsignedBigInt
  stream              AtoProviderStreamName
  role                AtoProviderStreamRole
  enabled             Boolean
  status              AtoProviderStreamStatus
  availability        AtoProviderAvailability @default(unknown)
  availabilityCode    String?                 @map("availability_code") @db.VarChar(64)
  cursor              String?                 @db.Text
  cursorSeq           BigInt                  @default(0) @map("cursor_seq") @db.UnsignedBigInt
  watermarkAt         DateTime?               @map("watermark_at") @db.DateTime(3)
  backfillFrom        DateTime?               @map("backfill_from") @db.DateTime(3)
  backfillRequestedAt DateTime?               @map("backfill_requested_at") @db.DateTime(3)
  backfillCompletedAt DateTime?               @map("backfill_completed_at") @db.DateTime(3)
  /// Start of the contiguous provider-time range already ingested (review fix; NULL on older rows).
  coveredFrom         DateTime?               @map("covered_from") @db.DateTime(3)
  /// During a backfill: events in [replay_from, replay_until) were processed by an earlier
  /// ingestion and are skipped (`replayed`); cleared when the backfill completes.
  replayFrom          DateTime?               @map("replay_from") @db.DateTime(3)
  replayUntil         DateTime?               @map("replay_until") @db.DateTime(3)
  nextPollAt          DateTime                @map("next_poll_at") @db.DateTime(3)
  throttledUntil      DateTime?               @map("throttled_until") @db.DateTime(3)
  lastAttemptAt       DateTime?               @map("last_attempt_at") @db.DateTime(3)
  lastSuccessAt       DateTime?               @map("last_success_at") @db.DateTime(3)
  lastEventAt         DateTime?               @map("last_event_at") @db.DateTime(3)
  lastErrorCode       String?                 @map("last_error_code") @db.VarChar(64)
  consecutiveFailures Int                     @default(0) @map("consecutive_failures") @db.UnsignedSmallInt
  eventsTotal         BigInt                  @default(0) @map("events_total") @db.UnsignedBigInt
  pagesTotal          BigInt                  @default(0) @map("pages_total") @db.UnsignedBigInt
  rowVersion          Int                     @default(1) @map("row_version") @db.UnsignedInt
  createdAt           DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime                @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  integration  AtoProviderIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, stream])
  /// Due streams (claim).
  @@index([status, nextPollAt])
  @@index([organizationId, integrationId])
  @@map("ato_provider_streams")
}

/// Step 8.5 (D8.3, ADR-0083): mailbox state items (forwarding, inbox rules / Gmail filters,
/// delegates, mailbox permissions, send-as) as hashes, target DOMAINS (never addresses) and
/// trait codes. Rows written by a page carry its cursor `seq` (`emitted_seq`); they count as
/// known only once the runner committed that cursor (cursor-confirmed state). Removed items are
/// kept 400 days after `removed_at`.
model AtoProviderMailboxItem {
  id                     BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  /// UUIDv7; `itemId` of `remove_forwarding_rule` and the api.
  publicId               String               @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  organizationId         BigInt               @map("organization_id") @db.UnsignedBigInt
  integrationId          BigInt               @map("integration_id") @db.UnsignedBigInt
  accountId              BigInt?              @map("account_id") @db.UnsignedBigInt
  /// Hex SHA-256 of `provider|externalId`.
  identityExternalIdHash String               @map("identity_external_id_hash") @db.Char(64)
  itemKind               AtoMailboxItemKind   @map("item_kind")
  /// Hex SHA-256 of `provider|externalUserId|kind|providerItemId or canonical definition`.
  itemHash               String               @map("item_hash") @db.Char(64)
  /// Provider rule or filter id only (never an address).
  providerItemRef        String?              @map("provider_item_ref") @db.VarChar(255)
  targetDomain           String?              @map("target_domain") @db.VarChar(253)
  /// ≤ 16 `MAILBOX_RULE_TRAITS` codes.
  traits                 Json
  enabled                Boolean?
  state                  AtoMailboxItemState
  source                 AtoMailboxItemSource
  firstSeenAt            DateTime             @map("first_seen_at") @db.DateTime(3)
  lastSeenAt             DateTime             @map("last_seen_at") @db.DateTime(3)
  removedAt              DateTime?            @map("removed_at") @db.DateTime(3)
  /// The page cursor `seq` that last emitted a change of this item.
  emittedSeq             BigInt               @map("emitted_seq") @db.UnsignedBigInt
  /// The change that page emitted (deviation WP1-3).
  lastChange             AtoMailboxItemChange @default(added) @map("last_change")
  createdAt              DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt              DateTime             @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  integration  AtoProviderIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  account      AtoAccount?            @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@unique([integrationId, identityExternalIdHash, itemKind, itemHash], map: "ato_provider_mailbox_items_identity_item_key")
  @@index([organizationId, accountId, state, itemKind])
  @@index([integrationId, emittedSeq])
  /// Retention sweep of removed items.
  @@index([state, removedAt])
  @@map("ato_provider_mailbox_items")
}

/// Mapping of an identity-provider identity to a `mailbox` account (D1, 8.5 adapters).
/// `external_id_hash` = hex SHA-256 of the provider's immutable id.
model AtoAccountIdentity {
  id                        BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId            BigInt                     @map("organization_id") @db.UnsignedBigInt
  accountId                 BigInt                     @map("account_id") @db.UnsignedBigInt
  provider                  String                     @db.VarChar(32)
  externalId                String                     @map("external_id") @db.VarChar(128)
  externalIdHash            String                     @map("external_id_hash") @db.Char(64)
  userPrincipalName         String?                    @map("user_principal_name") @db.VarChar(320)
  firstSeenAt               DateTime                   @map("first_seen_at") @db.DateTime(3)
  lastSeenAt                DateTime                   @map("last_seen_at") @db.DateTime(3)
  /// Step 8.5: the integration that resolved the identity.
  integrationId             BigInt?                    @map("integration_id") @db.UnsignedBigInt
  primaryEmailDomain        String?                    @map("primary_email_domain") @db.VarChar(253)
  directoryStatus           AtoIdentityDirectoryStatus @default(unknown) @map("directory_status")
  directoryStatusAt         DateTime?                  @map("directory_status_at") @db.DateTime(3)
  /// Step 8.5: set by `POST /ato/accounts/{id}/mailbox-state/refresh`, cleared after the poll.
  mailboxRefreshRequestedAt DateTime?                  @map("mailbox_refresh_requested_at") @db.DateTime(3)

  account     AtoAccount              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  integration AtoProviderIntegration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  @@unique([organizationId, provider, externalIdHash])
  @@index([accountId])
  @@index([integrationId, mailboxRefreshRequestedAt])
  @@index([organizationId, integrationId])
  @@map("ato_account_identities")
}

// ---------------------------------------------------------------------------------------------
// 3.10 Platform operations
// ---------------------------------------------------------------------------------------------

/// PARTITIONED by RANGE COLUMNS(created_at), daily. Transactional outbox (ADR-0005, carried
/// forward by ADR-0024): written in the same transaction as the state change. The relay
/// (`apps/event-relay`, ADR-0023) publishes each row to RabbitMQ and sets `published_at` only
/// after the broker confirmed it; `attempts`/`available_at`/`last_error` are the relay's row
/// backoff, and `attempts >= RELAY_MAX_ATTEMPTS` marks a poison row (never published, alerted).
/// The reconciler re-drives published rows whose consumer left no ledger row (`redrive_count`,
/// `last_redriven_at`). A partition is dropped only once every row in it is published.
/// No unique on `event_id` (it would have to include `created_at`); downstream de-duplication is
/// message_idempotency.
model MessageOutbox {
  id             BigInt    @default(autoincrement()) @db.UnsignedBigInt
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  eventId        String    @map("event_id") @db.Char(36)
  organizationId BigInt    @map("organization_id") @db.UnsignedBigInt
  eventType      String    @map("event_type") @db.VarChar(100)
  aggregateType  String    @map("aggregate_type") @db.VarChar(64)
  aggregateId    String    @map("aggregate_id") @db.VarChar(64)
  correlationId  String    @map("correlation_id") @db.VarChar(128)
  payload        Json
  /// Earliest publish time (retry backoff).
  availableAt    DateTime  @default(now()) @map("available_at") @db.DateTime(3)
  /// Set by the relay once the broker confirmed the publish; NULL again while re-driven.
  publishedAt    DateTime? @map("published_at") @db.DateTime(3)
  /// Row-specific publish failures (nack, unroutable, contract); not broker outages.
  attempts       Int       @default(0) @db.UnsignedInt
  /// A failure code, never an error message.
  lastError      String?   @map("last_error") @db.VarChar(1024)
  /// Reconciliation re-drives (ADR-0023).
  redriveCount   Int       @default(0) @map("redrive_count") @db.UnsignedSmallInt
  /// Set while a re-drive awaits its re-check; NULL once settled or exhausted.
  lastRedrivenAt DateTime? @map("last_redriven_at") @db.DateTime(3)

  @@id([id, createdAt])
  @@index([publishedAt, id])
  @@index([lastRedrivenAt])
  /// Provenance lookups by event id (the delivery planner checks that an approval was issued).
  @@index([eventId])
  @@map("message_outbox")
}

/// Inbox / idempotency ledger (not partitioned: the key must not contain time). A consumer
/// records (consumer, event_id) in the same transaction as its side effects via processOnce; a
/// duplicate delivery hits the primary key and is skipped. Purged after 30 days.
model MessageIdempotency {
  consumer    String   @db.VarChar(100)
  eventId     String   @map("event_id") @db.Char(36)
  processedAt DateTime @default(now()) @map("processed_at") @db.DateTime(3)

  @@id([consumer, eventId])
  @@index([processedAt])
  @@map("message_idempotency")
}

/// Idempotency-Key store of the api (step 3.3 L11; reusable by 6.1). Not partitioned, no foreign
/// keys. One row per (organization, key): the first successful response of an operation, replayed
/// for the same principal, operation and request fingerprint until `expires_at` (24 h); another
/// request under the same key is refused (422). Owned by the api; purged by db:partitions one day
/// after expiry. No message content: ids, codes and the response body of the operation only.
model ApiIdempotencyKey {
  id             BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId BigInt              @map("organization_id") @db.UnsignedBigInt
  /// The client's Idempotency-Key header (1–128 characters); collation utf8mb4_bin (case-sensitive).
  idempotencyKey String              @map("idempotency_key") @db.VarChar(128)
  /// Operation name, e.g. `message.rescan`, `message.release`.
  operation      String              @db.VarChar(64)
  /// `user:<publicId>` | `api_key:<publicId>`.
  principal      String              @db.VarChar(80)
  /// Hex SHA-256 of the canonical JSON { operation, resourceId, body }.
  requestSha256  String              @map("request_sha256") @db.Char(64)
  /// Public id of the addressed resource.
  resourceId     String              @map("resource_id") @db.VarChar(64)
  statusCode     Int                 @map("status_code") @db.UnsignedSmallInt
  response       Json
  /// `completed` (a stored 2xx response) or `pending` (a reservation of the step 6.1 interceptor,
  /// D9: status_code 0, response JSON null, short expiry).
  state          ApiIdempotencyState @default(completed)
  createdAt      DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  expiresAt      DateTime            @map("expires_at") @db.DateTime(3)

  @@unique([organizationId, idempotencyKey])
  @@index([expiresAt])
  @@map("api_idempotency_keys")
}

/// Reservation state of an `api_idempotency_keys` row (step 6.1 D9).
enum ApiIdempotencyState {
  completed
  pending
}

/// Where a RabbitMQ consumer left an event it has not handled (step 3.2, review round 1): the
/// QueueConsumer writes `retrying` after each confirmed retry hop and `dead_lettered` after the
/// confirmed dead-letter copy. The reconciler reads it so it never re-drives an event that is
/// still retrying or was dead-lettered on purpose (replay is the recovery path for those). The
/// ledger (`message_idempotency`) stays the record of handled events. Not partitioned (same key
/// as the ledger); purged after 30 days with the ledger.
model MessageConsumerProgress {
  consumer         String                       @db.VarChar(100)
  eventId          String                       @map("event_id") @db.Char(36)
  state            MessageConsumerProgressState
  /// A failure code (`/^[a-z0-9_]{1,48}$/`), never an error message.
  reason           String?                      @db.VarChar(48)
  attempt          Int                          @default(0) @db.UnsignedInt
  transientRetries Int                          @default(0) @map("transient_retries") @db.UnsignedInt
  updatedAt        DateTime                     @default(now()) @map("updated_at") @db.DateTime(3)

  @@id([consumer, eventId])
  @@index([updatedAt])
  @@map("message_consumer_progress")
}

enum MessageConsumerProgressState {
  retrying
  dead_lettered
}

/// PARTITIONED by RANGE COLUMNS(created_at), monthly, never auto-dropped. Append-only audit
/// trail of administrative actions; services never update or delete it. `organization_id` NULL
/// = platform action. No foreign keys.
model AuditLog {
  id             BigInt         @default(autoincrement()) @db.UnsignedBigInt
  createdAt      DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  organizationId BigInt?        @map("organization_id") @db.UnsignedBigInt
  actorType      AuditActorType @map("actor_type")
  actorId        String?        @map("actor_id") @db.VarChar(64)
  action         String         @db.VarChar(100)
  resourceType   String         @map("resource_type") @db.VarChar(64)
  resourceId     String?        @map("resource_id") @db.VarChar(64)
  correlationId  String?        @map("correlation_id") @db.VarChar(128)
  sourceIp       String?        @map("source_ip") @db.VarChar(45)
  metadata       Json?

  @@id([id, createdAt])
  @@index([organizationId, createdAt])
  @@index([resourceType, resourceId])
  /// Step 7.2 §2 E3 (ADR-0061): the resource plan of the audit search (a resource's history in
  /// keyset order (created_at, id), organization-led; `organization_id IS NULL` for platform rows).
  @@index([organizationId, resourceType, resourceId, createdAt, id], map: "audit_logs_org_resource_created_idx")
  @@map("audit_logs")
}

/// Tenant webhook endpoint (step 1.1; extended by step 6.2 §3, W5-W7, W11). Written by the api
/// (registration, rotation, status) and the webhook-worker (failure counters, auto-disable).
/// `event_types` is a JSON array of 1-10 public event types (`WEBHOOK_EVENT_TYPES` of
/// @email-gateway/webhooks); `filters` the strict `subscriptionFiltersSchema` object or NULL.
/// The signing secret is AES-256-GCM encrypted with WEBHOOK_SECRET_ENCRYPTION_KEY
/// (`WebhookSecretCipher`, AAD binds organization, subscription and secret version): never
/// plaintext, never returned after create/rotate. `url` may carry a receiver token: never logged
/// or audited (host and hash only). No message content.
model WebhookSubscription {
  id                       BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  publicId                 String        @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  organizationId           BigInt        @map("organization_id") @db.UnsignedBigInt
  name                     String        @db.VarChar(255)
  description              String?       @db.VarChar(512)
  url                      String        @db.VarChar(2048)
  eventTypes               Json          @map("event_types")
  /// `subscriptionFiltersSchema` (directions, domainIds, minSeverity, verdicts) or NULL.
  filters                  Json?
  secretCiphertext         String        @map("secret_ciphertext") @db.VarChar(512)
  /// Starts at 1; +1 per rotation (bound into the cipher AAD).
  secretVersion            Int           @default(1) @map("secret_version") @db.UnsignedSmallInt
  secretRotatedAt          DateTime?     @map("secret_rotated_at") @db.DateTime(3)
  /// The retired secret during a rotation overlap (W7); NULL when there is none.
  previousSecretCiphertext String?       @map("previous_secret_ciphertext") @db.VarChar(512)
  previousSecretExpiresAt  DateTime?     @map("previous_secret_expires_at") @db.DateTime(3)
  status                   WebhookStatus @default(active)
  /// Per-subscription in-flight cap (1 … WEBHOOK_MAX_INFLIGHT_PER_SUBSCRIPTION); NULL = default.
  maxConcurrency           Int?          @map("max_concurrency") @db.UnsignedTinyInt
  consecutiveFailures      Int           @default(0) @map("consecutive_failures") @db.UnsignedInt
  /// First failure of the current failure streak (auto-disable window, W11).
  failingSince             DateTime?     @map("failing_since") @db.DateTime(3)
  lastSuccessAt            DateTime?     @map("last_success_at") @db.DateTime(3)
  lastFailureAt            DateTime?     @map("last_failure_at") @db.DateTime(3)
  /// Code: `sustained_failure` (system) or `manual`.
  disabledReason           String?       @map("disabled_reason") @db.VarChar(64)
  disabledAt               DateTime?     @map("disabled_at") @db.DateTime(3)
  deletedAt                DateTime?     @map("deleted_at") @db.DateTime(3)
  rowVersion               Int           @default(1) @map("row_version") @db.UnsignedInt
  createdByUserId          BigInt?       @map("created_by_user_id") @db.UnsignedBigInt
  createdAt                DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  replays WebhookReplay[]

  @@index([organizationId, status])
  @@index([organizationId, id], map: "webhook_subscriptions_organization_id_id_idx")
  @@index([status, deletedAt], map: "webhook_subscriptions_status_deleted_at_idx")
  @@map("webhook_subscriptions")
}

/// PARTITIONED by RANGE COLUMNS(event_occurred_at), monthly (2 months, operational).
/// `event_occurred_at` comes from the envelope, so the unique key is deterministic across
/// redeliveries. One row per (subscription, public event, delivery_seq): `delivery_seq` 0 is the
/// original delivery (fanout or test), 1.. are replays (W12). Inserted by the webhook-worker
/// fanout and the api (single replay, test); updated by the webhook-worker delivery role
/// (lease, CAS on `attempt_count`). `last_error` is a code (`blocked:<reason>`,
/// `backlog_exceeded`, outcome codes), never a response body. No foreign keys.
model WebhookDelivery {
  id               BigInt                 @default(autoincrement()) @db.UnsignedBigInt
  eventOccurredAt  DateTime               @map("event_occurred_at") @db.DateTime(3)
  /// UUIDv7, app-generated (`EG-Delivery-Id`, REST id).
  publicId         String                 @default(uuid(7)) @map("public_id") @db.Char(36)
  subscriptionId   BigInt                 @map("subscription_id") @db.UnsignedBigInt
  organizationId   BigInt                 @map("organization_id") @db.UnsignedBigInt
  /// webhook_events.event_id (the public event id).
  eventId          String                 @map("event_id") @db.Char(36)
  eventType        String                 @map("event_type") @db.VarChar(100)
  /// 0 = original delivery; replays count up (≤ WEBHOOK_REPLAY_MAX_PER_DELIVERY).
  deliverySeq      Int                    @default(0) @map("delivery_seq") @db.UnsignedSmallInt
  trigger          WebhookDeliveryTrigger @default(event)
  /// webhook_replays.id of a range replay (no FK: partitioned table).
  replayId         BigInt?                @map("replay_id") @db.UnsignedBigInt
  status           WebhookDeliveryStatus  @default(pending)
  attemptCount     Int                    @default(0) @map("attempt_count") @db.UnsignedSmallInt
  nextAttemptAt    DateTime?              @map("next_attempt_at") @db.DateTime(3)
  firstAttemptAt   DateTime?              @map("first_attempt_at") @db.DateTime(3)
  lastAttemptAt    DateTime?              @map("last_attempt_at") @db.DateTime(3)
  lastResponseCode Int?                   @map("last_response_code") @db.UnsignedSmallInt
  lastLatencyMs    Int?                   @map("last_latency_ms") @db.UnsignedInt
  lastError        String?                @map("last_error") @db.VarChar(1024)
  completedAt      DateTime?              @map("completed_at") @db.DateTime(3)
  createdAt        DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.DateTime(3)

  @@id([id, eventOccurredAt])
  @@unique([subscriptionId, eventId, eventOccurredAt, deliverySeq], map: "webhook_deliveries_sub_event_seq_key")
  /// Step 1.1 retry-queue index (perf harness query Q-webhook).
  @@index([status, nextAttemptAt])
  @@index([publicId], map: "webhook_deliveries_public_id_idx")
  /// Due work per organization (W8 claim, loose index scan).
  @@index([status, organizationId, nextAttemptAt], map: "webhook_deliveries_status_org_next_idx")
  /// Delivery history keyset and range replay scan (W12, §6.1).
  @@index([subscriptionId, eventOccurredAt, id], map: "webhook_deliveries_sub_occurred_id_idx")
  @@map("webhook_deliveries")
}

/// PARTITIONED by RANGE COLUMNS(occurred_at), monthly (2 months, operational; step 6.2 §3, W3,
/// W4). One public webhook event projected from an internal event by the webhook-worker fanout
/// (or a `webhook.ping` of the api test route): `event_id` is the deterministic public id
/// (`webhookEventId`), `occurred_at` the source envelope's `occurredAt`, so redeliveries insert
/// nothing new (insert-ignore on the unique key). `payload_json` is the serialized envelope sent
/// byte-identically on every attempt and replay; it passed `assertWebhookPayloadSafe` (public
/// ids, domains, codes and counts only: never a subject, address local part, body, attachment,
/// S3 key, URL from mail or secret). Never updated. No foreign keys.
model WebhookEvent {
  id                BigInt               @default(autoincrement()) @db.UnsignedBigInt
  occurredAt        DateTime             @map("occurred_at") @db.DateTime(3)
  organizationId    BigInt               @map("organization_id") @db.UnsignedBigInt
  /// Public event id (envelope `id`, `EG-Event-Id`, `Idempotency-Key`).
  eventId           String               @map("event_id") @db.Char(36)
  eventType         String               @map("event_type") @db.VarChar(64)
  /// Envelope id of the internal source event.
  sourceEventId     String               @map("source_event_id") @db.Char(36)
  sourceEventType   String               @map("source_event_type") @db.VarChar(100)
  messageId         BigInt?              @map("message_id") @db.UnsignedBigInt
  messageReceivedAt DateTime?            @map("message_received_at") @db.DateTime(3)
  domainId          BigInt?              @map("domain_id") @db.UnsignedBigInt
  severity          WebhookEventSeverity
  /// The envelope JSON (≤ 16 KiB), exactly the bytes that are signed and sent.
  payloadJson       String               @map("payload_json") @db.Text
  /// Hex SHA-256 of `payload_json`.
  payloadSha256     String               @map("payload_sha256") @db.Char(64)
  createdAt         DateTime             @default(now()) @map("created_at") @db.DateTime(3)

  @@id([id, occurredAt])
  @@unique([eventId, occurredAt])
  @@index([organizationId, occurredAt])
  @@map("webhook_events")
}

/// PARTITIONED by RANGE COLUMNS(attempted_at), monthly (2 months, operational; step 6.2 §3, W8,
/// W10). Append-only record of one HTTP attempt of a delivery, written by the webhook-worker
/// delivery role in the transaction that records the outcome. `response_snippet` is the
/// sanitized first ≤ 512 characters of the response (`responseSnippet`: secrets and tokens
/// redacted); untrusted text, never rendered as HTML. No request body, no headers, no URL.
/// No foreign keys.
model WebhookDeliveryAttempt {
  id                      BigInt                @default(autoincrement()) @db.UnsignedBigInt
  attemptedAt             DateTime              @map("attempted_at") @db.DateTime(3)
  organizationId          BigInt                @map("organization_id") @db.UnsignedBigInt
  subscriptionId          BigInt                @map("subscription_id") @db.UnsignedBigInt
  /// webhook_deliveries.id (with `delivery_event_occurred_at`, its partition key).
  deliveryId              BigInt                @map("delivery_id") @db.UnsignedBigInt
  deliveryEventOccurredAt DateTime              @map("delivery_event_occurred_at") @db.DateTime(3)
  /// 1-based (`EG-Delivery-Attempt`).
  attemptNo               Int                   @map("attempt_no") @db.UnsignedSmallInt
  outcome                 WebhookAttemptOutcome
  httpStatus              Int?                  @map("http_status") @db.UnsignedSmallInt
  latencyMs               Int                   @map("latency_ms") @db.UnsignedInt
  responseSnippet         String?               @map("response_snippet") @db.VarChar(512)
  retryAfterSeconds       Int?                  @map("retry_after_seconds") @db.UnsignedInt
  /// Code only (e.g. `ECONNREFUSED`, `blocked:loopback`).
  errorCode               String?               @map("error_code") @db.VarChar(64)
  /// Number of `v1=` signatures sent (2 during a rotation overlap).
  signatureCount          Int                   @map("signature_count") @db.UnsignedTinyInt
  nextAttemptAt           DateTime?             @map("next_attempt_at") @db.DateTime(3)

  @@id([id, attemptedAt])
  @@unique([deliveryId, attemptNo, attemptedAt])
  @@index([organizationId, deliveryId, attemptedAt])
  @@map("webhook_delivery_attempts")
}

/// Time-range replay request (step 6.2 W12): inserted by the api (`queued`), processed in
/// batches by the webhook-worker delivery role over the subscription's original deliveries
/// (`cursor_*` keyset progress so a crash resumes). `statuses` / `event_types` are JSON arrays
/// of codes. Terminal rows are purged after 30 days (W13). No message data.
model WebhookReplay {
  id               BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  publicId         String               @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  organizationId   BigInt               @map("organization_id") @db.UnsignedBigInt
  subscriptionId   BigInt               @map("subscription_id") @db.UnsignedBigInt
  requestedByType  WebhookRequesterType @map("requested_by_type")
  /// Public id of the requesting user or API key.
  requestedById    String               @map("requested_by_id") @db.Char(36)
  rangeFrom        DateTime             @map("range_from") @db.DateTime(3)
  rangeTo          DateTime             @map("range_to") @db.DateTime(3)
  /// JSON array ⊆ succeeded, failed, dead, cancelled.
  statuses         Json
  /// JSON array of public event types, or NULL = all of the subscription's.
  eventTypes       Json?                @map("event_types")
  status           WebhookReplayStatus  @default(queued)
  cursorOccurredAt DateTime?            @map("cursor_occurred_at") @db.DateTime(3)
  cursorId         BigInt?              @map("cursor_id") @db.UnsignedBigInt
  matchedCount     Int                  @default(0) @map("matched_count") @db.UnsignedInt
  createdCount     Int                  @default(0) @map("created_count") @db.UnsignedInt
  /// True when WEBHOOK_REPLAY_MAX_EVENTS was reached.
  truncated        Boolean              @default(false)
  errorCode        String?              @map("error_code") @db.VarChar(64)
  createdAt        DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  startedAt        DateTime?            @map("started_at") @db.DateTime(3)
  completedAt      DateTime?            @map("completed_at") @db.DateTime(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([subscriptionId, status])
  @@index([organizationId, id])
  @@map("webhook_replays")
}

/// Tenant security-alert settings (step 6.2 N2, §6.3): strict `notificationSettingsSchema` of
/// @email-gateway/webhooks, every key optional (`{}` = defaults). Written by the api only
/// (`PUT /notifications/settings`, CAS on `row_version`); read by the webhook-worker fanout
/// (cached) and the notification-worker. No message data.
model NotificationSettings {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId  BigInt   @unique @map("organization_id") @db.UnsignedBigInt
  settings        Json
  /// Hex SHA-256 of the canonical settings JSON.
  settingsSha256  String   @map("settings_sha256") @db.Char(64)
  rowVersion      Int      @default(1) @map("row_version") @db.UnsignedInt
  updatedByUserId BigInt?  @map("updated_by_user_id") @db.UnsignedBigInt
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  updatedByUser User?        @relation("NotificationSettingsUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("notification_settings")
}

/// Per-user notification preferences (step 6.2 N3): strict `notificationPreferencesSchema`
/// (`{ optOut: PreferenceKind[] }`). Written by the api only (self route); read by the
/// notification-worker at send time. The quarantine digest opt-out stays in
/// quarantine_user_preferences.digest_opt_out (one source of truth).
model NotificationUserPreference {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId BigInt   @map("organization_id") @db.UnsignedBigInt
  userId         BigInt   @unique @map("user_id") @db.UnsignedBigInt
  preferences    Json
  rowVersion     Int      @default(1) @map("row_version") @db.UnsignedInt
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation("NotificationUserPreferenceUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("notification_user_preferences")
}

/// Security-alert throttle window (step 6.2 N2): one row per organization, alert kind, scope
/// (`-` for threat_detected, the domain public id for domain_dns_failed, the subscription public
/// id for webhook_disabled) and window start (`alertWindowStart`, UTC floor). Upserted by the
/// webhook-worker in the producing transaction (`event_count + 1`); only the first event of a
/// window writes the `notification.alert_requested.v1` outbox row (`alert_event_id`). Purged
/// after 7 days (W13). Ids and counts only.
model NotificationAlertWindow {
  id                 BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId     BigInt   @map("organization_id") @db.UnsignedBigInt
  kind               String   @db.VarChar(32)
  scopeKey           String   @map("scope_key") @db.VarChar(64)
  windowStart        DateTime @map("window_start") @db.DateTime(3)
  eventCount         Int      @default(1) @map("event_count") @db.UnsignedInt
  firstSourceEventId String   @map("first_source_event_id") @db.Char(36)
  alertEventId       String?  @map("alert_event_id") @db.Char(36)
  createdAt          DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, kind, scopeKey, windowStart])
  @@index([createdAt])
  @@map("notification_alert_windows")
}

/// Kind of a saved view (step 7.2 §2 E4); append-only like every enum.
enum SavedViewKind {
  message_explorer
}

/// A user's saved Email Explorer view (step 7.2 §2 E4, §3.3, ADR-0061): per organization, user
/// and kind, unique name (case-insensitive by collation), the strict `definition` (filters of
/// `GET /messages`, sort, range, columns; ≤ 8 KiB, validated by the api with the real list query
/// schema). Written and read by the api only (writer: read-after-write of the user's own
/// settings). The definition may hold an address or a subject searched by its owner: never
/// logged, never in audit metadata. Not partitioned.
model SavedView {
  id             BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  publicId       String        @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  organizationId BigInt        @map("organization_id") @db.UnsignedBigInt
  userId         BigInt        @map("user_id") @db.UnsignedBigInt
  kind           SavedViewKind
  name           String        @db.VarChar(80)
  definition     Json
  /// Compare-and-set counter (`expectedRowVersion` of PUT).
  rowVersion     Int           @default(1) @map("row_version") @db.UnsignedInt
  createdAt      DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation("SavedViewUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, kind, name])
  @@index([organizationId, userId, kind, id])
  @@index([userId])
  @@map("saved_views")
}

/// Platform configuration data (seeded): provider presets for destination servers (step 2.3
/// R2). Read by the api and the routing module; no tenant is special-cased in code.
model MailDestinationPreset {
  provider         MailDestinationProvider @id
  displayName      String                  @map("display_name") @db.VarChar(128)
  /// JSON array of anchored regular expressions (lower-case host names).
  hostPatterns     Json                    @map("host_patterns")
  hostHint         String?                 @map("host_hint") @db.VarChar(255)
  /// JSON array of { host, priority } or NULL (customer supplies the host).
  defaultServers   Json?                   @map("default_servers")
  port             Int                     @db.UnsignedSmallInt
  tlsMode          TlsMode                 @map("tls_mode")
  /// Postfix `match=` list (`:`-separated) for the preset's verified TLS.
  tlsVerifyNames   String                  @map("tls_verify_names") @db.VarChar(512)
  maxServers       Int                     @map("max_servers") @db.UnsignedTinyInt
  /// Relative documentation path (customer-side setup).
  documentationUrl String?                 @map("documentation_url") @db.VarChar(512)
  enabled          Boolean                 @default(true)
  createdAt        DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("mail_destination_presets")
}

/// Durable positions of stream consumers (outbox pollers, Postfix log tailers; step 2.3 R6, R9).
/// Not partitioned.
model StreamCursor {
  /// E.g. `outbox:delivery-worker.planner`, `postfix-log:out.gateway.local`.
  name        String    @id @db.VarChar(128)
  /// Outbox consumers: largest processed message_outbox.id below the safety lag.
  positionId  BigInt?   @map("position_id") @db.UnsignedBigInt
  /// Log tailers: file identity (device + inode) and byte offset.
  fileId      String?   @map("file_id") @db.VarChar(128)
  fileOffset  BigInt?   @map("file_offset") @db.UnsignedBigInt
  lastEventAt DateTime? @map("last_event_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("stream_cursors")
}

/// Platform catalog of settings.
model SystemSetting {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  key             String   @unique @db.VarChar(128)
  value           Json
  description     String?  @db.VarChar(512)
  updatedByUserId BigInt?  @map("updated_by_user_id") @db.UnsignedBigInt
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  updatedBy User? @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("system_settings")
}

/// Progress markers for maintenance jobs, written only by the partition-maintenance job
/// (migrator account). `message_identities.purged_below`: every registry id below this value has
/// been checked by the retention purge (D3.4); rows still below it are retained on purpose
/// because an email_archives or quarantine_messages row references them.
model MaintenanceWatermark {
  name      String   @id @db.VarChar(64)
  value     BigInt   @db.UnsignedBigInt
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("maintenance_watermarks")
}

// ---------------------------------------------------------------------------------------------
// Step 8.2: provider integrations (docs/plan/steps/25-m365-google-connectors.md §3)
// Microsoft 365 / Google Workspace connections, grants per permission profile, consent states,
// linked domains, validation runs, probe evidence, health, relay counters and the platform's
// provider egress ranges (ADR-0076 .. ADR-0081). No table is partitioned; no message content.
// ---------------------------------------------------------------------------------------------

enum IntegrationProvider {
  microsoft_365
  google_workspace
}

enum ProviderConnectionStatus {
  draft
  connecting
  configuring
  active
  disabled
}

enum ProviderOutboundMode {
  off
  probe_only
  active
  suspended
}

enum ProviderHealthStatus {
  unknown
  healthy
  warning
  critical
}

enum ProviderAuthMethod {
  platform_app
  customer_app_secret
  platform_service_account
  customer_service_account
}

enum ProviderGrantStatus {
  pending_consent
  verifying
  active
  error
  revoked
}

enum ProviderDomainVerification {
  unknown
  verified
  unverified
  absent
  alias
}

enum ProviderValidationKind {
  full
  credentials
  inbound
  outbound
}

enum ProviderValidationStatus {
  queued
  running
  awaiting_probe
  passed
  warning
  failed
  expired
  cancelled
}

enum ProviderCheckStatus {
  pass
  warn
  fail
  skipped
  error
}

enum ProviderCheckSeverity {
  info
  warning
  critical
}

enum ProviderTenantHeaderResult {
  match
  mismatch
  absent
  not_applicable
}

enum ProviderDkimResult {
  aligned_pass
  unaligned_pass
  fail
  none
  temperror
  replayed
  stale
}

enum ProviderProofResult {
  pass
  fail
  temperror
}

enum ProviderEgressSetStatus {
  active
  superseded
}

enum ProviderActorType {
  user
  system
  api_key
}

/// One organization's link to one Microsoft 365 tenant or Google Workspace customer (step 8.2
/// D1, D4, ADR-0076). `active_tenant_key` = `<provider>:<external_tenant_id>` while the status is
/// not `disabled`, set by the integration-worker at verification in the transaction that checks
/// it: a provider tenant binds to at most one non-disabled connection platform-wide (I10).
/// `relay_proof` = `provider-relay-proof/1` (NULL = provider default); `attestations` =
/// `provider-attestations/1` (≤ 32 `{ code, userId (public), at }`). CAS on `row_version`.
/// `disabled_by_user_id` has no FK (the trail survives the user).
model ProviderConnection {
  id                       BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  publicId                 String                   @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  organizationId           BigInt                   @map("organization_id") @db.UnsignedBigInt
  provider                 IntegrationProvider
  displayName              String                   @map("display_name") @db.VarChar(128)
  status                   ProviderConnectionStatus @default(draft)
  /// Microsoft tenant id (GUID) or Google customer id, verified by the worker (never trusted
  /// from a consent redirect).
  externalTenantId         String?                  @map("external_tenant_id") @db.VarChar(64)
  externalTenantName       String?                  @map("external_tenant_name") @db.VarChar(256)
  tenantVerifiedAt         DateTime?                @map("tenant_verified_at") @db.DateTime(3)
  activeTenantKey          String?                  @unique @map("active_tenant_key") @db.VarChar(100)
  outboundMode             ProviderOutboundMode     @default(off) @map("outbound_mode")
  internalRouting          Boolean                  @default(false) @map("internal_routing")
  relayProof               Json?                    @map("relay_proof")
  /// Microsoft 365 internal-routing route token version (D9, ADR-0081); the pending version
  /// becomes current after the administrator attests the updated transport rules.
  routeTokenVersion        Int                      @default(1) @map("route_token_version") @db.UnsignedSmallInt
  routeTokenPendingVersion Int?                     @map("route_token_pending_version") @db.UnsignedSmallInt
  attestations             Json?
  healthStatus             ProviderHealthStatus     @default(unknown) @map("health_status")
  healthCheckedAt          DateTime?                @map("health_checked_at") @db.DateTime(3)
  healthChangedAt          DateTime?                @map("health_changed_at") @db.DateTime(3)
  nextHealthCheckAt        DateTime?                @map("next_health_check_at") @db.DateTime(3)
  /// Lease of the integration-worker's health role.
  healthClaimedUntil       DateTime?                @map("health_claimed_until") @db.DateTime(3)
  /// Written by the smtp-adapter's relay counter flush.
  lastRelayAcceptedAt      DateTime?                @map("last_relay_accepted_at") @db.DateTime(3)
  createdByUserId          BigInt?                  @map("created_by_user_id") @db.UnsignedBigInt
  disabledAt               DateTime?                @map("disabled_at") @db.DateTime(3)
  disabledByUserId         BigInt?                  @map("disabled_by_user_id") @db.UnsignedBigInt
  rowVersion               Int                      @default(1) @map("row_version") @db.UnsignedInt
  createdAt                DateTime                 @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                DateTime                 @updatedAt @map("updated_at") @db.DateTime(3)

  organization         Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdByUser        User?                      @relation("ProviderConnectionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  grants               ProviderConnectionGrant[]
  consentStates        ProviderConsentState[]
  domains              ProviderConnectionDomain[]
  validationRuns       ProviderValidationRun[]
  probeObservations    ProviderProbeObservation[]
  healthChecks         ProviderHealthCheck[]
  healthEvents         ProviderHealthEvent[]
  relayCounters        ProviderRelayCounter[]
  smtpConnector        SmtpConnector?
  /// Step 8.6: journal intake sources bound to this connection (provider kinds).
  journalIntakeSources JournalIntakeSource[]
  /// Step API-1: the connection's API-mode row (created lazily).
  apiModeConnection    ApiModeConnection?

  @@unique([organizationId, displayName])
  @@index([organizationId, status])
  @@index([status, nextHealthCheckAt])
  @@map("provider_connections")
}

/// One grant per permission profile of a connection (step 8.2 D1, D2, D5; ADR-0076, ADR-0077).
/// `credential_ciphertext` = AES-256-GCM `v1.<kid>.<iv>.<tag>.<ct>` under
/// PROVIDER_CREDENTIAL_ENCRYPTION_KEY with row-bound AAD; the api encrypts, only the
/// integration-worker decrypts; never returned, logged or published (I5). `client_id` and
/// `subject_email` are non-secret. Permission lists are JSON arrays of permission names.
/// `consented_by_user_id` has no FK.
model ProviderConnectionGrant {
  id                    BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  publicId              String              @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  organizationId        BigInt              @map("organization_id") @db.UnsignedBigInt
  connectionId          BigInt              @map("connection_id") @db.UnsignedBigInt
  /// Permission profile key (`m365.mail_flow`, `google.mail_flow`; step 8.5 adds its own).
  profile               String              @db.VarChar(48)
  profileVersion        Int                 @map("profile_version") @db.UnsignedSmallInt
  authMethod            ProviderAuthMethod  @map("auth_method")
  status                ProviderGrantStatus @default(pending_consent)
  clientId              String?             @map("client_id") @db.VarChar(128)
  /// Google delegated administrator (domain-wide delegation subject).
  subjectEmail          String?             @map("subject_email") @db.VarChar(320)
  credentialCiphertext  String?             @map("credential_ciphertext") @db.Text
  credentialKeyId       String?             @map("credential_key_id") @db.VarChar(8)
  credentialVersion     Int                 @default(0) @map("credential_version") @db.UnsignedInt
  /// Lower-case hex SHA-256 fingerprint of the credential (the only visible trace of it).
  credentialFingerprint String?             @map("credential_fingerprint") @db.Char(64)
  credentialSetAt       DateTime?           @map("credential_set_at") @db.DateTime(3)
  credentialExpiresAt   DateTime?           @map("credential_expires_at") @db.DateTime(3)
  requestedPermissions  Json                @map("requested_permissions")
  observedPermissions   Json?               @map("observed_permissions")
  missingPermissions    Json?               @map("missing_permissions")
  excessPermissions     Json?               @map("excess_permissions")
  /// Tenant named by the consent redirect; verified by the worker before it is trusted (D3).
  claimedTenantId       String?             @map("claimed_tenant_id") @db.VarChar(64)
  consentedAt           DateTime?           @map("consented_at") @db.DateTime(3)
  consentedByUserId     BigInt?             @map("consented_by_user_id") @db.UnsignedBigInt
  verifyRequestedAt     DateTime?           @map("verify_requested_at") @db.DateTime(3)
  verifiedAt            DateTime?           @map("verified_at") @db.DateTime(3)
  verifyClaimedUntil    DateTime?           @map("verify_claimed_until") @db.DateTime(3)
  lastTokenAt           DateTime?           @map("last_token_at") @db.DateTime(3)
  lastErrorCode         String?             @map("last_error_code") @db.VarChar(64)
  consecutiveFailures   Int                 @default(0) @map("consecutive_failures") @db.UnsignedSmallInt
  rowVersion            Int                 @default(1) @map("row_version") @db.UnsignedInt
  createdAt             DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.DateTime(3)

  connection    ProviderConnection     @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  consentStates ProviderConsentState[]

  @@unique([connectionId, profile])
  @@index([status, verifyRequestedAt])
  @@index([organizationId, connectionId])
  @@index([credentialKeyId])
  @@map("provider_connection_grants")
}

/// Single-use admin-consent state (step 8.2 D3, D17): only the SHA-256 of the state is stored,
/// bound to organization, user and grant, 10-minute TTL; deleted 24 h after expiry.
model ProviderConsentState {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId BigInt    @map("organization_id") @db.UnsignedBigInt
  connectionId   BigInt    @map("connection_id") @db.UnsignedBigInt
  grantId        BigInt    @map("grant_id") @db.UnsignedBigInt
  userId         BigInt    @map("user_id") @db.UnsignedBigInt
  stateSha256    String    @unique @map("state_sha256") @db.Char(64)
  expiresAt      DateTime  @map("expires_at") @db.DateTime(3)
  usedAt         DateTime? @map("used_at") @db.DateTime(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  connection ProviderConnection      @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  grant      ProviderConnectionGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("provider_consent_states")
}

/// A TXT-verified gateway domain linked to a connection (step 8.2 D4): a domain belongs to at
/// most one connection. `provider_verification` is evidence from the provider tenant, never a
/// substitute for the gateway's TXT verification (I6). `inbound_applied_by_user_id` has no FK.
model ProviderConnectionDomain {
  id                     BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId         BigInt                     @map("organization_id") @db.UnsignedBigInt
  connectionId           BigInt                     @map("connection_id") @db.UnsignedBigInt
  domainId               BigInt                     @unique @map("domain_id") @db.UnsignedBigInt
  providerVerification   ProviderDomainVerification @default(unknown) @map("provider_verification")
  providerCheckedAt      DateTime?                  @map("provider_checked_at") @db.DateTime(3)
  /// Microsoft 365: the tenant's MX target host as the provider reports it.
  providerMxHost         String?                    @map("provider_mx_host") @db.VarChar(253)
  inboundAppliedAt       DateTime?                  @map("inbound_applied_at") @db.DateTime(3)
  inboundAppliedByUserId BigInt?                    @map("inbound_applied_by_user_id") @db.UnsignedBigInt
  createdAt              DateTime                   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt              DateTime                   @updatedAt @map("updated_at") @db.DateTime(3)

  connection ProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  domain     Domain             @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@map("provider_connection_domains")
}

/// Validation run of a connection (step 8.2 D10, ADR-0079). `results` = `provider-validation/1`
/// (≤ 64 entries, ≤ 64 KiB); `summary` = `{ pass, warn, fail, skipped, error }`. The outbound
/// probe address is single-use: only its SHA-256 is stored. `requested_by_id` is a public id.
/// Kept 180 days and at most the newest 50 per connection.
model ProviderValidationRun {
  id               BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  publicId         String                   @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  organizationId   BigInt                   @map("organization_id") @db.UnsignedBigInt
  connectionId     BigInt                   @map("connection_id") @db.UnsignedBigInt
  kind             ProviderValidationKind
  status           ProviderValidationStatus @default(queued)
  requestedByType  ProviderActorType        @map("requested_by_type")
  requestedById    String?                  @map("requested_by_id") @db.VarChar(64)
  probeTokenSha256 String?                  @unique @map("probe_token_sha256") @db.Char(64)
  probeExpiresAt   DateTime?                @map("probe_expires_at") @db.DateTime(3)
  results          Json?
  summary          Json?
  claimedUntil     DateTime?                @map("claimed_until") @db.DateTime(3)
  attempts         Int                      @default(0) @db.UnsignedSmallInt
  startedAt        DateTime?                @map("started_at") @db.DateTime(3)
  completedAt      DateTime?                @map("completed_at") @db.DateTime(3)
  createdAt        DateTime                 @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.DateTime(3)

  connection        ProviderConnection         @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  probeObservations ProviderProbeObservation[]

  @@index([connectionId, createdAt])
  @@index([status, createdAt])
  @@map("provider_validation_runs")
}

/// Bounded, non-content evidence of one intercepted probe message (step 8.2 D10, I8), written by
/// the smtp-adapter's LMTP ingestion; the message itself is never stored. `dkim_domains` = JSON
/// array of ≤ 5 `d=` values. Idempotent per (token, Postfix queue id). Kept 30 days.
model ProviderProbeObservation {
  id                 BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId     BigInt                     @map("organization_id") @db.UnsignedBigInt
  connectionId       BigInt                     @map("connection_id") @db.UnsignedBigInt
  validationRunId    BigInt?                    @map("validation_run_id") @db.UnsignedBigInt
  tokenSha256        String                     @map("token_sha256") @db.Char(64)
  queueId            String                     @map("queue_id") @db.VarChar(32)
  provider           IntegrationProvider
  clientIp           String                     @map("client_ip") @db.VarChar(45)
  tlsProtocol        String?                    @map("tls_protocol") @db.VarChar(16)
  tlsCipher          String?                    @map("tls_cipher") @db.VarChar(64)
  envelopeFromDomain String                     @map("envelope_from_domain") @db.VarChar(253)
  headerFromDomain   String?                    @map("header_from_domain") @db.VarChar(253)
  tenantHeader       ProviderTenantHeaderResult @map("tenant_header")
  dkim               ProviderDkimResult
  dkimDomains        Json                       @map("dkim_domains")
  dkimAgeSeconds     Int?                       @map("dkim_age_seconds")
  proofResult        ProviderProofResult        @map("proof_result")
  failureCode        String?                    @map("failure_code") @db.VarChar(64)
  receivedAt         DateTime                   @map("received_at") @db.DateTime(3)
  createdAt          DateTime                   @default(now()) @map("created_at") @db.DateTime(3)

  connection    ProviderConnection     @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  validationRun ProviderValidationRun? @relation(fields: [validationRunId], references: [id], onDelete: SetNull)

  @@unique([tokenSha256, queueId])
  @@index([connectionId, receivedAt])
  @@map("provider_probe_observations")
}

/// Latest result per health check and subject of a connection (step 8.2 D11, ADR-0079).
/// `subject` = a domain name, a profile key or '' (connection-wide); `evidence` ≤ 2 KiB.
model ProviderHealthCheck {
  id             BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId BigInt                @map("organization_id") @db.UnsignedBigInt
  connectionId   BigInt                @map("connection_id") @db.UnsignedBigInt
  checkCode      String                @map("check_code") @db.VarChar(64)
  subject        String                @default("") @db.VarChar(253)
  status         ProviderCheckStatus
  severity       ProviderCheckSeverity
  evidence       Json?
  firstFailedAt  DateTime?             @map("first_failed_at") @db.DateTime(3)
  checkedAt      DateTime              @map("checked_at") @db.DateTime(3)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.DateTime(3)

  connection ProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, checkCode, subject])
  @@map("provider_health_checks")
}

/// Append-only health transitions of a connection (step 8.2 D11, D12): each row is audited and
/// published as `integration.connection.health_changed.v1`. `failing_checks` = JSON array of ≤ 10
/// check codes. Kept 365 days.
model ProviderHealthEvent {
  id             BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId BigInt               @map("organization_id") @db.UnsignedBigInt
  connectionId   BigInt               @map("connection_id") @db.UnsignedBigInt
  fromStatus     ProviderHealthStatus @map("from_status")
  toStatus       ProviderHealthStatus @map("to_status")
  failingChecks  Json                 @map("failing_checks")
  createdAt      DateTime             @default(now()) @map("created_at") @db.DateTime(3)

  connection ProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, createdAt])
  @@index([createdAt])
  @@map("provider_health_events")
}

/// Hourly provider-relay counters per connection (step 8.2 D7, D18), upserted by the
/// smtp-adapter's counter flush (additive). Kept 35 days.
model ProviderRelayCounter {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId BigInt   @map("organization_id") @db.UnsignedBigInt
  connectionId   BigInt   @map("connection_id") @db.UnsignedBigInt
  /// UTC hour (minutes, seconds and milliseconds zero).
  hourStart      DateTime @map("hour_start") @db.DateTime(3)
  accepted       Int      @default(0) @db.UnsignedInt
  proofFailed    Int      @default(0) @map("proof_failed") @db.UnsignedInt
  tempFailed     Int      @default(0) @map("temp_failed") @db.UnsignedInt
  probes         Int      @default(0) @db.UnsignedInt
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  connection ProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, hourStart])
  @@index([hourStart])
  @@map("provider_relay_counters")
}

/// Platform: a versioned import of a provider's published egress ranges (step 8.2 D7, ADR-0078).
/// One `active` set per provider; `published_at` = the provider's publication date of the data;
/// `sha256` of the canonical sorted CIDR list. Seeded with a snapshot (`imported_by = 'seed'`)
/// only when the provider has no set; operators import current data with the CLI. Superseded
/// sets: the newest 5 per provider are kept.
model ProviderEgressRangeSet {
  id          BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  provider    IntegrationProvider
  version     Int                     @db.UnsignedInt
  status      ProviderEgressSetStatus
  source      String                  @db.VarChar(512)
  publishedAt DateTime?               @map("published_at") @db.DateTime(3)
  sha256      String                  @db.Char(64)
  rangeCount  Int                     @map("range_count") @db.UnsignedInt
  importedBy  String                  @map("imported_by") @db.VarChar(64)
  importedAt  DateTime                @default(now()) @map("imported_at") @db.DateTime(3)

  ranges ProviderEgressRange[]

  @@unique([provider, version])
  @@index([provider, status])
  @@map("provider_egress_range_sets")
}

/// Platform: one CIDR of an egress range set, with the same range encoding as
/// smtp_connector_networks (4 or 16 bytes big-endian) for range lookups.
model ProviderEgressRange {
  id         BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  setId      BigInt              @map("set_id") @db.UnsignedBigInt
  provider   IntegrationProvider
  /// Canonical CIDR text (network address, prefix).
  cidr       String              @db.VarChar(49)
  /// 4 or 6.
  ipVersion  Int                 @map("ip_version") @db.UnsignedTinyInt
  rangeStart Bytes               @map("range_start") @db.VarBinary(16)
  rangeEnd   Bytes               @map("range_end") @db.VarBinary(16)

  set ProviderEgressRangeSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@unique([setId, cidr])
  @@index([provider, ipVersion, rangeStart])
  @@map("provider_egress_ranges")
}

// ---------------------------------------------------------------------------------------------
// Step 8.6: journal-only intake and cross-source archive dedupe
// (docs/plan/steps/27-journal-intake-and-archive-split.md §3, ADR-0087, ADR-0088). Two tables are
// partitioned (journal_intake_messages, archive_record_sources). No message content: envelopes
// hold addresses, proofs hold codes; EMLs live in S3; intake credentials are stored as SHA-256.
// ---------------------------------------------------------------------------------------------

enum JournalIntakeSourceKind {
  microsoft_365_journal
  google_workspace_copy
  exchange_onprem_journal
  smtp_bcc
}

enum JournalIntakeSourceStatus {
  pending_verification
  active
  paused
  disabled
}

enum JournalIntakeHealthStatus {
  unknown
  healthy
  silent
  failing
  paused
}

enum JournalIntakeFormat {
  journal_report
  copy
  journal_report_unparsed
}

/// A customer sender configuration of journal-only intake (step 8.6 D1, ADR-0087): one intake
/// address `journal-<token>@<JOURNAL_INTAKE_DOMAIN>` per source. Only hashes are stored:
/// `address_hash` = SHA-256 of the lower-case local part (the token is derived by the api from
/// JOURNAL_INTAKE_ADDRESS_SECRET, the public id and `address_version`), `header_token_hash` = SHA-256
/// of the Google `X-EG-Journal-Token` value; `previous_*` stay valid until `previous_valid_until`
/// after a rotation. The organization of an intake message is always the source's (I4).
/// `networks` = `intake-networks/1` (on-premises kinds), `client_cert_fingerprints` = ≤ 4 SHA-256
/// hex, `attestations` = `provider-attestations/1` with `journal.*` codes. `last_accepted_at`,
/// `last_refused_at` and `last_refusal_code` are written by the smtp-adapter counter flush;
/// `health_*` by the archive-worker intake health loop. CAS on `row_version`. `disabled` is
/// terminal. `created_by_user_id` / `disabled_by_user_id` have no FK (the trail survives the user).
model JournalIntakeSource {
  id                      BigInt                    @id @default(autoincrement()) @db.UnsignedBigInt
  publicId                String                    @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  organizationId          BigInt                    @map("organization_id") @db.UnsignedBigInt
  kind                    JournalIntakeSourceKind
  displayName             String                    @map("display_name") @db.VarChar(128)
  status                  JournalIntakeSourceStatus @default(pending_verification)
  /// Provider kinds only: the bound step 8.2 connection (same organization and provider).
  providerConnectionId    BigInt?                   @map("provider_connection_id") @db.UnsignedBigInt
  /// `intake-networks/1` `{ v: 1, cidrs: [1..32] }` (on-premises kinds); never a provider range.
  networks                Json?
  requireTls              Boolean                   @default(true) @map("require_tls")
  clientCertFingerprints  Json?                     @map("client_cert_fingerprints")
  /// Per-source size ceiling (bytes); NULL = plan and platform limits only.
  maxMessageBytes         Int?                      @map("max_message_bytes") @db.UnsignedInt
  /// Silence alert threshold; NULL = no silence alert.
  silenceAlertMinutes     Int?                      @default(240) @map("silence_alert_minutes") @db.UnsignedInt
  addressVersion          Int                       @default(1) @map("address_version") @db.UnsignedSmallInt
  /// Hex SHA-256 of the lower-case local part of the current intake address.
  addressHash             String                    @unique @map("address_hash") @db.Char(64)
  previousAddressHash     String?                   @unique @map("previous_address_hash") @db.Char(64)
  headerTokenHash         String?                   @map("header_token_hash") @db.Char(64)
  previousHeaderTokenHash String?                   @map("previous_header_token_hash") @db.Char(64)
  previousValidUntil      DateTime?                 @map("previous_valid_until") @db.DateTime(3)
  /// First accepted intake message (`pending_verification` → `active`).
  verifiedAt              DateTime?                 @map("verified_at") @db.DateTime(3)
  lastAcceptedAt          DateTime?                 @map("last_accepted_at") @db.DateTime(3)
  lastRefusedAt           DateTime?                 @map("last_refused_at") @db.DateTime(3)
  /// `refused_network`, `proof_tenant_header`, … (codes only).
  lastRefusalCode         String?                   @map("last_refusal_code") @db.VarChar(64)
  healthStatus            JournalIntakeHealthStatus @default(unknown) @map("health_status")
  healthChangedAt         DateTime?                 @map("health_changed_at") @db.DateTime(3)
  healthAlertedAt         DateTime?                 @map("health_alerted_at") @db.DateTime(3)
  attestations            Json?
  createdByUserId         BigInt?                   @map("created_by_user_id") @db.UnsignedBigInt
  disabledAt              DateTime?                 @map("disabled_at") @db.DateTime(3)
  disabledByUserId        BigInt?                   @map("disabled_by_user_id") @db.UnsignedBigInt
  rowVersion              Int                       @default(1) @map("row_version") @db.UnsignedInt
  createdAt               DateTime                  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt               DateTime                  @updatedAt @map("updated_at") @db.DateTime(3)

  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  providerConnection ProviderConnection?    @relation(fields: [providerConnectionId], references: [id], onDelete: Restrict)
  counters           JournalIntakeCounter[]

  @@unique([organizationId, displayName])
  @@index([organizationId, status])
  @@index([status, healthStatus])
  @@index([providerConnectionId])
  @@map("journal_intake_sources")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly (6 months, core, like email_messages; step
/// 8.6 D2.6, D3). What the registry cannot hold about a journal intake message: the journal
/// envelope with fields (`journal-envelope/1`, BCC included), the passing proof
/// (`journal-intake-proof/1`), the format, the outer report's SHA-256 and size and the
/// organization's scan choice at commit. Written once by the smtp-adapter journal LMTP in the
/// message's commit transaction; read by the email-worker and the archive-worker. Addresses and
/// codes only. No foreign keys.
model JournalIntakeMessage {
  /// email_messages.id (registry id).
  messageId       BigInt                  @map("message_id") @db.UnsignedBigInt
  receivedAt      DateTime                @map("received_at") @db.DateTime(3)
  organizationId  BigInt                  @map("organization_id") @db.UnsignedBigInt
  /// journal_intake_sources.id (no FK: partitioned).
  sourceId        BigInt                  @map("source_id") @db.UnsignedBigInt
  kind            JournalIntakeSourceKind
  format          JournalIntakeFormat
  /// `journal-envelope/1`.
  envelope        Json
  /// `journal-intake-proof/1` (only passing proofs are stored).
  proof           Json
  /// Hex SHA-256 of the received (outer) message: the report for report kinds, else the copy.
  reportSha256    String                  @map("report_sha256") @db.Char(64)
  reportSizeBytes Int                     @map("report_size_bytes") @db.UnsignedInt
  /// `archive-settings/1` `intake.scanEnabled` of the organization at commit.
  scanRequested   Boolean                 @default(false) @map("scan_requested")
  createdAt       DateTime                @default(now()) @map("created_at") @db.DateTime(3)

  @@id([messageId, receivedAt])
  @@index([organizationId, receivedAt])
  @@index([sourceId, receivedAt])
  @@map("journal_intake_messages")
}

/// Daily journal intake counters per source (step 8.6 D2.8), upserted additively by the
/// smtp-adapter's counter flush (`(source_id, day)`); pruned after 400 days by the archive-worker
/// lifecycle maintenance. Refusals before a source is matched are counted in metrics only.
model JournalIntakeCounter {
  id                 BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId     BigInt   @map("organization_id") @db.UnsignedBigInt
  sourceId           BigInt   @map("source_id") @db.UnsignedBigInt
  /// UTC day.
  day                DateTime @db.Date
  accepted           Int      @default(0) @db.UnsignedInt
  duplicates         Int      @default(0) @db.UnsignedInt
  refusedAddress     Int      @default(0) @map("refused_address") @db.UnsignedInt
  refusedNetwork     Int      @default(0) @map("refused_network") @db.UnsignedInt
  refusedTls         Int      @default(0) @map("refused_tls") @db.UnsignedInt
  refusedSize        Int      @default(0) @map("refused_size") @db.UnsignedInt
  refusedRate        Int      @default(0) @map("refused_rate") @db.UnsignedInt
  refusedUnavailable Int      @default(0) @map("refused_unavailable") @db.UnsignedInt
  droppedProof       Int      @default(0) @map("dropped_proof") @db.UnsignedInt
  unwrapFailed       Int      @default(0) @map("unwrap_failed") @db.UnsignedInt
  bytes              BigInt   @default(0) @db.UnsignedBigInt
  updatedAt          DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  source JournalIntakeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, day])
  @@index([organizationId, day])
  @@map("journal_intake_counters")
}

/// Cross-source dedupe keys (step 8.6 D7, ADR-0088; transient): one row per archive record with a
/// Message-ID and per stored content variant. `message_id_hash` = SHA-256 of `archive-dedupe/1`
/// over the organization and the Message-ID, `header_fingerprint` = `archive-fingerprint/1`,
/// `body_sha256` = SHA-256 of the bytes after the header/body separator. Lookups and the capture's
/// gap lock use `(organization_id, message_id_hash, header_fingerprint)`. Rows older than
/// ARCHIVE_DEDUPE_WINDOW_HOURS are pruned by the archive-worker lifecycle role; disposal deletes
/// the record's rows. No foreign keys (the record is partitioned).
model ArchiveDedupeKey {
  id                BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId    BigInt   @map("organization_id") @db.UnsignedBigInt
  messageIdHash     String   @map("message_id_hash") @db.Char(64)
  headerFingerprint String   @map("header_fingerprint") @db.Char(64)
  bodySha256        String   @map("body_sha256") @db.Char(64)
  /// email_archives.id / received_at of the record.
  archiveId         BigInt   @map("archive_id") @db.UnsignedBigInt
  archiveReceivedAt DateTime @map("archive_received_at") @db.DateTime(3)
  hasGateway        Boolean  @default(false) @map("has_gateway")
  hasIntake         Boolean  @default(false) @map("has_intake")
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([organizationId, messageIdHash, headerFingerprint])
  @@index([archiveId, archiveReceivedAt])
  @@index([createdAt])
  @@map("archive_dedupe_keys")
}

/// PARTITIONED by RANGE COLUMNS(archive_received_at), monthly, never auto-dropped (compliance, like
/// email_archives; step 8.6 D7, ADR-0088). One row per message merged into another message's
/// archive record: its source, sizes and hashes, whether its body was stored as a content variant
/// and how many recipients it added. Inserted in the merge transaction by the archive-worker;
/// deleted only by the record's disposal. Keeps the merged message's `message_identities` row
/// alive (registry purge). No foreign keys.
model ArchiveRecordSource {
  id                BigInt              @default(autoincrement()) @db.UnsignedBigInt
  /// email_archives.received_at of the record (partition key).
  archiveReceivedAt DateTime            @map("archive_received_at") @db.DateTime(3)
  organizationId    BigInt              @map("organization_id") @db.UnsignedBigInt
  /// email_archives.id of the record.
  archiveId         BigInt              @map("archive_id") @db.UnsignedBigInt
  /// The merged message (registry id, its received_at and public id).
  messageId         BigInt              @map("message_id") @db.UnsignedBigInt
  messageReceivedAt DateTime            @map("message_received_at") @db.DateTime(3)
  messagePublicId   String              @map("message_public_id") @db.Char(36)
  source            MessageIngestSource
  /// journal_intake_sources.id for an intake copy.
  intakeSourceId    BigInt?             @map("intake_source_id") @db.UnsignedBigInt
  emlSha256         String              @map("eml_sha256") @db.Char(64)
  sizeBytes         Int                 @map("size_bytes") @db.UnsignedInt
  bodySha256        String              @map("body_sha256") @db.Char(64)
  /// The merged copy's EML was stored as a content variant of the record.
  contentVariant    Boolean             @default(false) @map("content_variant")
  recipientsAdded   Int                 @default(0) @map("recipients_added") @db.UnsignedSmallInt
  mergedAt          DateTime            @map("merged_at") @db.DateTime(3)

  @@id([id, archiveReceivedAt])
  @@unique([messageId, messageReceivedAt, archiveReceivedAt])
  @@index([organizationId, archiveId, archiveReceivedAt])
  @@map("archive_record_sources")
}

// ---------------------------------------------------------------------------------------------
// Step AI-1: AI assistant (chat-based management)
// (docs/plan/steps/28-ai-chat-management.md §3, D7, D12, D13; ADR-0091, ADR-0094). Six tables,
// none partitioned (low volume; revisited in AI-6). Metadata and user/assistant text only: no
// email body or attachment is ever stored (I5). Content columns (`title`, `content`,
// `provider_transcript`, `result_card`, `result_refs`, `next_cursor`) are purged at
// `purge_after` and on conversation delete; rows and execution metadata are hard-deleted after
// ASSISTANT_EXECUTION_RETENTION_DAYS. Written and read by the api's assistant module only.
// ---------------------------------------------------------------------------------------------

/// Status of an assistant conversation (step AI-1 §3); append-only like every enum.
enum AiChatConversationStatus {
  active
  archived
  deleted
}

/// Status of an assistant turn (step AI-1 §3, D7); `running` beyond its deadline is swept to
/// `failed` (`assistant_turn_abandoned`).
enum AiChatTurnStatus {
  running
  completed
  failed
  cancelled
}

/// Author of a stored assistant message (step AI-1 §3).
enum AiChatMessageRole {
  user
  assistant
}

/// Access class of a tool (step AI-1 D3): every tool is one existing `/api/v1` operation.
enum AiChatToolAccess {
  read
  write
}

/// Risk class of a tool (step AI-1 D3, §4.4); `critical` tools are portal-only (never executed).
enum AiChatToolRisk {
  read
  read_audited
  low
  medium
  high
  critical
}

/// Executor decision of one tool call (step AI-1 D5): `allowed` or the first refusal.
enum AiChatToolDecision {
  allowed
  denied_permission
  denied_unknown_tool
  denied_disabled
  denied_not_applicable
  denied_schema
  denied_ref
  denied_budget
  /// Step AI-3 D3: an assistant proposal guard refused the call (separation of duties); no
  /// loopback request was sent.
  denied_guard
}

/// Outcome of one tool execution (step AI-1 D5): `refused` = a `denied_*` decision (no loopback).
/// `pending_confirmation` (step AI-2 D1, D7): the proposal of a write tool; nothing was sent to the
/// write route, an `ai_chat_action_confirmations` row waits for the user, and the confirmed write
/// is a separate execution row (`parent_execution_id` = the proposal, `turn_id` NULL).
enum AiChatToolStatus {
  succeeded
  failed
  refused
  timeout
  pending_confirmation
}

/// HTTP method of the operation a tool executes (step AI-1 D2).
enum AiChatHttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
}

/// What the assistant may send to the LLM provider (step AI-1 D13, ADR-0092): `metadata` (AI-1)
/// sends tool results as minimized metadata envelopes; `pseudonymized` (step AI-6 D3, ADR-0097,
/// I25; appended) additionally replaces e-mail addresses, IP addresses, domains and person names
/// by stable per-conversation tokens (`ai_chat_pseudonyms`) before anything reaches the provider.
enum AiChatDataSharing {
  metadata
  pseudonymized
}

/// Which credential paid for an assistant turn (step AI-6 D6, D7; ADR-0097): the platform's
/// configured provider key, or the organization's own key (`ai_chat_provider_keys`). The platform
/// daily token cap counts only `platform` turns (A6-7).
enum AiChatKeySource {
  platform
  tenant
}

/// The organization's assistant setting `assistant-settings/1` (step AI-1 D13, §3; ADR-0094):
/// one row per organization, created on first `PUT /assistant/settings` (no row = disabled with
/// the platform defaults). Enabling requires `external_processing_ack_at` (the external-processing
/// acknowledgement, with the acknowledging user) and the `ai_assistant` feature. `daily_token_budget`
/// NULL = ASSISTANT_TENANT_DAILY_TOKENS_DEFAULT (never above ASSISTANT_TENANT_DAILY_TOKENS_MAX);
/// `retention_days` 1–365 is the content retention after the last turn. CAS on `row_version`.
/// `external_processing_ack_by_user_id` / `updated_by_user_id` have no FK (the trail survives the
/// user). Step AI-6 (D1, D3, D7): `data_sharing` may be `pseudonymized`; `user_daily_token_budget`
/// (NULL = none; 1 … the tenant's effective daily budget) is enforced per user and UTC day;
/// `use_tenant_key` routes turns through the organization's `ai_chat_provider_keys` row and
/// `tenant_key_fallback_to_platform` lets them fall back to the platform providers (A6-6).
model AiChatSettings {
  organizationId                BigInt            @id @map("organization_id") @db.UnsignedBigInt
  enabled                       Boolean           @default(false)
  externalProcessingAckAt       DateTime?         @map("external_processing_ack_at") @db.DateTime(3)
  externalProcessingAckByUserId BigInt?           @map("external_processing_ack_by_user_id") @db.UnsignedBigInt
  dailyTokenBudget              Int?              @map("daily_token_budget") @db.UnsignedInt
  retentionDays                 Int               @default(30) @map("retention_days") @db.UnsignedSmallInt
  dataSharing                   AiChatDataSharing @default(metadata) @map("data_sharing")
  /// Step AI-6 D1: per-user daily token budget (NULL = none).
  userDailyTokenBudget          Int?              @map("user_daily_token_budget") @db.UnsignedInt
  /// Step AI-6 D7: use the organization's own provider key (`ai_chat_provider_keys`).
  useTenantKey                  Boolean           @default(false) @map("use_tenant_key")
  /// Step AI-6 D6: with a tenant key, fall back to the platform providers when it fails.
  tenantKeyFallbackToPlatform   Boolean           @default(false) @map("tenant_key_fallback_to_platform")
  updatedByUserId               BigInt?           @map("updated_by_user_id") @db.UnsignedBigInt
  rowVersion                    Int               @default(1) @map("row_version") @db.UnsignedInt
  createdAt                     DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                     DateTime          @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("ai_chat_settings")
}

/// A user's private assistant conversation (step AI-1 §3, D7, D12; ADR-0094). Only its owner
/// reads it (PO Q9); under a platform override it is stored in the override's target
/// organization with `platform_override_id` (PO Q11). `title` (≤ 200 characters, user or
/// derived) is content and purged; `segment` is the current context segment (D7 recap);
/// `purge_after` = `last_turn_at` + the tenant's `retention_days`. DELETE sets `deleted` and
/// purges the content immediately (`content_purged_at`). The list index serves
/// `(organization_id, user_id, status) ORDER BY last_turn_at DESC, id DESC`.
model AiChatConversation {
  id                 BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  publicId           String                   @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  organizationId     BigInt                   @map("organization_id") @db.UnsignedBigInt
  userId             BigInt                   @map("user_id") @db.UnsignedBigInt
  /// Public id of the platform override the conversation was started under (no FK).
  platformOverrideId String?                  @map("platform_override_id") @db.Char(36)
  title              String?                  @db.VarChar(200)
  status             AiChatConversationStatus @default(active)
  turnCount          Int                      @default(0) @map("turn_count") @db.UnsignedInt
  segment            Int                      @default(1) @db.UnsignedSmallInt
  lastTurnAt         DateTime?                @map("last_turn_at") @db.DateTime(3)
  purgeAfter         DateTime?                @map("purge_after") @db.DateTime(3)
  contentPurgedAt    DateTime?                @map("content_purged_at") @db.DateTime(3)
  /// Compare-and-set counter (`PATCH`).
  rowVersion         Int                      @default(1) @map("row_version") @db.UnsignedInt
  createdAt          DateTime                 @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.DateTime(3)

  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User                       @relation("AiChatConversationUser", fields: [userId], references: [id], onDelete: Cascade)
  turns          AiChatTurn[]
  messages       AiChatMessage[]
  toolExecutions AiChatToolExecution[]
  confirmations  AiChatActionConfirmation[]
  /// Reports generated in the conversation (step AI-R); purged with its content.
  reports        AiChatReport[]
  /// Step AI-6 D2: ratings of the conversation's assistant messages.
  feedback       AiChatFeedback[]
  /// Step AI-6 D3: pseudonym mappings (content; deleted at the content purge).
  pseudonyms     AiChatPseudonym[]
  /// Step AI-6 D5: asynchronous report jobs.
  reportJobs     AiChatReportJob[]

  @@index([organizationId, userId, status, lastTurnAt, id])
  /// Step AI-6 D4: metadata-only admin list `WHERE organization_id = ? ORDER BY last_turn_at DESC,
  /// id DESC`.
  @@index([organizationId, lastTurnAt, id])
  @@index([purgeAfter])
  @@index([userId])
  @@map("ai_chat_conversations")
}

/// One assistant turn (step AI-1 §3, D7): one user message → up to ASSISTANT_MAX_TOOL_ROUNDS
/// model calls → one assistant message. `seq` is per conversation; `client_turn_id` (UUID from
/// the browser) makes a retried POST idempotent. Metrics per turn: provider, configured `model`,
/// the provider-reported `response_model`, prompt and registry versions, rounds, tool calls,
/// token counts, advisory `cost_micros` (micro-USD; NULL = unpriced model), latency, coded error.
/// `provider_transcript` = JSON of the provider-native blocks of the turn (≤ 512 KiB, replayed
/// verbatim within a segment for preserved thinking; content, purged). `user_id` has no FK (the
/// conversation's owner; the conversation cascades). Step AI-6 (D3, D6, D7): `provider`/`model`
/// are the candidate actually used, `data_sharing` the level the turn applied, `key_source`
/// whose key paid, `fallback_from` the provider id of the skipped or failed primary (NULL when
/// the first candidate answered); the `(organization_id, user_id, started_at)` index serves the
/// per-user usage and audit views.
model AiChatTurn {
  id                 BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  publicId           String            @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  conversationId     BigInt            @map("conversation_id") @db.UnsignedBigInt
  organizationId     BigInt            @map("organization_id") @db.UnsignedBigInt
  userId             BigInt            @map("user_id") @db.UnsignedBigInt
  seq                Int               @db.UnsignedInt
  segment            Int               @default(1) @db.UnsignedSmallInt
  clientTurnId       String            @map("client_turn_id") @db.Char(36)
  status             AiChatTurnStatus  @default(running)
  provider           String            @db.VarChar(32)
  model              String            @db.VarChar(64)
  responseModel      String?           @map("response_model") @db.VarChar(128)
  promptVersion      String            @map("prompt_version") @db.VarChar(32)
  registryVersion    String            @map("registry_version") @db.VarChar(32)
  rounds             Int               @default(0) @db.UnsignedTinyInt
  toolCalls          Int               @default(0) @map("tool_calls") @db.UnsignedSmallInt
  inputTokens        Int               @default(0) @map("input_tokens") @db.UnsignedInt
  outputTokens       Int               @default(0) @map("output_tokens") @db.UnsignedInt
  cacheReadTokens    Int               @default(0) @map("cache_read_tokens") @db.UnsignedInt
  cacheWriteTokens   Int               @default(0) @map("cache_write_tokens") @db.UnsignedInt
  costMicros         BigInt?           @map("cost_micros") @db.UnsignedBigInt
  latencyMs          Int?              @map("latency_ms") @db.UnsignedInt
  errorCode          String?           @map("error_code") @db.VarChar(64)
  correlationId      String            @map("correlation_id") @db.VarChar(128)
  providerTranscript String?           @map("provider_transcript") @db.MediumText
  /// Step AI-6 D3: the data-sharing level applied to this turn.
  dataSharing        AiChatDataSharing @default(metadata) @map("data_sharing")
  /// Step AI-6 D6, D7: whose provider key paid for the turn.
  keySource          AiChatKeySource   @default(platform) @map("key_source")
  /// Step AI-6 D6: provider id of the skipped or failed primary candidate.
  fallbackFrom       String?           @map("fallback_from") @db.VarChar(32)
  startedAt          DateTime          @default(now()) @map("started_at") @db.DateTime(3)
  finishedAt         DateTime?         @map("finished_at") @db.DateTime(3)

  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  conversation   AiChatConversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messages       AiChatMessage[]
  toolExecutions AiChatToolExecution[]
  confirmations  AiChatActionConfirmation[]

  @@unique([conversationId, seq])
  @@unique([conversationId, clientTurnId])
  @@index([organizationId, startedAt])
  @@index([organizationId, userId, startedAt])
  @@index([status, startedAt])
  @@map("ai_chat_turns")
}

/// A stored assistant message (step AI-1 §3, D12): the user's text or the assistant's final text
/// (≤ 16 000 characters). `content` is purged with the conversation's content (NULL afterwards);
/// `seq` is per conversation. The `(organization_id, created_at)` index serves the organization
/// purge and the organization foreign key.
model AiChatMessage {
  id             BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  publicId       String            @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  conversationId BigInt            @map("conversation_id") @db.UnsignedBigInt
  turnId         BigInt            @map("turn_id") @db.UnsignedBigInt
  organizationId BigInt            @map("organization_id") @db.UnsignedBigInt
  seq            Int               @db.UnsignedInt
  role           AiChatMessageRole
  content        String?           @db.Text
  createdAt      DateTime          @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  conversation AiChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  turn         AiChatTurn         @relation(fields: [turnId], references: [id], onDelete: Cascade)
  /// Step AI-6 D2: the author's rating of an assistant message (at most one).
  feedback     AiChatFeedback?

  @@unique([conversationId, seq])
  @@index([organizationId, createdAt])
  @@index([turnId])
  @@map("ai_chat_messages")
}

/// One tool execution of the assistant (step AI-1 §3, D5, D8, D12; ADR-0094), allowed or denied:
/// every `call_tool` and every `POST /assistant/executions/{id}/more` writes one row and one
/// `audit_logs` row (`assistant.tool_executed` / `assistant.tool_denied`, correlated through
/// `correlation_id`). `seq` is conversation-wide (refs `r<seq>`); `turn_id` NULL for "more"
/// (`parent_execution_id` = the list execution it continues; no FK). `params_redacted` = the
/// validated, credential-scrubbed parameters (≤ 4 KiB); `result_card` = `assistant-card/1`
/// (≤ 64 KiB), `result_refs` = ref → `{ resourceType, publicId }`, `next_cursor` = the API's
/// opaque cursor: content, purged. `user_id` has no FK (the conversation cascades).
model AiChatToolExecution {
  id                BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  publicId          String             @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  organizationId    BigInt             @map("organization_id") @db.UnsignedBigInt
  userId            BigInt             @map("user_id") @db.UnsignedBigInt
  conversationId    BigInt             @map("conversation_id") @db.UnsignedBigInt
  turnId            BigInt?            @map("turn_id") @db.UnsignedBigInt
  parentExecutionId BigInt?            @map("parent_execution_id") @db.UnsignedBigInt
  seq               Int                @db.UnsignedInt
  toolName          String             @map("tool_name") @db.VarChar(96)
  operationId       String             @map("operation_id") @db.VarChar(128)
  httpMethod        AiChatHttpMethod   @map("http_method")
  access            AiChatToolAccess
  risk              AiChatToolRisk
  decision          AiChatToolDecision
  status            AiChatToolStatus
  httpStatus        Int?               @map("http_status") @db.UnsignedSmallInt
  errorCode         String?            @map("error_code") @db.VarChar(64)
  correlationId     String             @map("correlation_id") @db.VarChar(128)
  paramsRedacted    Json?              @map("params_redacted")
  resourceRef       String?            @map("resource_ref") @db.VarChar(64)
  resultCard        Json?              @map("result_card")
  resultRefs        Json?              @map("result_refs")
  nextCursor        String?            @map("next_cursor") @db.VarChar(2048)
  latencyMs         Int?               @map("latency_ms") @db.UnsignedInt
  createdAt         DateTime           @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  conversation AiChatConversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  turn         AiChatTurn?               @relation(fields: [turnId], references: [id], onDelete: Cascade)
  /// The confirmation of a `pending_confirmation` proposal (step AI-2); at most one.
  confirmation AiChatActionConfirmation?

  @@unique([conversationId, seq])
  @@index([organizationId, createdAt])
  /// Step AI-6 D4: audit search by user and by tool within a time window.
  @@index([organizationId, userId, createdAt])
  @@index([organizationId, toolName, createdAt])
  @@index([correlationId])
  @@index([turnId])
  @@map("ai_chat_tool_executions")
}

/// Assistant usage per organization, UTC day, provider and model (step AI-1 §3, D11): upserted at
/// the end of every turn; seeds the Redis token budget `as:tok:o:<orgId>:<yyyymmdd>` on a miss and
/// backs `GET /assistant/usage`. `cost_micros` is advisory (micro-USD; unpriced models add 0).
model AiChatUsageDaily {
  organizationId   BigInt   @map("organization_id") @db.UnsignedBigInt
  day              DateTime @db.Date
  provider         String   @db.VarChar(32)
  model            String   @db.VarChar(64)
  turns            Int      @default(0) @db.UnsignedInt
  inputTokens      BigInt   @default(0) @map("input_tokens") @db.UnsignedBigInt
  outputTokens     BigInt   @default(0) @map("output_tokens") @db.UnsignedBigInt
  cacheReadTokens  BigInt   @default(0) @map("cache_read_tokens") @db.UnsignedBigInt
  cacheWriteTokens BigInt   @default(0) @map("cache_write_tokens") @db.UnsignedBigInt
  costMicros       BigInt   @default(0) @map("cost_micros") @db.UnsignedBigInt
  updatedAt        DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@id([organizationId, day, provider, model])
  @@map("ai_chat_usage_daily")
}

// ---------------------------------------------------------------------------------------------
// Step AI-2: AI assistant action confirmations
// (docs/plan/steps/29-ai-chat-confirmations-mail-writes.md §3, D1-D3, D7; ADR-0093 amendment
// AI-2). One table, not partitioned. A write tool call of the model never executes inside a turn:
// it stores a confirmation that the user confirms (or cancels) in the portal's confirmation card.
// ---------------------------------------------------------------------------------------------

/// Risk class of a write that waits for confirmation (step AI-2 D1, D4): the registry risk of the
/// write tool (`critical` tools are portal-only and never proposed). `high` requires
/// re-authentication (`requires_reauth`).
enum AiChatConfirmationRisk {
  low
  medium
  high
}

/// Lifecycle of an assistant action confirmation (step AI-2 D2, D7): `pending` → `executing`
/// (atomic, on confirm) → `executed` (2xx, including `202` approval-pending answers) or `failed`;
/// `pending` → `cancelled` (user, conversation delete, five wrong tokens) or `expired` (past
/// `expires_at`). `executing` older than the tool timeout + 60 s is failed by the sweeper with
/// `assistant_confirmation_outcome_unknown` (never re-executed).
enum AiChatConfirmationStatus {
  pending
  executing
  executed
  failed
  expired
  cancelled
}

/// A proposed assistant write waiting for the user's confirmation (step AI-2 §3, D1-D3, D7;
/// ADR-0093 amended in AI-2). Created with its proposal execution (`execution_id`, status
/// `pending_confirmation`) in one transaction. The single-use confirmation token (32 random
/// bytes) is **never stored**: only its SHA-256 (`token_hash`, hex) is; the token goes to the
/// proposing browser tab only. `action_digest` = SHA-256 of the canonical `assistant-action/1`
/// digest input (identity, session family, conversation, execution, tool, risk, request,
/// preconditions, expiry); every member is stored here, so the digest is recomputable at confirm.
/// Content columns, purged (NULL) with the conversation's content (`purge_after`, conversation
/// delete): `request` = the stored loopback request `{ method, path, body }` (≤ 256 KiB; the path
/// includes the query string), `preconditions` = the target snapshot `{ stateDigest, rowVersion,
/// definitionSha256, items? }` (≤ 16 KiB), `summary` = the server-authored impact summary
/// `assistant-confirmation/1` (≤ 16 KiB). `public_id` (UUIDv7) is the `Idempotency-Key` of the
/// confirmed write; `result_execution_id` is the execution row of the confirmed write (no FK).
/// `reported_at` = when the outcome was given to the model (action updates of the next turn).
/// Scoped like conversations: organization of the scope (the override target under a platform
/// override, `platform_override_id`), owner `user_id` (no FK; the conversation cascades) and the
/// proposing `session_family_id` (refresh-token family). Rows are hard-deleted with their
/// execution (FK cascade); the organization purge deletes them before the executions.
model AiChatActionConfirmation {
  id                 BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  publicId           String                   @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  organizationId     BigInt                   @map("organization_id") @db.UnsignedBigInt
  userId             BigInt                   @map("user_id") @db.UnsignedBigInt
  /// Public id of the platform override the proposal was made under (no FK).
  platformOverrideId String?                  @map("platform_override_id") @db.Char(36)
  /// Refresh-token family of the proposing session (`UserPrincipal.sessionId`).
  sessionFamilyId    String                   @map("session_family_id") @db.Char(36)
  conversationId     BigInt                   @map("conversation_id") @db.UnsignedBigInt
  turnId             BigInt?                  @map("turn_id") @db.UnsignedBigInt
  /// The proposal execution (`pending_confirmation`).
  executionId        BigInt                   @unique @map("execution_id") @db.UnsignedBigInt
  /// The execution of the confirmed write (no FK).
  resultExecutionId  BigInt?                  @map("result_execution_id") @db.UnsignedBigInt
  toolName           String                   @map("tool_name") @db.VarChar(96)
  operationId        String                   @map("operation_id") @db.VarChar(128)
  httpMethod         AiChatHttpMethod         @map("http_method")
  risk               AiChatConfirmationRisk
  requiresReauth     Boolean                  @map("requires_reauth")
  /// Stored loopback request `{ method, path, body }` (content, purged).
  request            Json?
  /// Precondition snapshot (content, purged).
  preconditions      Json?
  /// Impact summary `assistant-confirmation/1` (content, purged).
  summary            Json?
  /// SHA-256 hex of the canonical state fields of the precondition read.
  stateDigest        String?                  @map("state_digest") @db.Char(64)
  /// SHA-256 hex of the canonical `assistant-action/1` digest input.
  actionDigest       String                   @map("action_digest") @db.Char(64)
  /// SHA-256 hex of the confirmation token (the token itself is never stored).
  tokenHash          String                   @map("token_hash") @db.Char(64)
  status             AiChatConfirmationStatus @default(pending)
  /// Wrong tokens so far; the fifth cancels the confirmation.
  failedAttempts     Int                      @default(0) @map("failed_attempts") @db.UnsignedTinyInt
  reauthUsed         Boolean                  @default(false) @map("reauth_used")
  expiresAt          DateTime                 @map("expires_at") @db.DateTime(3)
  decidedAt          DateTime?                @map("decided_at") @db.DateTime(3)
  /// Set by the confirm request right before it sends the write (`executing` claim): the
  /// outcome-unknown sweep measures the write from here, the precondition re-read from `decidedAt`.
  executionStartedAt DateTime?                @map("execution_started_at") @db.DateTime(3)
  executedAt         DateTime?                @map("executed_at") @db.DateTime(3)
  reportedAt         DateTime?                @map("reported_at") @db.DateTime(3)
  resultHttpStatus   Int?                     @map("result_http_status") @db.UnsignedSmallInt
  errorCode          String?                  @map("error_code") @db.VarChar(64)
  /// Correlation id of the proposal.
  correlationId      String                   @map("correlation_id") @db.VarChar(128)
  createdAt          DateTime                 @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  conversation AiChatConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  turn         AiChatTurn?         @relation(fields: [turnId], references: [id], onDelete: Cascade)
  execution    AiChatToolExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, status, expiresAt])
  @@index([conversationId, status, reportedAt])
  @@index([status, expiresAt])
  @@index([status, decidedAt])
  @@index([turnId])
  @@map("ai_chat_action_confirmations")
}

// ---------------------------------------------------------------------------------------------
// Step AI-R: AI assistant reports
// (docs/plan/steps/31-ai-chat-reports.md §3, D2, D5-D8; ADR-0095, ADR-0094 amendment AI-R). Two
// tables, not partitioned (low volume). The report HTML lives in object storage (mail bucket,
// `org/<organizationId>/assistant/report/...`); MySQL holds metadata only (I5): window,
// sections, figures, size, SHA-256, object key, statuses and delivery recipients. Rows and
// objects follow the conversation's content retention (D7).
// ---------------------------------------------------------------------------------------------

/// Lifecycle of an assistant report (step AI-R D2, D7): `pending` (row written before the
/// PutObject) → `available` (object stored, in the execution's persist transaction) or `failed`
/// (put failed, or a `pending` row older than 1 hour swept with `assistant_report_abandoned`);
/// `available|pending|failed` → `purged` with the conversation's content. Step AI-6 D5
/// (ADR-0096; appended): `queued` = an asynchronous report whose `ai_chat_report_jobs` row waits
/// for the `api-assistant` consumer → `available` or `failed` (or `purged`); the AI-R `pending`
/// sweep ignores it, the job's `expires_at` sweep fails it.
enum AiChatReportStatus {
  pending
  available
  failed
  purged
  queued
}

/// Bucket size of the report's time series (step AI-R D2 step 3): `hour` for windows ≤ 48 h,
/// else `day`.
enum AiChatReportGranularity {
  hour
  day
}

/// Recipient class of a report email (step AI-R D5, I17), evaluated by the server at proposal and
/// again at confirm: the principal's own address, an active verified user of the organization, or
/// an address in one of its verified/active domains. Refused recipients never get a row.
enum AiChatReportRecipientKind {
  self
  member
  domain
}

/// Status of a report email (step AI-R D5, D8): `queued` (confirm transaction, with the outbox
/// event) → `sent` (notification-worker, with the SMTP message id) or `failed` (worker reason,
/// content purge, or the 25-hour timeout sweep `assistant_report_email_timeout`).
enum AiChatReportDeliveryStatus {
  queued
  sent
  failed
}

/// One assistant security report (step AI-R §3, D2, D6, D7; ADR-0095): generated by the native
/// tool `report_generate` from loopback reads of existing report operations, rendered as inert
/// HTML and stored in object storage at `object_key` (`org/<organizationId>/assistant/report/
/// <yyyy>/<mm>/<dd>/<publicId>.html`, never returned to a client). `title` is server-authored;
/// `sections` = `{ included, omitted: [{ section, reason, code? }] }` (≤ 4 KiB), `figures` = the
/// card figures (≤ 2 KiB, used by the email text part). `execution_id` is the `report_generate`
/// execution (set when `available`; no FK). Scoped like conversations (organization of the
/// scope, owner `user_id` without FK, `platform_override_id`). On content purge the row becomes
/// `purged`; the retention job then deletes the object (`object_deleted_at`, `object_key` NULL).
model AiChatReport {
  id                 BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  publicId           String                  @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  organizationId     BigInt                  @map("organization_id") @db.UnsignedBigInt
  userId             BigInt                  @map("user_id") @db.UnsignedBigInt
  /// Public id of the platform override the report was generated under (no FK).
  platformOverrideId String?                 @map("platform_override_id") @db.Char(36)
  conversationId     BigInt                  @map("conversation_id") @db.UnsignedBigInt
  /// The `report_generate` execution (no FK); set when the report becomes `available`.
  executionId        BigInt?                 @unique @map("execution_id") @db.UnsignedBigInt
  status             AiChatReportStatus      @default(pending)
  title              String                  @db.VarChar(200)
  periodFrom         DateTime                @map("period_from") @db.DateTime(3)
  periodTo           DateTime                @map("period_to") @db.DateTime(3)
  granularity        AiChatReportGranularity
  /// `{ included: string[], omitted: { section, reason, code? }[] }` (≤ 4 KiB).
  sections           Json
  /// The card figures `{ label, value }[]` (≤ 2 KiB).
  figures            Json
  templateVersion    String                  @map("template_version") @db.VarChar(32)
  /// Object key in the mail bucket; NULL before the put and after the object is deleted.
  objectKey          String?                 @map("object_key") @db.VarChar(512)
  sizeBytes          Int?                    @map("size_bytes") @db.UnsignedInt
  /// SHA-256 hex of the stored HTML.
  sha256             String?                 @db.Char(64)
  errorCode          String?                 @map("error_code") @db.VarChar(64)
  purgedAt           DateTime?               @map("purged_at") @db.DateTime(3)
  objectDeletedAt    DateTime?               @map("object_deleted_at") @db.DateTime(3)
  createdAt          DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  conversation AiChatConversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  deliveries   AiChatReportDelivery[]
  /// Step AI-6 D5: the background job of a `queued` report (at most one).
  job          AiChatReportJob?

  @@index([organizationId, userId, createdAt])
  @@index([conversationId, status, createdAt])
  @@index([status, objectDeletedAt, id])
  @@index([status, createdAt])
  @@map("ai_chat_reports")
}

/// One confirmed report email (step AI-R §3, D5, D8; ADR-0095): written with the outbox event
/// `assistant.report.email_requested.v1` (eventId = `public_id`) in the confirm transaction; at
/// most one per confirmation (unique `confirmation_id`, no FK). `recipient_address` is the
/// normalized address (content, NULL after the conversation's content purge);
/// `recipient_sha256` = SHA-256 hex of it (kept for the audit trail). The daily limits
/// (ASSISTANT_REPORT_EMAILS_PER_USER_PER_DAY / _PER_TENANT_PER_DAY, UTC day) count rows by
/// `requested_at`. The notification-worker writes only `status`, `error_code`, `message_id`,
/// `sent_at`. `user_id` and `conversation_id` have no FK (the report cascades).
model AiChatReportDelivery {
  id               BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  publicId         String                     @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  organizationId   BigInt                     @map("organization_id") @db.UnsignedBigInt
  userId           BigInt                     @map("user_id") @db.UnsignedBigInt
  conversationId   BigInt                     @map("conversation_id") @db.UnsignedBigInt
  reportId         BigInt                     @map("report_id") @db.UnsignedBigInt
  /// The executed `report_send_email` confirmation (no FK).
  confirmationId   BigInt                     @unique @map("confirmation_id") @db.UnsignedBigInt
  /// Normalized recipient address (content, purged).
  recipientAddress String?                    @map("recipient_address") @db.VarChar(320)
  /// SHA-256 hex of the normalized recipient address.
  recipientSha256  String                     @map("recipient_sha256") @db.Char(64)
  recipientKind    AiChatReportRecipientKind  @map("recipient_kind")
  status           AiChatReportDeliveryStatus @default(queued)
  errorCode        String?                    @map("error_code") @db.VarChar(64)
  /// SMTP Message-ID of the sent mail.
  messageId        String?                    @map("message_id") @db.VarChar(255)
  sizeBytes        Int                        @map("size_bytes") @db.UnsignedInt
  correlationId    String                     @map("correlation_id") @db.VarChar(128)
  requestedAt      DateTime                   @default(now()) @map("requested_at") @db.DateTime(3)
  sentAt           DateTime?                  @map("sent_at") @db.DateTime(3)
  updatedAt        DateTime                   @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  report       AiChatReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([organizationId, requestedAt])
  @@index([organizationId, userId, requestedAt])
  @@index([reportId, requestedAt])
  @@index([status, requestedAt])
  @@map("ai_chat_report_deliveries")
}

// ---------------------------------------------------------------------------------------------
// Step AI-6: AI assistant hardening and operations
// (docs/plan/steps/34-ai-chat-hardening-operations.md §3, D1-D7; ADR-0096, ADR-0097, ADR-0094
// amendment AI-6). Five tables, not partitioned (low volume). Metadata and user/assistant text
// only (I5). Content columns (`ai_chat_feedback.comment`, `ai_chat_pseudonyms.value`) follow the
// conversation's content retention; tenant provider keys are stored encrypted only (I27).
// ---------------------------------------------------------------------------------------------

/// Assistant usage per organization, UTC day, user, provider, model and key source (step AI-6
/// D1): upserted in the turn's closing transaction next to `ai_chat_usage_daily` (same
/// semantics: every turn closed by the turn engine counts, the day is the UTC day of
/// `finished_at`); seeds the per-user Redis budget `as:tok:u:<userPublicId>:<yyyymmdd>` on a miss
/// and backs `GET /assistant/admin/usage/users`. `cost_micros` is an estimate (micro-USD) and
/// NULL while no priced turn was counted. `user_id` has no FK (the usage trail survives the
/// user). Backfilled from `ai_chat_turns` by the migration (`key_source = platform`). Rows are
/// kept like `ai_chat_usage_daily` (execution retention).
model AiChatUsageUserDaily {
  organizationId   BigInt          @map("organization_id") @db.UnsignedBigInt
  day              DateTime        @db.Date
  userId           BigInt          @map("user_id") @db.UnsignedBigInt
  provider         String          @db.VarChar(32)
  model            String          @db.VarChar(64)
  keySource        AiChatKeySource @map("key_source")
  turns            Int             @default(0) @db.UnsignedInt
  inputTokens      BigInt          @default(0) @map("input_tokens") @db.UnsignedBigInt
  outputTokens     BigInt          @default(0) @map("output_tokens") @db.UnsignedBigInt
  cacheReadTokens  BigInt          @default(0) @map("cache_read_tokens") @db.UnsignedBigInt
  cacheWriteTokens BigInt          @default(0) @map("cache_write_tokens") @db.UnsignedBigInt
  costMicros       BigInt?         @map("cost_micros") @db.UnsignedBigInt
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@id([organizationId, day, userId, provider, model, keySource])
  @@index([organizationId, userId, day])
  @@map("ai_chat_usage_user_daily")
}

/// Rating of an assistant answer (step AI-6 D2, A6-10).
enum AiChatFeedbackRating {
  up
  down
}

/// Optional fixed reason of an assistant answer rating (step AI-6 D2).
enum AiChatFeedbackReason {
  incorrect
  incomplete
  not_helpful
  wrong_action
  unsafe
  too_slow
  other
}

/// The author's rating of one assistant message (step AI-6 D2; ADR-0094 amendment AI-6): one row
/// per message (UQ `message_id`), upserted and removable by the conversation's owner only.
/// `comment` (≤ 500 characters, sanitized like user text) is content: set to NULL at the
/// conversation's content purge; it is the only user-written text an `assistant:configure`
/// holder sees (I24, with a notice to the user). `user_id` and `turn_id` have no FK (the
/// conversation and the message cascade).
model AiChatFeedback {
  id             BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  publicId       String                @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  organizationId BigInt                @map("organization_id") @db.UnsignedBigInt
  userId         BigInt                @map("user_id") @db.UnsignedBigInt
  conversationId BigInt                @map("conversation_id") @db.UnsignedBigInt
  /// The turn of the rated message (no FK).
  turnId         BigInt                @map("turn_id") @db.UnsignedBigInt
  messageId      BigInt                @unique @map("message_id") @db.UnsignedBigInt
  rating         AiChatFeedbackRating
  reason         AiChatFeedbackReason?
  /// Optional comment (content, purged).
  comment        String?               @db.VarChar(500)
  createdAt      DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  conversation AiChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      AiChatMessage      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, rating, createdAt])
  @@index([conversationId])
  @@map("ai_chat_feedback")
}

/// Kind of a pseudonymized value (step AI-6 D3): token `[EMAIL_n]`, `[IP_n]`, `[DOMAIN_n]`,
/// `[PERSON_n]`.
enum AiChatPseudonymKind {
  email
  ip
  domain
  name
}

/// One pseudonym mapping of a conversation (step AI-6 D3, I25; ADR-0097): `token` (e.g.
/// `[EMAIL_3]`, numbered per kind and conversation) stands for `value` in everything the model
/// reads. `value` is content (the normalized real value, ≤ 320 characters); `value_sha256` =
/// SHA-256 hex of it (lookup of an existing token). New mappings of a turn are inserted in the
/// turn's closing transaction (the turn lock makes numbering race-free); rows are deleted at the
/// conversation's content purge, on conversation delete and with the organization purge.
model AiChatPseudonym {
  id             BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId BigInt              @map("organization_id") @db.UnsignedBigInt
  conversationId BigInt              @map("conversation_id") @db.UnsignedBigInt
  kind           AiChatPseudonymKind
  token          String              @db.VarChar(24)
  /// The real value (content; the row is deleted at the content purge).
  value          String              @db.VarChar(320)
  valueSha256    String              @map("value_sha256") @db.Char(64)
  createdAt      DateTime            @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  conversation AiChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, token])
  @@unique([conversationId, kind, valueSha256])
  @@index([organizationId, createdAt])
  @@map("ai_chat_pseudonyms")
}

/// Provider of a tenant-supplied assistant key (step AI-6 D7, A6-7): Azure OpenAI is not offered
/// (a per-tenant endpoint cannot be allowed by the egress policy).
enum AiChatTenantKeyProvider {
  anthropic
  openai
}

/// Validation status of a tenant-supplied assistant key (step AI-6 D7): `valid` (last probe
/// accepted), `invalid` (the provider answered 401/403, by probe or during a turn),
/// `unverified` (the last re-validation could not reach the provider).
enum AiChatTenantKeyStatus {
  valid
  invalid
  unverified
}

/// The organization's own LLM provider key (step AI-6 D7, I27; ADR-0097): at most one row per
/// organization, write-only. `key_ciphertext` = AES-256-GCM `v1.<kid>.<iv>.<tag>.<ct>` under
/// ASSISTANT_TENANT_KEY_ENCRYPTION_KEY (`_PREVIOUS` decrypts only) with the row-bound AAD
/// `assistant-provider-key:v1:<organizationId>:<keyVersion>`; `key_kid` = `k` + 7 hex of the
/// SHA-256 of the encryption key (ADR-0077); `key_fingerprint` = the first 16 hex of the SHA-256
/// of the API key, the only visible trace. The plaintext is never stored, returned, logged,
/// audited or put in an event. `model` is one of ASSISTANT_TENANT_KEY_MODELS. CAS on
/// `row_version`; `set_by_user_id` has no FK. Deleted by `DELETE /assistant/settings/provider-key`
/// and with the organization purge.
model AiChatProviderKey {
  organizationId  BigInt                  @id @map("organization_id") @db.UnsignedBigInt
  provider        AiChatTenantKeyProvider
  model           String                  @db.VarChar(64)
  /// Encrypted API key (never the plaintext).
  keyCiphertext   String                  @map("key_ciphertext") @db.VarChar(1024)
  keyKid          String                  @map("key_kid") @db.VarChar(8)
  keyFingerprint  String                  @map("key_fingerprint") @db.Char(16)
  /// Incremented on every new key (part of the AAD).
  keyVersion      Int                     @map("key_version") @db.UnsignedInt
  status          AiChatTenantKeyStatus
  lastValidatedAt DateTime?               @map("last_validated_at") @db.DateTime(3)
  lastErrorCode   String?                 @map("last_error_code") @db.VarChar(64)
  setByUserId     BigInt                  @map("set_by_user_id") @db.UnsignedBigInt
  setAt           DateTime                @map("set_at") @db.DateTime(3)
  /// Compare-and-set counter.
  rowVersion      Int                     @default(1) @map("row_version") @db.UnsignedInt
  createdAt       DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("ai_chat_provider_keys")
}

/// Lifecycle of an asynchronous assistant report job (step AI-6 D5; ADR-0096): `queued` (turn
/// transaction, with the outbox event) → `running` (consumer CAS with a lease) → `succeeded`
/// (report `available`) or `failed` (expired, session ended, not allowed, retries exhausted);
/// `queued|running` → `cancelled` at the conversation's content purge.
enum AiChatReportJobStatus {
  queued
  running
  succeeded
  failed
  cancelled
}

/// One background generation of a `queued` assistant report (step AI-6 D5, I26; ADR-0096):
/// written in the turn's transaction with the report row, the execution and the outbox event
/// `assistant.report.generate_requested.v1` (eventId = `public_id`); consumed from the
/// `assistant.reports` queue by the `api-assistant` consumer, which mints a 5-minute GET-only job
/// token of the requesting user's live session (`session_id`, `auth_methods`,
/// `home_organization_public_id`, `platform_override_id`). No credential is stored. `arguments`
/// = the validated `report_generate` arguments (≤ 1 KiB); `lease_until` guards a `running` row
/// against a second pod; `reported_at` = when the outcome was given to the model (action
/// updates). Expired rows (`expires_at`) are failed by the retention sweep. `user_id` and
/// `execution_id` have no FK (the conversation and the report cascade).
model AiChatReportJob {
  id                       BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  publicId                 String                @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  organizationId           BigInt                @map("organization_id") @db.UnsignedBigInt
  userId                   BigInt                @map("user_id") @db.UnsignedBigInt
  conversationId           BigInt                @map("conversation_id") @db.UnsignedBigInt
  reportId                 BigInt                @unique @map("report_id") @db.UnsignedBigInt
  /// The queuing `report_generate` execution (no FK).
  executionId              BigInt                @map("execution_id") @db.UnsignedBigInt
  /// Refresh-token family of the requesting session (`UserPrincipal.sessionId`).
  sessionId                String                @map("session_id") @db.Char(36)
  /// Authentication methods of the session (`pwd` / `pwd,otp`).
  authMethods              String                @map("auth_methods") @db.VarChar(16)
  homeOrganizationPublicId String                @map("home_organization_public_id") @db.Char(36)
  /// Public id of the platform override the job was queued under (no FK).
  platformOverrideId       String?               @map("platform_override_id") @db.Char(36)
  /// Validated `report_generate` arguments (≤ 1 KiB).
  arguments                Json
  organizationLabel        String?               @map("organization_label") @db.VarChar(120)
  status                   AiChatReportJobStatus @default(queued)
  attempts                 Int                   @default(0) @db.UnsignedTinyInt
  leaseUntil               DateTime?             @map("lease_until") @db.DateTime(3)
  errorCode                String?               @map("error_code") @db.VarChar(64)
  correlationId            String                @map("correlation_id") @db.VarChar(128)
  expiresAt                DateTime              @map("expires_at") @db.DateTime(3)
  reportedAt               DateTime?             @map("reported_at") @db.DateTime(3)
  createdAt                DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  startedAt                DateTime?             @map("started_at") @db.DateTime(3)
  finishedAt               DateTime?             @map("finished_at") @db.DateTime(3)
  updatedAt                DateTime              @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  conversation AiChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  report       AiChatReport       @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
  @@index([conversationId, status, reportedAt])
  @@index([organizationId, createdAt])
  @@map("ai_chat_report_jobs")
}

// ---------------------------------------------------------------------------------------------
// Step API-1: API-mode protection (docs/plan/steps/35-api-mode-protection.md §3; ADR-0098 ..
// ADR-0100). Protection modes live on `organizations` / `domains`; six tables, one partitioned
// (`api_message_copies`). Ids, hashes, addresses, verdicts and timings only: copies are EMLs in
// the mail bucket, provider cursors are opaque and never returned by the api, Graph client-state
// values are stored as SHA-256 only. Written by the mailbox-worker (and the api for settings and
// sync requests); purged with the organization (copies and dedupe keys before mailboxes,
// counters and mailboxes before connections).
// ---------------------------------------------------------------------------------------------

/// Protection mode of an organization (default of its domains) or a domain (step API-1 D1,
/// ADR-0098): `inline` = MX through the gateway (every existing tenant); `api` = the gateway sees
/// mail only as copies from the provider and never delivers or bounces it; `hybrid` = inline
/// plus API post-delivery. Append-only.
enum ProtectionMode {
  inline
  api
  hybrid
}

/// How the change feeds of an API-mode connection learn of new mail (D10): `poll` = delta /
/// history polling every API_MODE_FEED_POLL_SECONDS; `notify` = Graph change notifications as
/// wake-up hints plus a safety poll (Microsoft 365 only).
enum ApiModeFeedMode {
  poll
  notify
}

/// Last mailbox inventory of an API-mode connection (D11.1); `unavailable` = no active
/// `*.mailbox_remediation` grant.
enum ApiModeInventoryStatus {
  never
  ok
  failed
  unavailable
}

/// Health of an API-mode connection (D11.3, `api-mode-health/1`); `unknown` before the first
/// evaluation.
enum ApiModeHealthStatus {
  unknown
  healthy
  degraded
  failing
}

/// Directory status of an API-mode mailbox (D7.3, D11.1): `discovered` = only seen in journal
/// envelopes (no provider id yet); `deleted` rows are purged after 30 days.
enum ApiMailboxStatus {
  active
  discovered
  disabled
  deleted
}

/// Coverage of a mailbox (D11.2): healthy feed or a journal sighting within
/// API_MODE_JOURNAL_COVERAGE_DAYS = `covered`.
enum ApiMailboxCoverageState {
  covered
  gap
  out_of_scope
}

/// Change-feed state of a mailbox (D10).
enum ApiMailboxFeedStatus {
  off
  pending
  active
  error
  throttled
  revoked
}

enum ApiMailboxAddressKind {
  primary
  alias
}

/// Which copy of a message was recorded for a mailbox (`api_message_copies.source`) or holds a
/// dedupe claim (`api_copy_dedupe_keys.claimed_by`): the journal copy, a Graph or a Gmail feed copy.
enum ApiCopySource {
  journal
  graph
  gmail
}

/// Recipient direction of a copy (D7.4); API-1 records `inbound` only (`internal` is API-3).
enum ApiCopyDirection {
  inbound
  internal
}

/// Basis of `api_message_copies.provider_delivered_at` (D7.8).
enum ApiCopyDeliveredBasis {
  received_header
  graph_received
  gmail_internal
  ingest
}

/// Processing state of a per-mailbox copy (D7, D10.3): `pending` until the email-worker's
/// `mail.message.copy_scanned.v1`; `too_large` = above API_MODE_MAX_MESSAGE_BYTES, never fetched.
enum ApiCopyStatus {
  pending
  scanned
  scan_failed
  parse_failed
  too_large
}

/// Whose verdict a copy carries (D7.5): its own detect-mode scan, or the inline (gateway) verdict
/// of the same message in a hybrid domain.
enum ApiCopyVerdictAuthority {
  copy
  inline
}

/// One row per step 8.2 provider connection used for API mode (step API-1 §3.2, ADR-0100),
/// created lazily by the api or the mailbox-worker. Feeds are off by default (P3). `health_checks`
/// = `api-mode-health/1`; `throttled_until` mirrors the Redis throttle pause; `mailboxes_total` =
/// in-scope mailboxes of the last inventory (NULL = unknown). CAS on `row_version` (settings).
/// `created_by_user_id` has no FK (the trail survives the user).
model ApiModeConnection {
  id                   BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  publicId             String                 @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  organizationId       BigInt                 @map("organization_id") @db.UnsignedBigInt
  providerConnectionId BigInt                 @unique @map("provider_connection_id") @db.UnsignedBigInt
  provider             IntegrationProvider
  feedsEnabled         Boolean                @default(false) @map("feeds_enabled")
  feedMode             ApiModeFeedMode        @default(poll) @map("feed_mode")
  feedsEnabledAt       DateTime?              @map("feeds_enabled_at") @db.DateTime(3)
  inventoryStatus      ApiModeInventoryStatus @default(never) @map("inventory_status")
  inventorySyncedAt    DateTime?              @map("inventory_synced_at") @db.DateTime(3)
  inventoryRequestedAt DateTime?              @map("inventory_requested_at") @db.DateTime(3)
  nextInventoryAt      DateTime?              @map("next_inventory_at") @db.DateTime(3)
  /// In-scope mailboxes of the last inventory; NULL = unknown.
  mailboxesTotal       Int?                   @map("mailboxes_total") @db.UnsignedInt
  healthStatus         ApiModeHealthStatus    @default(unknown) @map("health_status")
  /// `api-mode-health/1` `{ v: 1, checks: [{ code, status, evidence? }] }` (non-secret evidence).
  healthChecks         Json?                  @map("health_checks")
  healthChangedAt      DateTime?              @map("health_changed_at") @db.DateTime(3)
  healthAlertedAt      DateTime?              @map("health_alerted_at") @db.DateTime(3)
  throttledUntil       DateTime?              @map("throttled_until") @db.DateTime(3)
  /// Classified `ProviderCallError` code only.
  lastErrorCode        String?                @map("last_error_code") @db.VarChar(64)
  createdByUserId      BigInt?                @map("created_by_user_id") @db.UnsignedBigInt
  rowVersion           Int                    @default(1) @map("row_version") @db.UnsignedInt
  createdAt            DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime               @updatedAt @map("updated_at") @db.DateTime(3)

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  providerConnection ProviderConnection @relation(fields: [providerConnectionId], references: [id], onDelete: Restrict)
  mailboxes          ApiMailbox[]
  counters           ApiModeCounter[]

  @@index([organizationId])
  @@index([healthStatus])
  @@index([nextInventoryAt])
  @@map("api_mode_connections")
}

/// A provider mailbox under an API-mode connection (step API-1 §3.2, D7.3, D10, D11). Created by
/// the inventory (`provider_user_id` set) or discovered from a journal envelope (`discovered`,
/// `provider_user_id` NULL; adopted by the inventory by address). `primary_address` lower case.
/// `feed_cursor` = Graph delta link or Gmail history id (opaque, never returned by the api);
/// `client_state_hash` = SHA-256 hex of the derived Graph client state (the value is never
/// stored); `lease_until` = feed claim lease. `domain_id` has no FK.
model ApiMailbox {
  id                    BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  publicId              String                  @unique @default(uuid(7)) @map("public_id") @db.Char(36)
  organizationId        BigInt                  @map("organization_id") @db.UnsignedBigInt
  apiConnectionId       BigInt                  @map("api_connection_id") @db.UnsignedBigInt
  /// Graph user id / Google user id; NULL for a mailbox only seen in journal envelopes.
  providerUserId        String?                 @map("provider_user_id") @db.VarChar(128)
  primaryAddress        String                  @map("primary_address") @db.VarChar(320)
  domainId              BigInt?                 @map("domain_id") @db.UnsignedBigInt
  status                ApiMailboxStatus        @default(discovered)
  coverageState         ApiMailboxCoverageState @default(out_of_scope) @map("coverage_state")
  coverageChangedAt     DateTime?               @map("coverage_changed_at") @db.DateTime(3)
  journalLastSeenAt     DateTime?               @map("journal_last_seen_at") @db.DateTime(3)
  feedStatus            ApiMailboxFeedStatus    @default(off) @map("feed_status")
  /// Opaque provider cursor; never returned by the api, never logged.
  feedCursor            String?                 @map("feed_cursor") @db.Text
  feedStartedAt         DateTime?               @map("feed_started_at") @db.DateTime(3)
  subscriptionId        String?                 @unique @map("subscription_id") @db.VarChar(128)
  subscriptionExpiresAt DateTime?               @map("subscription_expires_at") @db.DateTime(3)
  clientStateHash       String?                 @map("client_state_hash") @db.Char(64)
  clientStateVersion    Int                     @default(0) @map("client_state_version") @db.UnsignedSmallInt
  syncRequestedAt       DateTime?               @map("sync_requested_at") @db.DateTime(3)
  nextSyncAt            DateTime?               @map("next_sync_at") @db.DateTime(3)
  lastSyncAt            DateTime?               @map("last_sync_at") @db.DateTime(3)
  lastChangeAt          DateTime?               @map("last_change_at") @db.DateTime(3)
  lastGapAt             DateTime?               @map("last_gap_at") @db.DateTime(3)
  consecutiveFailures   Int                     @default(0) @map("consecutive_failures") @db.UnsignedSmallInt
  lastErrorCode         String?                 @map("last_error_code") @db.VarChar(64)
  leaseUntil            DateTime?               @map("lease_until") @db.DateTime(3)
  deletedAt             DateTime?               @map("deleted_at") @db.DateTime(3)
  createdAt             DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt             DateTime                @updatedAt @map("updated_at") @db.DateTime(3)

  apiConnection ApiModeConnection   @relation(fields: [apiConnectionId], references: [id], onDelete: Restrict)
  addresses     ApiMailboxAddress[]

  @@unique([apiConnectionId, providerUserId])
  @@index([organizationId, status])
  @@index([apiConnectionId, coverageState])
  @@index([feedStatus, nextSyncAt])
  @@index([syncRequestedAt])
  @@map("api_mailboxes")
}

/// Addresses (primary and aliases, lower case) of an API-mode mailbox; resolves a recipient
/// address to a mailbox, unique per organization (step API-1 §3.2, D7.3, D11.1).
model ApiMailboxAddress {
  id             BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId BigInt                @map("organization_id") @db.UnsignedBigInt
  mailboxId      BigInt                @map("mailbox_id") @db.UnsignedBigInt
  address        String                @db.VarChar(320)
  kind           ApiMailboxAddressKind
  createdAt      DateTime              @default(now()) @map("created_at") @db.DateTime(3)

  mailbox ApiMailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  @@unique([organizationId, address])
  @@index([mailboxId])
  @@map("api_mailbox_addresses")
}

/// PARTITIONED by RANGE COLUMNS(received_at), monthly (6 months, core, like email_messages; step
/// API-1 §3.2, D7, D10.3, ADR-0100). One row per scanned copy and mailbox: which copy was scanned
/// (`source`), whether the journal and/or a feed saw it, the verdict, risk score, lag from provider
/// delivery to verdict and the hybrid inline link. `received_at` = the copy registry message's.
/// `message_id_hash` = `api-copy/1` dedupe hash (NULL without a Message-ID). `public_id` is
/// app-generated UUIDv7, indexed but not unique (partitioned-table practice). The unique key
/// `(message_id, received_at, mailbox_id)` includes the partition column but, as designed, does
/// not end with it (one row per message and mailbox). Written by the mailbox-worker; API-2 acts on
/// these rows. No foreign keys.
model ApiMessageCopy {
  id                  BigInt                  @default(autoincrement()) @db.UnsignedBigInt
  receivedAt          DateTime                @map("received_at") @db.DateTime(3)
  publicId            String                  @map("public_id") @db.Char(36)
  organizationId      BigInt                  @map("organization_id") @db.UnsignedBigInt
  /// api_mode_connections.id (no FK: partitioned).
  apiConnectionId     BigInt                  @map("api_connection_id") @db.UnsignedBigInt
  /// api_mailboxes.id (no FK: partitioned).
  mailboxId           BigInt                  @map("mailbox_id") @db.UnsignedBigInt
  /// email_messages.id of the scanned copy (registry id).
  messageId           BigInt                  @map("message_id") @db.UnsignedBigInt
  source              ApiCopySource
  seenJournal         Boolean                 @default(false) @map("seen_journal")
  seenApi             Boolean                 @default(false) @map("seen_api")
  direction           ApiCopyDirection        @default(inbound)
  messageIdHash       String?                 @map("message_id_hash") @db.Char(64)
  providerMessageId   String?                 @map("provider_message_id") @db.VarChar(256)
  providerDeliveredAt DateTime?               @map("provider_delivered_at") @db.DateTime(3)
  deliveredBasis      ApiCopyDeliveredBasis?  @map("delivered_basis")
  status              ApiCopyStatus
  verdict             MessageVerdict?
  riskScore           Int?                    @map("risk_score") @db.UnsignedSmallInt
  verdictAt           DateTime?               @map("verdict_at") @db.DateTime(3)
  lagMs               Int?                    @map("lag_ms") @db.UnsignedInt
  verdictAuthority    ApiCopyVerdictAuthority @default(copy) @map("verdict_authority")
  /// The gateway message of a hybrid domain whose verdict is authoritative (no FK).
  inlineMessageId     BigInt?                 @map("inline_message_id") @db.UnsignedBigInt
  inlineReceivedAt    DateTime?               @map("inline_received_at") @db.DateTime(3)
  createdAt           DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime                @updatedAt @map("updated_at") @db.DateTime(3)

  @@id([id, receivedAt])
  @@unique([messageId, receivedAt, mailboxId])
  @@index([organizationId, receivedAt, id])
  @@index([organizationId, publicId])
  @@index([organizationId, mailboxId, receivedAt])
  @@index([organizationId, messageIdHash])
  @@index([organizationId, verdict, receivedAt])
  @@map("api_message_copies")
}

/// Dedupe claims of copies by Message-ID plus mailbox (step API-1 D7.6, D10.3; transient, pruned
/// after API_MODE_DEDUPE_WINDOW_HOURS). `copy_id` / `copy_received_at` reference the recorded
/// `api_message_copies` row; NULL while a feed claim is in flight (`claim_expires_at`). No
/// foreign keys.
model ApiCopyDedupeKey {
  id             BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId BigInt        @map("organization_id") @db.UnsignedBigInt
  mailboxId      BigInt        @map("mailbox_id") @db.UnsignedBigInt
  messageIdHash  String        @map("message_id_hash") @db.Char(64)
  claimedBy      ApiCopySource @map("claimed_by")
  copyId         BigInt?       @map("copy_id") @db.UnsignedBigInt
  copyReceivedAt DateTime?     @map("copy_received_at") @db.DateTime(3)
  claimExpiresAt DateTime?     @map("claim_expires_at") @db.DateTime(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.DateTime(3)

  @@unique([mailboxId, messageIdHash])
  @@index([createdAt])
  @@index([organizationId])
  @@map("api_copy_dedupe_keys")
}

/// Hourly API-mode counters per connection (step API-1 D7.8, D10.6, D11), upserted additively by
/// the mailbox-worker's counter flush (`(api_connection_id, hour)`); pruned after 400 days by the
/// health role. Lag buckets back the overview percentiles.
model ApiModeCounter {
  id               BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId   BigInt   @map("organization_id") @db.UnsignedBigInt
  apiConnectionId  BigInt   @map("api_connection_id") @db.UnsignedBigInt
  /// UTC hour start.
  hour             DateTime @db.DateTime(0)
  journalCopies    Int      @default(0) @map("journal_copies") @db.UnsignedInt
  feedCopies       Int      @default(0) @map("feed_copies") @db.UnsignedInt
  duplicates       Int      @default(0) @db.UnsignedInt
  skippedInternal  Int      @default(0) @map("skipped_internal") @db.UnsignedInt
  tooLarge         Int      @default(0) @map("too_large") @db.UnsignedInt
  providerRequests Int      @default(0) @map("provider_requests") @db.UnsignedInt
  throttled429     Int      @default(0) @map("throttled_429") @db.UnsignedInt
  throttled503     Int      @default(0) @map("throttled_503") @db.UnsignedInt
  providerErrors   Int      @default(0) @map("provider_errors") @db.UnsignedInt
  cursorResets     Int      @default(0) @map("cursor_resets") @db.UnsignedInt
  lagCount         Int      @default(0) @map("lag_count") @db.UnsignedInt
  lagLe60s         Int      @default(0) @map("lag_le_60s") @db.UnsignedInt
  lagLe300s        Int      @default(0) @map("lag_le_300s") @db.UnsignedInt
  lagLe900s        Int      @default(0) @map("lag_le_900s") @db.UnsignedInt
  lagLe3600s       Int      @default(0) @map("lag_le_3600s") @db.UnsignedInt
  lagGt3600s       Int      @default(0) @map("lag_gt_3600s") @db.UnsignedInt
  lagMaxMs         Int      @default(0) @map("lag_max_ms") @db.UnsignedInt
  fetchBytes       BigInt   @default(0) @map("fetch_bytes") @db.UnsignedBigInt
  lagSumMs         BigInt   @default(0) @map("lag_sum_ms") @db.UnsignedBigInt
  updatedAt        DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  apiConnection ApiModeConnection @relation(fields: [apiConnectionId], references: [id], onDelete: Cascade)

  @@unique([apiConnectionId, hour])
  @@index([organizationId, hour])
  @@map("api_mode_counters")
}
