{
  "name": "@email-gateway/security-incidents",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "testing": [
        "dist/testing/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src integration",
    "test": "vitest run --dir src",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@email-gateway/common": "workspace:*",
    "@email-gateway/database": "workspace:*",
    "@email-gateway/event-contracts": "workspace:*",
    "@email-gateway/logger": "workspace:*",
    "@email-gateway/security-contracts": "workspace:*",
    "zod": "^4.1.5"
  },
  "devDependencies": {}
}
