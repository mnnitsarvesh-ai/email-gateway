idth="2"/><path d="M102.19,10.31A100,100 0 0 1 104.79,10.14L106.77,48.08A62,62 0 0 0 105.16,48.19Z" fill="#ec835a" stroke="#ffffff" stroke-width="2"/><path d="M104.79,10.14A100,100 0 0 1 106.87,10.05L108.06,48.03A62,62 0 0 0 106.77,48.08Z" fill="#e1e0d9" stroke="#ffffff" stroke-width="2"/><path d="M106.87,10.05A100,100 0 0 1 108.7,10.01L109.19,48.01A62,62 0 0 0 108.06,48.03Z" fill="#d03b3b" stroke="#ffffff" stroke-width="2"/><path d="M108.7,10.01A100,100 0 0 1 109.74,10L109.84,48A62,62 0 0 0 109.19,48.01Z" fill="#2a78d6" stroke="#ffffff" stroke-width="2"/><path d="M109.74,10A100,100 0 0 1 110,10L110,48A62,62 0 0 0 109.84,48Z" fill="#b4b2a9" stroke="#ffffff" stroke-width="2"/><text x="110" y="114" font-size="22" text-anchor="middle" font-weight="bold" fill="#0b0b0b">9,644</text><text x="110" y="132" font-size="11" text-anchor="middle" fill="#6b6a65">total</text></g></svg><ul class="legend"><li><span class="sw sw-clean" aria-hidden="true"></span>Clean <strong>9,080</strong> <small>(94.2%)</small></li><li><span class="sw sw-spam" aria-hidden="true"></span>Spam <strong>348</strong> <small>(3.6%)</small></li><li><span class="sw sw-bulk" aria-hidden="true"></span>Bulk <strong>96</strong> <small>(1.0%)</small></li><li><span class="sw sw-suspicious" aria-hidden="true"></span>Suspicious <strong>40</strong> <small>(0.4%)</small></li><li><span class="sw sw-none" aria-hidden="true"></span>No verdict <strong>32</strong> <small>(0.3%)</small></li><li><span class="sw sw-phishing" aria-hidden="true"></span>Phishing <strong>28</strong> <small>(0.3%)</small></li><li><span class="sw sw-dlp_violation" aria-hidden="true"></span>DLP violation <strong>16</strong> <small>(0.2%)</small></li><li><span class="sw sw-other" aria-hidden="true"></span>Other <strong>4</strong> <small>(0.0%)</small></li></ul></figure></div></section><section class="section" id="section-threats" aria-label="Threats"><h2>Threats</h2><div class="grid"><figure class="chart-card"><figcaption>Threat types</figcaption><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 220 220" class="chart-svg chart-donut" role="img" aria-labelledby="chart-threat-types-title chart-threat-types-desc" focusable="false"><title id="chart-threat-types-title">Threat types</title><desc id="chart-threat-types-desc">Donut chart, total 351; largest Spam 300 (85.5%); 5 categories.</desc><g><path d="M110,10A100,100 0 1 1 30.87,48.86L60.94,72.09A62,62 0 1 0 110,48Z" fill="#fab219" stroke="#ffffff" stroke-width="2"/><path d="M30.87,48.86A100,100 0 0 1 65.12,20.64L82.17,54.59A62,62 0 0 0 60.94,72.09Z" fill="#d03b3b" stroke="#ffffff" stroke-width="2"/><path d="M65.12,20.64A100,100 0 0 1 95.73,11.02L101.15,48.63A62,62 0 0 0 82.17,54.59Z" fill="#ec835a" stroke="#ffffff" stroke-width="2"/><path d="M95.73,11.02A100,100 0 0 1 106.42,10.06L107.78,48.04A62,62 0 0 0 101.15,48.63Z" fill="#8f1d3a" stroke="#ffffff" stroke-width="2"/><path d="M106.42,10.06A100,100 0 0 1 110,10L110,48A62,62 0 0 0 107.78,48.04Z" fill="#6250d6" stroke="#ffffff" stroke-width="2"/><text x="110" y="114" font-size="22" text-anchor="middle" font-weight="bold" fill="#0b0b0b">351</text><text x="110" y="132" font-size="11" text-anchor="middle" fill="#6b6a65">total</text></g></svg><ul class="legend"><li><span class="sw sw-spam" aria-hidden="true"></span>Spam <strong>300</strong> <small>(85.5%)</small></li><li><span class="sw sw-phishing" aria-hidden="true"></span>Phishing <strong>25</strong> <small>(7.1%)</small></li><li><span class="sw sw-suspicious" aria-hidden="true"></span>Suspicious <strong>18</strong> <small>(5.1%)</small></li><li><span class="sw sw-malware" aria-hidden="true"></span>Malware <strong>6</strong> <small>(1.7%)</small></li><li><span class="sw sw-bec" aria-hidden="true"></span>BEC <strong>2</strong> <small>(0.6%)</small></li></ul></figure><figure class="chart-card"><figcaption>Final actions</figcaption><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 300" class="chart-svg chart-bar" role="img" aria-labelledby="chart-threat-acti