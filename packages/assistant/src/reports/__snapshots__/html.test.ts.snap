// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renderReportHtml (design D4) > is byte-stable for the full fixture report (snapshot) 1`] = `"<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta http-equiv="Content-Security-Policy" content="default-src &#39;none&#39;; style-src &#39;unsafe-inline&#39;; img-src data:"><meta name="referrer" content="no-referrer"><title>Security report: Last 7 days</title><style>*{box-sizing:border-box}html{background:#ffffff;color:#0b0b0b}body{margin:0;background:#ffffff;color:#0b0b0b;font-family:system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;font-size:14px;line-height:1.45}.report{max-width:1080px;margin:0 auto;padding:24px 16px 32px}.report-header{border-bottom:1px solid #e1e0d9;padding-bottom:12px;margin-bottom:20px}h1{font-size:24px;margin:0 0 4px}h2{font-size:18px;margin:0 0 12px}h3{font-size:14px;margin:0 0 8px}.org{font-size:16px;font-weight:600;margin:0 0 4px}.meta{color:#52514e;margin:0}.meta span{margin-right:16px}.section{margin:0 0 28px}.cards{display:flex;flex-wrap:wrap;gap:12px;margin:0 0 16px}.card{flex:1 1 150px;min-width:150px;border:1px solid #e1e0d9;border-radius:8px;padding:10px 12px;background:#ffffff}.card-label{display:block;color:#52514e;font-size:12px}.card-value{display:block;font-size:22px;font-weight:700;margin-top:2px}.card-hint{display:block;color:#6b6a65;font-size:11px}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.chart-card{margin:0;border:1px solid #e1e0d9;border-radius:8px;padding:12px;background:#ffffff;min-width:0}.chart-card figcaption{font-weight:600;margin:0 0 8px}.chart-svg{display:block;width:100%;height:auto}.chart-donut{max-width:220px;margin:0 auto}.empty{color:#6b6a65;text-align:center;padding:48px 0;margin:0;border:1px dashed #e1e0d9;border-radius:6px}.legend{list-style:none;margin:10px 0 0;padding:0;display:flex;flex-wrap:wrap;gap:4px 14px;font-size:12px;color:#52514e}.legend li{display:flex;align-items:center;gap:6px}.legend strong{color:#0b0b0b;font-weight:600}.sw{display:inline-block;width:10px;height:10px;border-radius:2px;flex:none}.sw-c0{background:#2a78d6}.sw-c1{background:#eb6834}.sw-c2{background:#1baf7a}.sw-c3{background:#eda100}.sw-c4{background:#e87ba4}.sw-c5{background:#008300}.sw-c6{background:#6250d6}.sw-c7{background:#e34948}.sw-clean{background:#898781}.sw-bulk{background:#c3c2b7}.sw-none{background:#e1e0d9}.sw-unknown{background:#52514e}.sw-spam{background:#fab219}.sw-suspicious{background:#ec835a}.sw-phishing{background:#d03b3b}.sw-malware{background:#8f1d3a}.sw-bec{background:#6250d6}.sw-dlp_violation{background:#2a78d6}.sw-other{background:#b4b2a9}.sw-good{background:#0ca30c}.sw-warning{background:#fab219}.sw-serious{background:#ec835a}.sw-critical{background:#d03b3b}.table-wrap{overflow-x:auto;margin:0 0 16px}table{border-collapse:collapse;width:100%;font-size:12px}caption{text-align:left;font-weight:600;padding:0 0 6px;font-size:13px}th,td{border-bottom:1px solid #e1e0d9;padding:4px 8px;text-align:left;vertical-align:top;word-break:break-word}th{color:#52514e;font-weight:600;background:#f7f7f5}.num{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}.note{color:#52514e;font-size:12px;margin:0 0 8px}.report-footer{border-top:1px solid #e1e0d9;padding-top:16px;color:#52514e;font-size:12px}.report-footer h2{font-size:14px;color:#0b0b0b;margin:12px 0 6px}.report-footer ul{margin:0 0 8px;padding-left:18px}.fineprint{margin:12px 0 0}@media (max-width:720px){.grid{grid-template-columns:minmax(0,1fr)}.card{flex-basis:130px;min-width:130px}}@media print{.report{max-width:none;padding:0}.chart-card,.card,table{break-inside:avoid}}</style></head><body><main class="report"><header class="report-header"><h1>Security report</h1><p class="org">Example Test Org</p><p class="meta"><span>Period: Last 7 days</span><span>Generated Nov 23, 2026 09:00 UTC</span></p></header><section class="section" id="section-summary" aria-label="Summary"><h2>Summary</h2><div class="cards"><div class="card"><span class="card-label">Messages</span><strong class="card-value">9,644</strong></div><div class="card"><span class="card-label">Inbound</span><strong class="card-value">7,724</strong></div><div class="card"><span class="card-label">Outbound</span><strong class="card-value">1,760</strong></div><div class="card"><span class="card-label">Threats</span><strong class="card-value">420</strong></div><div class="card"><span class="card-label">Quarantined</span><strong class="card-value">200</strong></div><div class="card"><span class="card-label">Delivery success rate</span><strong class="card-value">98.6%</strong></div><div class="card"><span class="card-label">p95 time to verdict</span><strong class="card-value">≤ 2.5 s</strong><small class="card-hint">upper bound</small></div><div class="card"><span class="card-label">Blocked URL clicks</span><strong class="card-value">20</strong></div><div class="card"><span class="card-label">Held in quarantine</span><strong class="card-value">42</strong></div><div class="card"><span class="card-label">Pending approvals</span><strong class="card-value">3</strong></div><div class="card"><span class="card-label">High-risk accounts</span><strong class="card-value">5</strong><small class="card-hint">high and critical</small></div></div></section><section class="section" id="section-traffic" aria-label="Mail traffic"><h2>Mail traffic</h2><div class="grid"><figure class="chart-card"><figcaption>Mail volume by direction</figcaption><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 260" class="chart-svg chart-timeseries" role="img" aria-labelledby="chart-traffic-volume-title chart-traffic-volume-desc" focusable="false"><title id="chart-traffic-volume-title">Mail volume by direction</title><desc id="chart-traffic-volume-desc">Stacked area chart of 8 daily buckets from Nov 16, 2026 00:00 UTC to Nov 23, 2026 00:00 UTC: Inbound total 7,724; Outbound total 1,760; Internal total 160.</desc><g><line x1="56" y1="230" x2="626" y2="230" stroke="#c3c2b7" stroke-width="1"/><text x="50" y="234" font-size="10" text-anchor="end" fill="#6b6a65">0</text><line x1="56" y1="157.33" x2="626" y2="157.33" stroke="#e1e0d9" stroke-width="1"/><text x="50" y="161.33" font-size="10" text-anchor="end" fill="#6b6a65">500</text><line x1="56" y1="84.67" x2="626" y2="84.67" stroke="#e1e0d9" stroke-width="1"/><text x="50" y="88.67" font-size="10" text-anchor="end" fill="#6b6a65">1,000</text><line x1="56" y1="12" x2="626" y2="12" stroke="#e1e0d9" stroke-width="1"/><text x="50" y="16" font-size="10" text-anchor="end" fill="#6b6a65">1,500</text><text x="56" y="250" font-size="10" text-anchor="start" fill="#6b6a65">Nov 16</text><text x="218.86" y="250" font-size="10" text-anchor="middle" fill="#6b6a65">Nov 18</text><text x="381.71" y="250" font-size="10" text-anchor="middle" fill="#6b6a65">Nov 20</text><text x="544.57" y="250" font-size="10" text-anchor="middle" fill="#6b6a65">Nov 22</text><path d="M56,95.28L137.43,93.68L218.86,92.22L300.29,90.33L381.71,88.88L463.14,87.28L544.57,85.68L626,84.09L626,230L544.57,230L463.14,230L381.71,230L300.29,230L218.86,230L137.43,230L56,230Z" fill="#2a78d6" opacity="0.85" stroke="#ffffff" stroke-width="1"/><path d="M56,63.3L137.43,61.7L218.86,60.25L300.29,58.36L381.71,56.91L463.14,55.31L544.57,53.71L626,52.11L626,84.09L544.57,85.68L463.14,87.28L381.71,88.88L300.29,90.33L218.86,92.22L137.43,93.68L56,95.28Z" fill="#eb6834" opacity="0.85" stroke="#ffffff" stroke-width="1"/><path d="M56,60.4L137.43,58.8L218.86,57.34L300.29,55.45L381.71,54L463.14,52.4L544.57,50.8L626,49.21L626,52.11L544.57,53.71L463.14,55.31L381.71,56.91L300.29,58.36L218.86,60.25L137.43,61.7L56,63.3Z" fill="#1baf7a" opacity="0.85" stroke="#ffffff" stroke-width="1"/></g></svg><ul class="legend"><li><span class="sw sw-c0" aria-hidden="true"></span>Inbound <strong>7,724</strong></li><li><span class="sw sw-c1" aria-hidden="true"></span>Outbound <strong>1,760</strong></li><li><span class="sw sw-c2" aria-hidden="true"></span>Internal <strong>160</strong></li></ul></figure><figure class="chart-card"><figcaption>Threat verdicts over time</figcaption><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 260" class="chart-svg chart-timeseries" role="img" aria-labelledby="chart-traffic-threats-title chart-traffic-threats-desc" focusable="false"><title id="chart-traffic-threats-title">Threat verdicts over time</title><desc id="chart-traffic-threats-desc">Line chart of 8 daily buckets from Nov 16, 2026 00:00 UTC to Nov 23, 2026 00:00 UTC: Spam total 348; Phishing total 28; Malware total 3; BEC total 1; Suspicious total 40; DLP violation total 16.</desc><g><line x1="56" y1="230" x2="626" y2="230" stroke="#c3c2b7" stroke-width="1"/><text x="50" y="234" font-size="10" text-anchor="end" fill="#6b6a65">0</text><line x1="56" y1="157.33" x2="626" y2="157.33" stroke="#e1e0d9" stroke-width="1"/><text x="50" y="161.33" font-size="10" text-anchor="end" fill="#6b6a65">20</text><line x1="56" y1="84.67" x2="626" y2="84.67" stroke="#e1e0d9" stroke-width="1"/><text x="50" y="88.67" font-size="10" text-anchor="end" fill="#6b6a65">40</text><line x1="56" y1="12" x2="626" y2="12" stroke="#e1e0d9" stroke-width="1"/><text x="50" y="16" font-size="10" text-anchor="end" fill="#6b6a65">60</text><text x="56" y="250" font-size="10" text-anchor="start" fill="#6b6a65">Nov 16</text><text x="218.86" y="250" font-size="10" text-anchor="middle" fill="#6b6a65">Nov 18</text><text x="381.71" y="250" font-size="10" text-anchor="middle" fill="#6b6a65">Nov 20</text><text x="544.57" y="250" font-size="10" text-anchor="middle" fill="#6b6a65">Nov 22</text><path d="M56,84.67L137.43,81.03L218.86,77.4L300.29,73.77L381.71,70.13L463.14,66.5L544.57,62.87L626,59.23" fill="none" stroke="#fab219" stroke-width="2"/><path d="M56,219.1L137.43,215.47L218.86,219.1L300.29,215.47L381.71,219.1L463.14,215.47L544.57,219.1L626,215.47" fill="none" stroke="#d03b3b" stroke-width="2"/><path d="M56,226.37L137.43,230