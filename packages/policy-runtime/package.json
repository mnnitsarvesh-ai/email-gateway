{
  "name": "@email-gateway/policy-runtime",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "testing": [
        "dist/testing/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:integration": "echo 'no infrastructure suites in @email-gateway/policy-runtime (writer reads run against transaction doubles here; the policy-engine and mailbox-worker integration suites run them on MySQL)'"
  },
  "dependencies": {
    "@email-gateway/database": "workspace:*",
    "@email-gateway/mailbox-api": "workspace:*",
    "@email-gateway/policy-dsl": "workspace:*",
    "@email-gateway/security-contracts": "workspace:*"
  },
  "devDependencies": {}
}
