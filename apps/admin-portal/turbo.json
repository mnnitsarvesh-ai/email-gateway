{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!src/test/**",
        "$TURBO_ROOT$/docs/api/openapi.json"
      ],
      "env": ["PORTAL_DEV_MOCKS"]
    },
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/docs/api/openapi.json"]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docs/api/openapi.json",
        "$TURBO_ROOT$/docs/security/rbac.md",
        "$TURBO_ROOT$/docs/plan/steps/20-admin-portal.md"
      ]
    }
  }
}
