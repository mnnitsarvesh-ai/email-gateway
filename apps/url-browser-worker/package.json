{
  "name": "@email-gateway/url-browser-worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/main.js",
    "dev:proxy": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/proxy-main.js",
    "start": "node dist/main.js",
    "start:proxy": "node dist/proxy-main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --no-error-on-unmatched-pattern src integration",
    "test": "vitest run --dir src",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@email-gateway/common": "workspace:*",
    "@email-gateway/config": "workspace:*",
    "@email-gateway/event-contracts": "workspace:*",
    "@email-gateway/logger": "workspace:*",
    "@email-gateway/security-contracts": "workspace:*",
    "@email-gateway/shared-types": "workspace:*",
    "@email-gateway/url-security": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "amqplib": "^0.10.9",
    "playwright-core": "1.64.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.6",
    "@swc/core": "^1.13.5",
    "@types/amqplib": "^0.10.7",
    "@types/express": "^5.0.3",
    "unplugin-swc": "^1.5.7"
  }
}
