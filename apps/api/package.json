{
  "name": "@email-gateway/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --exec \"node --env-file-if-exists=../../.env\"",
    "start": "node dist/main.js",
    "auth:bootstrap": "node --env-file-if-exists=../../.env dist/modules/auth/cli/bootstrap-admin.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test integration",
    "test": "vitest run --dir src",
    "test:e2e": "vitest run --dir test",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@email-gateway/common": "workspace:*",
    "@email-gateway/config": "workspace:*",
    "@email-gateway/database": "workspace:*",
    "@email-gateway/event-contracts": "workspace:*",
    "@email-gateway/logger": "workspace:*",
    "@email-gateway/shared-types": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "argon2": "^0.45.1",
    "dns-packet": "^5.6.1",
    "helmet": "^8.1.0",
    "jose": "^5.10.0",
    "nodemailer": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@swc/core": "^1.13.5",
    "@types/dns-packet": "^5.6.5",
    "@types/express": "^5.0.3",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "unplugin-swc": "^1.5.7"
  }
}
